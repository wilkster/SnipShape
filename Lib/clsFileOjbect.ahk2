/************************************************************************
 * @description Class to save recreate editable screen clips using
 *              Either json sidecar or embedded iTxt in PNG files
 * @file clsFileObject.ahk2
 * @author Tom Wilkason
 * @date 2026-08-01 
 * @version 1.0.0
 ***********************************************************************/
#Requires AutoHotkey v2
#include Settings.ahk2
#include clsGDIp.ahk2
#include libMisc.ahk2
#include clsBitmap.ahk2
#include clsSnips.ahk2
#include shapes\clsCommonShape.ahk2
Class FileObject {
   Static FileTag := "SnipShape"
   /**
    * Save a snip and all of its shapes for alter editing in JSON format
    * @param SnipObj Snip Object to save
    * @param fileName Existing File name of png image to append data to
    * @returns {Integer} 1 if sucessful
    */
   Static SaveSnipMetaData(SnipObj, pngFileName) {
      fileObj := {}
      ; Save the shape bitmap
      fileObj.Snip := SnipObj.SnipInfo()
      pTemp        := GDIp.CreateARGBBitmapFromHBITMAP(SnipObj.Handle)

      ; TODO - look into saving binary chunk here vs base64 to save space
      ; Base snip bitmap gets a base64 encoded stream to save to the file
      fileObj.Snip.hBitmap := BitMap.SaveBitmapToFile(pTemp, "dummy.png", , 1)
      GDIp.DisposeImage(pTemp)

      ; Create the shape info objects in JSON format
      fileObj.Shapes := Array()
      For ShapeObj in SnipObj.VisibleShapes {
         Info := ShapeObj.InstanceInfo()
         ; Points is a buffer, serialize the data
         If (Info.hasProp("Points")) {
            ; Type=Buffer
            pts := Bitmap.BinaryToBase64(Info.Points, Info.Points.Size)
            If (Type(pts) = "String") {
               Info.Points := pts
            } Else {
               Info.Points := ""
               MsgBox("Failed to Set Points for Shape", "Shape Error", 0x30)
            }
         }
         ; Serialize embedded bitmaps
         If (Info.HasProp("FileName") and IsInteger(Info.FileName)) {
            pTemp := GDIp.CreateARGBBitmapFromHBITMAP(Info.FileName)
            Info.FileName := BitMap.SaveBitmapToFile(pTemp, "dummy.png", , 1)
            GDIp.DisposeImage(pTemp)
         }
         ; Push each to front so they are restored in the proper Z-Order
         fileObj.Shapes.InsertAt(1, Info)
      }

      ; Now we have the object constructed, get a text version we can write to a file
      txt := JSON.Stringify(fileObj)      

      ; We have the text data, now ready to append to png file
      If (FileExist(pngFileName)) {
         Try {
            PngMeta.WriteText(pngFileName, this.FileTag, txt)
            Return 1
         } Catch as E {
            MsgBox("Error Appending to PNG File`n" pngFileName E.message, 0x30)
         }
      } else
            MsgBox("PNG File does not exist!`n" pngFileName, 0x30)

      ; Failsafe if writing to PNG fails
      ; Try the json sidecar approach if we fail appending to pngfile
      SplitPath(pngFileName,,&folder,,&baseName)
      scFileName := folder "\" baseName ".json"
      ; We have the fileObj, now ready to save to file
      ; We won't get here unless we have been prompted to overwrite
      Try {
         f := FileOpen(scFileName, "w")
         f.write(txt)
         f.Close()
         Return 1
      } Catch as E {
         MsgBox("Failed to save " scFileName, "Save Error", 0x30)
      }
      Return 0
   }
   /**
    * Load a snp snip file so we can continue to edit it.
    * @param fileName File name of the snip to load (snp)
    * @returns {GuiSnip | 0} 
    */
   Static LoadSnip(pngFileName) {

      ; 1. First try the png file to see if data is embedded
      If (FileExist(pngFileName)) {
         Try {
            ; If txt is null there was no sidecar data in the file
            If (txt := PngMeta.ReadText(pngFileName, this.FileTag)) {
               If (SnipObj := this._buildSnip(txt)) {
                  If (Snips.SaveSidecar) {
                     SplitPath(pngFileName, , , , &basename)
                     SnipObj._FileName := pngFileName
                     SnipObj.Title := "SnipShapeWindow - " basename
                  }
                  Return SnipObj
               }
            }
         } Catch as E {
            MsgBox("Error Reading PNG File " pngFileName E.message, 0x30)
         }
      }

      ; 2. Then look for sidecar files if png doesn't contain the data
      SplitPath(pngFileName,,&folder,,&baseName)
      sideCarFileName := folder "\" baseName ".json"
      If (FileExist(sideCarFileName)) {
         If (txt := FileRead(sideCarFileName)) {
            If (SnipObj := this._buildSnip(txt)) {
               If (Snips.SaveSidecar) {
                  SplitPath(sideCarFileName, , , , &basename)
                  SnipObj._FileName := sideCarFileName
                  SnipObj.Title := "SnipShapeWindow - " basename
               }
               Return SnipObj
            }
         } Else {
            MsgBox("Failed to read any text from " sideCarFileName E.message, 0x30)
         }
      }

      ; 3. Finally try to load the png file with layers merged, transparency is supported
      pBitmap := GDIp.CreateBitmapFromFile(pngFileName) 
      If (pBitmap) {
         ; Need an hBitmap for the picture, hand if off
         hBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
         GDIp.DisposeImage(pBitmap)
         SnipObj := Snips.CreateSnipFromHBitmap(hBitmap)
         Return SnipObj
      } Else {
         MsgBox("Did not find a valid bitmap to load for " pngFileName E.message, 0x30)
      }
      ; Nothing worked, return failure
      Return 0
   }
   /**
    * Build the Snip Object from JSON Text data
    * @param txt text of JSON to build with
    * @returns {Integer | GuiSnip} 
    */
   Static _buildSnip(txt) {
      If (txt) {
         Try {
            fileObj := JSON.Parse(txt, , false)
         } Catch as E {
            elog(E)
            MsgBox("Error Parsing JSON data" E.Message, 0x30)
            Return 0
         }

         pTemp := BitMap.LoadBitmapFromBase64(fileObj.Snip.hBitmap)
         If (pTemp > 0) {
            hBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pTemp)
            fileObj.Snip.hBitmap := ""
            GDIp.DisposeImage(pTemp)
            If (SnipObj := Snips.CreateSnipFromHBitmap(hBitmap, fileObj.Snip.Area)) {
               ; If allow edits is true, use the original name and title
               ; We have the data for the snip and the shapes, so recreate them here
               For ShapeInfo in fileObj.Shapes {
                  this._RecreateShape(SnipObj, ShapeInfo)
               }
               Return SnipObj
            } else 
               MsgBox("Failed to Create Snip" , "File Load Error", 0x30)
         }
         MsgBox("Failed to Read bitmap","File Load Error:" pTemp, 0x30)
      }
      Return 0
   }
   /**
    * 
    * @param SnipObj Snip Object just created
    * @param Info Info Object with information how to create the shape
    * @returns {Object} handle to the created shape object
    */
   Static _RecreateShape(SnipObj, Info) {
      Info.Gui := SnipObj
      Switch Info.Source {
         Case "File", "Clip":
            ; Bitmap has already been replaced in Info.FileName
            If (StrLen(Info.FileName) > 500 OR NOT FileExist(Info.FileName)) {
               pTemp := BitMap.LoadBitmapFromBase64(Info.FileName)
               If (pTemp > 0) {
                  Info.FileName := GDIp.CreateARGBHBITMAPFromBitmap(pTemp)
                  GDIp.DisposeImage(pTemp)
               } else 
                  MsgBox("Failed to Create Bitmap Shape:" pTemp, "Shape Error", 0x30)
            }
            CloneObj := Shapes.CreatePicFromSource(SnipObj, Info.FileName, Info.shapeCoord.X1, Info.shapeCoord.Y1)

         Case "BlurShape", "BodyShape", "LineShape", "FreeHand", "Text":
            ; Other shapes
            If (Info.HasProp("drawFunction")) {
               ; Saved as text, get the pointer for freehand draw function
               Info.DrawFunction := getFunctionObject(Info.DrawFunction)
            }
            ; Points buffer recreate
            If (Info.hasProp("Points")) {
               Info.Points := Bitmap.Base64ToBinary(Info.Points)
            }
            CloneObj := SnipObj.AddNewShape(Info.Shape)

         Default:
            warning("Unknwon Shape Source " Info.Source)
            Return 0
      }
      ; Restore saved properties and build the shape
      If (IsSet(CloneObj) AND (CloneObj is commonShape)) {
         ; Blend in saved properties
         For pr, v in Info.OwnProps()
            Try CloneObj.%pr% := v
         ; Now draw the shape on the canvas
         CloneObj.Refresh()
         ShapeOnTop(CloneObj)
      } Else {
         warning("Expected Object for " Info.Source " shape, Num=" Info.Shape)
         Return 0
      }
      Return CloneObj
   }
}
/*
 * PngMeta Class
 * Read and write iTXt chunks to PNG files to contain extra user txt data
 * In this case we are saving the shape information to allow using PNG
 * files as editable SnipShape files. PNG files are still compatible with other apps
 */
class PngMeta {
   ; ---- CRC32 over the type+data bytes of a chunk ----
   static CRC32(pData, size) {
      Return DllCall("ntdll\RtlComputeCrc32", "UInt", 0, "Ptr", pData, "UInt", size, "UInt")
   }

   static Swap32(v) {
      Return ((v & 0xFF) << 24) | ((v & 0xFF00) << 8) | ((v >> 8) & 0xFF00) | ((v >> 24) & 0xFF)
   }

   ; ---- UTF-8 encode a string into a buffer, returns {Buf, Size} (Size excludes the null) ----
   static Utf8Bytes(str) {
      n := StrPut(str, "UTF-8") - 1
      buf := Buffer(n + 1)
      StrPut(str, buf, "UTF-8")
      Return {Buf: buf, Size: n}
   }

   ; ---- Build the iTXt payload: keyword\0 flag(0) method(0) lang\0 xkeyword\0 text ----
   static BuildITXtPayload(keyword, text) {
      kw  := PngMeta.Utf8Bytes(keyword)
      txt := PngMeta.Utf8Bytes(text)
      size := kw.Size + 1 + 1 + 1 + 1 + 1 + txt.Size
      out := Buffer(size, 0)
      off := 0
      DllCall("RtlMoveMemory", "Ptr", out.Ptr + off, "Ptr", kw.Buf.Ptr, "UPtr", kw.Size)
      off += kw.Size + 1        ; keyword's null terminator
      off += 2                  ; compression flag=0, method=0 (buffer already zeroed)
      off += 1 + 1               ; empty language tag + empty translated keyword, both null-terminated
      DllCall("RtlMoveMemory", "Ptr", out.Ptr + off, "Ptr", txt.Buf.Ptr, "UPtr", txt.Size)
      Return out
   }

   ; ---- Wrap a chunk type + payload into a full length/type/data/crc chunk buffer ----
   static BuildChunk(type, pData, dataSize) {
      out := Buffer(12 + dataSize)
      NumPut("UInt", PngMeta.Swap32(dataSize), out, 0)
      Loop 4
         NumPut("UChar", Ord(SubStr(type, A_Index, 1)), out, 3 + A_Index)
      DllCall("RtlMoveMemory", "Ptr", out.Ptr + 8, "Ptr", pData, "UPtr", dataSize)
      crc := PngMeta.CRC32(out.Ptr + 4, 4 + dataSize)
      NumPut("UInt", PngMeta.Swap32(crc), out, 8 + dataSize)
      Return out
   }

   ; ---- Locate every top-level chunk in a PNG buffer ----
   static Parse(buf) {
      chunks := []
      pos := 8
      While (pos + 8 <= buf.Size) {
         len  := PngMeta.Swap32(NumGet(buf, pos, "UInt"))
         type := StrGet(buf.Ptr + pos + 4, 4, "CP0")
         chunks.Push({Start:pos, Len:len, Type:type, Total: 8 + len + 4})
         pos += 8 + len + 4
      }
      Return chunks
   }

   ; ---- Write (replacing any prior copy) a keyword/text pair into a PNG's iTXt chunks ----
   ; Writes bitmaps as well as base64, uses keywords but tradeoff is file size
   static WriteText(fileName, keyword, text) {
      buf := FileRead(fileName, "RAW")
      chunks := PngMeta.Parse(buf)
      payload := PngMeta.BuildITXtPayload(keyword, text)
      newChunk := PngMeta.BuildChunk("iTXt", payload.Ptr, payload.Size)
      tmp := fileName ".tmp"
      f := FileOpen(tmp, "w")
      f.RawWrite(buf.Ptr, 8)                       ; <-- PNG signature, was missing
      For c in chunks {
         If (c.Type = "iTXt") {
            kw := StrGet(buf.Ptr + c.Start + 8, "UTF-8")
            If (kw = keyword)
               Continue                 ; drop the stale copy
         }
         If (c.Type = "IEND")
            f.RawWrite(newChunk.Ptr, newChunk.Size)   ; insert just before IEND
         f.RawWrite(buf.Ptr + c.Start, c.Total)
      }
      f.Close()
      FileDelete(fileName)
      FileMove(tmp, fileName)
   }

   ; ---- Read a keyword's text back out of a PNG's iTXt chunks ----
   static ReadText(fileName, keyword) {
      buf := FileRead(fileName, "RAW")
      For c in PngMeta.Parse(buf) {
         If (c.Type != "iTXt")
            Continue
         kw := StrGet(buf.Ptr + c.Start + 8, "UTF-8")
         If (kw != keyword)
            Continue
         kwSize := StrPut(kw, "UTF-8") - 1
         textOffset := c.Start + 8 + kwSize + 5   ; kw + \0 + flag + method + lang\0 + xkw\0
         textSize   := c.Len - (kwSize + 5)
         Return StrGet(buf.Ptr + textOffset, textSize, "UTF-8")
      }
      Return ""
   }
}
/************************************************************************
 * @description: JSON格式字符串序列化和反序列化, 修改自[HotKeyIt/Yaml](https://github.com/HotKeyIt/Yaml)
 * 增加了对true/false/null类型的支持, 保留了数值的类型
 * https://raw.githubusercontent.com/thqby/ahk2_lib/refs/heads/master/JSON.ahk
 * @author thqby, HotKeyIt
 * @date 2025/12/22
 * @version 1.0.8
 ***********************************************************************/

Class JSON {
   Static null := ComValue(1, 0), true := ComValue(0xB, 1), false := ComValue(0xB, 0)

   /**
    * Converts a AutoHotkey Object Notation JSON string into an object.
    * @param text A valid JSON string.
    * @param keepbooltype convert true/false/null to JSON.true / JSON.false / JSON.null where it's true, otherwise 1 / 0 / ''
    * @param as_map object literals are converted to map, otherwise to object
    */
   Static Parse(text, keepbooltype := false, as_map := true) {
      keepbooltype ? (_true := this.true, _false := this.false, _null := this.null) : (_true := true, _false := false, _null := "")
      as_map ? (map_set := (maptype := Map).Prototype.Set) : (map_set := (obj, key, val) => obj.%key% := val, maptype := Object)
      NQ := "", LF := "", LP := 0, P := "", R := "", text := LTrim(text, " `t`r`n")
      If !text || !InStr('{[', SubStr(text, 1, 1))
         Throw Error("Malformed JSON - unrecognized character.", 0, SubStr(text, 1, 1))
      D := [C := (A := InStr(text, "[") = 1) ? [] : maptype()], text := LTrim(SubStr(text, 2), " `t`r`n"), L := 1, N := 0, V := K := "", J := C, !(Q := InStr(text, '"') != 1) ? text := SubStr(text, 2) : ""
      Loop Parse text, '"' {
         Q := NQ ? 1 : !Q
         NQ := Q && RegExMatch(A_LoopField, '(^|[^\\])(\\\\)*\\$')
         If !Q {
            If (t := Trim(A_LoopField, " `t`r`n")) = "," || (t = ":" && V := 1)
               Continue
            Else If t && (InStr("{[]},:", SubStr(t, 1, 1)) || A && RegExMatch(t, "m)^(null|false|true|-?\d+(\.\d*)?([eE][-+]\d+)?)\s*[,}\]\r\n]")) {
               Loop Parse t {
                  If N && N--
                     Continue
                  If InStr("`n`r `t", A_LoopField)
                     Continue
                  Else If InStr("{[", A_LoopField) {
                     If !A && !V
                        Throw Error("Malformed JSON - missing key.", 0, t)
                     C := A_LoopField = "[" ? [] : maptype(), A ? D[L].Push(C) : map_set(D[L], K, C), D.Has(++L) ? D[L] := C : D.Push(C), V := "", A := Type(C) = "Array"
                     Continue
                  } Else If InStr("]}", A_LoopField) {
                     If !A && V
                        Throw Error("Malformed JSON - missing value.", 0, t)
                     Else If L = 0
                        Throw Error("Malformed JSON - to many closing brackets.", 0, t)
                     Else C := --L = 0 ? "" : D[L], A := Type(C) = "Array"
                  } Else If !(InStr(" `t`r,", A_LoopField) || (A_LoopField = ":" && V := 1)) {
                     If RegExMatch(SubStr(t, A_Index), "m)^(null|false|true|-?\d+(\.\d*)?([eE][-+]\d+)?)\s*[,}\]\r\n]", &R) && (N := R.Len(0) - 2, R := R.1, 1) {
                        If A
                           C.Push(R = "null" ? _null : R = "true" ? _true : R = "false" ? _false : IsNumber(R) ? R + 0 : R)
                        Else If V
                           map_set(C, K, R = "null" ? _null : R = "true" ? _true : R = "false" ? _false : IsNumber(R) ? R + 0 : R), K := V := ""
                        Else Throw Error("Malformed JSON - missing key.", 0, t)
                     } Else {
                        ; Added support for comments without '"'
                        If A_LoopField == '/' {
                           nt := SubStr(t, A_Index + 1, 1), N := 0
                           If nt == '/' {
                              If nt := InStr(t, '`n', , A_Index + 2)
                                 N := nt - A_Index - 1
                           } Else If nt == '*' {
                              If nt := InStr(t, '*/', , A_Index + 2)
                                 N := nt + 1 - A_Index
                           } Else nt := 0
                           If N
                              Continue
                        }
                        Throw Error("Malformed JSON - unrecognized character.", 0, A_LoopField " in " t)
                     }
                  }
               }
            } Else If A || InStr(t, ':') > 1
               Throw Error("Malformed JSON - unrecognized character.", 0, SubStr(t, 1, 1) " in " t)
         } Else If NQ && (P .= A_LoopField '"', 1)
            Continue
         Else If A
            LF := P A_LoopField, C.Push(InStr(LF, "\") ? UC(LF) : LF), P := ""
         Else If V
            LF := P A_LoopField, map_set(C, K, InStr(LF, "\") ? UC(LF) : LF), K := V := P := ""
         Else
            LF := P A_LoopField, K := InStr(LF, "\") ? UC(LF) : LF, P := ""
      }
      Return J
      UC(S, e := 1) {
         Static m := Map('"', '"', "a", "`a", "b", "`b", "t", "`t", "n", "`n", "v", "`v", "f", "`f", "r", "`r")
         Local v := ""
         Loop Parse S, "\"
            If !((e := !e) && A_LoopField = "" ? v .= "\" : !e ? (v .= A_LoopField, 1) : 0)
               v .= (t := m.Get(SubStr(A_LoopField, 1, 1), 0)) ? t SubStr(A_LoopField, 2) :
                  (t := RegExMatch(A_LoopField, "i)^(u[\da-f]{4}|x[\da-f]{2})\K")) ?
                     Chr("0x" SubStr(A_LoopField, 2, t - 2)) SubStr(A_LoopField, t) : "\" A_LoopField,
                  e := A_LoopField = "" ? e : !e
         Return v
      }
   }

   /**
    * Converts a AutoHotkey Array/Map/Object to a Object Notation JSON string.
    * @param obj A AutoHotkey value, usually an object or array or map, to be converted.
    * @param expandlevel The level of JSON string need to expand, by default expand all.
    * @param space Adds indentation, white space, and line break characters to the return-value JSON text to make it easier to read.
    */
   Static Stringify(obj, expandlevel := unset, space := "  ") {
      expandlevel := IsSet(expandlevel) ? Abs(expandlevel) : 10000000
      Return Trim(CO(obj, expandlevel))
      CO(O, J := 0, R := 0, Q := 0) {
         Static M1 := "{", M2 := "}", S1 := "[", S2 := "]", N := "`n", C := ",", S := "- ", E := "", K := ":"
         If (OT := Type(O)) = "Array" {
            D := !R ? S1 : ""
            For key, value in O {
               F := (VT := Type(value)) = "Array" ? "S" : InStr("Map,Object", VT) ? "M" : E
               Z := VT = "Array" && value.Length = 0 ? "[]" : ((VT = "Map" && value.count = 0) || (VT = "Object" && ObjOwnPropCount(value) = 0)) ? "{}" : ""
               D .= (J > R ? "`n" CL(R + 2) : "") (F ? (%F%1 (Z ? "" : CO(value, J, R + 1, F)) %F%2) : ES(value)) (OT = "Array" && O.Length = A_Index ? E : C)
            }
         } Else {
            D := !R ? M1 : ""
            For key, value in (OT := Type(O)) = "Map" ? (Y := 1, O) : (Y := 0, O.OwnProps()) {
               F := (VT := Type(value)) = "Array" ? "S" : InStr("Map,Object", VT) ? "M" : E
               Z := VT = "Array" && value.Length = 0 ? "[]" : ((VT = "Map" && value.count = 0) || (VT = "Object" && ObjOwnPropCount(value) = 0)) ? "{}" : ""
               D .= (J > R ? "`n" CL(R + 2) : "") (Q = "S" && A_Index = 1 ? M1 : E) ES(key) K (F ? (%F%1 (Z ? "" : CO(value, J, R + 1, F)) %F%2) : ES(value)) (Q = "S" && A_Index = (Y ? O.count : ObjOwnPropCount(O)) ? M2 : E) (J != 0 || R ? (A_Index = (Y ? O.count : ObjOwnPropCount(O)) ? E : C) : E)
               If J = 0 && !R
                  D .= (A_Index < (Y ? O.count : ObjOwnPropCount(O)) ? C : E)
            }
         }
         If J > R
            D .= "`n" CL(R + 1)
         If R = 0
            D := RegExReplace(D, "^\R+") (OT = "Array" ? S2 : M2)
         Return D
      }
      ES(S) {
         Switch Type(S) {
            Case "Float":
               If (v := '', d := InStr(S, 'e'))
                  v := SubStr(S, d), S := SubStr(S, 1, d - 1)
               If ((StrLen(S) > 17) && (d := RegExMatch(S, "(99999+|00000+)\d{0,3}$")))
                  S := Round(S, Max(1, d - InStr(S, ".") - 1))
               Return S v
            Case "Integer":
               Return S
            Case "String":
               S := StrReplace(S, "\", "\\")
               S := StrReplace(S, "`t", "\t")
               S := StrReplace(S, "`r", "\r")
               S := StrReplace(S, "`n", "\n")
               S := StrReplace(S, "`b", "\b")
               S := StrReplace(S, "`f", "\f")
               S := StrReplace(S, "`v", "\v")
               S := StrReplace(S, '"', '\"')
               Return '"' S '"'
            default:
               Return S == this.true ? "true" : S == this.false ? "false" : "null"
         }
      }
      CL(i) {
         Loop (s := "", space ? i - 1 : 0)
            s .= space
         Return s
      }
   }
}
