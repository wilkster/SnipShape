/************************************************************************
 * @description Class to create a screen clip
 * @file clsGuiSnip.ahk2
 * @author Tom Wilkason
 * @date 2026/07/18
 * @version 1.0.0
 ***********************************************************************/
#Requires AutoHotkey v2
#include Settings.ahk2
#include libMisc.ahk2
#include clsGuiSnip.ahk2
#include clsGDIp.ahk2
#include clsBitmap.ahk2 
#include clsShapes.ahk2
#include clsMenus.ahk2
#include clsShapeGroup.ahk2
#include ColorPopDown.ahk2
/**
 * Extended GUI class that stores snip-specific metadata, brush caches, and bitmap state
 */
Class GuiSnip extends Gui {
   /**
    * Create a new snip GUI window and register it in the global snip map
    * @param {Object} [objArea] - Area object with X, Y, W, H describing the captured region
    */
   __New(objArea := "") {
      ; +E0x80000 Layered WS_EX_LAYERED
      ; +0x1010000 WS_CLIPCHILDREN + WS_VISIBLE , 
      Static Opt := '+E0x80000 -0x1010000 -AlwaysOnTop -Caption -ToolWindow +OwnDialogs -DPIScale'
      super.__New(Opt, "", this)

      if Snips.topMost
         this.Opt("+AlwaysOnTop")
      this.Time                 := Snips.timeTag ; time at creation
      this._Area                := objArea
      this._DrawMode            := 0
      this.Counter              := 0
      this.Dirty                := 0
      this.Title                := "SnipShapeWindow - " this.Time . ' (' this._Area.W 'x' this._Area.H ')'
      this._FileName            := ""
      this.BrushMap             := Map()
      this.BrushCount           := Map()
      this.priorDrawMode        := 0
      this.myHandle             := 0
      this.BW                   := Settings.BorderWidth
      Snips.guiSnips[this.hWnd] := this
      this.UnDo                 := UnDo()
      ; Picture model: _base is the master picture at 100%; every edit is made to it.
      ; myHandle is only the display picture, always rebuilt from _base at _zoom.
      this._base                := 0
      this._zoom                := 1.0
      this._alpha               := 0xFF
      this.ogRadius             := 0
      super.MarginX := super.MarginY := this.BW
      ; logGDI("+Create Snip:" this.Title)
      ; RMB menu is on the screenshot picture control
      super.OnEvent("Close", this.Destroy.Bind(this))
      super.OnEvent("Escape", Snips.Close.Bind(Snips, this))
      ; Image files dropped on the snip (or any of its shapes) open as new snips
      super.OnEvent("DropFiles", Snips.DropFiles.Bind(Snips))
      super.OnMessage(0x0216, this.WM_SIZEEMOVE_GUI.Bind(this))
      super.OnMessage(0x0231, this.WM_SIZEEMOVE_GUI.Bind(this))
      super.OnMessage(0x006, this.WM_ACTIVATE_GUI.Bind(this))
   }
   /**
    * Destructor — releases all cached GDI+ texture brushes when the GUI object is garbage-collected
    */
   __Delete(*) {
      For key, brush in this.BrushMap {
         GDIp.DeleteBrush(brush)
         debug("Deleted brush " key)
      }
      this.BrushMap := Map()
      this.BrushCount := Map()
   }
   /**
    * Post an undo action to the Snip UnDo/ReDo class
    * @param what Action
    */
   PostAction(what, tag:="") {
      this.UnDo.PostAction(this, what, tag)
   }
   /**
    * Undo the last undo action off the stack
    */
   PopAction() {
      this.UnDo.PopAction()
   }      
   /**
    * Initiate orderly destruction of the snip: clear shapes, release the save bitmap,
    * remove from the global snip map, and hide the button bar if no snips remain
    * Called by Snips.Close()
    */
   Destroy(*) {
      ; A shape group on this snip goes with it (its box is owned by this window)
      If (ShapeGroup.SnipObj = this)
         ShapeGroup.Clear()
      Try {
         ; title := this.Title
         this.ClearAllShapes(true)  ; in case we have built in GC
         ; Free the undo/redo history (bitmap copies). Emptying the stacks also breaks
         ; the snip <-> undo reference cycle (entries are what point back at the snip).
         ; Snips.Close unsets UnDo before calling this (which also frees it); other
         ; paths (the window's Close event) arrive with it still set.
         If (this.HasOwnProp("UnDo") AND IsObject(this.UnDo))
            this.UnDo.Clear()
         hwnd := this.hWnd
         super.Destroy()
         GDI.DeleteObject(this.myHandle)
         if (this._base)
            GDI.DeleteObject(this._base)
            
         Snips.guiSnips.Delete(hwnd) ; remove from known snips
         ; logGDI("-Close  Snip:" Title ", " GetProcessMemoryInfo("K") ",")
      } Catch as E {
         elog(E,"During Object Destroy")
      } Finally {
         focusBorder.HideFocus()
         if (Snips.VisibleSnips() = 0)
            ButtonBar.Hide()
         ; Force windows to reclaim (used for checkking for memory leaks)
         if (Snips.guiSnips.Count == 0)
            DllCall("psapi\EmptyWorkingSet", "ptr", -1)
      }
      Return 1
   }
   /*
   * Return the current scale factor for this snip
   */
   ScaleFactor => this._zoom
   Radius {
      get {
         Return round(this.ogRadius * this.ScaleFactor)
      }
   }
   /**
    * Put a snip and border for the background of the GUI
    * @param hBitmap Handle to bitmap to use as the snip background
    * @param x/y Optional location to place the snip on the screen
    * @returns {Any} 
    */
   AddSnipPic(hBitmap, x?, y?) {
      this.OnEvent("ContextMenu", SnipMenus.Post.bind(SnipMenus))
      this._renderSnip(hBitmap, x?, y?)
      this.MyHandle := hBitmap
      ; The master picture starts as a copy at 100%
      If (this._base)
         GDI.DeleteObject(this._base)
      this._base := GDI.CopyImage(hBitmap)
      this._zoom := 1.0
      Return hBitmap
   }
   /**
    * Return the postion of the snip
    * @param x,y,w,h GUI Coordinates
    */
   getPicPos(&x?, &y?, &w?, &h?) {
      GDI.GetHBitmapDimensions(this.Handle, &hW, &hH)
      bw := Settings.BorderWidth
      x := bw
      y := bw
      w := hW
      h := hH
   }
   /**
    * Return the location of the snip picture on the screen
    * @param x,y,w,h screen Coordinates
    */
   getPicLocation(&x?, &y?, &w?, &h?) {
      bw := Settings.BorderWidth
      GDI.GetHBitmapDimensions(this.Handle, &hW, &hH)
      this.GetPos(&gx, &gy)
      x := gx + bw
      y := gy + bw
      w := hW
      h := hH
   }
   /**
    * Return the dimensions of the Snip bitmap.
    * @type {Object} W/H
    */
   Dimensions {
      get {
         GDI.GetHBitmapDimensions(this.Handle, &W, &H)
         return {W:W, H:H}
      }
   }

   /**
    * Replace the snip bitmap with a new modified version, 
    * also optionally place it on the screen
    * @param hBitmap Snip Bitmap to replace
    * @param x optional X screen position
    * @param y option Y screen position
    */
   ReplaceSnip(hBitmap, x?, y?) {
      If (hBitmap != this.MyHandle) {
         this._renderSnip(hBitmap, x?, y?)
         GDI.DeleteObject(this.MyHandle)
         this.MyHandle := hBitmap
      }
   }
   /**
    * Make the corners of some snips transparent if it has a radius
    * Generally called when first capturing the window
    * @param radius Radius to use, based on original snip
    */
   RoundSnipCorners(radius?) {
      If (IsSet(radius)) {
         this.ogRadius := radius
      } Else {
         radius := this.ogRadius
      }
      ; Round the master picture; the display picture is rebuilt from it (scaling
      ; keeps the transparent corners)
      If (radius AND this._base) {
         BitMap.RoundWindowCorners(this._base, radius)
         this.SetZoom(this._zoom)
      }
   }
  /**
   * Update the border color of the snip to the back color of the GUI
   */
   BackColor {
      get {
         Try {
            bc := super.BackColor ;  STM_GETIMAGE, STM_SETIMAGE := 0x172 to set
            return bc
         } Catch as E {
            return 0x808080
         }
      }
      ; Resize control to actual bitmap size
      set {
         super.Backcolor := value
         if (this.myHandle)
            this._renderSnip(this.myHandle)
      }
   }
   /**
    * Get or set the underlying HBITMAP handle for the GUI.
    * It will resize the window to match the new bitmap dimensions.
    * @type {Integer}
    */
   Handle => this.myHandle   ; display picture (read only: edit the picture with SetBase)
   Alpha {
      get => this._alpha
      set {
         ; Don't allow fully transparent otherwise it disappears
         newAlpha := Constrain(0xF, 0xFF, Value)
         If (newAlpha != this._alpha) {
            ; Store first: _renderSnip draws with this._alpha
            this._alpha := newAlpha
            this._renderSnip(this.myHandle)
         }
      }
   }
   /**   
    * Return a list of visible (active) shapes on the snip in Z-Order
    * Order is Useful when restoring shapes from sidecar file
    */
   VisibleShapes {
      get {
         myShapes := Array()
         hwndShape := DllCall("GetWindow", "Ptr", this.Hwnd, "UInt", 5, "Ptr")  ; GW_CHILD = 5
         If (Obj := (GuiCtrlFromHwnd(hwndShape) ?? false)) {
            If (Obj.HasProp("Visible") AND Obj.Visible)
               myShapes.Push(Obj)
            ; Loop through all child windows
            While (hwndShape != 0) {
               ; Get the next child window in Z-order (below the current one)
               hwndShape := DllCall("GetWindow", "Ptr", hwndShape, "UInt", 2, "Ptr")  ; GW_HWNDNEXT = 2
               Obj := GuiCtrlFromHwnd(hwndShape) ?? false
               If (Obj AND Obj.HasProp("Visible") AND Obj.Visible)
                  myShapes.Push(Obj) ; First In First Out
            }
         }
         Return myShapes
      }
   }
   /**
    * Get or set the underlying HBITMAP handle for the GUI.
    * It will resize the window to match the new bitmap dimensions.
    * @type {Integer}
    */
   ;----------------------------------------------------------------------
   ; Picture model
   ;  _base    master picture at 100%; all picture edits are made to it
   ;  _zoom    display zoom (ScaleFactor)
   ;  myHandle display picture (Handle), always _base scaled by _zoom
   ; Shapes and the window are in display coordinates; RectToBase/_Ratios map a
   ; window rectangle to master pixels.
   ;----------------------------------------------------------------------
   /**
    * Master picture at 100% (owned by the snip; copy it before changing it)
    * @type {Integer}
    */
   BaseBitmap => this._base
   /**
    * Scale a master picture to the display zoom
    * @param {Integer} [hBase] - master picture (default: the snip's)
    * @param {Float} [zoom] - zoom (default: the snip's)
    * @returns {Integer} new display hBitmap (caller owns)
    */
   _ScaledBase(hBase?, zoom?) {
      hBase ??= this._base
      zoom  ??= this._zoom
      If (zoom = 1.0)
         Return GDI.CopyImage(hBase)
      pBitmap := GDIp.WrapARGBBitmapFromHBITMAP(hBase)
      pScaled := BitMap.BitmapScale(pBitmap, zoom)   ; disposes pBitmap when it scales
      hBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pScaled)
      GDIp.DisposeImage(pScaled)
      Return hBitmap
   }
   /**
    * Install a new master picture and its display picture (both now owned by the snip)
    * @param {Integer} hBase - new master picture
    * @param {Integer} hDisp - display picture made from it (_ScaledBase)
    * @param {Integer} [x] - new window X (screen)
    * @param {Integer} [y] - new window Y (screen)
    */
   _SetPicture(hBase, hDisp, x?, y?) {
      If (this._base AND this._base != hBase)
         GDI.DeleteObject(this._base)
      this._base := hBase
      this.ReplaceSnip(hDisp, x?, y?)
   }
   /**
    * Replace the master picture (an edited copy) and redraw it at the current zoom
    * @param {Integer} hBase - new master picture, now owned by the snip
    */
   SetBase(hBase, x?, y?) => this._SetPicture(hBase, this._ScaledBase(hBase), x?, y?)
   /**
    * Show the master picture at a zoom (no undo, shapes untouched)
    * @param {Float} zoom - zoom factor (1.0 = 100%)
    */
   SetZoom(zoom, x?, y?) {
      this._zoom := zoom
      this.ReplaceSnip(this._ScaledBase(), x?, y?)
   }
   /**
    * Exact display/master size ratios (the display is Ceil(base * zoom))
    */
   _Ratios(&rX, &rY) {
      GDI.GetHBitmapDimensions(this._base, &baseW, &baseH)
      GDI.GetHBitmapDimensions(this.myHandle, &dW, &dH)
      rX := dW / baseW, rY := dH / baseH
   }
   /**
    * Map a rectangle in snip window coordinates to master picture pixels
    * (edges rounded to the nearest master pixel, clamped to the picture)
    * @returns {Object} {X, Y, W, H} in master pixels
    */
   RectToBase(l, t, r, b) {
      BW := Settings.BorderWidth
      this._Ratios(&rX, &rY)
      ; (not bW/bH: AHK names are case-insensitive, bW would be BW)
      GDI.GetHBitmapDimensions(this._base, &baseW, &baseH)
      x1 := Constrain(0, baseW, Round((l - BW) / rX)), x2 := Constrain(0, baseW, Round((r - BW) / rX))
      y1 := Constrain(0, baseH, Round((t - BW) / rY)), y2 := Constrain(0, baseH, Round((b - BW) / rY))
      Return { X: x1, Y: y1, W: x2 - x1, H: y2 - y1 }
   }
   /**
    * Iterate all visible non-screen shapes and call their Refresh method
    * to redraw texture brushes after a bitmap change
    */
   RefreshTextures() {
      this.ReleaseAllBrushes()
      For ShapeObj in this.VisibleShapes {
         ShapeObj.Refresh()
      }
   }
   /**
    * Take a hBitmap and paint it into a layered window.
    * @param {Object} Bitmap Handle Object with X, Y, W, H properties defining the region
    * @param {Integer} X/Y, optional location to place the gui
    */
   _renderSnip(hBitmap, x?, y?) {
      ; keep this.hWnd's current top-left; only the size grows (per spec)
      this.GetPos(&winX, &winY)
      x ??= winX
      y ??= winY
      ; NOTE If we want to adjust transparency do it here so border is always correct
      hDIB := this._ComposeSnip(hBitmap, this._alpha, &newW, &newH)

      hdcScreen := GDI.GetDC(0)
      hdcMem    := GDI.CreateCompatibleDC(hdcScreen)
      obm       := GDI.SelectObject(hdcMem, hDIB)
      ; Update the GUI with the snip and border
      GDI.UpdateLayeredWindow(this.hWnd, hdcMem, x, y, newW, newH)

      ; clean up
      GDI.SelectObject(hdcMem, obm)
      GDI.DeleteObject(hDIB)
      GDI.DeleteDC(hdcMem)
      GDI.ReleaseDC(hdcScreen)
      Return
   }

   /**
    * Build the snip image with its border (what _renderSnip shows), as a new 32bpp DIB.
    * @param {Integer} hBitmap - Snip picture
    * @param {Integer} alpha - Snip transparency (255 = opaque)
    * @param {VarRef} newW - Returns the width (picture + 2 borders)
    * @param {VarRef} newH - Returns the height
    * @returns {Integer} hDIB, caller owns it
    */
   _ComposeSnip(hBitmap, alpha, &newW?, &newH?) {
      GDI.GetHBitmapDimensions(hBitmap, &W, &H)
      BW   := Settings.BorderWidth
      SBW  := Settings.SnippingBorderWidth
      newW := W + BW * 2
      newH := H + BW * 2

      hdcScreen := GDI.GetDC(0)
      hdcMem    := GDI.CreateCompatibleDC(hdcScreen)
      hDIB      := GDI.CreateDIBSection(newW, newH, hdcMem)
      obm       := GDI.SelectObject(hdcMem, hDIB)

      ; blit the caller's bitmap into the middle, inset by bw on each side
      hdcSrc := GDI.CreateCompatibleDC(hdcScreen)
      obmSrc := GDI.SelectObject(hdcSrc, hBitmap)
      GDI.BitBlt(hdcMem, BW, BW, W, H, hdcSrc, 0, 0)
      ; Premultiply if we have some transparency to show
      BitMap.PreMultiplyBitmap(hDIB, alpha)
      If (BW > 0) {
         iG := GDIp.GraphicsFromHDC(hdcMem)
         ; Paint the border fully opaque
         bc := RGBval(this.BackColor)
         pen := GDIp.CreatePen(0xFF000000 | bc, BW)
         GDIp.SetPenAlignment(pen, 1)
         GDIp.SetPenLineJoin(pen, 2)  ;1=bevel, 2=rounded
         ; Shadow, fade the border color outside to in to fill the gap
         ; between snip border width and the live snipper border width.
         GDIp.DrawRectangle(iG, pen, 0, 0, newW, newH)
         If (SBW < BW) {
            GDIp.SetCompositingMode(iG, 1)
            maxAlpha := 200
            n := BW - SBW                          ; number of 1px fade rings
            i := 0
            shadowRGB := DeSaturate(RGBval(this.BackColor), 0.7)
            GDIp.SetPenWidth(pen, 1)
            i := 0
            Loop n {
               t := (i + 1) / n
               opacity := Round(maxAlpha * t * t)
               GDIp.SetPenColor(pen, opacity << 24 | shadowRGB)
               GDIp.DrawRectangle(iG, pen, i, i, newW - i * 2, newH - i * 2)
               i += 1
            }
         }
         GDIp.DeletePen(pen)
      }
      ; Restore obm and delete DC we created
      GDI.SelectObject(hdcSrc, obmSrc)
      GDI.DeleteDC(hdcSrc)

      ; clean up (deleting the graphics flushes any pending GDI+ drawing)
      if (IsSet(iG))
         GDIp.DeleteGraphics(iG)
      GDI.SelectObject(hdcMem, obm)
      GDI.DeleteDC(hdcMem)
      GDI.ReleaseDC(hdcScreen)
      Return hDIB
   }

   /**
    * Used by Snip2Clipboard and Snip2File.
    * Render the snip and all of its visible shapes onto a new hBitmap, without a screen
    * capture: nothing on top of the snip (other windows, the focus box, the button bar)
    * can get into it, and the snip doesn't need to be visible.
    * Each shape draws itself again on demand (commonShape.RenderSurface), bottom to
    * top, at its current position, with the same drawing code as the screen.
    * The snip's transparency (Alpha) is applied to the picture as on screen; the
    * border and the shapes stay opaque, as they do on screen.
    * Shapes that extend past the picture are clipped to it (or to the border when
    * Borders is true), as on screen.
    * @param {Integer} [Borders=false] - Include the snip border (as drawn on screen)
    * @returns {Integer} 32bpp hBitmap (DIB section, premultiplied ARGB); caller owns it,
    *                    e.g. pass it to Clipboard.SetHBITMAPToClipboard or delete it
    */
   RenderBitmap(Borders := false) {
      Static AC_SRC_OVER_ALPHA := 0x01FF0000   ; BLENDFUNCTION: SrcOver, const alpha 255, AC_SRC_ALPHA
      BW := Settings.BorderWidth
      ; Start from exactly what the snip window shows (picture + border), so pixels,
      ; alpha and rounded corners match the screen; shape window coords are canvas coords
      hFull := this._ComposeSnip(this.myHandle, this._alpha)
      hdcDst := GDI.CreateCompatibleDC(0)
      obmDst := GDI.SelectObject(hdcDst, hFull)
      hdcSrc := GDI.CreateCompatibleDC(0)
      ; VisibleShapes is top of the Z-order first: paint from the bottom up
      ; Each shape draws itself again onto its own surface (commonShape.RenderSurface)
      list := this.VisibleShapes
      i := list.Length
      While (i >= 1) {
         ShapeObj := list[i--]
         Try {
            If NOT (r := ShapeObj.RenderSurface())
               Continue
         } Catch as e {
            elog(e, "RenderBitmap: shape " ShapeObj.ShapeName " failed to render")
            Continue
         }
         DllCall("Msimg32\AlphaBlend"
            , "Ptr", hdcDst, "Int", r.X, "Int", r.Y, "Int", r.Surf.W, "Int", r.Surf.H
            , "Ptr", r.Surf.hdc, "Int", 0, "Int", 0, "Int", r.Surf.W, "Int", r.Surf.H
            , "UInt", AC_SRC_OVER_ALPHA)
         r := ""
      }
      If (Borders) {
         GDI.SelectObject(hdcDst, obmDst)
         GDI.DeleteDC(hdcDst), GDI.DeleteDC(hdcSrc)
         Return hFull
      }
      ; No border: copy out the picture area (shapes past the picture are clipped here)
      GDI.GetHBitmapDimensions(this.myHandle, &W, &H)
      hOut   := GDI.CreateDIBSection(W, H, hdcSrc)
      obmOut := GDI.SelectObject(hdcSrc, hOut)
      GDI.BitBlt(hdcSrc, 0, 0, W, H, hdcDst, BW, BW)
      GDI.SelectObject(hdcSrc, obmOut)
      GDI.DeleteDC(hdcSrc)
      GDI.SelectObject(hdcDst, obmDst)
      GDI.DeleteDC(hdcDst)
      GDI.DeleteObject(hFull)
      Return hOut
   }

   /**
    * Render some of this snip's shapes into a new 32bpp DIB (caller owns) covering
    * a rectangle of the snip window. Used to copy a shape group (ShapeGroup).
    * @param {Array} shapeList - shapes to draw (painted in Z-order, bottom first)
    * @param {Object} rc - {X, Y, W, H} in snip window coordinates
    * @param {Integer} withPicture - true: over the snip picture/border as shown;
    *                                false: on a transparent background
    * @returns {Integer} hBitmap
    */
   RenderShapes(shapeList, rc, withPicture := true) {
      Static AC_SRC_OVER_ALPHA := 0x01FF0000
      If (withPicture) {
         hFull := this._ComposeSnip(this.myHandle, this._alpha)
      } Else {
         this.GetPos(, , &wW, &wH)
         hdcT  := GDI.CreateCompatibleDC(0)
         hFull := GDI.CreateDIBSection(wW, wH, hdcT)   ; zero filled = transparent
         GDI.DeleteDC(hdcT)
      }
      want := Map()
      For shp in shapeList
         want[shp.hWnd] := true
      hdcDst := GDI.CreateCompatibleDC(0)
      obmDst := GDI.SelectObject(hdcDst, hFull)
      list := this.VisibleShapes   ; top of the Z-order first
      i := list.Length
      While (i >= 1) {
         ShapeObj := list[i--]
         If NOT want.Has(ShapeObj.hWnd)
            Continue
         Try {
            If NOT (r := ShapeObj.RenderSurface())
               Continue
         } Catch as e {
            elog(e, "RenderShapes: shape " ShapeObj.ShapeName " failed to render")
            Continue
         }
         DllCall("Msimg32\AlphaBlend"
            , "Ptr", hdcDst, "Int", r.X, "Int", r.Y, "Int", r.Surf.W, "Int", r.Surf.H
            , "Ptr", r.Surf.hdc, "Int", 0, "Int", 0, "Int", r.Surf.W, "Int", r.Surf.H
            , "UInt", AC_SRC_OVER_ALPHA)
         r := ""
      }
      GDI.SelectObject(hdcDst, obmDst)
      GDI.DeleteDC(hdcDst)
      ; CropHBITMAP deletes hFull
      Return BitMap.CropHBITMAP(hFull, rc.X, rc.Y, Max(1, rc.W), Max(1, rc.H))
   }

   /**
    * Adjust the reference count for a cached brush by a given amount
    * @param {Integer} brush - GDI+ brush handle
    * @param {Integer} [Amount=0] - Delta to apply to the reference count
    * @returns {Integer} The new reference count
    */
   _BrushRefCount(brush, Amount:=0) {
      if (this.BrushCount.Has(brush))
         this.BrushCount[brush] += Amount
      else
         this.BrushCount[brush] := Amount
      ; debug("Brush Reference Count Now =" this.BrushCount[brush] ", amount=" Amount)
      Return this.BrushCount[brush]
   }
   /**
    * Build the map key used to look up a cached texture brush
    * @param {String} shape - Shape type identifier
    * @param {String|Float} parameter - Shape-specific brush parameter
    * @returns {String} Composite cache key string
    */
   _BrushKey(shape, parameter) =>  "brush-" . shape . "-" . (IsFloat(parameter) ? round(parameter,3) : parameter)
   /**
    * Add a new texture brush to the cache; warns if a brush already exists for the key
    * @param {Integer} brush - GDI+ brush handle to cache
    * @param {String} shape - Shape type identifier
    * @param {String|Float} parameter - Shape-specific brush parameter used to build the cache key
    */
   AddBrush(brush, shape, parameter) {
      key := this._BrushKey(shape, parameter)
      if (this.BrushMap.Has(key))
         Warning("Did not expect to find an existing brush for " key)
      this.BrushMap[key] := brush
      this._BrushRefCount(brush, 1)
      ; debug("Adding new Brush:'" key "' " hex(brush))
   }
   /**
    * Retrieve a cached brush and increment its reference count
    * @param {String} shape - Shape type identifier
    * @param {String|Float} parameter - Shape-specific brush parameter
    * @returns {Integer} The cached GDI+ brush handle, or 0 if not found
    */
   GetBrush(shape, parameter) {
      key := this._BrushKey(shape, parameter)
      If (brush := this.BrushMap.Get(key, 0)) {
         this._BrushRefCount(brush, 1)
      }
      Return brush
   }
   /**
    * Decrement the reference count for a brush and delete it when the count reaches zero
    * @param {Integer} handle - GDI+ brush handle to release
    * @returns {Integer} Remaining reference count, or 0 if the brush was not found
    */
   ReleaseBrush(handle) {
      For key, brush in this.BrushMap {
         If (brush = handle) {
            ; If there remain no more references to the brush delete it
            if ((res := this._BrushRefCount(brush,-1)) == 0) {
               GDIp.DeleteBrush(brush)
               this.BrushMap.Delete(key)
               this.BrushCount.Delete(brush)
               ; debug("Deleted a brush " key " " hex(brush) ", " this.BrushMap.Count " remaining unique brushes")
            }
            Return res
         }
      }
      Return 0
   }
   /**
    * Reset all the texture/image brushes ref count to 1
    * Needed if the bitmap changes underneath
    * Next time we refresh a brush, it will be replaces since
    * Count is only 1
    */
   ReleaseAllBrushes() {
      For key, brush in this.BrushMap {
         if (this.BrushCount[brush] > 1)
            this.BrushCount[brush] := 1
      }
   }
   /**
    * Get or set the area object describing the captured screen region
    * @type {Object}
    */
   Area {
      get => this._Area
      set => this._Area := Value
   }
   /**
    * Get or set the current draw mode for this snip
    * @type {Integer}
    */
   DrawMode {
      get => this._DrawMode
      set {
         this.priorDrawMode := this._DrawMode 
         this._DrawMode := Value
      }
   }
   /**
    * Get or set the file path associated with this snip.
    * Setting this property also updates the window title to the base filename.
    * @type {String}
    */
   FileName {
      set {
         SplitPath(value,,,,&baseName)
         this.Title := "SnipShapeWindow - " baseName
         this._FileName := value
      }
      get => this._FileName
   }
   /**
    * Get the display base name for the snip.
    * Returns the filename stem if a file is associated, otherwise a timestamp and dimensions string.
    * @type {String}
    */
   BaseName {
      get {
         if (this.FileName) {
            SplitPath(this._FileName,,,,&baseName)
            return basename
         } Else {
            return this.Time . ' (' this._Area.W 'x' this._Area.H ')'
         }
      }
   }
      /**
    * Posta a DELETE_SHAPE event if user is clearing all the shapes
    * Call separate due to posting vs not posting
    * @param {Integer} hWnd 
    */
   PostClearAllShapes() {
      tag := UnDo.NewTag("ClearAll")
      For ShapeObj in this.VisibleShapes {
         ShapeObj.PostAction(UnDo.DELETE_SHAPE, tag)
      }
   }
   /**
    * Clear all non-screen shapes from a snip and reset its dirty flag
    * @param {Integer} [hWnd=0] - Window handle of the target snip; defaults to the active window
    */
   ClearAllShapes(skipundo := false) {
      For ShapeObj in this.VisibleShapes {
         ShapeObj.Close(skipundo)
      }
      this.Dirty := 0
   }

   /**
    * Return the most common color at some pixel location.
    * Good for finding the true background color.
    * Handles GDI+ startup/shutdown here.
    * @param {Integer} winX - Window-relative X coordinate of the center point
    * @param {Integer} winY - Window-relative Y coordinate of the center point
    * @param {Integer} [extent=0] - Radius around the center point to extend the search matrix
    * @returns {String} Most common color in hex string format
    */
   BackgroundPICColorFromXY(winX, winY, extent := 10) {
      hBitmap := this.Handle
      ; Center of the region
      winX -= extent, winY -= extent
      W := 2 * extent + 1, H := 2 * extent + 1
      ; Keep box on the window
      winX := Max(0, winX), winY := Max(0, winY)
      picHBitmap := BitMap.CropHBITMAP(hBitmap, winX, winY, W, H, 1)
      CC := BitMap.GetBackgroundColor(picHBitmap)
      GDI.DeleteObject(picHBitmap)
      ; GDIp.DisposeImage(picPBitmap)
      Return hex(CC) ; return in hex string like PixelGetColor
   }

   /**
    * Return Snip Info for the undo/redo handler
    * @returns {Object} 
    */
   SnipInfo() {
      this.GetPos(&X, &Y, &W, &H)
      ; The master picture and the zoom: restoring rebuilds the display from them
      Return { hBitmap: GDI.CopyImage(this._base), Zoom: this._zoom, Area: { X: X, Y: Y, W: W, H: H } }
   }
   /**
    * Zoom info for undo/redo of a zoom step (no picture copy)
    * @returns {Object}
    */
   ZoomInfo() {
      this.GetPos(&X, &Y, &W, &H)
      Return { Zoom: this._zoom, Area: { X: X, Y: Y, W: W, H: H } }
   }
   /**
    * Undo/redo of a picture change: restore a master picture (owned by the snip
    * from now on) and the zoom it was shown at
    */
   RestoreBase(hBase, zoom) {
      this._zoom := zoom
      this.SetBase(hBase)
   }
      /**
    * Position info for undo/redo
    * @returns {Object} 
    */
   MoveInfo() {
      this.GetPos(&X, &Y, &W, &H)
      Return { Area: { X: X, Y: Y, W: W, H: H } }
   }
   /**
    * Callback when the user drags the snip, move the button bar along with it
    * @returns 1
    */
   WM_SIZEEMOVE_GUI(snipObj, wParam, lParam, msg) {
      Switch msg {
         Case 0x231: ; start dragging Snip
            ; snipObj.PostAction(UnDo.MOVE_SNIP) ; may not be a good idea
         Case 0x216: ; dragging
            ; lParam is pointer to a rect structure of new position
            ; better than WinGetPos while dragging
            X := NumGet(lParam,0,"Int")
            Y := NumGet(lParam,4,"Int")
            ButtonBar.Show(snipObj.hWnd, , X, Y)
         Case 0x232: ; done dragging

         Default:

      }
      return 1
   }      
   /**
    * WM_ACTIVATE message handler — updates the snip border color and draw mode
    * when a snip window gains or loses focus, and shows or hides the button bar accordingly
    * @param {Integer} wParam - Activation code (0=deactivate, 1=activate, 2=click-activate)
    * @param {Integer} lParam - Handle of the other window involved in the activation change
    * @param {Integer} msg - Message identifier (0x006)
    * @param {Integer} hWnd - Handle of the window receiving the message
    */
   WM_ACTIVATE_GUI(SnipObj, wParam, lParam, msg) {
      ; lParam is other window
      focusBorder.HideFocus(true)
      hwnd := SnipObj.hwnd
      Switch (wParam &= 0xFF) {
         Case 0:  ; Deactivate
            If (Snips.SetDrawMode(0, hwnd)) {
               SnipObj.BackColor := RGBval("c0x6d7f7f") ; Not Active
               ; lParam is 0 if non AHK gui was activated
            }
            Sleep(50) ; let it Deactivate first so we know where it is
            If (lParam = 0 OR WinExist("A") = 0 OR NOT WinActive("ahk_class AutoHotkeyGUI"))
               ButtonBar.Hide()
         Case 1, 2:  ; Activate
            ; 2 = click, 1 = other reason
            ; Cursor Callback may have already set drawmode from button bar
            ; But this will make sure the border is correct
            ; If minimized from task bar activate gets fired again
            ButtonBar.SnipObj := SnipObj
            If (WinExist("A")) {
               Snips.SetDrawMode(Snips.GetGuiObj(hWnd).DrawMode, hWnd)
               If (wParam = 1)
                  Sleep(50) ; let it restore first so we know where it is
               ButtonBar.SyncPin(hWnd)
               ButtonBar.Show(hWnd)
            } Else {
               debug("Expected snip")
            }
         Default:
      }
   }
   ;============================================================================
   ;                S N I P   M A N I P U L A T I O N S
   ;============================================================================
   /**
    * Replace the background color of the snip with the color under the cursor where the menu was launched
    * @param {Integer} X, Y - Coordinates to look for a color to replace
    * @param {Integer} radius - Radius to search for color
    */
   ReplaceSnipBGColor(X, Y, how:="dialog", radius := 8) {
      hBitmap := GDI.CopyImage(this._base)
      ; We are launched from a menu, so the coordinates are where the menu was launched
      fromRGB := this.BackgroundPICColorFromXY(X, Y, radius)
      Switch how {
         Case "dialog" :
            colorArray := ColorPopDown.colorValArray.clone()
            colorArray.Length := Min(16, colorArray.Length)
            toRGB   := ColorSelectDialog(fromRGB, this.hWnd, colorArray, true)
         Case "picker" :
            toRGB := ColorPicker.Run()
         Default :
            Return
      }
      If (toRGB >= 0 AND fromRGB != toRGB) {
         this.PostAction(UnDo.CHANGE_SNIP)
         hits := BitMap.ReplaceBitmapColor(hBitmap, 0xFF000000 | fromRGB, toRGB, 0, 25)
         If (hits > 0) {
            ; Replace the picture
            this.SetBase(hBitmap) ; destroys the old master
            this.RefreshTextures()
            this.Dirty++
         } Else {
            GDI.DeleteObject(hBitmap)
            this.PopAction()
         }
      } Else {
         GDI.DeleteObject(hBitmap)
      }
   }
    /**
    * Transform the snip colors to make it easier in some cases.
    * Shapes are not impacted.
    * @param {Integer} [Angle=0] - Degress to rotate bitmap
    * @param {Integer} [FlipHow=0] - Flip type: 1=Top/Bottom, 2=left/right
    */
   RotateFlipSnip(Angle := 0, FlipHow := 0) {
      this.PostAction(UnDo.CHANGE_SNIP)
      pBitmap := GDIp.WrapARGBBitmapFromHBITMAP(this._base) ; WrapARGBBitmapFromHBITMAP
      ; Transform in place
      If (Angle)
         pBitmap := BitMap.Rotate(pBitmap, Angle)
      If (FlipHow)
         pBitmap := BitMap.Flip(pBitmap, FlipHow)
      ihBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
      ; Replace the picture
      this.SetBase(ihBitmap)
      ; Cleanup
      GDIp.DisposeImage(pBitmap) ;
      ; Recompute textures
      this.Dirty++
      this.RefreshTextures()
   }

   /**
    * Stretches the contrast of a snip.
    * Shapes are not impacted.
    */
   StretchSnip(*) {
      hBitmap := GDI.CopyImage(this._base)
      this.PostAction(UnDo.CHANGE_SNIP)
      If (BitMap.ContrastStretch(hBitmap)) {
         this.SetBase(hBitmap) ; destroys the old master
         ; Recompute textures
         this.RefreshTextures()
         this.Dirty++
      } Else {
         GDI.DeleteObject(hBitmap)   ; the unused copy
         this.PopAction()
         qTrayTip("Did not need to change any pixels")
      }
   }
   /**
    * Transform the snip colors to make it easier in some cases.
    * Shapes are not impacted.
    * @param {Integer} [numEffect=1] - Transform type: 1=Invert, 2=Grayscale, 3=B&W High Contrast
    */
   TransformSnip(numEffect := 1) {
      this.PostAction(UnDo.CHANGE_SNIP)
      pBitmap := GDIp.WrapARGBBitmapFromHBITMAP(this._base)
      ; Transform in place
      BitMap.TransformBitmap(pBitmap, numEffect)
      ihBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
      ; Replace the picture
      this.SetBase(ihBitmap) ; destroys the old master
      ; Cleanup
      GDIp.DisposeImage(pBitmap) ;
      ; Recompute textures
      this.RefreshTextures()
      this.Dirty++

   }
   /**
    * Create a scaled clone of an existing snip in a new snip window, optionally compositing shapes
    * @param {Float} [ScaleFactor=1.0] - Scale multiplier to apply to the bitmap; values >1 also apply sharpening
    * @param {Integer} [IncludeShapes=0] - If true, flatten visible shapes into the cloned bitmap
    */
   CloneAndScaleSnip(ScaleFactor := 1.0, IncludeShapes := 0) {
         ; Use the raw picture without any shapes
      srcSnip := this
      this.GetPos(&X, &Y)
      ; A plain duplicate copies the master picture and its zoom, so it can still
      ; zoom back to full quality
      useBase := (NOT IncludeShapes AND ScaleFactor = 1.0)
      If (useBase) {
         hBitmap := GDI.CopyImage(this._base)
         GDI.GetHBitmapDimensions(this.myHandle, &W, &H)
      } Else {
         if (IncludeShapes)
            pBitMap := BitMap.pBitmapCropFromHWND(this.hWnd, 1, Settings.BorderWidth)
         else
            pBitmap := gdip.WrapARGBBitmapFromHBITMAP(this.myHandle)
         ; Scale to a new bitmap
         if (ScaleFactor != 1.0)
            pBitmap := BitMap.BitmapScale(pBitMap, ScaleFactor)
         if (ScaleFactor > 1.0) ; ScaleFactor => radius
            pBitMap := BitMap.Sharpen(pBitMap, ScaleFactor, 80.0) ; NOTE - Amount is hard coded
         GDIp.GetImageDimensions(pBitmap, &W, &H)
         ; Need an hBitmap for the picture
         hBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
         GDIp.DisposeImage(pBitmap)
      }
      BW := Settings.BorderWidth
      ; Setup the new Snip information
      Area            := { X: X+50, Y: Y+50, W: W, H: H, X2: X + W, Y2: Y + H }
      SnipObj         := GuiSnip(Area)   ;-' FormatTime(,"HH:mm:ss"
      ; SnipObj.MarginX := BW, SnipObj.MarginY := BW
      SnipObj.AddSnipPic(hBitmap)
      If (useBase AND this._zoom != 1.0)
         SnipObj.SetZoom(this._zoom)
      ;-------------------------------------
      ; Recreate any shapes on the new Snip
      ;-------------------------------------
      tag := UnDo.NewTag("AddShapes")
      For ShapeObj in srcSnip.VisibleShapes {
         ; When repooling, clear out the old shape data and properties
         Info := ShapeObj.InstanceInfo()
         Switch Info.Source {
            Case "File", "Clip":
               CloneObj := Shapes.CreatePicFromSource(SnipObj, Info.FileName, Info.shapeCoord.X1, Info.shapeCoord.Y1)
            Case "BlurShape", "BodyShape", "LineShape", "FreeHand", "Text":
               CloneObj := SnipObj.AddNewShape(Info.Shape)
            Default:
               warning("Unknown Shape Source " Info.Source)
               Continue
         }
         If (IsSet(CloneObj) AND (CloneObj is commonShape)) {
            CloneObj.PostAction(UnDo.ADD_SHAPE, tag)
            ; Blend in saved properties
            If (Info.HasProp("drawFunction")) {
               ; Saved as text, get the pointer
               Info.DrawFunction := getFunctionObject(Info.DrawFunction)
            }
            For pr, v in Info.OwnProps() {
               If (Info.Source = "File" OR Info.Source = "Clip") AND (pr = "FileName" OR pr = "hBitmap")
                  Continue   ; InstanceInfo's bitmap copy, freed below
               Try CloneObj.%pr% := v
            }
            ; Bitmap shapes: InstanceInfo made a copy; the new shape made its own from it
            If (Info.Source = "File" OR Info.Source = "Clip")
               GDI.DeleteObject(Info.hBitmap)
            ; Now draw the shape on the canvas
            CloneObj.Refresh()
            ShapeOnTop(CloneObj)
            CloneObj.Gui.Dirty++
         } Else
            warning("Expected Object for " Info.Source " shape, Num=" Info.Shape)
      }
      ; Minimize existing snip
      if (ScaleFactor != 1.0)
         srcSnip.Minimize()
      ; Shift by margin so picture lays over the real image, specify h/w in case we need to be larger than the screen
      SnipObj.Show('x' Area.X - BW ' y' Area.Y - BW) ; NA -> want active
   }

   /**
    * Zoom the snip: the display picture is rebuilt from the master picture at the
    * new zoom (no quality loss over repeated zooms, and edits made at any zoom are
    * kept). Shapes are scaled with it. Undo records only the zoom (ZOOM_SNIP).
    * @param {Float} ScaleFactor , + for relative scale, - for absolute scale
    */
   ScaleSnip(ScaleFactor := 1.0) {
      if (ScaleFactor = 1.0)
         Return
      newZoom := (ScaleFactor > 0) ? ScaleFactor * this._zoom : -ScaleFactor
      newZoom := Round(newZoom, (newZoom < 0.4 ? 2 : 1))
      If (newZoom <= 0 OR newZoom = this._zoom)
         Return
      tag := UnDo.NewTag("ScaleSnip")
      this.PostAction(UnDo.ZOOM_SNIP, tag)
      this.GetPos(&X, &Y, &wW, &wH)
      GDI.GetHBitmapDimensions(this.myHandle, &oldW, &oldH)
      this._zoom := newZoom
      ; Most of the time is here
      hBitmap := this._ScaledBase()
      GetCursorPos(&mX, &mY)
      CoordMode("ToolTip", "Screen")
      ToolTip("     Zoom at " Round(newZoom * 100) "%", mX, mY)
      SetTimer(ToolTip, -2000)
      GDI.GetHBitmapDimensions(hBitmap, &W, &H)
      ; Recenter bitmap
      X := (X + wW / 2) - W / 2
      Y := (Y + wH / 2) - H / 2
      focusBorder.HideFocus()
      this.ReplaceSnip(hBitmap, X - Settings.BorderWidth, Y - Settings.BorderWidth)
      ; Relocate and scale all of the shapes on this snip
      relativeScaleFactor := W / oldW
      For objShape in this.VisibleShapes {
         objShape.PostAction(UnDo.MOVE_SHAPE, tag)
         objShape.Scale(relativeScaleFactor)
      }
      this.RefreshTextures()
      this.Dirty++
      ButtonBar.Show()
   }
   /**
    * Crop the image to one of the drawn shapes/pictures
    * @param CropObj Is the crop rectangle just drawn
    * @param Clipboard Also copy to clipboard
    * @returns Nothing 
    */
   Crop(CropObj, Clipboard := false) {
      If NOT (this.myHandle AND this._base)
         Return
      this.GetPos(&gX1, &gY1) ; window, includes the border
      C := CropObj.shapeCoord
      this.GetPicPos(&pX1, &pY1, &pW, &pH) ; picture, window coordinates
      ; Intersection to handle an off-picture crop tool
      iR := IntersectRect(C.X1, C.Y1, C.X2, C.Y2, pX1, pY1, pX1 + pW, pY1 + pH)
      If (NOT iR OR (iR.w < 25 AND iR.h < 25))
         Return
      ; Crop the master picture
      bR := this.RectToBase(iR.l, iR.t, iR.l + iR.w, iR.t + iR.h)
      If (bR.W < 1 OR bR.H < 1)
         Return
      tag := UnDo.NewTag("Crop")
      this.PostAction(UnDo.CHANGE_SNIP, tag)
      ; Where the new top-left is in the current display picture: the window moves
      ; there, and the shapes move back by the same amount so they stay put
      this._Ratios(&rX, &rY)
      dX := Round(bR.X * rX), dY := Round(bR.Y * rY)
      this.SetBase(BitMap.CropHBITMAP(this._base, bR.X, bR.Y, bR.W, bR.H, 1), gX1 + dX, gY1 + dY)
      For ShapeObj in this.VisibleShapes {
         ShapeObj.GetPos(&X, &Y)
         ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
         ShapeObj.Move(X - dX, Y - dY)
      }
      this.RefreshTextures()
      this.Dirty++
      ButtonBar.Show()
      if Clipboard {
         this.Snip2Clipboard(Snips.borderWithCopy)
      }
   }

   /**
    * Slice a section out of the bitmap
    * @param SliceObj Is the slice rectangle just drawn
    * @param Clipboard Also copy to clipboard
    * @returns Nothing 
    */
   Slice(SliceObj, Clipboard := false) {
      If NOT (this.myHandle AND this._base)
         Return
      BW  := Settings.BorderWidth
      C   := SliceObj.shapeCoord ; includes picture border offset, snip relative
      this.GetPos(&gX, &gY)     ; screen relative
      this.GetPicPos(&pX1, &pY1, &pW, &pH) ; Snip picture only, snip relative
      iR := IntersectRect(pX1, pY1, pX1 + pW, pY1 + pH, C.X1, C.Y1, C.X2, C.Y2)
      If NOT iR
         Return
      ; A band across the whole width removes rows, down the whole height removes columns
      vert := (iR.h = pH)
      bR := this.RectToBase(iR.l, iR.t, iR.l + iR.w, iR.t + iR.h)
      GDI.GetHBitmapDimensions(this._base, &baseW, &baseH)   ; not bW: that is BW
      If (vert)
         bR.Y := 0, bR.H := baseH
      Else
         bR.X := 0, bR.W := baseW
      If ((vert AND (bR.W < 1 OR bR.W >= baseW)) OR (NOT vert AND (bR.H < 1 OR bR.H >= baseH)))
         Return
      tag := UnDo.NewTag("Slice")
      this.PostAction(UnDo.CHANGE_SNIP, tag)
      ; Band start in the current display picture
      this._Ratios(&rX, &rY)
      bandX := BW + Round(bR.X * rX), bandY := BW + Round(bR.Y * rY)
      hBase := BitMap.SliceHBITMAP(this._base, bR.X, bR.Y, bR.W, bR.H, 1)
      hDisp := this._ScaledBase(hBase)
      GDI.GetHBitmapDimensions(hDisp, &W, &H)
      ; How much the display picture lost
      deltaW := pW - W, deltaH := pH - H
      ; If we cut off the left or top, move the window to keep the rest in place
      if (vert AND C.X1 < pX1)
         gX += deltaW
      else if (NOT vert AND C.Y1 < pY1)
         gY += deltaH
      this._SetPicture(hBase, hDisp, gX, gY)
      ; Shapes past the band move back by the band size so they stay on their pixels
      ; (the window moved instead when the band started at the left/top edge)
      edge := (vert AND C.X1 < pX1) OR (NOT vert AND C.Y1 < pY1)
      For ShapeObj in this.VisibleShapes {
         ShapeObj.GetPos(&X, &Y)
         ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
         If (edge)
            ShapeObj.Move(X - (vert ? deltaW : 0), Y - (vert ? 0 : deltaH))
         Else If (vert)
            ShapeObj.Move(X - (X > bandX ? deltaW : 0), Y)
         Else
            ShapeObj.Move(X, Y - (Y > bandY ? deltaH : 0))
      }
      this.RefreshTextures()
      this.Dirty++
      ButtonBar.Show()
      if Clipboard {
         this.Snip2Clipboard(Snips.borderWithCopy)
      }
   }

    /**
    * Extend or expand the image to one of the drawn shapes/pictures
    * @param ExtendObj Is the extend rectangle just drawn
    * @param Clipboard Also copy to clipboard
    * @returns Nothing 
    */
   Extend(ExtendObj, Clipboard := false) {
      If (this.myHandle AND this._base) {
         tag := UnDo.NewTag("Extend")
         this.PostAction(UnDo.CHANGE_SNIP, tag)
         ; NOTE - Rather then background of extend shape, get closer to start of drag
         ; bgColor := ExtendObj.ShapeBackgroundColor()
         SS := ExtendObj.shapeStart
         bgColor := this.BackgroundPICColorFromXY(SS.X, SS.Y, 10)

         sC :=ExtendObj.shapeCoord ; includes picture border offset
         this.GetPicPos(&pX1, &pY1, &pW, &pH) ; relative to frame, includes picture lef/top border offset
         sC.X2 := sc.X1 + sc.W, sc.Y2 := sc.Y1 + sc.H
         pX2 := pX1 + pW, pY2 := pY1 + pH
         l := r := t := b := 0
         eType := ""
         ; Find what was extended
         Switch {
            Case (pX1 > sC.X):
               ; left
               l := Abs(pX1 - sC.X1)
               eType := "Extend"
            Case (pY1 > sC.Y):
               ; top
               t := Abs(pY1 - sC.Y1)
               eType := "Extend"
            Case (pX2 < sC.X2):
               ; right
               r := Abs(pX2 - sC.X2)
               eType := "Extend"
            Case (pY2 < sC.Y2):
               ; bottom
               b := Abs(pY2 - sC.Y2)
               eType := "Extend"
            Case (sc.W = pW AND sc.H != pH):
               ; Horz
               t := SS.Y
               b := t + sC.H
               eType := "Expand"
            Case (sc.H = pH AND sc.W != pW):
               ; Vert
               l := SS.X
               r := l + sc.W
               eType := "Expand"
            Default:
               Warning("Internal Selection Only")
               Return 0
         }
         ; Work on the master picture: amounts/positions above are display pixels
         ; in window coordinates (the border included for Expand positions)
         BW := Settings.BorderWidth
         this._Ratios(&rX, &rY)
         this.GetPos(&gX1, &gY1) ; includes the Border
         Switch eType {
            Case "Extend": ; enlarge outside
               lb := Round(l / rX), tb := Round(t / rY), rb := Round(r / rX), bb := Round(b / rY)
               If (lb + tb + rb + bb = 0)
                  Return
               hBase := BitMap.ExtendBITMAP(this._base, bgColor, lb, tb, rb, bb, 1)
            Case "Expand": ; enlarge inside
               If (t = 0 AND b = 0) {   ; vertical strip
                  lb := Round((l - BW) / rX), wb := Round((r - l) / rX)
                  If (wb < 1)
                     Return
                  hBase := BitMap.ExpandBITMAP(this._base, bgColor, lb, 0, lb + wb, 0, 1)
               } Else {
                  tb := Round((t - BW) / rY), hb := Round((b - t) / rY)
                  If (hb < 1)
                     Return
                  hBase := BitMap.ExpandBITMAP(this._base, bgColor, 0, tb, 0, tb + hb, 1)
               }
            Default:
               Return
         }
         hDisp := this._ScaledBase(hBase)
         GDI.GetHBitmapDimensions(hDisp, &W, &H)
         ; Exact ratios of the new picture, for where the change landed on screen
         GDI.GetHBitmapDimensions(hBase, &nbW, &nbH)
         nrX := W / nbW, nrY := H / nbH
         Switch eType {
            Case "Expand": ; enlarge inside, don't move window
               this._SetPicture(hBase, hDisp)
               ; Shapes past the insert point move by the inserted amount
               If (t = 0 AND b = 0) {
                  at := BW + Round(lb * nrX), amt := W - pW
                  For ShapeObj in this.VisibleShapes {
                     ShapeObj.GetPos(&X, &Y)
                     If (X > at) {
                        ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
                        ShapeObj.Move(X + amt, Y)
                     }
                  }
               } Else {
                  at := BW + Round(tb * nrY), amt := H - pH
                  For ShapeObj in this.VisibleShapes {
                     ShapeObj.GetPos(&X, &Y)
                     If (Y > at) {
                        ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
                        ShapeObj.Move(X, Y + amt)
                     }
                  }
               }
            Case "Extend": ; enlarge outside
               ; Added left/top margin as shown at this zoom
               dl := Round(lb * nrX), dt := Round(tb * nrY)
               this._SetPicture(hBase, hDisp, gX1 - dl, gY1 - dt)
               ; Shift all of the controls so they stay in same place (has to be after the resize)
               If (dl > 0 OR dt > 0) {
                  For ShapeObj in this.VisibleShapes {
                     ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
                     ShapeObj.GetPos(&X, &Y)
                     ShapeObj.Move(X + dl, Y + dt)
                  }
               }
         }
         this.RefreshTextures()
         this.Dirty++
         ButtonBar.Show()
         if Clipboard {
            this.Snip2Clipboard(Snips.borderWithCopy)
         }
      }
   }
     /**
    * Minimize the specified snip window, hiding the button bar if no other snips are visible
    */
   Minimize() {
      WinMinimize(this.hwnd)
      If NOT Snips.ActivateFirst()
         ButtonBar.Hide()
   }
      /**
    * 
    * Briefly flash the snip border to a bright green to signal a completed action (e.g. clipboard copy)
    * @param {Integer} [flash=100] - Duration in milliseconds for each flash phase
    */
   flashBorder(flash := 100) {
      Try {
         ; GUI may close during the sleeps
         bc := this.BackColor
         Sleep(flash)
         this.BackColor := 0xFFFF ; Settings.ActiveSnipBorderColor
         Sleep(flash)
         this.BackColor := bc
      }
   }
   ;============================================================================
   ;                S N I P   E X P O R T S
   ;============================================================================
   /**
    * OCR the image to one of the drawn shapes/pictures
    * @param {commonShape} ShapeCropObj Is the crop rectangle just drawn
    * @returns Nothing 
    * OCR.FromRect(X, Y, W, H, lang?, scale:=1) will work on the snip itself
    */
   OCRShape(ShapeCropObj) {
      ; Need the screen coordinates of the shape and the GUI
      this.GetPos(&gX1, &gY1, &gW, &gH)
      sC := ShapeCropObj.shapeCoord
      If (sC.W < 25 OR sC.H < 25)
         Return
      ; Do the OCR from the window rectangle
      Result  := OCR.FromRect(gx1 + sC.X1, gy1 + sC.Y1, sC.W, sC.H)
      Cluster := OCR.Cluster(Result.Words)
      For rowWords in Cluster {
         LineText .= rowWords.Text . "`n"
      } Else
         LineText := ""
      try {
         A_Clipboard := LineText
         qTrayTip("Clipped " Cluster.Length " lines and " StrLen(A_Clipboard) " Characters", 4)
      } catch as e {
         qTrayTip("Error Clipping " Cluster.Length " lines and " StrLen(A_Clipboard) " Characters", 4)
      }
   }
   /**
    * Capture the active snip (or any window) as a bitmap and place it on the clipboard
    * @param {Integer} [Borders=false] - Include the snip border in the copied image
    */
   Snip2Clipboard(Borders := false) {
      ; Rounded corners cut when the snip was created are already transparent in its
      ; picture, and RenderBitmap keeps them (no RoundWindowCorners needed)
      hBitmap := this.RenderBitmap(Borders)
      this.Dirty := 0
      ; clipboard owns hBitmap now
      if ((res := Clipboard.SetHBitmapToClipboard(hBitmap)) < 0)
         MsgBox("Failed To Set Clipboard Data " res, "Clipboard", 0x30)
      Return
   }

   /**
    * Capture the active snip window as a bitmap and save it to a file
    * @param {String} SavePath - Directory path where the file should be saved
    * @param {Integer} [Borders=false] - Include the snip border in the saved image
    * @returns {String} Full path of the saved file, or empty string on failure
    */
   Snip2File(SavePath, Borders := false) {
      Try {
         If (SavePath AND !FileExist(SavePath))
            DirCreate(SavePath)
         ; TEST SWITCH: 1 = render the snip and its shapes (RenderBitmap), 0 = screen capture
         hBitmap := this.RenderBitmap(Borders)
         if (savePath)
            FileName := Snips.SaveHBitMapFile(hBitmap, SavePath, this)
         else
            FileName := Snips.ExportHBitMapFile(hBitmap)
         GDI.DeleteObject(hBitmap)
         this.Dirty := 0
         Return FileName
      } Catch as E {
         FileName := ""
         elog(E)
         MsgBox("Failed to Save Snip to file: " SavePath, "Save", 0x10)
      }
      ; Draw a black window under the snip in case it is partially transparent so we don't bleed thru
      Return FileName
   }


}
/*
 * Helper class to set owndialogs, when it goes out of scope the dialog is released
 */
Class PreDialog {
   __New(SnipObj) {
      this.SnipObj := SnipObj
      SnipObj.Opt("+OwnDialogs")
      ; debug("Grabbing Dialog")
   }
   __Delete() {
      ; Snip may be destroyed
      If this.SnipObj is GuiSnip {
         this.SnipObj.Opt("-OwnDialogs")
         ; debug("Releasing Dialog")
      }
   }
}