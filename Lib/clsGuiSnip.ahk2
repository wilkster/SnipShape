/************************************************************************
 * @description Class to create a screen clip
 * @file clsGuiSnip.ahk2
 * @author Tom Wilkason
 * @date 2026/07/18
 * @version 1.0.0
 ***********************************************************************/
#Requires AutoHotkey v2
#include Settings.ahk2
#include libMisc.ahk2
#include clsGuiSnip.ahk2
#include clsGDIp.ahk2
#include clsBitmap.ahk2 
#include clsShapes.ahk2
#include clsMenus.ahk2
#include ColorPopDown.ahk2
/**
 * Extended GUI class that stores snip-specific metadata, brush caches, and bitmap state
 */
Class GuiSnip extends Gui {
   /**
    * Create a new snip GUI window and register it in the global snip map
    * @param {Object} [objArea] - Area object with X, Y, W, H describing the captured region
    */
   __New(objArea := "") {
      ; +E0x80000 Layered WS_EX_LAYERED
      ; +0x1010000 WS_CLIPCHILDREN + WS_VISIBLE , 
      Static Opt := '+E0x80000 -0x1010000 -AlwaysOnTop -Caption -ToolWindow +OwnDialogs -DPIScale'
      super.__New(Opt, "", this)

      if Snips.topMost
         this.Opt("+AlwaysOnTop")
      this.Time                 := Snips.timeTag ; time at creation
      this._Area                := objArea
      this._DrawMode            := 0
      this.Counter              := 0
      this.Dirty                := 0
      this.Title                := "SnipShapeWindow - " this.Time . ' (' this._Area.W 'x' this._Area.H ')'
      this._FileName            := ""
      this.BrushMap             := Map()
      this.BrushCount           := Map()
      this.priorDrawMode        := 0
      this.myHandle             := 0
      this.BW                   := Settings.BorderWidth
      Snips.guiSnips[this.hWnd] := this
      this.UnDo                 := UnDo()
      this._OGHandle            := 0
      this._alpha                := 0xFF
      super.MarginX := super.MarginY := this.BW
      ; logGDI("+Create Snip:" this.Title)
      ; RMB menu is on the screenshot picture control
      super.OnEvent("Close", this.Destroy.Bind(this))
      super.OnEvent("Escape", Snips.Close.Bind(Snips, this))
      super.OnMessage(0x0216, this.WM_SIZEEMOVE_GUI.Bind(this))
      super.OnMessage(0x0231, this.WM_SIZEEMOVE_GUI.Bind(this))
      super.OnMessage(0x006, this.WM_ACTIVATE_GUI.Bind(this))
   }
   /**
    * Destructor — releases all cached GDI+ texture brushes when the GUI object is garbage-collected
    */
   __Delete(*) {
      For key, brush in this.BrushMap {
         GDIp.DeleteBrush(brush)
         debug("Deleted brush " key)
      }
      this.BrushMap := Map()
      this.BrushCount := Map()
   }
   /**
    * Post an undo action to the Snip UnDo/ReDo class
    * @param what Action
    */
   PostAction(what, tag:="") {
      this.UnDo.PostAction(this, what, tag)
   }
   /**
    * Undo the last undo action off the stack
    */
   PopAction() {
      this.UnDo.PopAction()
   }      
   /**
    * Initiate orderly destruction of the snip: clear shapes, release the save bitmap,
    * remove from the global snip map, and hide the button bar if no snips remain
    * Called by Snips.Close()
    */
   Destroy(*) {
      Try {
         ; title := this.Title
         this.ClearAllShapes(true)  ; in case we have built in GC
         hwnd := this.hWnd
         super.Destroy()
         GDI.DeleteObject(this.myHandle)
         if (this._OGHandle)
            GDI.DeleteObject(this._OGHandle)
            
         Snips.guiSnips.Delete(hwnd) ; remove from known snips
         ; logGDI("-Close  Snip:" Title ", " GetProcessMemoryInfo("K") ",")
      } Catch as E {
         elog(E,"During Object Destroy")
      } Finally {
         focusBorder.HideFocus()
         if (Snips.VisibleSnips() = 0)
            ButtonBar.Hide()
         ; Force windows to reclaim (used for checkking for memory leaks)
         if (Snips.guiSnips.Count == 0)
            DllCall("psapi\EmptyWorkingSet", "ptr", -1)
      }
      Return 1
   }
   /*
   * Return the current scale factor for this snip
   */
   ScaleFactor {
      get {
         If (this._OGHandle) {
            GDI.GetHBitmapDimensions(this._OGHandle, &ogW, &ogH)
            GDI.GetHBitmapDimensions(this.myHandle, &aW, &aH)
            ; Use a fresh OG handle incase something changed on the snip (color, trim...)
            ; Note, we modifed more than one dimension then don't save OGHandle again
            If (ogW == aW OR ogH == aH) {
               GDI.DeleteObject(this._OGHandle)
               this._OGHandle := GDI.CopyImage(this.myHandle)
            }
            Return aW / ogW
         } else
            return 1.0
      }
   }
   /**
    * Put a snip and border for the background of the GUI
    * @param hBitmap Handle to bitmap to use as the snip background
    * @param x/y Optional location to place the snip on the screen
    * @returns {Any} 
    */
   AddSnipPic(hBitmap, x?, y?) {
      this.OnEvent("ContextMenu", SnipMenus.Post.bind(SnipMenus))
      this._replaceSnip(hBitmap, x?, y?)
      this.MyHandle := hBitmap
      Return hBitmap
   }
   /**
    * Return the postion of the snip
    * @param x,y,w,h GUI Coordinates
    */
   getPicPos(&x?, &y?, &w?, &h?) {
      GDI.GetHBitmapDimensions(this.Handle, &hW, &hH)
      bw := Settings.BorderWidth
      x := bw
      y := bw
      w := hW
      h := hH
   }
   /**
    * Return the location of the snip picture on the screen
    * @param x,y,w,h screen Coordinates
    */
   getPicLocation(&x?, &y?, &w?, &h?) {
      bw := Settings.BorderWidth
      GDI.GetHBitmapDimensions(this.Handle, &hW, &hH)
      this.GetPos(&gx, &gy)
      x := gx + bw
      y := gy + bw
      w := hW
      h := hH
   }
   /**
    * Return the dimensions of the Snip bitmap.
    * @type {Object} W/H
    */
   Dimensions {
      get {
         GDI.GetHBitmapDimensions(this.Handle, &W, &H)
         return {W:W, H:H}
      }
   }

   /**
    * Replace the snip bitmap with a new modified version, 
    * also optionally place it on the screen
    * @param hBitmap Snip Bitmap to replace
    * @param x optional X screen position
    * @param y option Y screen position
    */
   ReplaceSnip(hBitmap, x?, y?) {
      If (hBitmap != this.MyHandle) {
         this._replaceSnip(hBitmap, x?, y?)
         GDI.DeleteObject(this.MyHandle)
         this.MyHandle := hBitmap
      }
   }
  /**
   * Update the border color of the snip to the back color of the GUI
   */
   BackColor {
      get => super.BackColor ;  STM_GETIMAGE, STM_SETIMAGE := 0x172 to set
      ; Resize control to actual bitmap size
      set {
         super.Backcolor := value
         if (this.myHandle)
            this._replaceSnip(this.myHandle)
      }
   }
   /**
    * Get or set the underlying HBITMAP handle for the GUI.
    * It will resize the window to match the new bitmap dimensions.
    * @type {Integer}
    */
   Handle {
      get => this.myHandle
      set {
         this._replaceSnip(value)
         oldhBitmap := this.myHandle
         this.myHandle := value
         GDI.DeleteObject(oldhBitmap)
      }
   }  
   Alpha {
      get => this._alpha
      set {
         ; Don't allow fully transparent otherwise it disappears
         newAlpha := Min(Max(Value, 0xF), 0xFF)
         If (newAlpha != this._alpha) {
            this._replaceSnip(this.myHandle)
            this._alpha := newAlpha
         }
      }
   }
   /**   
    * Return a list of visible (active) shapes on the snip
    */
   VisibleShapes {
      get {
         shapes := Array()
         For ShapeObj in this {
            If (ShapeObj.Visible) {
               shapes.Push(ShapeObj)
            }
         }
         Return shapes
      }
   }

   /**
    * Get or set the underlying HBITMAP handle for the GUI.
    * It will resize the window to match the new bitmap dimensions.
    * @type {Integer}
    */
   OGHandle {
      get {
         If (not this._OGHandle) {
            this._OGHandle := GDI.CopyImage(this.myHandle)
         }
         return this._OGHandle
      }
      set {
         this._replaceSnip(value)
         oldhBitmap := this.myHandle
         this.myHandle := value
         GDI.DeleteObject(oldhBitmap)
      }
   }  
   /**
    * Iterate all visible non-screen shapes and call their Refresh method
    * to redraw texture brushes after a bitmap change
    */
   RefreshTextures() {
      For ShapeObj in this.VisibleShapes {
         ShapeObj.Refresh()
      }
   }
   /**
    * Take a hBitmap and paint it into a layered window.
    * @param {Object} Bitmap Handle Object with X, Y, W, H properties defining the region
    * @param {Integer} X/Y, optional location to place the gui
    */
   _replaceSnip(hBitmap, x?, y?) {
      GDI.GetHBitmapDimensions(hBitmap, &W, &H)
      BW := Settings.BorderWidth
      newW := W + BW * 2
      newH := H + BW * 2
      ; keep this.hWnd's current top-left; only the size grows (per spec)
      this.GetPos(&winX, &winY)
      x ??= winX
      y ??= winY
      ; NOTE If we want to adjust transparency do it here so border is always correct

      hdcScreen := GDI.GetDC(0)
      hdcMem    := GDI.CreateCompatibleDC(hdcScreen)
      hDIB      := GDI.CreateDIBSection(newW, newH, hdcMem)
      obm       := GDI.SelectObject(hdcMem, hDIB)

      ; blit the caller's bitmap into the middle, inset by bw on each side
      hdcSrc := GDI.CreateCompatibleDC(hdcScreen)
      obmSrc := GDI.SelectObject(hdcSrc, hBitmap)
      GDI.BitBlt(hdcMem, BW, BW, W, H, hdcSrc, 0, 0)
      ; Premultiply if we have some transparency to show
      if (this._alpha < 0xFF)
         BitMap.PreMultiplyBitmap(hDIB,this._alpha)

      ; Paint the border fully opaque
      If (BW > 0) {
         iG := GDIp.GraphicsFromHDC(hdcMem)
         pen := GDIp.CreatePen(0xFF000000 | RGBval(this.BackColor), BW)
         GDIp.SetPenAlignment(pen, 1)
         GDIp.DrawRectangle(iG, pen, 0, 0, newW, newH)
         ; NOTE, to draw a dropoff shadow around border we need a bigger BW
         ; and a loop to draw progressively thinner rectangle lines with some alpha value (not overlay let them stack opacity)
         ; to simlate a shadow
      }
      ; Restore obm and delete DC we created
      GDI.SelectObject(hdcSrc, obmSrc)
      GDI.DeleteDC(hdcSrc)

      ; Update the GUI with the snip and border
      GDI.UpdateLayeredWindow(this.hWnd, hdcMem, x, y, newW, newH)

      ; clean up
      if (IsSet(pen))
         GDIp.DeletePen(pen)
      if (IsSet(iG))
         GDIp.DeleteGraphics(iG)
      GDI.SelectObject(hdcMem, obm)
      GDI.DeleteObject(hDIB)
      GDI.DeleteDC(hdcMem)
      GDI.ReleaseDC(hdcScreen)
      Return
   }

   /**
    * Adjust the reference count for a cached brush by a given amount
    * @param {Integer} brush - GDI+ brush handle
    * @param {Integer} [Amount=0] - Delta to apply to the reference count
    * @returns {Integer} The new reference count
    */
   _BrushRefCount(brush, Amount:=0) {
      if (this.BrushCount.Has(brush))
         this.BrushCount[brush] += Amount
      else
         this.BrushCount[brush] := Amount
      ; debug("Brush Reference Count Now =" this.BrushCount[brush] ", amount=" Amount)
      Return this.BrushCount[brush]
   }
   /**
    * Build the map key used to look up a cached texture brush
    * @param {String} shape - Shape type identifier
    * @param {String|Float} parameter - Shape-specific brush parameter
    * @returns {String} Composite cache key string
    */
   _BrushKey(shape, parameter) =>  "brush-" . shape . "-" . (IsFloat(parameter) ? round(parameter,3) : parameter)
   /**
    * Add a new texture brush to the cache; warns if a brush already exists for the key
    * @param {Integer} brush - GDI+ brush handle to cache
    * @param {String} shape - Shape type identifier
    * @param {String|Float} parameter - Shape-specific brush parameter used to build the cache key
    */
   AddBrush(brush, shape, parameter) {
      key := this._BrushKey(shape, parameter)
      if (this.BrushMap.Has(key))
         Warning("Did not expect to find an existing brush for " key)
      this.BrushMap[key] := brush
      this._BrushRefCount(brush, 1)
      ; debug("Adding new Brush:'" key "' " hex(brush))
   }
   /**
    * Retrieve a cached brush and increment its reference count
    * @param {String} shape - Shape type identifier
    * @param {String|Float} parameter - Shape-specific brush parameter
    * @returns {Integer} The cached GDI+ brush handle, or 0 if not found
    */
   GetBrush(shape, parameter) {
      key := this._BrushKey(shape, parameter)
      If (brush := this.BrushMap.Get(key, 0)) {
         this._BrushRefCount(brush, 1)
      }
      Return brush
   }
   /**
    * Decrement the reference count for a brush and delete it when the count reaches zero
    * @param {Integer} handle - GDI+ brush handle to release
    * @returns {Integer} Remaining reference count, or 0 if the brush was not found
    */
   ReleaseBrush(handle) {
      For key, brush in this.BrushMap {
         If (brush = handle) {
            ; If there remain no more references to the brush delete it
            if ((res := this._BrushRefCount(brush,-1)) = 0) {
               GDIp.DeleteBrush(brush)
               this.BrushMap.Delete(key)
               this.BrushCount.Delete(brush)
               ; debug("Deleted a brush " key " " hex(brush) ", " this.BrushMap.Count " remaining unique brushes")
            }
            Return res
         }
      }
      Return 0
   }
   /**
    * Get or set the area object describing the captured screen region
    * @type {Object}
    */
   Area {
      get => this._Area
      set => this._Area := Value
   }
   /**
    * Get or set the current draw mode for this snip
    * @type {Integer}
    */
   DrawMode {
      get => this._DrawMode
      set {
         this.priorDrawMode := this._DrawMode 
         this._DrawMode := Value
      }
   }
   /**
    * Get or set the file path associated with this snip.
    * Setting this property also updates the window title to the base filename.
    * @type {String}
    */
   FileName {
      set {
         SplitPath(value,,,,&baseName)
         this.Title := "SnipShapeWindow - " baseName
         this._FileName := value
      }
      get => this._FileName
   }
   /**
    * Get the display base name for the snip.
    * Returns the filename stem if a file is associated, otherwise a timestamp and dimensions string.
    * @type {String}
    */
   BaseName {
      get {
         if (this.FileName) {
            SplitPath(this._FileName,,,,&baseName)
            return basename
         } Else {
            return this.Time . ' (' this._Area.W 'x' this._Area.H ')'
         }
      }
   }
      /**
    * Posta a DELETE_SHAPE event if user is clearing all the shapes
    * Call separate due to posting vs not posting
    * @param {Integer} hWnd 
    */
   PostClearAllShapes() {
      tag := A_TickCount . "ClearAll"
      For ShapeObj in this.VisibleShapes {
         ShapeObj.PostAction(UnDo.DELETE_SHAPE, tag)
      }
   }
   /**
    * Clear all non-screen shapes from a snip and reset its dirty flag
    * @param {Integer} [hWnd=0] - Window handle of the target snip; defaults to the active window
    */
   ClearAllShapes(skipundo := false) {
      For ShapeObj in this.VisibleShapes {
         ShapeObj.Close(skipundo)
      }
      this.Dirty := 0
   }

   /**
    * Return the most common color at some pixel location.
    * Good for finding the true background color.
    * Handles GDI+ startup/shutdown here.
    * @param {Integer} winX - Window-relative X coordinate of the center point
    * @param {Integer} winY - Window-relative Y coordinate of the center point
    * @param {Integer} [extent=0] - Radius around the center point to extend the search matrix
    * @returns {String} Most common color in hex string format
    */
   BackgroundPICColorFromXY(winX, winY, extent := 10) {
      hBitmap := this.Handle
      ; Center of the region
      winX -= extent, winY -= extent
      W := 2 * extent + 1, H := 2 * extent + 1
      ; Keep box on the window
      winX := Max(0, winX), winY := Max(0, winY)
      picHBitmap := BitMap.CropHBITMAP(hBitmap, winX, winY, W, H, 1)
      CC := BitMap.GetBackgroundColor(picHBitmap)
      GDI.DeleteObject(picHBitmap)
      ; GDIp.DisposeImage(picPBitmap)
      Return hex(CC) ; return in hex string like PixelGetColor
   }

   /**
    * Return Snip Info for the undo/redo handler
    * @returns {Object} 
    */
   SnipInfo() {
      this.GetPos(&X, &Y, &W, &H)
      Return { hBitmap: GDI.CopyImage(this.Handle), Area: { X: X, Y: Y, W: W, H: H } }
   }
      /**
    * Position info for undo/redo
    * @returns {Object} 
    */
   MoveInfo() {
      this.GetPos(&X, &Y, &W, &H)
      Return { Area: { X: X, Y: Y, W: W, H: H } }
   }
   /**
    * Callback when the user drags the snip, move the button bar along with it
    * @returns 1
    */
   WM_SIZEEMOVE_GUI(snipObj, wParam, lParam, msg) {
      Switch msg {
         Case 0x231: ; start dragging Snip
            snipObj.PostAction(UnDo.MOVE_SNIP)
         Case 0x216: ; dragging
            ; lParam is pointer to a rect structure of new position
            ; better than WinGetPos while dragging
            X := NumGet(lParam,0,"Int")
            Y := NumGet(lParam,4,"Int")
            ButtonBar.Show(snipObj.hWnd, , X, Y)
         Case 0x232: ; done dragging

         Default:

      }
      return 1
   }      
   /**
    * WM_ACTIVATE message handler — updates the snip border color and draw mode
    * when a snip window gains or loses focus, and shows or hides the button bar accordingly
    * @param {Integer} wParam - Activation code (0=deactivate, 1=activate, 2=click-activate)
    * @param {Integer} lParam - Handle of the other window involved in the activation change
    * @param {Integer} msg - Message identifier (0x006)
    * @param {Integer} hWnd - Handle of the window receiving the message
    */
   WM_ACTIVATE_GUI(SnipObj, wParam, lParam, msg) {
      ; lParam is other window
      focusBorder.HideFocus(true)
      hwnd := SnipObj.hwnd
      Switch (wParam &= 0xFF) {
         Case 0:  ; Deactivate
            If (Snips.SetDrawMode(0, hwnd)) {
               SnipObj.BackColor := RGBval("c0x6d7f7f") ; Not Active
               ; lParam is 0 if non AHK gui was activated
            }
            Sleep(50) ; let it Deactivate first so we know where it is
            If (lParam = 0 OR WinExist("A") = 0 OR NOT WinActive("ahk_class AutoHotkeyGUI"))
               ButtonBar.Hide()
         Case 1, 2:  ; Activate
            ; 2 = click, 1 = other reason
            ; Cursor Callback may have already set drawmode from button bar
            ; But this will make sure the border is correct
            ; If minimized from task bar activate gets fired again
            ButtonBar.SnipObj := SnipObj
            If (WinExist("A")) {
               Snips.SetDrawMode(Snips.GetGuiObj(hWnd).DrawMode, hWnd)
               If (wParam = 1)
                  Sleep(50) ; let it restore first so we know where it is
               ButtonBar.Show(hWnd)
            } Else {
               debug("Expected snip")
            }
         Default:
      }
   }
   ;============================================================================
   ;                S N I P   M A N I P U L A T I O N S
   ;============================================================================
   /**
    * Replace the background color of the snip with the color under the cursor where the menu was launched
    * @param {Integer} X, Y - Coordinates to look for a color to replace
    * @param {Integer} radius - Radius to search for color
    */
   ReplaceSnipBGColor(X, Y, radius := 8) {
      this.PostAction(UnDo.CHANGE_SNIP)
      hBitmap := GDI.CopyImage(this.Handle)
      ; We are launched from a menu, so the coordinates are where the menu was launched
      fromRGB := this.BackgroundPICColorFromXY(X, Y, radius)
      colorArray := ColorPopDown.colorValArray.clone()
      colorArray.Length := Min(16, colorArray.Length)
      toRGB   := ColorSelectDialog(fromRGB, this.hWnd, colorArray, true)
      If (toRGB >= 0 AND fromRGB != toRGB) {
         hits := BitMap.ReplaceBitmapColor(hBitmap, 0xFF000000 | fromRGB, toRGB)
         If (hits > 0) {
            ; Replace the picture
            this.Handle := hBitmap ; destroys og hBitmap
            this.RefreshTextures()
            ; If (this.OGHandle) {
            ;    hits := BitMap.ReplaceBitmapColor(this.OGHandle, 0xFF000000 | fromRGB, toRGB)
            ; }
         } Else {
            GDI.DeleteObject(hBitmap)
         }
      } Else {
         GDI.DeleteObject(hBitmap)
      }
   }
    /**
    * Transform the snip colors to make it easier in some cases.
    * Shapes are not impacted.
    * @param {Integer} [Angle=0] - Degress to rotate bitmap
    * @param {Integer} [FlipHow=0] - Flip type: 1=Top/Bottom, 2=left/right
    */
   RotateFlipSnip(Angle := 0, FlipHow := 0) {
      this.PostAction(UnDo.CHANGE_SNIP)
      pBitmap := GDIp.WrapARGBBitmapFromHBITMAP(this.Handle) ; WrapARGBBitmapFromHBITMAP
      ; Transform in place
      If (Angle)
         pBitmap := BitMap.Rotate(pBitmap, Angle)
      If (FlipHow)
         pBitmap := BitMap.Flip(pBitmap, FlipHow)
      ihBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
      ; Replace the picture
      this.ReplaceSnip(ihBitmap)
      ; Cleanup
      GDIp.DisposeImage(pBitmap) ;
      ; Recompute textures
      this.RefreshTextures()
   }

   /**
    * Transform the snip colors to make it easier in some cases.
    * Shapes are not impacted.
    * @param {Integer} [numEffect=1] - Transform type: 1=Invert, 2=Grayscale, 3=B&W High Contrast
    */
   TransformSnip(numEffect := 1) {
      this.PostAction(UnDo.CHANGE_SNIP)
      pBitmap := GDIp.WrapARGBBitmapFromHBITMAP(this.Handle)
      ; Transform in place
      BitMap.TransformBitmap(pBitmap, numEffect)
      ihBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
      ; Replace the picture
      this.Handle := ihBitmap ; destroys og hBitmap
      ; Cleanup
      GDIp.DisposeImage(pBitmap) ;
      ; Recompute textures
      this.RefreshTextures()
   }
   /**
    * Create a scaled clone of an existing snip in a new snip window, optionally compositing shapes
    * @param {Float} [ScaleFactor=1.0] - Scale multiplier to apply to the bitmap; values >1 also apply sharpening
    * @param {Integer} [IncludeShapes=0] - If true, flatten visible shapes into the cloned bitmap
    */
   CloneAndScaleSnip(ScaleFactor := 1.0, IncludeShapes := 0) {
         ; Use the raw picture without any shapes
      srcSnip := this
      hBitmap := srcSnip.Handle
      if (IncludeShapes)
         pBitMap := BitMap.pBitmapCropFromHWND(this.hWnd, 1, Settings.BorderWidth)
      else
         pBitmap := gdip.WrapARGBBitmapFromHBITMAP(hBitmap)
      this.GetPos(&X, &Y)
      ; Scale to a new bitmap
      if (ScaleFactor != 1.0)
         pBitmap := BitMap.BitmapScale(pBitMap, ScaleFactor)
      if (ScaleFactor > 1.0) ; ScaleFactor => radius
         pBitMap := BitMap.Sharpen(pBitMap, ScaleFactor, 80.0) ; NOTE - Amount is hard coded
      GDIp.GetImageDimensions(pBitmap, &W, &H)
      ; Need an hBitmap for the picture
      hBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
      GDIp.DisposeImage(pBitmap)
      BW := Settings.BorderWidth
      ; Setup the new Snip information
      Area            := { X: X+50, Y: Y+50, W: W, H: H, X2: X + W, Y2: Y + H }
      SnipObj         := GuiSnip(Area)   ;-' FormatTime(,"HH:mm:ss"
      ; SnipObj.MarginX := BW, SnipObj.MarginY := BW
      SnipObj.AddSnipPic(hBitmap)
      ;-------------------------------------
      ; Recreate any shapes on the new Snip
      ;-------------------------------------
      tag := A_TickCount . "AddShapes"
      For ShapeObj in srcSnip.VisibleShapes {
         ; When repooling, clear out the old shape data and properties
         Info := ShapeObj.InstanceInfo()
         Switch Info.Source {
            Case "File", "Clip":
               CloneObj := Shapes.CreatePicFromSource(SnipObj, Info.FileName, Info.shapeCoord.X1, Info.shapeCoord.Y1)
            Case "BlurShape", "BodyShape", "LineShape", "FreeHand", "Text":
               CloneObj := SnipObj.AddNewShape(Info.Shape)
            Default:
         }
         If (IsSet(CloneObj)) {
            CloneObj.PostAction(UnDo.ADD_SHAPE, tag)
            ; Blend in saved properties
            For pr, v in Info.OwnProps()
               Try CloneObj.%pr% := v
            ; Now draw the shape on the canvas
            CloneObj.Refresh()
            ShapeOnTop(CloneObj)
            CloneObj.Gui.Dirty++
         }               
      }
      ; Minimize existing snip
      if (ScaleFactor != 1.0)
         srcSnip.Minimize()
      ; Shift by margin so picture lays over the real image, specify h/w in case we need to be larger than the screen
      SnipObj.Show('x' Area.X - BW ' y' Area.Y - BW) ; NA -> want active
   }

   /**
    * Scale the picture in the snip (vs just resizing it)
    * NOTE - OGHandle is saved the first scalefactor so any subsequent snip changes may be replaced if you scale again.
    * @param {Float} ScaleFactor , + for relative scale, - for aboslute scape
    */
   ScaleSnip(ScaleFactor := 1.0) {
      if (ScaleFactor != 1.0) {
         ; Use the raw picture without any shapes
         if (ScaleFactor > 0)
            ScaleFactor *= this.ScaleFactor
         else
            ScaleFactor *= -1
         ScaleFactor := Round(ScaleFactor, (ScaleFactor < 0.4 ? 2 : 1))
         this.PostAction(UnDo.CHANGE_SNIP)
         ; Always scale the base image so we don't lose quality after multiple passes
         hBitmap := this.OGHandle
         ; Scale factor is applies against current scale
         pBitmap := GDIp.WrapARGBBitmapFromHBITMAP(hBitmap)
         this.GetPos(&X, &Y, &wW, &wH)
         ; Scale to a new bitmap, most of the time is here
         pBitmap := BitMap.BitmapScale(pBitmap, ScaleFactor)
         GetCursorPos(&mX, &mY)
         CoordMode("ToolTip", "Screen")
         ToolTip("     Zoom at " Round(ScaleFactor * 100) "%", mX, mY)
         SetTimer(ToolTip, -2000)
         GDIp.GetImageDimensions(pBitmap, &W, &H)
         ; Need an hBitmap for the picture
         hBitmap := GDIp.CreateARGBHBITMAPFromBitmap(pBitmap)
         GDIp.DisposeImage(pBitmap)
         ; Recenter bitmap
         X := (X + wW / 2) - W / 2
         Y := (Y + wH / 2) - H / 2
         this.ReplaceSnip(hBitmap, X - Settings.BorderWidth, Y - Settings.BorderWidth)
         this.RefreshTextures()
         ButtonBar.Show()
      }
   }   
   /**
    * Crop the image to one of the drawn shapes/pictures
    * @param CropObj Is the crop rectangle just drawn
    * @param Clipboard Also copy to clipboard
    * @returns Nothing 
    */
   Crop(CropObj, Clipboard := false) {
      If (hBitmap := this.handle) {
         tag := A_TickCount . "Crop"
         this.PostAction(UnDo.CHANGE_SNIP, tag)
         BW := Settings.BorderWidth
         ; Get various dimensions
         this.GetPos(&gX1, &gY1) ; includes the Border 
         ; Crop tool
         C := CropObj.shapeCoord
         ; Get the raw picture dimensions
         this.GetPicPos(&pX1, &pY1, &pW, &pH) ; includes left/top border
         ; Intersection to handle off picture crop tool
         iR := IntersectRect(
            C.X1, C.Y1, C.X2, C.Y2, 
            pX1, pY1, pX1 + pW, pY1 + pH
         )

         If (IR AND iR.w < 25 AND iR.h < 25)
            Return
         ; This destroys the existing snip bitmap and creates a new one
         hBitmap := BitMap.CropHBITMAP(hBitmap, iR.l - BW, iR.t - BW, iR.w, iR.h, 1)
         ; Replace bitmap shoving it into the upper left of the gui with empty space right/belw
         this.ReplaceSnip(hBitmap, gX1 + iR.l - BW, gY1 + iR.t - BW)

         ; Shift all of the controls so they stay in same place
         For ShapeObj in this.VisibleShapes {
            ShapeObj.GetPos(&X, &Y, &W, &H)
            ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
            ShapeObj.Move(X - C.X1, Y - C.Y1)
            ShapeObj.Refresh()
         }
         this.RefreshTextures()
         ButtonBar.Show()
         if Clipboard {
            this.Snip2Clipboard(Snips.borderWithCopy)
         }
      }
   }

   /**
    * Slice a section out of the bitmap
    * @param SliceObj Is the slice rectangle just drawn
    * @param Clipboard Also copy to clipboard
    * @returns Nothing 
    */
   Slice(SliceObj, Clipboard := false) {
      If (hBitmap := this.handle) {
         tag := A_TickCount . "Slice"
         this.PostAction(UnDo.CHANGE_SNIP, tag)
         BW  := Settings.BorderWidth
         C   := SliceObj.shapeCoord ; includes picture border offset, snip relative
         this.GetPos(&gX, &gY)     ; screen relative
         this.GetPicPos(&pX1, &pY1, &pW, &pH) ; Snip picture only, snip relative
         iR := IntersectRect(pX1, pY1, pX1 + pW, pY1 + pH, C.X1, C.Y1, C.X2, C.Y2)
         ; Offset by borderwidth (0 based)
         hBitmap := BitMap.SliceHBITMAP(hBitmap, iR.l - BW, iR.t - BW, iR.w, iR.h,1)
         GDI.GetHBitmapDimensions(hBitmap, &W, &H)
         deltaW := pW - W, deltaH := pH - H
         ; If we cut off the left or top, recenter to keep rest in same place
         if (c.x1 < pX1)
            gX += deltaW
         else if (c.y1 < pY1)
            gY += deltaH

         this.ReplaceSnip(hBitmap, gX, gY)
         ; Shift all of the controls so they stay in same place
         For ShapeObj in this.VisibleShapes {
            ShapeObj.GetPos(&X, &Y, &W, &H)
            ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
            If (pW = iR.W) ; Horz section
               ShapeObj.Move(X, Y - (Y > iR.t ? iR.h : 0)) ; if top of shape below top of selection, then move it up by selection height
            Else if (pH = iR.H) ; Vert section
               ShapeObj.Move(X - (X > iR.L ? iR.w :0) , Y)
         }
         this.RefreshTextures()
         ButtonBar.Show()
         if Clipboard {
            this.Snip2Clipboard(Snips.borderWithCopy)
         }
      }
   }

    /**
    * Extend or expand the image to one of the drawn shapes/pictures
    * @param ExtendObj Is the extend rectangle just drawn
    * @param Clipboard Also copy to clipboard
    * @returns Nothing 
    */
   Extend(ExtendObj, Clipboard := false) {
      If (hBitmap := this.handle) {
         tag := A_TickCount . "Extend"
         this.PostAction(UnDo.CHANGE_SNIP, tag)
         ; NOTE - Rather then background of extend shape, get closer to start of drag
         ; bgColor := ExtendObj.ShapeBackgroundColor()
         SS := ExtendObj.shapeStart
         bgColor := this.BackgroundPICColorFromXY(SS.X, SS.Y, 10)

         sC :=ExtendObj.shapeCoord ; includes picture border offset
         this.GetPicPos(&pX1, &pY1, &pW, &pH) ; relative to frame, includes picture lef/top border offset
         sC.X2 := sc.X1 + sc.W, sc.Y2 := sc.Y1 + sc.H
         pX2 := pX1 + pW, pY2 := pY1 + pH
         l := r := t := b := 0
         eType := ""
         ; Find what was extended
         Switch {
            Case (pX1 > sC.X):
               ; left
               l := Abs(pX1 - sC.X1)
               eType := "Extend"
            Case (pY1 > sC.Y):
               ; top
               t := Abs(pY1 - sC.Y1)
               eType := "Extend"
            Case (pX2 < sC.X2):
               ; right
               r := Abs(pX2 - sC.X2)
               eType := "Extend"
            Case (pY2 < sC.Y2):
               ; bottom
               b := Abs(pY2 - sC.Y2)
               eType := "Extend"
            Case (sc.W = pW AND sc.H != pH):
               ; Horz
               t := SS.Y
               b := t + sC.H
               eType := "Expand"
            Case (sc.H = pH AND sc.W != pW):
               ; Vert
               l := SS.X
               r := l + sc.W
               eType := "Expand"
            Default:
               Warning("Internal Selection Only")
               Return 0
         }
         ; Extend in the appropriate direction
         Switch eType {
            Case "Extend": ; enlarge outside
               hBitmap := BitMap.ExtendBITMAP(hBitmap, bgColor, l, t, r, b, 1)
            Case "Expand": ; enlarge inside
               hBitmap := BitMap.ExpandBITMAP(hBitmap, bgColor, l, t, r, b, 1)
            Default:
               Return
         }
         ; Get new dimensions
         GDI.GetHBitmapDimensions(hBitmap, &W, &H)
         this.GetPos(&gX1, &gY1) ; includes the Border 
         ; Resize GUI to contain the new crop coordinates
         Switch eType {
            Case "Expand": ; enlarge inside, don't move window
               this.ReplaceSnip(hBitmap)
               ; Shift all of the controls so they stay in same place (has to be after the resize)
                  For ShapeObj in this.VisibleShapes {
                     ShapeObj.GetPos(&X, &Y, &W, &H)
                     If (l > 0 AND X > l OR (t > 0 and Y > t)) {
                        ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
                        ShapeObj.Move(X + (r - l), Y + (b - t))
                     }
                  }
            Case "Extend": ; enlarge outside
               this.ReplaceSnip(hBitmap, gX1 - l, gY1 - t)
               ; Shift all of the controls so they stay in same place (has to be after the resize)
               If (l > 0 OR t > 0) {
                  For ShapeObj in this.VisibleShapes {
                     ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
                     ShapeObj.GetPos(&X, &Y, &W, &H)
                     ShapeObj.Move(X + l, Y + t)
                  }
               }
         }
         this.RefreshTextures()
         ButtonBar.Show()
         if Clipboard {
            this.Snip2Clipboard(Snips.borderWithCopy)
         }
      }
   }
     /**
    * Minimize the specified snip window, hiding the button bar if no other snips are visible
    */
   Minimize() {
      WinMinimize(this.hwnd)
      If NOT Snips.ActivateFirst()
         ButtonBar.Hide()
   }
      /**
    * 
    * Briefly flash the snip border to a bright green to signal a completed action (e.g. clipboard copy)
    * @param {Integer} [flash=100] - Duration in milliseconds for each flash phase
    */
   flashBorder(flash := 100) {
      Try {
         ; GUI may close during the sleeps
         bc := this.BackColor
         Sleep(flash)
         this.BackColor := "c05ff00"
         Sleep(flash)
         this.BackColor := bc
      }
   }
   ;============================================================================
   ;                S N I P   E X P O R T S
   ;============================================================================
   /**
    * OCR the image to one of the drawn shapes/pictures
    * @param {commonShape} ShapeCropObj Is the crop rectangle just drawn
    * @returns Nothing 
    * OCR.FromRect(X, Y, W, H, lang?, scale:=1) will work on the snip itself
    */
   OCRShape(ShapeCropObj) {
      ; Need the screen coordinates of the shape and the GUI
      this.GetPos(&gX1, &gY1, &gW, &gH)
      sC := ShapeCropObj.shapeCoord
      If (sC.W < 25 OR sC.H < 25)
         Return
      ; Do the OCR from the window rectangle
      Result  := OCR.FromRect(gx1 + sC.X1, gy1 + sC.Y1, sC.W, sC.H)
      Cluster := OCR.Cluster(Result.Words)
      For rowWords in Cluster {
         LineText .= rowWords.Text . "`n"
      } Else
         LineText := ""
      try {
         A_Clipboard := LineText
         qTrayTip("Clipped " Cluster.Length " lines and " StrLen(A_Clipboard) " Characters", 4)
      } catch as e {
         qTrayTip("Error Clipping " Cluster.Length " lines and " StrLen(A_Clipboard) " Characters", 4)
      }
   }
   /**
    * Capture the active snip (or any window) as a bitmap and place it on the clipboard
    * @param {Integer} [Borders=false] - Include the snip border in the copied image
    */
   Snip2Clipboard(Borders := false) {
      this.GetPos(&X, &Y, &W, &H)
      ; If there is some transparency, put a black background behind it
      (g := Gui("-Caption -DPIScale")).BackColor := "000000", g.Show("X" X "Y" Y "W" W "H" H)
      hBitMap := BitMap.HBitmapFromHWND(this.hWnd, 1, Borders ? 0 : Settings.BorderWidth)
      g.Destroy()
      this.Dirty := 0
      if ((res := Clipboard.SetHBitmapToClipboard(hBitMap)) < 0)
         MsgBox("Failed To Set Clipboard Data " res, "Clipboard", 0x30)
   }

   /**
    * Capture the active snip window as a bitmap and save it to a file
    * @param {String} SavePath - Directory path where the file should be saved
    * @param {Integer} [Borders=false] - Include the snip border in the saved image
    * @returns {String} Full path of the saved file, or empty string on failure
    */
   Snip2File(SavePath, Borders := false) {
      Try {
         If !FileExist(SavePath)
            DirCreate(SavePath)
         this.GetPos(&X, &Y, &W, &H)
         (g := Gui("-Caption -DPIScale")).BackColor := "000000", g.Show("X" X "Y" Y "W" W "H" H)
         hBitmap := BitMap.HBitmapFromHWND(this.hWnd, 1, Borders ? 0 : Settings.BorderWidth)
         g.Destroy()
         FileName := Snips.SaveHBitMapFile(hBitmap, SavePath, this)
         GDI.DeleteObject(hBitmap)
      } Catch as E {
         FileName := ""
         elog(E)
         MsgBox("Failed to Save Snip to file: " SavePath, "Save", 0x10)
      }
      ; Draw a black window under the snip in case it is partially transparent so we don't bleed thru
      Return FileName
   }


}