/************************************************************************
 * @description Class to draw shapes on a snip
 * @file clsShapes.ahk2
 * @author Tom Wilkason
 * @date 2024/04/19
 * @version 1.0.0
 ***********************************************************************/
#Requires AutoHotkey v2
#include Settings.ahk2
#include clsGDIp.ahk2
; #include clsText.ahk2
#include clsBitmap.ahk2
#include clsClipboard.ahk2
#include LibMisc.ahk2
#include StopWatch.ahk2
#include OCR.ahk2
#include clsButtonBar.ahk2
#include clsCursor.ahk2
#include clsSnips.ahk2
#include undo.ahk2
#include clsSnipDrag.ahk2
#include clsShapeStyles.ahk2
#include clsShapeSelect.ahk2
#include ColorPopDown.ahk2
#include Shapes\clsCommonShape.ahk2
#include Shapes\clsTextShape.ahk2

/**
 * Shape class to draw various shapes, load pictures and show text
 */
Class Shapes {
   i := 0
   ; Enum of the shapes
   Static SHAPE_PICTURE := 0 ; Imported picture
   Static DrawActive := false
   Static ColorQueue := Array()

   Static DefaultColorNames := [
      "Red", "Blue","Yellow", "Lime", "Aqua","Fuchsia", "Orange", "Black", "White"
   ]

   ; List of all installed fonts
   Static FontNames := Array()
   Static InstalledFonts := GetInstalledFontNames()
   Static FontStyles := ["Normal", "Bold", "Italic", "BoldItalic", "Underline", "Strikeout"]
   Static Alignments := ["Left","Center","Right"]

   /**
    * @description Initializes the Shapes class. Reads all INI settings for shape properties
    *   (opacity, thickness, smoothing, etc.), builds the shape database (ID constants,
    *   ShapeName array, ShapeCat map), validates and loads available system fonts, and
    *   constructs all sub-menus used by the button bar right-click handler.
    */
   Static __New() {
      this.ShapeName := Array()
      this.ShapeCat  := Map()
      this.ColorCat  := Map()   ; shape number -> default color category (see DefaultColor)
      this.CatColors := Map()   ; category -> RGB
      ; Shape Databased ObjectVal, Name - hotkey, menu category
      /*
         1. Insert row below to hold the shape ID, menu entry (icon name & shortcut key), and category for button bar
            The order shown will be the order in the buttonbar menu (for each category)
         2. Make sure a cursor file exists in the cursors subfolder matching the name part below
         3. Ensure the shape is covered by one of the nested shape classes starting with clsCommonShape.
         4. Look for instances of the other IDs in the code below and handle them as needed
            Generally if they fall into a certain category then they would be handled there.
      */
     ;     Convert into number   Name of Icon file - hotkey    Buttonbar icon
      shapeDb := [
         ; Retired (2026-11-26): the plain arrow. Kept only so saved snips that have one still
         ; open and draw (shape numbers are row positions here and are saved in snip files).
         ; No hotkey and no category: not offered for new shapes. The outlined arrow is "Arrow".
         ["SHAPE_ARROW"        , "Plain Arrow - "            , ""],
         ["SHAPE_OARROW"       , "Arrow - A"                 , "Arrows"],
         ["SHAPE_TAPARROW"     , "Tapered Arrow - \"         , "Arrows"],
         ["SHAPE_ARCARROW"     , "Arc Arrow - J"             , "Arrows"],
         ; Retired (2026-11-27): the double arrow, now Arrow with ArrowStart "Arrow". Kept,
         ; hidden, for the shape numbers; saved ones are converted on open (FileObject).
         ["SHAPE_ODARROW"      , "Double Arrow - "           , ""],
         ["SHAPE_LINE"         , "Line - L"                  , "Shapes"],
         ; Retired (2026-11-27): the square rectangle, now the rectangle with Roundness 0. Kept,
         ; hidden, for the shape numbers; saved ones are converted on open (FileObject).
         ["SHAPE_RECT"         , "Square Rectangle - "       , ""],
         ["SHAPE_RORECT"       , "Rectangle - R"             , "Shapes"],
         ["SHAPE_ELLIPSE"      , "Ellipse - E"               , "Shapes"],
         ["SHAPE_CONNECT"      , "Connector - ["             , "Shapes"],
         ["SHAPE_BRACKET"      , "Bracket - ]"               , "Shapes"],
         ["SHAPE_PEN"          , "Pen - P"                   , "Free Hand"],
         ["SHAPE_WIDEPEN"      , "Wide Pen - M"              , "Free Hand"],
         ["SHAPE_HILITER"      , "Highlighter Pen - H"       , "Highlighters"],
         ["SHAPE_HILITE"       , "Block Highlight - Y"       , "Highlighters"],
         ["SHAPE_WHITEOUT"     , "Whiteout Pen - W"          , "Redact"],
         ["SHAPE_SMUDGE"       , "Smudge Pen - S"            , "Redact"],
         ["SHAPE_REDAC"        , "Redact - X"                , "Redact"],
         ["SHAPE_PIXELATE"     , "Pixelate - I"              , "Redact"],
         ["SHAPE_BLUR"         , "Blur - B"                  , "Redact"],
         ["SHAPE_GAUS_BLUR"    , "Gaussian Blur - G"         , "Redact"],
         ["SHAPE_CROP"         , "Crop - C"                  , "Tool"],
         ["SHAPE_SLICE"        , "Slice - K"                 , "Tool"],
         ["SHAPE_EXTEND"       , "Extend - Q"                , "Tool"],
         ["SHAPE_OCR"          , "OCR - O"                   , "Tool"],
         ["SHAPE_TEXT"         , "Text - T"                  , "Text"],
         ["SHAPE_FILLTEXT"     , "Fill Text - F"             , "Text"],
         ["SHAPE_OLTEXT"       , "Outline Text - U"          , "Text"],
         ["SHAPE_TAG"          , "Tag - N"                   , "Text"],
         ["SHAPE_LEFTARROWTEXT", "Left Arrow Text - <"       , "Text"],
         ["SHAPE_RIGHTARROWTEXT", "Right Arrow Text - >"     , "Text"]
      ]
      ;----------------------------------------------------------------------
      ; Build the required data for drawing/menus/buttonbar
      ;----------------------------------------------------------------------
      for I, V in shapeDb {
         ; Shape type Property to check while drawing, has unique value for switch statements
         this.%v[1]% := I
         ; Hotkeys & Menus
         this.ShapeName.Push(V[2])
         ; Buttonbar Categories (none: a retired shape, not in the menus)
         cat := V[3]
         If (cat != "") {
            if NOT this.ShapeCat.Has(cat)
               this.ShapeCat[cat] := Array()
            this.ShapeCat[cat].Push(V[2])
         }
         ; Default color category: the menu category, tags on their own. Redact shapes
         ; sample their color and tools have none.
         If (V[1] = "SHAPE_TAG")
            this.ColorCat[I] := "Tags"
         Else If (V[1] = "SHAPE_ARROW" OR V[1] = "SHAPE_ODARROW")
            this.ColorCat[I] := "Arrows"   ; retired plain and double arrows
         Else If (V[1] = "SHAPE_RECT")
            this.ColorCat[I] := "Shapes"   ; retired square rectangle
         Else If (cat != "Redact" AND cat != "Tool")
            this.ColorCat[I] := cat
      }
      ; Non-drawn shapes
      this.SHAPE_FILE := -1
      this.SHAPE_BITMAP := -2
      ;----------------------------------------------------------------------
      ; Read Ini settings
      ;----------------------------------------------------------------------
      ;Common Shapes
      this.outlineColor          := RGBval(IniReadValue("User Shape Color", "Outline Color", "Silver")) ; Not currently set by menu
      this.outlineOpacity        := IniReadValue("Common Shape", "Outline Opacity", 160)
      this.rawLineThickness      := IniReadValue("Common Shape", "Line Thickness", 3)
      this.outlineThickFactor    := IniReadValue("Common Shape", "Outline Thickness Factor", 3)
      this.globalShapeColor      := RGBval(IniReadValue("Common Shape", "Default Shape Color", 0xFF0000))
      ; Default color per category (Highlighters use highlightColor below)
      For cat in ["Arrows", "Shapes", "Free Hand", "Text", "Tags"]
         this.CatColors[cat] := RGBval(IniReadValue("Default Color", cat, hex(this.globalShapeColor)))
      this.shapeOpacity          := IniReadValue("Common Shape", "Shape Opacity", 0xFF)
      ; Arrows   
      this.arrowLineThickness    := IniReadValue("Arrow Shape", "Arrow Thickness", 5)
      this.ArrowSmoothFactor     := IniReadValue("Arrow Shape", "Arrow Smoothing Factor", "High")
      this.arrowOpacity          := IniReadValue("Arrow Shape", "Arrow Opacity", 0xFF)
      ; Start end of the arrow: "Arrow" (a second head), "Square" (flat) or "Round"
      this.ArrowStart            := IniReadValue("Arrow Shape", "Arrow Start", "Square")
      ; Body   
      this.fillOpacity           := IniReadValue("Body Shape", "Shape Fill Opacity", 0)
      ; Rectangle corners: 0 square .. 10 fully round ends (2 = the old rounded rectangle)
      this.Roundness             := IniReadValue("Body Shape", "Rectangle Roundness", 2)
      ; Freehand   
      this.penLineThickness      := IniReadValue("Freehand Shape", "Pen Thickness", 3)
      this.widePenThickness      := IniReadValue("Freehand Shape", "Wide Pen Thickness", 14)
      this.penOpacity            := IniReadValue("Freehand Shape", "Pen Opacity", 0xFF)
      this.PenSmoothFactor       := IniReadValue("Freehand Shape", "Pen Smoothing Factor", "Low")
      ; Highlighters / Redact
      this.highLightThickness    := IniReadValue("Highlight Shape", "Highlight/Whiteout Factor", 18)
      this.HighlightSmoothFactor := IniReadValue("Highlight Shape", "Highlight/Whiteout Smoothing Factor", "High")
      this.highlightOpacity      := IniReadValue("Highlight Shape", "Highlighter Opacity", 160)
      this.highlightColor        := IniReadValue("Highlight Shape", "Highlighter Color", 0xFFFF00)
      ; Obscuring
      this.PixelateBlockSize     := IniReadValue("Obscure Shape", "Pixelate Block Size", 4)
      this.BlurDivisor           := IniReadValue("Obscure Shape", "Blur Factor", 10)

      ; Text
      this.TagReset               := 1

      ; Padding around snip when drawing shapes
      this.DIBPad                := SETTINGS.DIBPad 
      this.shapePad              := 25
      ; Line
      ; Blur / Redact / Highlight
      ;----------------------------------------------------------------------
      ; Make sure the standard fonts below really exist, and discard if not
      ;----------------------------------------------------------------------
      _FontNames := [
      "Arial", "Arial Black", "Calibri", "Cambria", "Candara", "Century",  
      "Century Gothic", "Comic Sans MS", "Consolas", "Franklin Gothic Medium", "Impact", "Segoe UI", "Segoe UI Emoji", 
      "Segoe UI Symbol", "Segoe Print", "Tahoma", "Times New Roman", "Trebuchet MS", "Verdana"
      ]
      dlog("Reading System Fonts")
      tHash := Map()
      for fnt in this.InstalledFonts
         tHash[fnt] := 1

      for fnt in _fontNames {
         if tHash.has(fnt)
            this.fontNames.push(fnt)
         else
            dlog("Discarding unavailable font " fnt)
      }
      logGDI("Complete reading system fonts")
      ; Table of style properties for the shape bar (needs the shape numbers, defaults and fonts above)
      ShapeStyles.Build()
   }


   /**
    * @description Looks up a shape name string in the ShapeName array and returns its
    *   1-based index (shape number). Used to convert a queued command name into the
    *   numeric draw mode used internally.
    * @param {String} name - Shape name to search for (matched against the part before " - ").
    * @returns {Integer} 1-based shape index if found, or 0 if not found.
    */
   Static NameToNumber(name) {
      For sn in this.ShapeName {
         sn := Trim(StrSplit(sn, "-")[1])
         If (sn = name) {
            Return A_Index
         }
      }
      Return 0
   }

   /**
    * @description OnEvent click callback for an existing shape control. If the mouse
    *   button is still held, either initiates a new draw on the snip surface (when a
    *   draw mode is active and Ctrl is not held) or delegates to MoveSize for
    *   moving/resizing the clicked shape.
    * @param {String} Key - Mouse button identifier (e.g. "lButton").
    * @param {commonShape} ShapeObj - The shape control object that was clicked.
    * @param {*} * - Additional event parameters (ignored).
    */
   Static ShapeClickHandler(Key, ShapeObj, *) {
      ; make sure mouse key is pressed down NOTE - A key may not be down if
      ; clicking from another active window, get two events, one with mouse up
      If GetKeyState(Key,"P") {
         If (ShapeObj.GUI.DrawMode and NOT GetKeyState("Ctrl","P")) {
            this.InitateDrawHandler(ShapeObj.Gui)
         } Else {
            ; A plain press (move or resize) selects the shape; Ctrl duplicates, Alt pushes down
            If NOT (ShapeObj.GUI.DrawMode OR GetKeyState("Ctrl", "P") OR GetKeyState("Alt", "P"))
               ShapeSelect.Select(ShapeObj)
            this.MoveSize(Key, ShapeObj)
         }
      }
   }

   /**
    * Called from lButton callback if we have an active Snip
    * and a drawing mode is active.
    * 
    * Calls either the Draw function or differernt Text functions
    * @param SnipObj - Snip Object that is currently active
    */
   Static InitateDrawHandler(SnipObj) {
      Static WM_NCLBUTTONDOWN := 0xA1
      DrawMode         := SnipObj.DrawMode
      hWnd             := SnipObj.hWnd
      changed          := 0
      Factor           := GetKeyState("Alt", "P") ? 2 : 1
      ; Ctrl-drag (any mode) drags the snip out to another app as a copy;
      ; Ctrl+Shift-drag selects a group of shapes (Shift alone constrains drawing)
      If (GetKeyState("Ctrl", "P")) {
         If (GetKeyState("Shift", "P"))
            ShapeGroup.SelectDrag(SnipObj)
         Else
            SnipDrag.Start(SnipObj)
         Return
      }
      Switch DrawMode {
         Case 0:
            ; Shift-drag selects a group of shapes (Ctrl+Shift-drag in a draw mode)
            If (GetKeyState("Shift", "P")) {
               ShapeGroup.SelectDrag(SnipObj)
               Return
            }
            ; Make it seem the caption was clicked so dragging will work.
            Cursor.SetCursor("SizeAll") ; (Changed: was Move)
            DllCall("ReleaseCapture")
            PostMessage(WM_NCLBUTTONDOWN, 2, , hWnd)
         Case Shapes.SHAPE_CROP, Shapes.SHAPE_SLICE, Shapes.SHAPE_EXTEND:
            changed := Shapes.Draw(SnipObj,DrawMode)
            Snips.SetDrawMode(0)
         Case Shapes.SHAPE_TAG:
            changed := Shapes.DrawTag(SnipObj, Shapes.DefaultColor(Shapes.SHAPE_TAG), Factor)
         Case Shapes.SHAPE_FILLTEXT,Shapes.SHAPE_TEXT,Shapes.SHAPE_LEFTARROWTEXT,Shapes.SHAPE_RIGHTARROWTEXT,Shapes.SHAPE_OLTEXT:
            changed := Shapes.AddDispText(SnipObj.hWnd, DrawMode, , Factor)

         Default : ; All other shapes
            changed := Shapes.Draw(SnipObj, DrawMode, Factor)
      }
      ; Update the clipboard automatically if that mode is enabled
      If (changed AND Snips.UpdateClipboard) {
         SnipObj.Snip2Clipboard(Snips.borderWithCopy)
         SnipObj.flashBorder()
      }
      Return
   }

   /**
    * @description Attempts to paste content from the clipboard as a new shape. Prefers
    *   text over images when both are available and both flags are set. Displays a tray
    *   tip on failure. Mouse position is used as the insertion point unless overridden.
    * @param {Integer} tryText - If 1, attempt to paste clipboard text first. Defaults to 1.
    * @param {Integer} tryImage - If 1, attempt to paste a clipboard bitmap. Defaults to 1.
    * @param {Number} [wX] - Optional X coordinate override for insertion (window-relative).
    * @param {Number} [wY] - Optional Y coordinate override for insertion (window-relative).
    */
   Static PasteNewShape(tryText :=1, tryImage :=1, wX?, wY?) {
      CoordMode('Mouse', 'Window')
      MouseGetPos(&X, &Y, &mhWnd)
      lX := wx ?? X
      lY := wy ?? Y
      If (SnipObj := GuiFromHwnd(WinActive("A")) ?? false) {
         ; Prefer text if desired and available
         If (tryText AND Clipboard.hasText()) {
            If NOT (Shapes.InsertText(SnipObj, lX, lY, A_Clipboard)) {
               qTrayTip("Failed to paste Text found from Clipboard", 2)
            }
            Return
         }
      } Else {
         qTrayTip("Failed to find active window object", 2)
         Return
      }
      ; Paste image if desired and available
      If (tryImage AND Clipboard.hasImage()) {

         hBitmap := Clipboard.HBITMAPFromClipboard(&W:=0, &H:=0)
         If (hBitmap) {
            If NOT ( ShapeObj := Shapes.CreatePicFromSource(SnipObj, hBitmap, lX, lY)) {
               qTrayTip("Failed to paste Bitmap found from Clipboard", 2)
            } Else {
               ShapeObj.PostAction(UnDo.ADD_SHAPE)
            }
            GDI.DeleteObject(hBitmap)
         } Else {
            qTrayTip("Failed to get Image Clipboard",2)
         }
      } Else {
         qTrayTip("Nothing suitable found on Clipboard",2)
      }
   }

   /**
    * Optional pass in existing shape and if so hide it then replace layer
    * In that case also the mouse start/end positions that are the shape boundaries
    * So we start off with a sized shape same as the passed in shape
    * 
    * Essentially this will also be the resize code for drawn shapes.
    * 
    * Text is not drawn here
    * 
    * @param {GuiSnip} SnipObj Object Handle for the snip
    * @param {commonShape} ShapeObj Canned Shape Number or Existing Shape Object
    * @param baseThicknessOrFactor Factor to pass to shape (thickness, blur values...)
    * @returns Nothing
    */
   static Draw(SnipObj, ShapeObj, baseThicknessOrFactor := 1) {
      Static canvasGui := Gui('+E0x20 -Caption -Border +E0x80000 +ToolWindow +AlwaysOnTop -DPIScale')
      ; All window relative
      Static shapeStart := {X:0, Y:0} ; Location where first click is done (window)
      Static mouseNew   := {X:0, Y:0} ; location of mouse in real time (window)
      Static mouseOld   := {X:0, Y:0} ; Copy of prior mouseNew, used to detect delta movement
      Static pressedKey :="lButton"
      this.ColorQueue.Length := 0
      CoordMode('Mouse', 'Window')
      MouseGetPos(&shapeStart.X, &shapeStart.Y)
      SnipObj.GetPos(&winX, &winY, &winW, &winH)
      DPIFactor      := WinDPI(SnipObj.hWnd)/96
      snapGrid       := DPIFactor * 10
      reverseLine    := false
      ; As we draw, we draw on this temp GUI DIB, later we draw on a picturecontrol  on the snip
      canvasGui.Show("NA W0 H0")

      ;@region check 
      ;----------------------------------------------------------------------
      ; If pre-existing shape to resize, then pull properties from the shape
      ;----------------------------------------------------------------------
      If (ShapeObj is commonShape) {
         newShape := false
         coord                 := ShapeObj.shapeCoord
         Shape                 := ShapeObj.Shape
         ; shapeColor            := ShapeObj.Color
         ShapeStart.W          := coord.W
         ShapeStart.H          := coord.H
         ;----------------------------------------------------------------------
         ; Lines complicate this logic because they have a direction
         ;----------------------------------------------------------------------
         Switch Shape {
            Case this.SHAPE_LINE, this.SHAPE_CONNECT, this.SHAPE_ARROW, this.SHAPE_OARROW, this.SHAPE_ODARROW, this.SHAPE_TAPARROW, this.SHAPE_BRACKET:
               Switch ShapeObj.Corner {
                  Case 1, 2: start := 3, reverseLine := true
                  Case 4, 6: start := 0
                  Default: start := 0
               }
            Default:
               Switch ShapeObj.Corner {
                  Case 1, 7, 8: start := 3 ; UL 3 points
                  Case 3, 4, 5: start := 0 ; LR 3 points
                  Case 2: start := 2 ; LL
                  Case 6: start := 1 ; UR
                  Default: start := 0
               }
         }
         ;----------------------------------------------------------------------
         ; Depending on start corner, have to conifgure the shape
         ; starting layout because we essentially resume a draw
         ;----------------------------------------------------------------------
         Switch start {
            Case 0: shapeStart.X := coord.X1, shapeStart.Y := coord.Y1 ; no swap ;UL
            Case 1: shapeStart.X := coord.X2, shapeStart.Y := coord.Y1 ; swap X ;UR
            Case 2: shapeStart.X := coord.X1, shapeStart.Y := coord.Y2 ; swap Y;LL
            Case 3: shapeStart.X := coord.X2, shapeStart.Y := coord.Y2 ; swap both;LR
            Default:
         }
         ;----------------------------------------------------------------------
         ; Some defaults in case the mouse isn't down
         ; Arrows can be in either direction
         ;----------------------------------------------------------------------
         W  := Round(coord.W), H  := Round(coord.H)
         X  := coord.X,        Y  := coord.Y
         X1 := coord.X1,       Y1 := coord.Y1
         X2 := coord.X2,       Y2 := coord.Y2

         ResizeMode := True
         SisShapes := this.SisterShapes(ShapeObj)
      } else if (IsInteger(ShapeObj)) {
         newShape := true
         ; No passed in Shape, just the Shape type, so create one
      /** @type {commonShape} */
         Shape := ShapeObj

      /** @type {commonShape} */
         ShapeObj         := SnipObj.AddNewShape(Shape, baseThicknessOrFactor)
         ShapeObj.Visible := false
         ; In case key is no longer pressed on a draw
         X := Y := W := H := X1 := X2 := Y1 := Y2 :=0
         ResizeMode := False
         ; Snap start point to any nearby sister focus points
         SisShapes := this.SisterShapes(ShapeObj)
         sisterShapeSnap := findNearestFocusPoint(ShapeObj,shapeStart.X, shapeStart.Y)
         If (sisterShapeSnap.Valid) {
            shapeStart.X := sisterShapeSnap.X
            shapeStart.Y := sisterShapeSnap.Y
         }

      } Else {
         qTrayTip("Draw Function has no shape parameter",2)
         Return
      }
      ;@endregion
      ;-----------------------------------------------------------------------
      ; Create a drawing surface for the temp GUI
      ; Draw onto a separate GUI slightly larger than the snip to allow shape overflow
      ;-----------------------------------------------------------------------
      surfSource := DIBSurface(winW, winH, canvasGui.hWnd, this.DIBPad)
      ; Needed for complex shape opacity
      ; Gdip.SetCompositingMode(surfSource.G,1)

      ; Force 0,0 to be inside the DIB to allow coloring outside the lines a a bit
      surfSource.Translate(this.DIBPad, this.DIBPad)
      ; Initialize loop variables
      mouseOld := shapeStart.Clone()
      ; Number of segments added (freehand)
      AddedPoints := 0 
      ;----------------------------------------------------------------------
      ; Create all the pens, arrow heads and brushes
      ; Adjust transparancy as needed
      ;----------------------------------------------------------------------
      Try {
         ; May be a slight lag on older computers while initializing texture
         BlockInput("MouseMove")
         ShapeObj.Startup()
      } Catch As e {
         elog(e)
      } Finally {
         BlockInput("MouseMoveOff")
      }
            ; We don't want an error while mouse is locked out

      local useLines := false
      ;----------------------------------------------------------------------
      ; Start the drawing loop if the mouse button is held down
      ; Otherwise draw the shape (e.g. for a duplicate action)
      ;----------------------------------------------------------------------
      lastShiftKey := GetKeyState("Shift","P")
      CoordMode('Mouse', 'Window')
      if (pressedKey) {
         this.DrawActive := True
         If (ResizeMode) {
            focusBorder.ShowFocus(ShapeObj.hWnd, True)
         }
         ;----------------------------------------------------------------------
         ; Drawing Loop starts here
         ; Bug in alpha ~23+ where phyiscal state is missed when click is released
         ;----------------------------------------------------------------------
         While GetKeyState(pressedKey) { ; ,"p"
            ; Logical state: the hook's "P" state can stick down after a session unlock
            If GetKeyState("Esc") {
               AddedPoints := W := H := 0
               focusBorder.HideFocus(true)
               Break
            }
            
            Sleep(10)
            MouseGetPos(&mouseNew.X, &mouseNew.Y)
            dX := mouseNew.X - mouseOld.X, dY := mouseNew.Y - mouseOld.Y

            ;----------------------------------------------------------------------
            ; Set the real-time pen/brush color key if pressed
            ; use the shape.Color to compare to
            ;----------------------------------------------------------------------
            Switch {
               Case this.ColorQueue.Length:
                  If (ResizeMode)
                     ShapeObj.PostAction(UnDo.SHAPE_COLOR)
                  ShapeObj.SetColor(this.ColorQueue.Pop())
               Case GetKeyState("Up", "P"):
                  ; Arrow key can real time change the width of the pens
                  ShapeObj.ChangeThickness(+0.03)
               Case GetKeyState("Down", "P"):
                  ShapeObj.ChangeThickness(-0.03)
               Case lastShiftKey != (lks := GetKeyState("Shift", "P")):
                  ; If shift key toggled while looping in place, keep processing
                  lastShiftKey := lks
               Case (Abs(dx) + Abs(dy)) = 0 :
                  ; No movement or adjustments, don't draw just keep looping
                  Continue
               Default:
            }
            ;----------------------------------------------------------------------
            ; Shift the starting position when Space Bar is down
            ;----------------------------------------------------------------------
            If (GetKeyState("Space","P")) {
               shapeStart.X += dX
               shapeStart.Y += dY
            }
            ;----------------------------------------------------------------------
            ; Compute the new unadjusted shape dimensions
            ; Account for non down/right drags
            ;----------------------------------------------------------------------
            X := Min(shapeStart.X, mouseNew.X)
            Y := Min(shapeStart.Y, mouseNew.Y)
            W := Abs(shapeStart.X - mouseNew.X)
            H := Abs(shapeStart.Y - mouseNew.Y)
            
            surfSource.GraphicsClear(0)
            ;----------------------------------------------------------------------
            ; Make real-time adjustments based on shape and shift key
            ; Also draw the apprpriate shape
            ;----------------------------------------------------------------------
            Switch ShapeObj.Source {
               Case "LineShape":
                  ;----------------------------------------------------------------------
                  ; Adjust the mouseNew position
                  ; First check if within rectangle of other line shape focus points to snap to them
                  ; Otherwise Soft Snap to 0/90/180/270 degrees
                  ;----------------------------------------------------------------------
                  sisterShapeSnap := findNearestFocusPoint(ShapeObj,mouseNew.X, mouseNew.Y)
                  ; Of we dodm't snape to another line then snap to horz/vert/45 deg lines
                  If (sisterShapeSnap.Valid) {
                     mouseNew.X := round(sisterShapeSnap.X)
                     mouseNew.Y := round(sisterShapeSnap.Y)
                  } else {
                     ; focusBorder.HideFocus(true)
                     If (W < snapGrid) {
                        mouseNew.X := shapeStart.X
                        ; W := 0
                     } Else If (H < snapGrid) {
                        mouseNew.Y := shapeStart.Y
                        ; H := 0
                     } Else If (Abs(H - W) < snapGrid) {
                        maxDel := Max(W, H)
                        mouseNew.Y := shapeStart.Y + (mouseNew.Y > shapeStart.Y ? maxDel : -maxDel)
                        mouseNew.X := shapeStart.X + (mouseNew.X > shapeStart.X ? maxDel : -maxDel)
                     }
                  }
                  ; Recompute the new coordinates in case we snapped
                  X := Min(shapeStart.X, mouseNew.X)
                  Y := Min(shapeStart.Y, mouseNew.Y)
                  W := Abs(shapeStart.X - mouseNew.X) 
                  H := Abs(shapeStart.Y - mouseNew.Y) 
                  ;----------------------------------------------------------------------
                  ; For lines, need to determine direction (for arrow head)
                  ;----------------------------------------------------------------------
                  if reverseLine {
                     x1 := mouseNew.X, x2 :=shapeStart.X
                     y1 := mouseNew.Y, y2 :=shapeStart.Y
                  } else {
                     x2 := mouseNew.X, x1 :=shapeStart.X
                     y2 := mouseNew.Y, Y1 :=shapeStart.Y
                  }
                  ;----------------------------------------------------------------------
                  ; Draw Line Shapes
                  ;----------------------------------------------------------------------
                  ShapeObj.Draw(surfSource.G, X1, Y1, X2, Y2)

               Case "BodyShape", "BlurShape", "ToolShape":
                  ; If on a middle grab then lock the opposing edge
                  Switch ShapeObj.Corner {
                     Case 5:
                        ; Grab bottom middle, Lock the right edge
                        W := shapeStart.W
                     Case 8:
                        ; Grab top middle, Lock the right edge
                        W := shapeStart.W
                        X := shapeStart.X - W ; drawn reverse
                     Case 3:
                        ; Grab right middle, Lock the Height
                        H := shapeStart.H
                     Case 7:
                        ; Grab left middle, Lock the Height
                        H := shapeStart.H
                        Y := shapeStart.Y - H ; drawn reverse
                     Default:
                        ; If we are on a corner, check for shift key to maintain square shape
                        If (GetKeyState("Shift", "P")) {
                           H := W := Max(H,W)
                           ; If U/L from start then lock the other side
                           if (mouseNew.X < shapeStart.X)
                              X := shapeStart.X - W
                           if (mouseNew.Y < shapeStart.Y)
                              Y := shapeStart.Y - H
                        } 
                  }
                  ;-------------------------------------------------------
                  ; Ellipse is drawn from center out, but resized normally
                  ;-------------------------------------------------------
                  If (NOT ResizeMode AND Shape = this.SHAPE_ELLIPSE) {
                     X := round(shapeStart.X - W)
                     Y := round(shapeStart.Y - H)
                     W *= 2, H *= 2
                  }
                  ;----------------------------------------------------------------------
                  ; Draw 2-D Shapes
                  ;----------------------------------------------------------------------
                  ShapeObj.Draw(surfSource.G, X, Y, W, H)

               Case "FreeHand":
                  ;----------------------------------------------------------------------
                  ; Draw straight lines when shift is down
                  ;----------------------------------------------------------------------
                  if (GetKeyState("Shift", "P")) {
                     ; useLines will stick for the reset of the shape
                     useLines := true
                     ; Pass in long gap to force straight lines
                     AddedPoints := ShapeObj.Draw(surfSource.G, mouseNew.X, mouseNew.Y, useLines, 50000)
                  } else {
                     AddedPoints := ShapeObj.Draw(surfSource.G, mouseNew.X, mouseNew.Y, useLines)
                  }

               Default:
                  warning("Unhandled Shape:" Shape " with source:" ShapeObj.Source)
            }
            mouseOld := mouseNew.Clone()
            ;----------------------------------------------------------------------
            ; Update the drawing window with the new locations
            ;----------------------------------------------------------------------
            surfSource.UpdateLayer(winX - this.DIBPad, winY - this.DIBPad)
            ;----------------------------------------------------------------------
            ; Hide the old picture if it was visible after we update once to the new GUI for a
            ; seamless transition (needed if re-sizing shape)
            ;----------------------------------------------------------------------
            if (ShapeObj.Visible) {
               ShapeObj.Visible := false
            }
            ;----------------------------------------------------------------------
            ; Sync the focus border
            ;----------------------------------------------------------------------
            if (ResizeMode)
               focusBorder.Move(X, Y, W, H)
         } ; end while loop
         
         ShapeObj.shapeStart := shapeStart.Clone() ; Used to know direction drawn for tools
         this.DrawActive := false
         if (ResizeMode) {
            ; Unlock the focusBorder after the next unfocus
            focusBorder.UnBlockMe()
         }
      } else {
         ;----------------------------------------------------------------------
         ; We used to one-off draw here, but shouldn't need anymore
         ;----------------------------------------------------------------------
         dlog("We shouldn't be getting here for " ShapeObj.Source)
         qTrayTip("We shouldn't be getting here for " ShapeObj.Source, 2)
      }
      ;----------------------------------------------------------------------
      ; Ready to transfer over to the Snip Window
      ; Ignore baby or escaped shapes
      ; X/Y are the mouse and not the constrained values
      ; Freehand shapes have one final draw to last point and compute their coordinates
      ;----------------------------------------------------------------------
      if (ResizeMode OR ShapeObj.SizeOk(W,H) OR AddedPoints > 2) {
         If (ShapeObj.Source = "FreeHand") {
            ; Some freehand shapes will close if start/end points are close to each other
            ShapeObj.CloseCurve(surfSource.G, useLines)
            ; Return the outer bounding box, including padding
            bndBx := ShapeObj.saveCoords(surfSource)
         } Else {
            ;----------------------------------------------------------------------
            ; Compute the actual extent used so we don't clip when cropped
            ; GetPathWorldBoundsI would work if we always had a path and knew the widest pen
            ; Even then, the boundary is a bit too large
            ; Example, rounded rectangle is drawn with outline that extends beyound he coordinates
            ; both size of the drawing coordinates, thus the need for DIBPadding
            ; Only add padding for line and body shapes, blurshapes recompute each move
            ;----------------------------------------------------------------------
            pad := ShapeObj.Source = "BlurShape" ? 0 : Shapes.shapePad
            bndBx := surfSource.FindExtent(X, Y, W, H, pad)
            ; Save the padding (if shape used it) so we know the shape vs window
            ; size differences for moving
            ShapeObj.savePadding(bndBx.L, bndBx.T, bndBx.R, bndBx.B)
         }
         ;----------------------------------------------------------------------
         ; Update the shape window with a portion of the DIB to reduce any padding
         ; Can we use one updatelayer with optional offset (or retrieve the offset in the object)
         ;----------------------------------------------------------------------
         surfSource.UpdateShapeWindow(ShapeObj.hwnd, bndBx.X1, bndBx.Y1, bndBx.W, bndBx.H, this.DIBPad)
         ShapeOnTop(ShapeObj)
         SnipObj.Dirty++

         ;----------------------------------------------------------------------
         ; Show shape over the draw window, then hide the draw window (flicker free)
         ;----------------------------------------------------------------------
         if NOT ShapeObj.Visible 
            ShapeObj.Visible := true
         canvasGui.Hide()
         ;----------------------------------------------------------------------
         ; Special shape handling after drawing
         ;----------------------------------------------------------------------
         Switch Shape {
            Case this.SHAPE_CROP:
               ; Crop the selection
               ShapeObj.Close(true)
               SnipObj.Crop(ShapeObj, Snips.UpdateClipboard)
            Case this.SHAPE_SLICE:
               ; Slice the selection
               ShapeObj.Close(true)
               SnipObj.Slice(ShapeObj, Snips.UpdateClipboard)
            Case this.SHAPE_EXTEND:
               ; Slice the selection
               ShapeObj.Close(true)
               SnipObj.Extend(ShapeObj, Snips.UpdateClipboard)
            Case this.SHAPE_OCR:
               ; OCR the selection
               ShapeObj.Close(true)
               SnipObj.OCRShape(ShapeObj)
            Default:
               if (newShape) {
                  ShapeObj.PostAction(UnDo.ADD_SHAPE)
                  ; the shape bar changes it too while this draw mode is on
                  SnipObj.lastDrawn := ShapeObj
               }

         }
         ; Done with drawing now
         ShapeObj.Cleanup()
      } else {
         ;----------------------------------------------------------------------
         ; Not valid shape, reset draw mode and hide this shape if visible. We
         ; can fall through here with a visible shape if we only click on the
         ; surface to exit draw mode. Control will be recycled. Normally not
         ; used since shape shouldn't be visible yet anyway.
         ; This can happen if we just click on the surface to exit draw mode
         ;----------------------------------------------------------------------
         If IsSet(ShapeObj) {
            ShapeObj.Close(true)
         }
         Snips.SetDrawMode(0)
      }
      ;----------------------------------------------------------------------
      ; All done, tidy up
      ; Destroy the writing surface & temp GUI, sleep Helps with flash/flicker
      ;----------------------------------------------------------------------
      surfSource := ""
      Sleep(-1) 
      ; Remove the overlay that we just drew to be seamless (it now aligns with shape window)
      canvasGui.Hide()
      return 1

      /**
       * Return a snap point for sister objects (closure)
       * @returns  Object of coordinates of the snap point 
       */
      findNearestFocusPoint(ShapeObj,X, Y) {
         For Ctrl in SisShapes {
            CI := Ctrl.CornerInfo(X, Y)
            If (CI.C and ShapeObj.hWnd != Ctrl.hWnd) {
               return {Valid : True, X : CI.X + Ctrl.shapeCoord.X, Y: CI.Y + Ctrl.shapeCoord.Y, Hwnd: Ctrl.Hwnd}
            }
         }
         return {Valid : False, X: -1, Y: -1}
      }
   }

   /**
    * Click on an object to move it, corner to resize it
    * Responds to a click on the existing control (OnEvent click)
    * Drawn shapes are resized by re-drawing them
    * 
    * @param Key - mouse lbutton
    * @param ShapeObj - Existing Shape Object
    */
   Static MoveSize(Key, ShapeObj) {
      Static mouseStart    := {X:0, Y:0} ; Location where first click is done (window)
      Static mouseNew      := {X:0, Y:0} ; location of mouse in real time (window)
      Static mouseDiff     := {X:0, Y:0}
      Static mouseLast     := {X:0, Y:0}
      Static shapeStart  := {X:0, Y:0, W:0, H:0}
      Static controlOffset := {X:0, Y:0}
      this.ColorQueue.Length := 0
      If (GetKeyState("Alt", "P")) {
         ; Alt-click: edit a text shape, push any other shape down one
         ; (Shift-click is group add/remove, handled in Snips.WM_LBUTTONDOWN)
         If (ShapeObj.Source = "Text")
            ShapeObj.EditDispText()
         Else
            ShapeObj.PushDown()
         Return
      } Else If (GetKeyState("Ctrl", "P")) {
         ; Duplicate the shape
         Shapes.Duplicate(Key, ShapeObj)
         Return
      }

      ; Latest control clicked will be on top of others (shapes are always over bitmaps for some reason)
      SnipObj := ShapeObj.Gui
      ShapeObj.RaiseToTop()   ; posts a SHAPE_ZORDER undo only if it wasn't on top
      CoordMode('Mouse', 'Window')
      MouseGetPos(&mouseStart.X, &mouseStart.Y)

      ; outer coordinates used for moving and box size
      ShapeObj.GetPos(&shapeStart.X, &shapeStart.Y, &shapeStart.W, &shapeStart.H)
      ; Box size to see if we are close to a corner/middle
      coord   := ShapeObj.shapeCoord
      ; Get start/end points of the shape (may be different than the picture size due to padding)
      ; See if we are near upper right/lower left corner (or line/arrow end-points)
      CI := ShapeObj.CornerInfo(mouseStart.X, mouseStart.Y)
      cur := CI.C ? (CI.Cur ?? Cursor.ResizeCursors[CI.C]) : "Move"
      ; cur is text version of Move, SizeNWSE and so on
      Cursor.SetCursorMode(cur)
      corner := CI.C
      ; Snap to the center of the resize point
      ccX := coord.X + CI.X
      ccY := coord.Y + CI.Y

      ;-----------------------------------------------------
      ; Resize or Redraw Loop Starts Here
      ;-----------------------------------------------------
      If (corner) {
         ShapeObj.PostAction(Undo.RESIZE_SHAPE)
         MouseMove(ccX, ccY, 0)

         ; If ShapeObj.Source = "FreeHand" {
         ;    ShapeObj.scaleFreeHand := GetKeyState("Shift","P")
         ; }
         ; Close to the corner, then resize
         If (CI.HasOwnProp("Ctrl")) {
            ;-----------------------------------------------------
            ; Control point: reshape the shape (e.g. text callout tip,
            ; connector middle segment) rather than resize it
            ;-----------------------------------------------------
            this.DragControl(Key, ShapeObj, CI.Ctrl)
         } Else if ShapeObj.Source ~= "Shape" {
            ;-----------------------------------------------------
            ; If registered shape, then redraw it instead of resizing it
            ;-----------------------------------------------------
            ShapeObj.Corner := corner
            this.Draw(ShapeObj.Gui, ShapeObj)
         } else {
            ;-----------------------------------------------------
            ; Resize The Non-Shape Control (Text, File, Clip, Freehand)
            ;-----------------------------------------------------
            ; Determine if text box with text in it
            If (ShapeObj.Source = "Text") {
               cFact := 1
               fSize := ShapeObj.FontSize
            }
            ;-----------------------------------------------------
            ; Initialize some variables with starting info
            ;-----------------------------------------------------
            Aspect := shapeStart.H / shapeStart.W
            MouseGetPos(&mouseStart.X, &mouseStart.Y)
            W := shapeStart.W, H := shapeStart.H
            mouseLast := mouseStart.Clone()

            ;-----------------------------------------------------
            ; Resize Non shape items like text, freehand or pictures
            ;-----------------------------------------------------
            focusBorder.ShowFocus(ShapeObj.hWnd, true)
            ; All but free hand shapes are redrawn vs resized, but pictures/Text are resized here also
            ShapeObj.Startup()
            Loop {
               ; NOTE - shapes don't auto refresh when color/thickness changed,
               ; we also do this in draw mode
               Sleep(10)
               
               If (this.ColorQueue.Length) {
                  ShapeObj.PostAction(UnDo.SHAPE_COLOR)
                  ShapeObj.SetColor(this.ColorQueue.Pop())  ; works on active pen
                  ShapeObj.Refresh()           ; not needed for all shapes
               }
               ;----------------------------------------------------------------------
               ; Arrow key can real time change the width of the pens
               ;----------------------------------------------------------------------
               If (GetKeyState("Up","P")) {
                  ShapeObj.ChangeThickness(+0.03)
                  ShapeObj.Refresh()
               } Else If (GetKeyState("Down","P")) {
                  ShapeObj.ChangeThickness(-0.03)
                  ShapeObj.Refresh()
               }
               
               MouseGetPos(&mouseNew.X, &mouseNew.Y)
               dX := mouseNew.X - mouseLast.X, dY := mouseNew.Y - mouseLast.Y
               if ((abs(dx) + abs(dy)) > 0) {
                  mouseDiff.X := mouseNew.X - mouseStart.X
                  mouseDiff.Y := mouseNew.Y - mouseStart.Y
                  ; Adjust dimensions depending on the corner
                  Switch corner {
                     ; Corners maintain aspect ratio
                     Case 1: ;UL 
                        q := (Aspect * -mouseDiff.X > -mouseDiff.Y) ? (mouseDiff.Y := Aspect * mouseDiff.X) : (mouseDiff.X := mouseDiff.Y / Aspect)
                        X := shapeStart.X + mouseDiff.X, W := (shapeStart.W - mouseDiff.X)
                        Y := shapeStart.Y + mouseDiff.Y, H := (shapeStart.H - mouseDiff.Y)
                     Case 2: ;UR
                        q := (Aspect * mouseDiff.X > -mouseDiff.Y) ? (mouseDiff.Y := -Aspect * mouseDiff.X) : (mouseDiff.X := -mouseDiff.Y / Aspect)
                        X := shapeStart.X,               W := (shapeStart.W + mouseDiff.X)
                        Y := shapeStart.Y + mouseDiff.Y, H := (shapeStart.H - mouseDiff.Y)
                     Case 6: ;LL
                        q := (Aspect * -mouseDiff.X > -mouseDiff.Y) ? (mouseDiff.Y := -Aspect * mouseDiff.X) : (mouseDiff.X := -mouseDiff.Y / Aspect)
                        X := shapeStart.X + mouseDiff.X, W := (shapeStart.W - mouseDiff.X)
                        Y := shapeStart.Y,               H := (shapeStart.H + mouseDiff.Y)
                     Case 4: ;LR
                        q := (Aspect * mouseDiff.X > mouseDiff.Y) ? (mouseDiff.Y := Aspect * mouseDiff.X) : (mouseDiff.X := mouseDiff.Y / Aspect)
                        X := shapeStart.X, W := (shapeStart.W + mouseDiff.X)
                        Y := shapeStart.Y, H := (shapeStart.H + mouseDiff.Y)
                        
                     Case 3: ;Right Middle
                        X := shapeStart.X, W := (shapeStart.W + mouseDiff.X)
                        Y := shapeStart.Y, H := shapeStart.H
                     Case 5: ;Bottom Middle
                        X := shapeStart.X, W := shapeStart.W
                        Y := shapeStart.Y, H := (shapeStart.H + mouseDiff.Y)
                     Case 7: ;left Middle
                        X := shapeStart.X + mouseDiff.X, W := (shapeStart.W - mouseDiff.X)
                        Y := shapeStart.Y, H := shapeStart.H
                     Case 8: ;top Middle
                        X := shapeStart.X, W := shapeStart.W
                        Y := shapeStart.Y + mouseDiff.Y, H := (shapeStart.H - mouseDiff.Y) 
                     Default: ; not a corner, won't happen
                        X := Min(shapeStart.X, mouseNew.X), W := (mouseDiff.X)
                        Y := Min(shapeStart.Y, mouseNew.Y), H := (mouseDiff.Y)
                  }
                  ; If W and H are of shape are positiive then process change
                  If (W > 0 AND H > 0) {
                     ; Space adjusts the offset while resizing
                     If (GetKeyState("Space", "P")) {
                        ; These kick in the next loop
                        mouseStart.X += dX, mouseStart.Y += dY
                        shapeStart.X += dX, shapeStart.Y += dY
                        ShapeObj.Move(X, Y)
                     } Else If (ShapeObj.Source = "Text") {
                        If (Abs(W / shapeStart.W - cFact) > 0.001) {
                           ; W is new width, controlStart.W is og width
                           cFact := W / shapeStart.W
                           ; ALso shift the control up/down to maintain the centerline
                           deltaY := shapeStart.H * (1 - cFact) / 2
                           ShapeObj.Move(Round(X), Round(shapeStart.Y + deltaY), Round(fSize * cFact, 2))
                        }
                     } Else {
                        ; Resize the shape, control coords, not shape
                        ; pictures are done here along with freehand
                        ShapeObj.Move(X, Y, W, H)
                     }
                     focusBorder.Sync()
                  }
               }
               mouseLast := mouseNew.Clone()

            } Until !GetKeyState(Key, 'p')

            ShapeObj.CleanUp()
            ; Unlock the focusBorder after the next unfocus
            focusBorder.UnBlockMe()
         }
      } Else {
         ; Undo is posted with the first change: a plain click (select) posts nothing
         posted := false
         ;-----------------------------------------------------
         ;               Move the control
         ;-----------------------------------------------------
         C := ShapeObj.shapeCoord
         controlOffset.X := shapeStart.X - mouseStart.X
         controlOffset.Y := shapeStart.Y - mouseStart.Y
         ; Grabbing a text callout's arrow/tail moves the whole thing (body and tip);
         ; grabbing the text body moves only the body (the tip stays where it points)
         moveTip  := (ShapeObj.Source = "Text" AND ShapeObj.IsOnCallout(mouseStart.X, mouseStart.Y))
         tipStart := moveTip ? ShapeObj.Tip.Clone() : 0

         MouseGetPos(&mouseNew.X, &mouseNew.Y)
         mouseLast := mouseNew.Clone()
         focusBorder.ShowFocus(ShapeObj.hWnd, true)
         ;----------------------------------------------------------------------
         ; Move only Loop starts here
         ;----------------------------------------------------------------------
         Loop {
            Sleep(10)
            MouseGetPos(&mouseNew.X, &mouseNew.Y)
            dX := mouseNew.X - mouseLast.X, dY := mouseNew.Y - mouseLast.Y
            if ((abs(dx) + abs(dy)) > 0) {
               PostMove()
               nX := mouseNew.X + controlOffset.X, nY := mouseNew.Y + controlOffset.Y
               If (moveTip)
                  ShapeObj.Tip := { X: tipStart.X + nX - shapeStart.X, Y: tipStart.Y + nY - shapeStart.Y }
               ShapeObj.Move(nX, nY)
               focusBorder.Sync()
            }
            ;----------------------------------------------------------------------
            ; Handle color changes and redraw shape
            ;----------------------------------------------------------------------
            If (this.ColorQueue.Length) {
               ShapeObj.PostAction(UnDo.SHAPE_COLOR)
               ShapeObj.Color := this.ColorQueue.Pop()
               ShapeObj.Refresh()
            }
            ;----------------------------------------------------------------------
            ; Arrow key can real time change the width of the pens
            ;----------------------------------------------------------------------
            If (GetKeyState("Up","P")) {
               PostMove()
               ShapeObj.shapeThickness *= 1.02 ; line/shape borders
               ShapeObj.Factor         *= 1.05 ; blur/pixelate
               ShapeObj.Refresh()
               focusBorder.Sync()
            } Else If (GetKeyState("Down","P")) {
               PostMove()
               ShapeObj.shapeThickness *= .98 ; line/shape borders
               ShapeObj.Factor         *= .95 ; blur/pixelate
               ShapeObj.Refresh()
               focusBorder.Sync()
            }
            mouseLast := mouseNew.Clone()

         } Until !GetKeyState(Key, 'p')
         ; Done
         focusBorder.UnBlockMe()
      }

      ; Restore active cursor
      Cursor.MoveResizeCursor := 0 ; HACK - why is this also needed for correct behaviour?
      Cursor.SetCursor("Select") ; not really needed
      ; Snapshot clipboard if enabled
      If (Snips.UpdateClipboard) {
         SnipObj.flashBorder()
         SnipObj.Snip2Clipboard(Snips.borderWithCopy)
      }
      ShapeObj.Gui.Dirty++
      Return

      ; Move undo, once, before the first change
      PostMove() {
         If NOT posted
            ShapeObj.PostAction(UnDo.MOVE_SHAPE)
         posted := true
      }
   }

   /**
    * Drag a shape's control point while the mouse button is held (see the control
    * point notes in commonShape). The caller has already posted the undo action.
    * @param {String} Key - Mouse button being held (e.g. "lButton")
    * @param {commonShape} ShapeObj - Shape owning the control point
    * @param {String} name - Ctrl name from the shape's FocusPoints()
    */
   Static DragControl(Key, ShapeObj, name) {
      focusBorder.ShowFocus(ShapeObj.hWnd, true)
      CoordMode('Mouse', 'Window')
      MouseGetPos(&lastX, &lastY)
      Loop {
         Sleep(10)
         MouseGetPos(&mX, &mY)
         If (mX != lastX OR mY != lastY) {
            ShapeObj.ControlDrag(name, mX, mY)
            focusBorder.Sync(ShapeObj)
            lastX := mX, lastY := mY
         }
      } Until !GetKeyState(Key, 'p')
      ShapeObj.ControlDragEnd(name)
      focusBorder.Sync(ShapeObj)
      focusBorder.UnBlockMe()
   }

   /**
    * Duplicate an object
    * @param key - 'lbutton' 
    * @param GuiCtrlObj - Picture control object
    * @returns {commonShape|Integer} the copy, 0 if the shape can't be copied
    */
   Static Duplicate(key, ShapeObj) {
      ; Needs file name for picture control
      ; GetPos is shifted by Margin I think, where coords are not??
      Info := ShapeObj.InstanceInfo()
      ShapeObj.GetPos(&csX, &csY, &cW, &cH)
      SnipObj := Info.Gui
      Switch Info.Source {
         Case "File", "Clip":
            CloneObj := this.CreatePicFromSource(SnipObj, Info.FileName, Info.shapeCoord.X1, Info.shapeCoord.Y1)
            For pr, v in Info.OwnProps() {
               If (pr = "FileName" OR pr = "hBitmap")   ; the copy's handle, freed below
                  Continue
               Try CloneObj.%pr% := v ; Can't set GUI (read only)
            }
            ; InstanceInfo made a bitmap copy; the new shape made its own from it
            GDI.DeleteObject(Info.hBitmap)
            CloneObj.Move(csX, csY + cH, cW, cH)
            CloneObj.PostAction(UnDo.ADD_SHAPE)

         Case "BlurShape", "BodyShape", "LineShape", "FreeHand":
            vShift   := round(random(10,100)) ; must round to whole number
            CloneObj := SnipObj.AddNewShape(Info.Shape)
            If (Info.HasProp("drawFunction")) {
               ; Saved as text, get the pointer
               Info.DrawFunction := getFunctionObject(Info.DrawFunction)
            }
            ; Blend in the properties
            For pr, v in Info.OwnProps() {
               Try CloneObj.%pr% := v ; Can't set GUI (read only)
            }
            ; Redraw then shift the cloned shape
            CloneObj.Refresh()
            CloneObj.Move(csX, csY + vShift)
            ShapeOnTop(CloneObj)
            CloneObj.PostAction(UnDo.ADD_SHAPE)
            
         Case "Text":
            ; Pretty much the same but shift by shape height
            CloneObj := SnipObj.AddNewShape(Info.Shape)
            For pr, v in Info.OwnProps() {
               Try CloneObj.%pr% := v ; Can't set GUI (read only)
            }
            vShift  := Info.shapeCoord.H
            ; Copy points its callout at the same offset from its body as the original
            If (IsObject(Info.Tip ?? ""))
               CloneObj.Tip := { X: Info.Tip.X, Y: Info.Tip.Y + vShift }
            If (CloneObj.DrawText(csX, csY + vShift)) {
               ShapeOnTop(CloneObj)
               ShapeObj.Gui.Dirty++
            }
            ShapeOnTop(CloneObj)
            CloneObj.PostAction(UnDo.ADD_SHAPE)

         Default:
      }
      Return CloneObj ?? 0   ; the copy (the shape bar selects it)
   }

   /**
    * Find sister shapes of the same type in the same GUI that are visible
    * @param ShapeObj Target shape to find ones of the same type
    */
   Static SisterShapes(ShapeObj) {
      SisShapes := Array()
      For Ctrl in ShapeObj.Gui {
         If Ctrl.Visible AND Ctrl.Source ~= "Shape" {
            SisShapes.Push(Ctrl)
         }
      }
      Return SisShapes
   }

   /**
    * Add a picture or icon to the image for annotation
    * @param hWnd Handle to window
    * @param Key the button key that is pressed
    */
   Static AddPictureFromFile(hWnd, key, letter) {
      SnipObj := Snips.GetGuiObj(hWnd)
      SnipObj.GetPos(,,&W,&H)
      KeyWait(letter,"t3") ; wait for key to not be pressed
      _ := PreDialog(SnipObj)
      SelectedFiles := FileSelect("M", SETTINGS.SavePath_Icons, "Select Pictures to Add", "Picture (*.png; *.ico; *.bmp *.gif *.jpg *.WMF)")
      Count := 0
      For SelectedFile in SelectedFiles {
         If (FileExist(SelectedFile)) {
            If (ShapeObj := this.CreatePicFromSource(SnipObj, SelectedFile, W // 3, H // 3)) {
               SplitPath(SelectedFile, , &Settings.SavePath_Icons)  ; Save new location for snips
               ShapeObj.Gui.Dirty++
               ShapeObj.PostAction(UnDo.ADD_SHAPE)
               Count++
            }
         }
      }
      Return Count
   }

   /**
    * @description Placeholder for creating a picture shape directly from clipboard image data.
    * @param {Object} SnipObj - The target snip GUI object.
    * @param {Number} sX - X coordinate for placement (window-relative).
    * @param {Number} sY - Y coordinate for placement (window-relative).
    */
   Static CreatePicFromClipboard(SnipObj, sX, sY) {
   }

   /**
    * @description Creates a new picture/bitmap shape control on the snip from either a
    *   file path or an HBITMAP handle string. Brings the new control to the top of the
    *   z-order and marks the snip as dirty.
    * @param {Object} SnipObj - The target snip GUI object to add the shape to.
    * @param {String} SelectedFileOrBitmap - Full file path or "HBITMAP:*<handle>" string.
    * @param {Number} sX - X coordinate for placement (window-relative).
    * @param {Number} sY - Y coordinate for placement (window-relative).
    * @returns {Object|Integer} The new shape control object, or 0 if the source was not found.
    */
   Static CreatePicFromSource(SnipObj, SelectedFileOrBitmap, sX, sY) {
      If ((FE := FileExist(SelectedFileOrBitmap)) OR IsNumber(SelectedFileOrBitmap)) {
         Shape := FE ? Shapes.SHAPE_FILE : Shapes.SHAPE_BITMAP
         ; NOTE - layered windows are always on top of other pictures like this, work around would be to 
         ;       save the image and draw into a layered window. Would have to handle resizing manually
         If (ShapeObj := SnipObj.AddNewBitmap(Shape, SelectedFileOrBitmap, sX, sY)) { ; NOTE +E0x80000 hides the image
            ShapeObj.SaveSize(SelectedFileOrBitmap)
            ShapeOnTop(ShapeObj)
            ShapeObj.Gui.Dirty++
         }
         Return ShapeObj
      } Else {
         Warning("Did not Find Existing " SelectedFileOrBitmap)
         Return 0
      }
   }

   /**
    * Color new shapes of a type get: that of its category (Arrows, Shapes, Free Hand, Text,
    * Tags, Highlighters), or the overall color for types without one (tools, pictures)
    * @param {Integer} Shape - shape type number
    * @returns {Integer} RGB
    */
   Static DefaultColor(Shape) {
      cat := this.ColorCat.Get(Shape, "")
      Return RGBval(cat = "Highlighters" ? this.highlightColor : this.CatColors.Get(cat, this.globalShapeColor))
   }
   /**
    * Set the color of a shape type's category
    * @param {Integer} Shape - shape type number
    * @param {Integer} clr - RGB
    * @returns {Integer} false if the type has no color category
    */
   Static SetDefaultColor(Shape, clr) {
      If NOT (cat := this.ColorCat.Get(Shape, ""))
         Return false
      If (cat = "Highlighters")
         this.highlightColor := clr
      Else
         this.CatColors[cat] := clr
      ShapeBar.Redraw()
      Return true
   }
   /**
    * Set every category's color, except the highlighters'
    * @param {Integer} clr - RGB
    */
   Static SetAllColors(clr) {
      this.globalShapeColor := clr
      For cat in this.CatColors.Clone()
         this.CatColors[cat] := clr
      ShapeBar.Redraw()
   }
   /**
    * @description Color key (1-9). A selected group takes the color; a shape being drawn,
    *   moved or resized does too (color queue). Otherwise it is the color for new shapes:
    *   of the selected drawing tool's category, or of all categories in select mode.
    * @param {String|Integer} val - Color value (name or RGB integer).
    * @param {*} * - Additional event parameters (ignored).
    */
   Static setShapeColor(val,*) {
      nc := RGBval(val)
      ; A selected shape group takes the color directly, the defaults stay
      If (ShapeGroup.Active) {
         ShapeGroup.SetColor(nc)
         Return
      }
      this.ColorQueue.push(nc)
      mode := (SnipObj := Snips.GetGuiObj()) ? SnipObj.DrawMode : 0
      ; Moving or resizing a shape: only that shape
      If (NOT mode AND GetKeyState("LButton", "P"))
         Return
      If NOT (mode AND this.SetDefaultColor(mode, nc))
         this.SetAllColors(nc)
      Snips.SetSnipBorderColor(val)
   }

   /**
    * @description Sends STM_SETIMAGE to assign a new HBITMAP to a static picture control,
    *   and deletes the prior image handle if one was replaced.
    * @param {Ptr} hwnd - Handle to the static picture control.
    * @param {Ptr} hBitmap - Handle to the new bitmap to assign.
    * @returns {Ptr} Handle to the previous bitmap, or 0 if none was set.
    */
   Static SetImage(hwnd, hBitmap) {
      ; STM_SETIMAGE
      _E := DllCall("SendMessage", "Ptr", hwnd, "UInt", 0x172, "UInt", 0x0, "Ptr", hBitmap)
      if (_E)
         GDI.DeleteObject(_E)      
      Return _E
   }

   /**
    * @description Counts and returns the number of currently visible Text shape controls
    *   in the specified snip window.
    * @param {Ptr} hWnd - Handle to the snip window. Defaults to the currently active window if 0.
    * @returns {Integer} Number of visible Text shapes found.
    */
   Static VisibleTextShapes(hWnd := 0) {
      if NOT hWnd
         hWnd := WinExist("A")
      Count := 0
      For Ctrl in Snips.GetGuiObj(hWnd) {
         If Ctrl.Visible and Ctrl.Source = "Text" {
            Count++
         }
      }
      Return Count
   }

   /**
    * @description The numbered tags on a snip: tags whose text is a label of their own
    *   scheme (TagScheme: number, letters or Roman). Tags with other text are left out.
    * @param {Object} SnipObj - The snip GUI object
    * @returns {Array} [{shape, n}] sorted by number (ties: oldest first)
    */
   Static TagSequence(SnipObj) {
      ; VisibleShapes is top of the Z-order first; walk bottom-up so ties keep oldest first
      list := SnipObj.VisibleShapes, tags := []
      i := list.Length
      While (i >= 1) {
         s := list[i--]
         If (s.Shape = Shapes.SHAPE_TAG AND (n := TextShape.TagValue(s.Text, s.TagScheme)))
            tags.Push({ shape: s, n: n })
      }
      ; Stable insertion sort by current number
      Loop tags.Length - 1 {
         j := A_Index + 1, cur := tags[j]
         While (j > 1 AND tags[j - 1].n > cur.n) {
            tags[j] := tags[j - 1], j--
         }
         tags[j] := cur
      }
      Return tags
   }

   /**
    * @description Relabel one tag (number n, scheme), keeping its centre (the width
    *   changes with the label). Posts TEXT_CHANGE and MOVE_SHAPE under undoTag.
    */
   Static _RelabelTag(s, n, scheme, undoTag) {
      ; Text, then position: undo replays in reverse, restoring the old spot last
      s.PostAction(UnDo.TEXT_CHANGE, undoTag)
      s.PostAction(UnDo.MOVE_SHAPE, undoTag)
      C := s.shapeCoord, cx := C.X + C.W / 2, cy := C.Y + C.H / 2
      s.TagScheme := scheme
      s.Text := TextShape.TagLabel(n, scheme)
      s.DrawText(C.X1, C.Y1)
      C := s.shapeCoord
      s.Move(Round(cx - C.W / 2), Round(cy - C.H / 2))
   }

   /**
    * @description Renumber the numbered tags on a snip 1..N with no gaps (e.g. after one
    *   was deleted), each in its own scheme (1, 2, 3 / A, B, C / a, b, c / I, II, III).
    *   Tags whose text isn't a label of their scheme are left alone. Order follows the
    *   current numbers (ties: oldest first). Each tag keeps its centre. One undo restores
    *   all of them. The snip's tag counter is set so the next tag drawn continues the
    *   sequence.
    * @param {Object} SnipObj - The snip GUI object
    * @returns {Integer} Number of tags changed
    */
   Static RenumberTags(SnipObj) {
      tags := this.TagSequence(SnipObj)
      If (tags.Length = 0) {
         qTrayTip("No numbered tags to renumber")
         Return 0
      }
      undoTag := UnDo.NewTag("RenumberTags")
      changed := 0
      For idx, t in tags {
         If (t.n = idx)
            Continue
         this._RelabelTag(t.shape, idx, t.shape.TagScheme, undoTag)
         changed++
      }
      ; The next tag drawn continues the sequence
      SnipObj.Counter := tags.Length
      If (changed)
         SnipObj.Dirty++
      Return changed
   }

   /**
    * @description Change the label scheme of every numbered tag on a snip (e.g. 1, 2, 3
    *   to A, B, C). Each tag keeps its number and centre; one undo restores them all.
    *   New tags on the snip continue in this scheme.
    * @param {Object} SnipObj - The snip GUI object
    * @param {String} scheme - One of TextShape.TagSchemes
    * @returns {Integer} Number of tags changed
    */
   Static SetTagScheme(SnipObj, scheme) {
      undoTag := UnDo.NewTag("TagScheme")
      changed := 0
      For t in this.TagSequence(SnipObj) {
         If (t.shape.TagScheme = scheme)
            Continue
         this._RelabelTag(t.shape, t.n, scheme, undoTag)
         changed++
      }
      If (changed)
         SnipObj.Dirty++
      Return changed
   }

   /**
    * @description Draws an auto-incrementing numbered tag at the current mouse position.
    *   Resets the snip counter if no text shapes are present. The tag background color is
    *   sampled from the snip bitmap at the mouse location. The tag is centered on the
    *   mouse cursor after rendering. If the mouse button is still held, a callout
    *   tip follows the drag until it is released.
    * @param {Object} SnipObj - The snip GUI object to draw the tag on.
    * @param {Integer} fColor - Foreground color for the tag text (RGB integer).
    * @param {Number} Factor - Font size scaling factor. Defaults to 1.
    * @returns {Integer} Always returns 1.
    *   (See RenumberTags to close gaps after tags are deleted.)
    */
   Static DrawTag(SnipObj, fColor, Factor:=1) {
      if (this.VisibleTextShapes(SnipObj.hWnd) = 0)
         SnipObj.Counter := 0
      next := ++SnipObj.Counter
      ; Continue the scheme the snip's tags already use (the highest one), else the default
      seq := this.TagSequence(SnipObj)
      scheme := seq.Length ? seq[-1].shape.TagScheme : TextShape.TagScheme
      nextChar := TextShape.TagLabel(next, scheme) ; a string: numbers cause an issue for render

      CoordMode('Mouse', 'Window')
      MouseGetPos(&mX, &mY)
      BGColor := SnipObj.BackgroundPICColorFromXY(mX, mY, 32)
      TextObj := SnipObj.AddNewShape(Shapes.SHAPE_TAG)
      TextObj.TagScheme := scheme
      TextObj.Visible := false
      ; No size until rendered, so BackgroundColorFromShape won't work here

      If (TextObj.DrawText(mX, mY, TextShape.TagFontSize * Factor, nextChar, TextShape.TagFontName, "Center", TextShape.TagFontStyle, RGBval(fColor), BGColor)) {
         S := TextObj.shapeCoord
         ; Adjust for center of tag vs upper left
         dx := -S.W / 2, dy := -S.H / 2
         TextObj.Move(mX + dx, mY + dy)
         ShapeOnTop(TextObj)
         TextObj.Visible := true
         TextObj.Gui.Dirty++
         ; Button still down: the tag stays put and a callout tip follows the drag
         ; (same loop as dragging the tip handle; a tip released inside the tag
         ; leaves no callout, so a plain click is unchanged)
         If GetKeyState("LButton", "P")
            Shapes.DragControl("LButton", TextObj, "Tip")
         ; After the drag, so one undo removes the tag and its callout together
         TextObj.PostAction(UnDo.ADD_SHAPE)
         SnipObj.lastDrawn := TextObj
      }
      Return 1
   }

   /**
    * @description Inserts text (typically from the clipboard) as a new FillText shape on
    *   the snip at the given window-relative coordinates. If the coordinates fall outside
    *   the snip bounds, the text is placed at the snip center instead. CRLF line endings
    *   are normalized to LF before rendering.
    * @param {Object} SnipObj - The snip GUI object to insert text into.
    * @param {Number} wX - X insertion coordinate (window-relative).
    * @param {Number} wY - Y insertion coordinate (window-relative).
    * @param {String} Text - The text content to insert.
    * @returns {Object|Integer} The new text shape object on success, or 0 on failure.
    */
   Static InsertText(SnipObj, wX, wY, Text) {
      ; Keep the text on the GUI

      SnipObj.GetPos(&gX, &gY, &gW, &gH)
      CoordMode('Mouse', 'Screen')
      MouseGetPos(&mX, &mY)
      GDIp.CreateRect(&Rect, 0, 0, gW, gH)
      Pt := wY << 32 | wX
      If ( NOT PtInRect(Rect, Pt)) {
         wX := round(0.5 * gW)
         wY := round(0.5 * gH)
      }
      ; Use fill text as a default, translate CRLF to just LF
      Text := StrReplace(Text,"`r`n","`n")
      BGColor := SnipObj.BackgroundPICColorFromXY(wX, wY, 32)
      TextObj := SnipObj.AddNewShape(Shapes.SHAPE_FILLTEXT)
      If (TextObj.DrawText(wX, wY, TextShape.FillFontSize, Trim(Text, " `n"), TextShape.FillFontName, , , Shapes.DefaultColor(Shapes.SHAPE_FILLTEXT), BGColor)) {
         qTrayTip("Inserting text: " SubStr(Text,1,20) "...")
         ShapeOnTop(TextObj)
         SnipObj.Dirty++
         TextObj.PostAction(UnDo.ADD_SHAPE)
         Return TextObj
      } Else {
         qTrayTip("Failed to Insert Text")
         Return 0
      }
   }

   /**
    * @description Prompts the user for text input via a dialog and draws the result as
    *   a text shape at the current mouse position. Font, style, size, and alignment are
    *   pre-populated from the appropriate TextShape defaults for the given shape type.
    *   The resulting shape is vertically centered on the mouse click point.
    * @param {Ptr} hWnd - Handle to the snip window.
    * @param {Integer} Shape - Shape type constant (e.g. SHAPE_FILLTEXT, SHAPE_TAG, SHAPE_OLTEXT).
    * @param {String} letter - Hotkey letter to wait for release before showing the dialog. Empty string to skip.
    * @param {Number} factor - Font size scaling factor. Defaults to 1.
    * @returns {Integer} 1 on success, 0 if the dialog was cancelled or the draw failed.
    */
   Static AddDispText(hWnd, Shape, letter := "", factor := 1) {
      CoordMode('Mouse', 'Window')
      MouseGetPos(&sX, &sY)
      ; Commpute the appropriate background color
      if (letter)
         KeyWait(letter, "t2") ; wait for key to not be pressed (repeats)
      SnipObj := Snips.GetGuiObj(hWnd)

      ; Background is fill for tags and fill style
      BGColor := SnipObj.BackgroundPICColorFromXY(sX, sY, 32)
      TextObj := SnipObj.AddNewShape(Shape)
      Switch Shape {
         Case Shapes.SHAPE_TAG:
            TextObj.FontName  := TextShape.TagFontName
            TextObj.FontStyle := TextShape.TagFontStyle
            TextObj.FontSize  := TextShape.TagFontSize * factor
         Case Shapes.SHAPE_FILLTEXT, Shapes.SHAPE_LEFTARROWTEXT, Shapes.SHAPE_RIGHTARROWTEXT, Shapes.SHAPE_TEXT:
            TextObj.FontName  := TextShape.FillFontName
            TextObj.FontStyle := TextShape.FillFontStyle
            TextObj.Alignment := TextShape.FillAlignment
            TextObj.FontSize  := TextShape.FillFontSize * factor
         Case Shapes.SHAPE_OLTEXT:
            TextObj.FontName  := TextShape.OLFontName
            TextObj.FontStyle := TextShape.OLFontStyle
            TextObj.Alignment := TextShape.OLAlignment
            TextObj.FontSize  := TextShape.OLFontSize * factor
         Default:
      }
      _ := PreDialog(SnipObj)
      TextObj.Color := Shapes.DefaultColor(Shape)
      Obj := TextInputBox(TextObj, "Enter Text to Add (Ctrl-Enter to Accept), Resize to set wrapping in shape", "Snip Text", "")
      If (WinExist(hWnd)) {
         If (Obj.Result = "OK") {
            If (TextObj.DrawText(sX, sY, Obj.Size, Trim(Obj.Value, " `n"), Obj.Font, Obj.ALignment, Obj.FontStyle, RGBval(Obj.Color), BGColor)) {
               ShapeOnTop(TextObj)
               SnipObj.Dirty++
               ; Shift up so it is centered on the mouse location
               TextObj.GetPos(, , &W, &H)
               dy := -H / 2
               TextObj.Move(sX, SY + dy)
               TextObj.PostAction(UnDo.ADD_SHAPE)
               Return 1
            } Else
               Return 0
         } Else {
            ; zombie text will be recycled
            Return 0
         }
      } Else {
         Return 0
      }
   }
}
logGDI(BFN(Error("", -1).File) " loaded...")


;----------------------------------------------------------------------
; Class to get Font Info from GetObject
;----------------------------------------------------------------------
; Class tagLOGFONTA {
;   lfHeight               : i32
;   lfWidth                : i32
;   lfEscapement           : i32
;   lfOrientation          : i32
;   lfWeight               : i32
;   lfItalic               : u8
;   lfUnderline            : u8
;   lfStrikeOut            : u8
;   lfCharSet              : u8
;   lfOutPrecision         : u8
;   lfClipPrecision        : u8
;   lfQuality              : u8
;   lfPitchAndFamily       : u8
;   _lfFaceName            : 32 ; string pointer
;   lfFaceName =>   StrGet(this._lfFaceName, 32)
; }
