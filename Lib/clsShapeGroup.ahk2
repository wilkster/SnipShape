#Requires AutoHotkey v2.1-
/************************************************************************
 * @description Group selection of shapes on a snip
 *
 * Shift-drag on the snip background (select mode, or Ctrl+Shift-drag in a draw
 * mode) draws a selection rectangle; the shapes fully inside it become a group,
 * shown with a dashed box. Shift-click on a shape (select mode) adds it to the
 * group, starting one if needed, or takes it out if it is already in; inside the
 * box the click looks through it to the shape underneath. Shift-click on a
 * resize handle still resizes (Shift keeps the aspect ratio). While the group is up:
 *   - drag inside the box moves every shape (one undo step)
 *   - right-click the box: copy, delete
 *   - Up/Down and the mouse wheel change each shape's size/thickness (as for a
 *     single focused shape); Del deletes; Ctrl-C copies; Esc or a click
 *     anywhere else on the snip clears the group; 1-9 color keys recolor it
 *
 * The box is a layered popup owned by the snip, filled with a faint tint so it
 * catches clicks over its whole area (Snips.WM_LBUTTONDOWN routes them here).
 * It never activates (WS_EX_NOACTIVATE), so the snip keeps its hotkeys.
 * A timer keeps it in step with the shapes (snip moved/scaled, undo, close).
 ***********************************************************************/
#include Settings.ahk2
#include libMisc.ahk2
#include clsCursor.ahk2
#include undo.ahk2
#include clsSnips.ahk2
#include ColorPopDown.ahk2
#include clsShapeBar.ahk2
#include clsShapeSelect.ahk2
Class ShapeGroup {
   Static List     := []      ; selected shapes (commonShape)
   Static SnipObj  := 0       ; snip that owns them
   Static snipHwnd := 0
   Static Margin   := 4       ; box margin around the shapes (px)

   Static __New() {
      this._timer   := this.Sync.Bind(this)
      this._lastKey := ""
      this._resizePosted := false
      this._MakeGui()
   }
   /**
    * Create the box window: layered, no caption, tool window, never activated.
    * It is owned by the snip while a group is up, and Windows destroys owned
    * windows with their owner, so it is recreated if a snip took it down.
    */
   Static _MakeGui() {
      If (this.HasOwnProp("gui") AND DllCall("IsWindow", "Ptr", this.hWnd))
         Return
      ; AlwaysOnTop: snips are topmost, and an owned window that isn't stays behind them
      this.gui  := Gui("-Caption +E0x80000 +E0x08000000 +ToolWindow +AlwaysOnTop -DPIScale")
      this.hWnd := this.gui.hWnd
      this.gui.OnEvent("ContextMenu", (*) => this.ShowMenu())
      ; WS_EX_NOACTIVATE alone doesn't stop a click activating it (tested), and the
      ; snip's hotkeys (keys, wheel) need the snip to stay active: MA_NOACTIVATE
      this.gui.OnMessage(0x21, (*) => 3)   ; WM_MOUSEACTIVATE
   }

   /**
    * True while a group is selected and shown
    * @type {Integer}
    */
   Static Active => (this.List.Length > 0 AND this.SnipObj != 0)

   /**
    * Shift-drag on the snip: draw the selection rectangle until the button is
    * released, then select the shapes fully inside it. Esc cancels.
    * @param {GuiSnip} SnipObj - Snip that was clicked
    * @returns {Integer} number of shapes selected
    */
   Static SelectDrag(SnipObj) {
      this.Clear()
      CoordMode("Mouse", "Screen")
      MouseGetPos(&sX, &sY)
      SnipObj.GetPos(&wX, &wY, &wW, &wH)
      this._MakeGui()
      this.gui.Opt("+Owner" SnipObj.hWnd)
      focusBorder.HideFocus(true)
      rc := 0, lastX := "", lastY := ""
      While GetKeyState("LButton", "P") {
         ; Logical state: the hook's "P" state can stick down after a session unlock
         If GetKeyState("Esc") {
            this._Hide()
            Return 0
         }
         MouseGetPos(&mX, &mY)
         If (mX != lastX OR mY != lastY) {
            ; snip window coordinates, kept inside the snip
            x1 := Constrain(0, wW, Min(sX, mX) - wX), x2 := Constrain(0, wW, Max(sX, mX) - wX)
            y1 := Constrain(0, wH, Min(sY, mY) - wY), y2 := Constrain(0, wH, Max(sY, mY) - wY)
            rc := { X: x1, Y: y1, W: x2 - x1, H: y2 - y1 }
            this._Render(wX, wY, rc)
            lastX := mX, lastY := mY
         }
         Sleep(10)
      }
      this._Hide()
      If (NOT rc OR (rc.W < 3 AND rc.H < 3))
         Return 0
      sel := this.ShapesInRect(SnipObj, rc)
      If (sel.Length)
         this.Select(SnipObj, sel)
      Return sel.Length
   }

   /**
    * Shapes fully inside a rectangle: the shape box (line end points, text body)
    * and, for a text callout, its tip
    * @param {Object} rc - {X, Y, W, H} in snip window coordinates
    * @returns {Array}
    */
   Static ShapesInRect(SnipObj, rc) {
      Return this._Filter(SnipObj, rc)
   }

   /**
    * Ctrl-A: select every shape on the snip (clears the group if there are none)
    * @returns {Integer} number of shapes selected
    */
   Static SelectAll(SnipObj) {
      sel := this._Filter(SnipObj)
      If (sel.Length)
         this.Select(SnipObj, sel)
      Else
         this.Clear()
      Return sel.Length
   }

   ; Selectable visible shapes, optionally only those fully inside rc
   Static _Filter(SnipObj, rc?) {
      sel := []
      For ShapeObj in SnipObj.VisibleShapes {
         If NOT this._Selectable(ShapeObj)
            Continue
         If NOT IsSet(rc) {
            sel.Push(ShapeObj)
            Continue
         }
         C := ShapeObj.shapeCoord
         inside := this._InRect(C.X, C.Y, C.X + C.W, C.Y + C.H, rc)
         If (inside AND ShapeObj.Source = "Text" AND ShapeObj.HasProp("Tip") AND IsObject(ShapeObj.Tip))
            inside := this._InRect(ShapeObj.Tip.X, ShapeObj.Tip.Y, ShapeObj.Tip.X, ShapeObj.Tip.Y, rc)
         If (inside)
            sel.Push(ShapeObj)
      }
      Return sel
   }
   ; True if the box x1,y1 - x2,y2 lies fully inside rc {X, Y, W, H}, edges included.
   ; A zero-size box (straight line, callout tip point) works, unlike Win32 IntersectRect.
   Static _InRect(x1, y1, x2, y2, rc) => (x1 >= rc.X AND y1 >= rc.Y AND x2 <= rc.X + rc.W AND y2 <= rc.Y + rc.H)

   /**
    * Make a group from a list of shapes and show its box
    */
   Static Select(SnipObj, shapeList) {
      ShapeSelect.Drop()   ; a group replaces the single selected shape
      this.Clear()
      this.SnipObj := SnipObj
      this.snipHwnd := SnipObj.hWnd   ; reading hWnd of a destroyed snip throws
      this.List    := shapeList
      this._resizePosted := false
      this._MakeGui()
      this.gui.Opt("+Owner" SnipObj.hWnd)
      focusBorder.HideFocus(true)
      this.Sync()
      SetTimer(this._timer, 200)
      ShapeBar.Update(SnipObj)
   }

   /**
    * Shift-click on a shape: add it to the group (starting a group if there is
    * none, or replacing one on another snip), or take it out if it is already in.
    * Taking out the last shape clears the group.
    * @param {GuiSnip} SnipObj - Snip the shape is on
    * @param {commonShape} ShapeObj - Shape that was clicked
    */
   Static Toggle(SnipObj, ShapeObj) {
      If NOT this._Selectable(ShapeObj)
         Return
      If (NOT this.Active OR this.SnipObj != SnipObj) {
         ; together with the selected shape, if there is one
         sel := ShapeSelect.Current
         this.Select(SnipObj, (sel AND sel.Gui = SnipObj AND sel != ShapeObj AND this._Selectable(sel)) ? [sel, ShapeObj] : [ShapeObj])
         Return
      }
      For idx, s in this.List {
         If (s = ShapeObj) {
            this.List.RemoveAt(idx)
            If (this.List.Length)
               this._Redraw()
            Else
               this.Clear()
            Return
         }
      }
      this.List.Push(ShapeObj)
      this._Redraw()
   }
   ; The group's shapes changed: redraw the box now
   Static _Redraw() {
      this._resizePosted := false
      this._lastKey := ""
      focusBorder.HideFocus(true)
      this.Sync()
      If (this.SnipObj)
         ShapeBar.Update(this.SnipObj)
   }

   /**
    * The shape of the group's snip at a screen point, looking through the box.
    * The box is made click-through (WS_EX_TRANSPARENT) for the hit test, so a
    * shape's transparent padding is skipped just as for a normal click.
    * @returns {commonShape|Integer} the shape, or 0
    */
   Static ShapeAt(x, y) {
      If NOT this.Active
         Return 0
      ex := WinGetExStyle(this.hWnd)
      WinSetExStyle("+0x20", this.hWnd)
      h := DllCall("WindowFromPoint", "Int64", (y << 32) | (x & 0xFFFFFFFF), "Ptr")
      If NOT (ex & 0x20)
         WinSetExStyle("-0x20", this.hWnd)
      ShapeObj := GuiCtrlFromHwnd(h) ?? 0
      Return (ShapeObj AND ShapeObj.HasProp("Shape") AND ShapeObj.Gui = this.SnipObj) ? ShapeObj : 0
   }

   /**
    * Drop the group and hide its box
    */
   Static Clear() {
      SetTimer(this._timer, 0)
      snip := this.SnipObj
      this.List    := []
      this.SnipObj := 0
      this._lastKey := ""
      this._Hide()
      ; The bar goes, or back to the draw mode (snipHwnd: hWnd of a closed snip throws)
      If (snip AND DllCall("IsWindow", "Ptr", this.snipHwnd))
         ShapeBar.Update(snip)
   }
   ; Hide the box and let go of the snip (an owned window dies with its owner)
   Static _Hide() {
      If NOT DllCall("IsWindow", "Ptr", this.hWnd)
         Return
      this.gui.Hide()
      this.gui.Opt("-Owner")
   }

   /**
    * Keep the box on the shapes: drops shapes that were closed (delete, undo),
    * clears the group when the snip is gone or minimized, and redraws the box
    * when the snip or any shape moved or changed size.
    */
   Static Sync() {
      If NOT this.Active
         Return
      snip := this.SnipObj
      If (NOT DllCall("IsWindow", "Ptr", this.snipHwnd) OR DllCall("IsIconic", "Ptr", this.snipHwnd)) {
         this.Clear()
         Return
      }
      keep := []
      For ShapeObj in this.List {
         Try {
            If (ShapeObj.Visible)
               keep.Push(ShapeObj)
         }
      }
      this.List := keep
      If NOT keep.Length {
         this.Clear()
         Return
      }
      snip.GetPos(&wX, &wY)
      If NOT (rc := this.Bounds(this.Margin))
         Return
      key := wX "," wY "," rc.X "," rc.Y "," rc.W "," rc.H
      If (key != this._lastKey) {
         this._Render(wX, wY, rc, true)
         this._lastKey := key
      }
      ShapeBar.SyncGroup()
   }

   /**
    * Union of the shapes' window rectangles (what they draw, padding included),
    * in snip window coordinates, grown by a margin and clipped to the snip.
    * @param {Integer} margin
    * @param {Array} list - shapes, default the group
    * @param {GuiSnip} snip - their snip
    * @returns {Object|Integer} {X, Y, W, H} or 0
    */
   Static Bounds(margin := 0, list := this.List, snip := this.SnipObj) {
      snip.GetPos(&wX, &wY, &wW, &wH)
      x1 := y1 := 1e9, x2 := y2 := -1e9
      For ShapeObj in list {
         WinGetRect(&sx, &sy, &sw, &sh, ShapeObj.hWnd)
         x1 := Min(x1, sx - wX), y1 := Min(y1, sy - wY)
         x2 := Max(x2, sx - wX + sw), y2 := Max(y2, sy - wY + sh)
      }
      x1 := Max(0, x1 - margin), y1 := Max(0, y1 - margin)
      x2 := Min(wW, x2 + margin), y2 := Min(wH, y2 + margin)
      If (x2 <= x1 OR y2 <= y1)
         Return 0
      Return { X: Round(x1), Y: Round(y1), W: Round(x2 - x1), H: Round(y2 - y1) }
   }

   /**
    * Drag inside the box: move every shape with the mouse. Text callout tips move
    * with their text. One undo step; nothing is posted if the mouse didn't move.
    */
   Static DragMove() {
      If NOT this.Active
         Return
      snip := this.SnipObj
      tag  := UnDo.NewTag("GroupMove")
      For ShapeObj in this.List
         ShapeObj.PostAction(UnDo.MOVE_SHAPE, tag)
      this._resizePosted := false
      CoordMode("Mouse", "Screen")
      MouseGetPos(&sX, &sY)
      starts := this._Starts()
      Cursor.SetCursorMode("Move")
      focusBorder.HideFocus(true)
      lastX := sX, lastY := sY, moved := false
      While GetKeyState("LButton", "P") {
         Sleep(10)
         MouseGetPos(&mX, &mY)
         If (mX = lastX AND mY = lastY)
            Continue
         this._MoveTo(starts, mX - sX, mY - sY)
         this.Sync()
         lastX := mX, lastY := mY, moved := true
      }
      Cursor.MoveResizeCursor := 0
      Cursor.SetCursor("Select")
      ; keep the snip active so its hotkeys (color keys, wheel, Del) still reach the group
      If (NOT WinActive(this.snipHwnd) AND DllCall("IsWindow", "Ptr", this.snipHwnd))
         WinActivate(this.snipHwnd)
      If NOT moved {
         ; a click without a drag: take back the undo entries
         Loop this.List.Length
            snip.UnDo.PopAction()
         Return
      }
      this._Changed()
   }

   /**
    * Delete every shape in the group (one undo step) and clear the group
    */
   Static Delete() {
      If NOT this.Active
         Return
      snip := this.SnipObj
      tag  := UnDo.NewTag("GroupDelete")
      For ShapeObj in this.List {
         ShapeObj.PostAction(UnDo.DELETE_SHAPE, tag)
         ShapeObj.Close(true)
      }
      this.Clear()
      If (Snips.UpdateClipboard) {
         snip.Snip2Clipboard(Snips.borderWithCopy)
         snip.flashBorder()
      }
   }

   /**
    * Color every shape that has a color (not pictures or blur/pixelate), one undo step
    * @param {Integer} color - RGB
    */
   Static SetColor(color) {
      If NOT this.Active
         Return
      tag := UnDo.NewTag("GroupColor")
      For ShapeObj in this.List {
         If NOT this._HasColor(ShapeObj)
            Continue
         ShapeObj.PostAction(UnDo.SHAPE_COLOR, tag)
         ShapeObj.Color := color
         ShapeObj.Refresh()
      }
      this._resizePosted := false
      this._Changed()
   }

   /**
    * A button bar default changed (ShapeStyles._DefaultPicked): apply it to the
    * shapes in the group it belongs to, one undo step. Opacities, outline type etc.
    * are set to the new value; thickness and blur/pixelate amounts are scaled by
    * new/old so sizes changed on a shape are kept. Other shapes are left alone.
    * @param {String} key - default name (ShapeStyles key)
    * @param {Any} old - previous default
    * @param {Any} new - new default
    * @returns {Integer} number of shapes changed
    */
   Static ApplyDefault(key, old, new) {
      If NOT this.Active
         Return 0
      old := IsNumber(old) ? Number(old) : old
      new := IsNumber(new) ? Number(new) : new
      tag := UnDo.NewTag("GroupStyle")
      n   := 0
      For ShapeObj in this.List {
         If NOT (t := ShapeObj.StyleTarget(key))
            Continue
         If NOT ShapeObj.StyleValue(t, old, new, &value)
            Continue
         ShapeObj.PostAction(UnDo.SHAPE_STYLE, tag)
         ShapeObj.SetStyle(t.Prop, value)
         ShapeObj.Refresh()
         n++
      }
      If (n) {
         this._resizePosted := false
         this._Changed()
      }
      Return n
   }

   /**
    * Up/Down/wheel: change each shape's thickness/size, as for a single focused
    * shape (line width, text font size, blur amount). The first change after a
    * selection or another group action posts one undo step for the whole run.
    * @param {Float} amt - fractional change (+0.02 = 2% bigger)
    */
   Static Thicken(amt) {
      If NOT this.Active
         Return
      If NOT this._resizePosted {
         tag := UnDo.NewTag("GroupSize")
         For ShapeObj in this.List
            ShapeObj.PostAction(UnDo.RESIZE_SHAPE, tag)
         this._resizePosted := true
      }
      For ShapeObj in this.List {
         ShapeObj.ChangeThickness(amt)
         ShapeObj.Refresh()
      }
      this.Sync()
      this.SnipObj.Dirty++
   }

   /**
    * Copy the group to the clipboard
    * @param {Integer} withPicture - true: the shapes over the snip picture under them
    *                                (as seen); false: only the shapes, transparent
    */
   Static CopyToClipboard(withPicture := true) {
      If this.Active
         this.CopyShapes(this.SnipObj, this.List, withPicture)
   }
   /**
    * Copy shapes to the clipboard
    * @param {GuiSnip} snip
    * @param {Array} list - shapes on it
    * @param {Integer} withPicture - as for CopyToClipboard
    */
   Static CopyShapes(snip, list, withPicture := true) {
      If NOT (rc := this.Bounds(0, list, snip))
         Return
      hBitmap := snip.RenderShapes(list, rc, withPicture)
      If ((res := Clipboard.SetHBITMAPToClipboard(hBitmap, , MonDPIunderWindow(snip.hWnd))) < 0)
         MsgBox("Failed To Set Clipboard Data: " res, "Clipboard", 0x30)
      Else
         snip.flashBorder()
   }

   /**
    * Right-click on the box
    */
   Static ShowMenu() {
      Static grpMenu := Menu()
      If NOT this.Active
         Return
      grpMenu.Delete()
      n := this.List.Length
      title := n " Shape" (n = 1 ? "" : "s")
      grpMenu.Add("Copy " title " to Clipboard (Ctrl-C)", (*) => this.CopyToClipboard(true))
      grpMenu.SetIcon("Copy " title " to Clipboard (Ctrl-C)", SETTINGS.CursorPath "Clipboard.ico")
      grpMenu.Add("Copy " title " Only (Transparent)", (*) => this.CopyToClipboard(false))
      grpMenu.SetIcon("Copy " title " Only (Transparent)", SETTINGS.CursorPath "Clipboard.ico")
      grpMenu.Add()
      grpMenu.Add("Delete " title " (Del)", (*) => this.Delete())
      grpMenu.SetIcon("Delete " title " (Del)", SETTINGS.CursorPath "Close.ico")
      ; Blocks here
      grpMenu.Show()
      grpMenu.Delete()
   }

   ;----------------------------------------------------------------------
   ; Helpers
   ;----------------------------------------------------------------------
   ; Start positions for a move (text callout tips move with their text)
   Static _Starts() {
      starts := []
      For ShapeObj in this.List {
         ShapeObj.GetPos(&X, &Y)
         tip := (ShapeObj.Source = "Text" AND ShapeObj.HasProp("Tip") AND IsObject(ShapeObj.Tip)) ? ShapeObj.Tip.Clone() : 0
         starts.Push({ X: X, Y: Y, Tip: tip })
      }
      Return starts
   }
   ; Place every shape at its start position plus dX, dY
   Static _MoveTo(starts, dX, dY) {
      For idx, ShapeObj in this.List {
         st := starts[idx]
         If (st.Tip)
            ShapeObj.Tip := { X: st.Tip.X + dX, Y: st.Tip.Y + dY }
         ShapeObj.Move(st.X + dX, st.Y + dY)
      }
   }
   Static _Selectable(ShapeObj) {
      Switch ShapeObj.Source {
         Case "File", "Clip", "BlurShape", "BodyShape", "LineShape", "FreeHand", "Text":
            Return true
      }
      Return false
   }
   ; Same rule as the single shape menu: pictures and blur/pixelate have no color, and
   ; redact takes its color from the picture on every redraw
   Static _HasColor(ShapeObj) {
      Switch ShapeObj.Source {
         Case "BlurShape", "BodyShape", "LineShape", "FreeHand", "Text":
            Switch ShapeObj.Shape {
               Case Shapes.SHAPE_PIXELATE, Shapes.SHAPE_BLUR, Shapes.SHAPE_GAUS_BLUR, Shapes.SHAPE_SMUDGE, Shapes.SHAPE_REDAC:
                  Return false
            }
            Return true
      }
      Return false
   }
   ; After a move/color change: redraw the box, mark the snip, auto clipboard
   Static _Changed() {
      snip := this.SnipObj
      this.Sync()
      snip.Dirty++
      If (Snips.UpdateClipboard) {
         snip.Snip2Clipboard(Snips.borderWithCopy)
         snip.flashBorder()
      }
   }

   /**
    * Draw the box (dashed black/white like the focus rectangle) over a faint tint.
    * The tint is what makes the box catch clicks (fully transparent pixels of a
    * layered window are click-through).
    * @param {Number} wX - snip window screen X
    * @param {Number} wY - snip window screen Y
    * @param {Object} rc - {X, Y, W, H} in snip window coordinates
    */
   Static _Render(wX, wY, rc, isGroup := false) {
      bw := focusBorder.BW
      dW := Max(Round(rc.W), 2), dH := Max(Round(rc.H), 2)
      Surf := DIBSurface(dW, dH, this.hWnd)
      Surf.GraphicsClear(isGroup ? 0x283C78D8 : 0x203C78D8)
      pen := GDIp.CreatePen(0xFF000000, bw)
      GDIp.DrawRectangle(Surf.G, pen, bw / 2, bw / 2, dW - bw, dH - bw)
      GDIp.SetPenColor(pen, 0xFFFFFFFF)
      dash := Cursor.ResizeBox / 4
      GDIp.SetPenDashArray(pen, [dash, dash])
      GDIp.DrawRectangle(Surf.G, pen, bw / 2, bw / 2, dW - bw, dH - bw)
      GDIp.DeletePen(pen)
      sX := Round(wX + rc.X), sY := Round(wY + rc.Y)
      ; The first Show sizes and centres the window itself, so give it the box first
      If NOT IsWindowVisible(this.hWnd) {
         this.gui.Show(Format("NA x{} y{} w{} h{}", sX, sY, dW, dH))
         ; above the (topmost) snip: HWND_TOPMOST, SWP_NOMOVE|NOSIZE|NOACTIVATE
         DllCall("SetWindowPos", "Ptr", this.hWnd, "Ptr", -1, "Int", 0, "Int", 0, "Int", 0, "Int", 0, "UInt", 0x13)
      }
      Surf.UpdateLayer(sX, sY)
      Surf := ""
   }
}
logGDI(BFN(Error("", -1).File) " loaded...")
