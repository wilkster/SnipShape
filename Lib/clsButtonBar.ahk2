/************************************************************************
 * @description ButtonBar Class for SnipShape
 * @file clsButtonBar.ahk2
 * @author Tom Wilkason
 * @date 2024/04/19
 * @version 1.0.0
 ***********************************************************************/
#Requires AutoHotkey v2.1-
#include clsDrawnBar.ahk2
#include Settings.ahk2
#include libMisc.ahk2
#include clsGDIp.ahk2
#include Theming.ahk2
#include clsShapes.ahk2
#include clsSnips.ahk2
#include ColorPopDown.ahk2
#include clsShapeBar.ahk2
#include clsStickyBar.ahk2
/*
 * Button Bar (toolbar) to pick shapes and act on the snip.
 * Lives beside the active snip if it is enabled: vertical to the left of its top left
 * corner, or horizontal above it ([User Button Bar] Orientation in the settings file).
 *
 * Drawn with GDI+ on one layered window (DrawnBar), with a cell per button instead of
 * button controls. Shape category buttons open their shape menu when pressed (right click:
 * the category's defaults); the others act when released over them. Undo/Redo are greyed
 * out with nothing to undo/redo; the pin button shows the snip's pin state.
 * It never takes the focus, like the shape bar: the snip stays active, so using the toolbar
 * doesn't end the drawing tool, and Esc goes to the snip. Its menus are shown with
 * DrawnBar._GuardedMenu (the snip ignores the menu's activation), and a shape picked from a
 * menu takes effect at once. The old button controls couldn't do this: native buttons take
 * the focus when clicked even in a WS_EX_NOACTIVATE window (tested for the shape bar).
 * The button images and the shape menu icons are loaded when first drawn or shown, and
 * freed when the last snip closes (Release).
*/
Class ButtonBar extends DrawnBar {
   Static DPIFactor  := activeDPIFactor()
   Static Margin     := round(2.5 * this.DPIFactor)
   ; NOTE - we are not adjusting this dynamically for multiple monitors
   Static ButSize    := this.DPIFactor >= 1.5 ? 32 : 16 ; size of a shape category button
   Static shapeQueue := 0
   Static lastShape  := 0
   Static bbGui      := 0       ; the window (Gui); other code reads bbGui.hWnd
   Static Pinned     := 1       ; pin button state (SyncPin)
   Static _pressed   := 0       ; index of the cell being pressed
   Static _shapeIcons := 0      ; ImageList of the shape menu icons, made when first needed
   /**
    * Read the settings, make the window and lay out the buttons
    */
   Static __New() {
      logGDI("Building ButtonBar")
      this.Enabled  := IniReadValue("Button Bar", "Enabled", 1)
      ; For now, this is not run-time adjustable just read from the settings file
      this.FontSize := IniReadValue("User Button Bar", "Font Size", 8)
      ; Vertical (left of the snip) or Horizontal (above it)
      this.Vertical := (IniReadValue("User Button Bar", "Orientation", "Vertical") != "Horizontal")
      this.Scale    := this.DPIFactor
      this.SnipObj  := 0
      ; It never takes the focus (a deactivated snip leaves its draw mode)
      this._InitBar(true)
      this.bbGui := this.gui
      this.MenuShapes := Menu()
      this._Layout()
      this.bbWidth  := this.BarW
      this.bbHeight := this.BarH
      logGDI("ButtonBar Complete")
   }
   /**
    * The buttons, in order along the bar, each after a gap. Sizes as the old controls:
    * cH from the font size; categories ButSize; copy/save smaller; undo/redo/pin a bit
    * smaller. Narrower buttons are centred across the bar.
    */
   Static _Layout() {
      cH := round(this.FontSize * this.DPIFactor / 0.3)
      bs := this.ButSize := round(cH - 4 * this.DPIFactor)
      o  := Round(2 * this.DPIFactor)   ; spacing
      cells := []
      cells.Push({ Gap: this.Margin * 3, Size: cH, File: "Close.ico", Tip: "Close Active Snip (Esc)", Action: this.CloseSnip.Bind(this) })
      for cat in ["Arrows", "Shapes", "Free Hand", "Highlighters", "Redact", "Text", "Tool"] {
         ; Picture shapes (stickies) between Text and Tool
         If (cat = "Tool") {
            cells.Push(sticky := { Gap: o, Size: bs, File: "Shapes.ico", Tip: "Picture Shapes" })
            sticky.Action := StickyBar.Toggle.Bind(StickyBar, sticky)
         }
         cells.Push({ Gap: o, Size: bs, Image: SETTINGS.CursorPath . "Menu\" . cat . ".png", Tip: cat " Menu"
            , Kind: "Menu", Cat: cat, Sub: Shapes.ShapeCat[cat] })
      }
      padded := round(cH * .7)
      cells.Push({ Gap: o * 3, Size: padded, File: "Clipboard.ico", Tip: "Clipboard Snip (Ctrl-C)", Action: this.ClipSnip.Bind(this) })
      cells.Push({ Gap: o, Size: padded, File: "SaveAs.ico", Tip: "Save Snip to file (Ctrl-S)", Action: this.SaveSnip.Bind(this) })
      cells.Push(this._undo := { Gap: o * 3, Size: round(cH * .8), File: "Undo.ico", Tip: "Undo (Ctrl-Z)", Action: this.Undo.Bind(this), Disabled: true })
      cells.Push(this._redo := { Gap: o, Size: round(cH * .8), File: "Redo.ico", Tip: "Redo (Ctrl-Y)", Action: this.Redo.Bind(this), Disabled: true })
      cells.Push(this._pin  := { Gap: o * 3, Size: round(cH * .8), File: "Pin.ico", Tip: "Pin or Unpin Snip", Action: this.TogglePin.Bind(this) })
      cells.Push({ Gap: o, Size: cH, File: "Minimize.ico", Tip: "Minimize Active Snip (⌄)", Action: this.MinimizeSnip.Bind(this) })
      pos := this.Margin
      For cell in cells {
         If NOT cell.HasOwnProp("Kind")
            cell.Kind := "Button"
         If NOT cell.HasOwnProp("Disabled")
            cell.Disabled := false
         pos += cell.Gap
         cross := this.Margin + (cH - cell.Size) // 2
         If (this.Vertical)
            cell.X := cross, cell.Y := pos
         Else
            cell.X := pos, cell.Y := cross
         cell.W := cell.H := cell.Size
         pos += cell.Size
      }
      this.Items := cells
      If (this.Vertical)
         this.BarW := 2 * this.Margin + cH, this.BarH := pos + this.Margin
      Else
         this.BarW := pos + this.Margin, this.BarH := 2 * this.Margin + cH
   }

   ;----------------------------------------------------------------------
   ; Mouse
   ;----------------------------------------------------------------------
   /**
    * Left button pressed on the bar (Snips.WM_LBUTTONDOWN). A category button opens its
    * shape menu at once; another button acts when the button is released over it; the
    * background drags the bar.
    */
   Static Click() {
      If NOT (idx := this._MouseItem(&x, &y)) {
         this._DragBar()
         Return
      }
      cell := this.Items[idx]
      If (cell.Disabled)
         Return
      this._pressed := idx
      this.Redraw()
      If (cell.Kind = "Menu") {
         ; leave the button message first, as before
         SetTimer(this._OpenMenu.Bind(this, idx), -10)
         Return
      }
      While GetKeyState("LButton", "P")
         Sleep(10)
      over := (this._MouseItem(&x, &y) = idx)
      this._pressed := 0
      this.Redraw()
      If (over)
         SetTimer(cell.Action, -10)
   }
   ; Shape menu of a category button; the snip keeps its draw mode while it is open
   Static _OpenMenu(idx) {
      Try
         this._GuardedMenu(this.SnipObj, () => this.PostShapeMenu(this.Items[idx].Sub))
      Finally {
         this._pressed := 0
         this.Redraw()
      }
   }
   ; Right click on a category button: the defaults of the category (Shapes._cmdRMBHandler)
   Static RightClick() {
      If ((idx := this._MouseItem(&x, &y)) AND (cell := this.Items[idx]).Kind = "Menu")
         this._GuardedMenu(this.SnipObj, () => Shapes._cmdRMBHandler(cell.Cat, "lButton", 0, 0, 0, 0, 0))
   }
   ; Tooltips clear of the bar: beside a vertical one, below a horizontal one
   Static _TipPos(item) {
      WinGetPos(&wX, &wY,,, this.hWnd)
      If (this.Vertical)
         Return { X: wX + this.BarW + 2, Y: wY + item.Y }
      Return { X: wX + item.X, Y: wY + this.BarH + 2 }
   }

   ;----------------------------------------------------------------------
   ; Drawing
   ;----------------------------------------------------------------------
   /**
    * Draw the bar: background, a highlight under the mouse or the pressed button (moved a
    * pixel when pressed), each button's image (faded when disabled)
    * @returns {DIBSurface}
    */
   Static Draw() {
      Surf := DIBSurface(this.BarW, this.BarH, this.hWnd)
      G    := Surf.G
      Surf.GraphicsClear(0)
      this._DrawBack(G, this._Px(6))
      brush := GDIp.BrushCreateSolid(this.Colors.Hover)
      For idx, cell in this.Items {
         pressed := (idx = this._pressed)
         If (NOT cell.Disabled AND (pressed OR idx = this._hover))
            GDIp.FillRoundedRectangle(G, brush, cell.X, cell.Y, cell.W, cell.H, cell.H / 8)
         off := pressed ? 1 : 0
         If (cell.HasOwnProp("Image")) {
            If (pB := this._Image(cell.Image))
               GDIp.DrawImageRect(G, pB, cell.X + off, cell.Y + off, cell.W, cell.H)
         } Else {
            file := (cell = this._pin) ? (this.Pinned ? "Pin.ico" : "UnPin.ico") : cell.File
            this._DrawIcon(Surf, this._Icon(file, cell.W), cell.X + off, cell.Y + off, cell.W, cell.Disabled ? 70 : 255)
         }
      }
      GDIp.DeleteBrush(brush)
      Return Surf
   }
   /**
    * Icon of a shape for menus and the shape bar, e.g. "Arrow (V)": a copy the caller owns
    * (a menu's "HICON:" takes it). The image list of all of them is made when first asked.
    * @returns {Ptr} HICON, 0 if there is none
    */
   Static ShapeIcon(name) {
      If NOT this._shapeIcons {
         this._shapeIcons := ImageList()
         this._shapeIcons.Size := this.ButSize
         For cat in ["Arrows", "Shapes", "Free Hand", "Highlighters", "Redact", "Text", "Tool"] {
            For sb in Shapes.ShapeCat[cat] {
               sna      := StrSplit(sb, "-")
               baseName := Trim(sna[1])
               fileName := SETTINGS.CursorPath . baseName ".cur"
               If (FileExist(fileName))
                  this._shapeIcons[baseName . " (" . Trim(sna[2]) . ")"] := fileName
               Else
                  warning("Could not find file:" fileName)
            }
         }
      }
      Return this._shapeIcons[name]
   }
   /**
    * Free the button images and shape icons (the last snip closed). The window stays
    * (one window, no controls); they load again when next drawn.
    */
   Static Release() {
      this.ReleaseIcons()   ; icons and the category pictures
      this._shapeIcons := 0   ; ImageList.__Delete destroys the list
   }

   ;----------------------------------------------------------------------
   ; Shape menus
   ;----------------------------------------------------------------------
   /**
    * Build and display the shape selection popup menu for a shape category button
    * @param {Array} SubButtons - Array of "CursorName - HotkeyChar" strings defining the menu entries
    */
   Static PostShapeMenu(SubButtons) {
      this.MenuShapes.Delete()
      For Button in SubButtons {
         sna      := StrSplit(Button, "-")
         baseName := Trim(sna[1])
         key      := Trim(sna[2])
         bn       := baseName . " (" . key . ")"
         this.MenuShapes.Add(bn, this._cmdHandler.bind(this, baseName, key))
         If (icon := this.ShapeIcon(bn))
            this.MenuShapes.SetIcon(bn, "HICON:" icon, , 0)
      }
      this.MenuShapes.Show()
      ; Blocks here
      this.MenuShapes.Delete()
   }

   /**
    * Handle a shape button click by queuing the selected shape name,
    * updating lastShape, and briefly showing a tooltip confirmation
    * @param {String} btn - Base name of the selected shape (cursor filename without extension)
    * @param {String} key - Hotkey character associated with the shape
    * @param {Object} ctl - Control that was clicked (unused)
    * @param {Integer} info - Additional event info (unused)
    */
   Static _cmdHandler(btn, key, ctl, info, *) {
      this.shapeQueue := btn
      this.lastShape := btn
      ToolTip
      ToolTip(btn " shape pressed (" key ")")
      SetTimer(ToolTip, -2000)
      ; The snip is still active (the toolbar doesn't take the focus): use the shape now
      ; rather than when the mouse is next over the snip (Cursor.WM_SETCURSOR)
      SetTimer(this._ApplyQueued.Bind(this), -1)
   }
   /**
    * Set the queued shape as the draw mode of the toolbar's snip, if it is still there
    */
   Static _ApplyQueued() {
      If NOT (this.shapeQueue AND this.SnipObj)
         Return
      hwnd := 0
      Try hwnd := this.SnipObj.hWnd   ; a destroyed snip's hWnd throws
      If NOT (hwnd AND Snips.IsValid(hwnd))
         Return
      If (idx := Shapes.NameToNumber(this.GetQueuedCommand()))
         Snips.SetDrawMode(idx, hwnd)
   }

   /**
    * Consume and return the pending queued shape command, clearing the queue
    * @returns {String|Integer} The queued shape name, or 0 if the queue is empty
    */
   Static GetQueuedCommand() {
      cmd := this.shapeQueue
      this.shapeQueue := 0
      return cmd
   }

   ;----------------------------------------------------------------------
   ; Show / hide
   ;----------------------------------------------------------------------
   /**
    * Position and show the button bar beside the specified snip window (see BarPos).
    * Optionally overrides the enabled state before showing.
    * @param {Integer} [hWnd=0] - Window handle of the target snip; defaults to the active SnipShapeWindow
    * @param {Integer} [Enable] - If provided, sets the Enabled state before deciding whether to show
    * @param {Integer} [X] - Override X screen coordinate (used during live drag via WM_MOVING)
    * @param {Integer} [Y] - Override Y screen coordinate (used during live drag via WM_MOVING)
    */
   Static Show(hWnd := 0, Enable?, X?, Y?) {
      If (IsSet(Enable))
         this.Enabled := Enable
      If (this.Enabled) {
         If (hWnd OR (hWnd := WinActive("SnipShapeWindow"))) {
            ; Snip location, dragging will set these more accuratly
            If (IsSet(X) AND IsSet(Y))
               sX := X, sY := Y
            Else
               WinGetPos(&sX, &sY,,, hWnd)
            WinGetPos(,, &sW,, hWnd)
            ; Keep it visible on monitor containing snip
            pos := this.BarPos(sX, sY, sW, windowMonArea(hWnd))
            this._Render(pos.X, pos.Y, true)
            ; The shape bar goes along if the snip is in a draw mode
            If (SnipObj := Snips.IsValid(hWnd)) {
               ShapeBar.Update(SnipObj, sX, sY)
            }
         } Else {
            dlog("No Snip Active when expected")
         }
      }
   }
   /**
    * Where the bar goes for a snip.
    * Horizontal: above the snip, from its left edge. Vertical: to the left of the snip,
    * from its top edge; with no room on the left it goes on the right, and with no room
    * on either side it covers the snip's left edge. Kept inside the monitor's work area.
    * @param {Integer} sX - snip window screen X
    * @param {Integer} sY - snip window screen Y
    * @param {Integer} sW - snip window width
    * @param {Object} Mon - {X, Y, X2, Y2} work area of the snip's monitor
    * @returns {Object} {X, Y}
    */
   Static BarPos(sX, sY, sW, Mon) {
      If NOT this.Vertical
         Return { X: Max(sX, Mon.X), Y: Max(sY - this.bbHeight, Mon.Y) }
      X := sX - this.bbWidth
      If (X < Mon.X)
         X := (sX + sW + this.bbWidth <= Mon.X2) ? sX + sW : Mon.X
      ; A short snip near the bottom: move the bar up until it fits
      Y := Max(Min(sY, Mon.Y2 - this.bbHeight), Mon.Y)
      Return { X: X, Y: Y }
   }
   /**
    * Hide the button bar and optionally change its enabled state
    * @param {Integer} [enabled] - If provided, sets the Enabled state; pass 0 to disable, 1 to keep enabled
    */
   Static Hide(enabled?, *) {
      if (IsSet(enabled))
         this.Enabled := enabled
      SetTimer(this._hoverTimer, 0)
      this._hover   := 0
      this._pressed := 0
      this.gui.Hide()
      ShapeBar.Hide()
      StickyBar.Hide()
      ToolTip
   }

   ;----------------------------------------------------------------------
   ; Button actions
   ;----------------------------------------------------------------------
   Static Undo(*) {
      If (hWnd := this.SnipObj.hWnd) {
         Snips.UndoAction(hWnd)
      }
   }
   Static Redo(*) {
      If (hWnd := this.SnipObj.hWnd) {
         Snips.RedoAction(hWnd)
      }
   }
   /**
    * Save the active snip to a file
    */
   Static SaveSnip(*) {
      If (SnipObj := this.SnipObj) {
         Tooltip ; don't capture the tooltip!
         SnipObj.Snip2File(Settings.SavePath_Image, Snips.borderWithSave)
         SnipObj.flashBorder()
      }
   }
    /**
    * Clipboard the active snip
    */
   Static ClipSnip(*) {
      If (SnipObj := this.SnipObj) {
         Tooltip ; don't capture the tooltip!
         SnipObj.Snip2Clipboard(Snips.borderWithCopy)
         SnipObj.flashBorder()
      }
   }
   /**
    * Minimize the foremost SnipShapeWindow via Snips.Minimize
    */
   Static MinimizeSnip(*) {
      If (SnipObj := this.SnipObj) {
         SnipObj.Minimize()
      }
   }
   /**
    * Pin or UnPin the image on top
    */
   Static TogglePin(*) {
      If (SnipObj := this.SnipObj) {
         If (WinGetAlwaysOnTop(SnipObj.hWnd)) {
            SnipObj.Opt("-AlwaysOnTop")
         } Else {
            SnipObj.Opt("+AlwaysOnTop")
         }
         this.SyncPin(SnipObj.hwnd)
      }
   }
   /**
    * Sync the pin button to the window state (and the undo/redo buttons)
    */
   Static SyncPin(hWnd) {
      If (this.SyncUndoRedo()) {
         state := WinGetAlwaysOnTop(hWnd) ? 1 : 0
         If (state != this.Pinned) {
            this.Pinned := state
            this.Redraw()
         }
      }
   }
   /**
    * Sync undo/redo buttons to their stack length
    * @returns {Integer} true if the bar's snip has an undo history
    */
   Static SyncUndoRedo(*) {
      ; SnipObj may be a snip that was just closed (Snips.Close unsets its UnDo):
      ; only query a live undo history
      If (this.SnipObj is GuiSnip AND this.SnipObj.HasOwnProp("UnDo") AND IsObject(this.SnipObj.UnDo)) {
         noUndo := (this.SnipObj.UnDo.undoStack.length = 0)
         noRedo := (this.SnipObj.UnDo.redoStack.length = 0)
         If (noUndo != this._undo.Disabled OR noRedo != this._redo.Disabled) {
            this._undo.Disabled := noUndo
            this._redo.Disabled := noRedo
            this.Redraw()
         }
         return true
      }
      return false
   }
   /**
    * Close the foremost SnipShapeWindow and activate the next available snip
    */
   Static CloseSnip(*) {
      If (SnipObj := this.SnipObj) {
         Snips.Close(SnipObj, 0)
         Snips.ActivateFirst()
      } Else {
         dlog("No Snip Window Found")
      }
   }
}
logGDI(BFN(Error("", -1).File) " loaded...")
