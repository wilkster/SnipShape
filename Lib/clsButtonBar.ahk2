/************************************************************************
 * @description ButtonBar Class for SnipShape
 * @file clsButtonBar.ahk2
 * @author Tom Wilkason
 * @date 2024/04/19
 * @version 1.0.0
 ***********************************************************************/
#Requires AutoHotkey v2.1-
#include Settings.ahk2
#include libMisc.ahk2
#include clsGDIp.ahk2
#include Theming.ahk2
#include clsShapes.ahk2
#include clsSnips.ahk2
#include ColorPopDown.ahk2
#include clsShapeBar.ahk2
/*
 * Button Bar Class to show buttons and select shapes, colors and such
 * Lives beside the active snip if it is enabled: vertical to the left of its top left
 * corner, or horizontal above it ([User Button Bar] Orientation in the settings file).
*/
Class ButtonBar {
   Static DPIFactor  := activeDPIFactor()
   Static Margin     := round(2.5 * this.DPIFactor)
   ; NOTE - we are not adjusting this dynamically for multiple monitors
   Static ButSize    := this.DPIFactor >= 1.5 ? 32 : 16 ; Raw size of cursor, may have to use 16 for low DPI
   Static shapeQueue := 0
   Static buttonTips := Map()
   Static buttonCallbacks := Map()

   Static bbGUI      := 0
   Static lastShape  := 0
   ;                      Arrows   Blocks  Pen  HL   Erase    C/E  Text
   Static buttonGaps     := [6,2,2,2, 6,2,2,2, 6,2, 6,2, 6,2,2,2, 6,2, 6,2,2, 2,2,2,2,2]
   Static BS_ICON        := 0x40
   Static BS_BITMAP      := 0x80
   /**
    * Initialize the button bar GUI, build all shape and color buttons,
    * read settings, and measure the bar height for later positioning
    */
   Static __New() {
      logGDI("Building ButtonBar")
      ; 0x08000000 not foreground
      this.Enabled         := IniReadValue("Button Bar", "Enabled", 1)
      ; For now, this is not run-time adjustable just read from the settings file
      this.FontSize        := IniReadValue("User Button Bar", "Font Size", 8)
      ; Vertical (left of the snip) or Horizontal (above it)
      this.Vertical        := (IniReadValue("User Button Bar", "Orientation", "Vertical") != "Horizontal")
      this.bbGui           := Gui("+AlwaysOnTop +Border +ToolWindow -Caption -DPIScale")
      this.bbGui.MarginY   := this.Margin
      this.bbGui.MarginX   := this.Margin
      this.bbGui.BackColor := MenuBackColor()   ; same as the shape bar and color popup
      this.bbWidth         := 0
      this.bbHeight        := 0
      this.SnipObj         := 0
      ; Force rounded corners on windows 11 since we don't have a caption - we do manually later for windows 10
      win11RoundCorners(this.bbGUI.hwnd, 3)
      ; Setting the font size sets the button size as well, later we re-read the button size for this DPI
      this.bbGui.SetFont("S" this.FontSize " bold", "Verdana")
      ; Close snip button
      cH := round(this.FontSize * this.DPIFactor / 0.36)  ; Initial guess, no margin
      ; TODO - have a space but would like a grabber
      b := this.AddBarButton(this._Next(this.Margin * 3), Settings.CursorPath . "Close.ico", cH, "Close Active Snip (Esc)", this.CloseSnip.Bind(this))
      b.GetPos(,,,&cH)
      ; Cursors need to zoom in a bit, remove some margin
      bs := this.ButSize := round(cH - 4 * this.DPIFactor)

      ; First button tells us what hull size to use, leave a small margin for cursors
      this.shapeIconsObj := ImageList()
      this.shapeIconsObj.Size := this.ButSize

      this.MenuShapes := Menu()
      o := Round(2 * activeDPIFactor()) ; spacing
      logGDI("Building Shape Buttons")
      for cat in ["Arrows", "Shapes", "Free Hand", "Highlighters", "Redact", "Text", "Tool"]
         this.BuildShapeButtons(cat, Shapes.ShapeCat[cat], o)

      logGDI("Built Shape Buttons")
      padded := round(cH*.7)
      b := this.AddBarButton(this._Next(o * 3), Settings.CursorPath . "Clipboard.ico", padded, "Clipboard Snip (Ctrl-C)", this.ClipSnip.Bind(this, 0))
      b := this.AddBarButton(this._Next(o),     Settings.CursorPath . "SaveAs.ico", padded, "Save Snip to file (Ctrl-S)", this.SaveSnip.Bind(this, 0))

      this.btnUndo := this.AddBarButton(this._Next(o * 3), Settings.CursorPath . "Undo.ico", round(cH*.8), "Undo (Ctrl-Z)", this.Undo.Bind(this, 0))
      this.btnRedo := this.AddBarButton(this._Next(o), Settings.CursorPath . "Redo.ico", round(cH*.8), "Redo (Ctrl-Y)", this.Redo.Bind(this, 0))
      this.btnUndo.enabled := false
      this.btnRedo.enabled := false

      this.pinButton := this.AddBarButton(this._Next(o * 3), Settings.CursorPath . "Pin.ico", round(cH*.8), "Pin or Unpin Snip", this.TogglePin.Bind(this, 0))
      this.pinButton.Pinned := 1

      b := this.AddBarButton(this._Next(o), Settings.CursorPath . "Minimize.ico", cH, "Minimize Active Snip (⌄)", this.MinimizeSnip.Bind(this, 0))
      logGDI("Built Snip Buttons")
      ; Also handle Escape
      this.bbGui.OnEvent("Escape", this.CloseSnip.bind(this))
      ; this.buttonTips[b.hWnd] := "Close Active Snip (Esc)"
      logGDI("Built Close Buttons")
      ; Save the size for positioning on Show
      logGDI("GUI Show complete")
      this.bbgui.Show("NA Hide")
      this.bbgui.GetPos(,,&bbW, &bbH)
      this.bbWidth  := bbW
      this.bbHeight := bbH
      ; Windows 10 round the corners (not needed with backcolor)
      win10RoundCorners(this.bbgui.hWnd, this.DPIFactor)

      this.bbgui.Hide()
      logGDI("ButtonBar Complete")

   }
   /**
    * Control options that place the next button after the last one
    * @param {Integer} gap - space before it (px)
    * @returns {String}
    */
   Static _Next(gap) => this.Vertical ? "X" this.Margin " Y+" gap : "Y" this.Margin " X+" gap
   /**
    * Helper routine to add a pic button
    * @param opts control options
    * @param icon icon to show in the button
    * @param wh width/height of the button
    * @param tip tooltip to show for the button
    * @param onClick optional event to call when button is clicked
    * @param onPress optional event to call when button is pressed
    * @returns {unset} 
    */
   Static AddBarButton(opts, icon, wh := 16, tip := "", onClick?, onPress?) {
      b := this.bbGUI.AddPicButton(opts, icon, "W" wh " H" wh)
      b.SetFlat(MenuBackColor(), MenuHoverColor(), wh)
      this.buttonTips[b.hWnd] := tip
      If IsSet(onClick)
         b.OnEvent("Click", onClick)
      If IsSet(onPress)
         this.buttonCallbacks[b.hWnd] := onPress

      Return b
   }

   /**
    * Build a shape category button on the bar and cache all of its cursor icons into the shared ImageList.
    * Also registers a right-click handler on the button for shape settings.
    * @param {String} Button - Shape category name used as the button icon filename and menu label
    * @param {Array} SubButtons - Array of "CursorName - HotkeyChar" strings defining the submenu entries
    * @param {Integer} [pad=3] - Horizontal pixel padding to insert before this button
    */
   Static BuildShapeButtons(Button, SubButtons, pad:=3) {
      fileName := SETTINGS.CursorPath . "Menu\" . Button . ".png"

      b := this.AddBarButton(this._Next(pad), fileName, this.ButSize, Button . " Menu", , this.PostShapeMenu.Bind(this, SubButtons))
      ; RMB menu for settings
      b.OnEvent("contextMenu", Shapes._cmdRMBHandler.bind(Shapes, Button, "lButton"))
      ; Cache the cursor images into an imagelist for reuse and less GDI resources.
      For sb in SubButtons {
         sna      := StrSplit(sb, "-")
         baseName := Trim(sna[1])
         key      := Trim(sna[2])
         fileName := SETTINGS.CursorPath . baseName ".cur"
         If (FileExist(fileName)) {
            butName := baseName . " (" . key . ")"
            this.shapeIconsObj[butName] := fileName  ; Load into image list          
         } Else
            MsgBox("Could not find file:" fileName)
      }
      ; logGDI("  Built " Button)
   }
   /**
    * Build and display the shape selection popup menu for a shape category button,
    * populating it with cursor icons from the shared ImageList
    * @param {Array} SubButtons - Array of "CursorName - HotkeyChar" strings defining the menu entries
    */
   Static PostShapeMenu(SubButtons) {
      this.MenuShapes.Delete()
      For Button in SubButtons {
         sna      := StrSplit(Button, "-")
         baseName := Trim(sna[1])
         key      := Trim(sna[2])
         bn       := baseName . " (" . key . ")"
         this.MenuShapes.Add(bn, this._cmdHandler.bind(this, baseName, key))
         this.MenuShapes.SetIcon(bn, "HICON:" this.shapeIconsObj[bn], , 0)
      }
      this.MenuShapes.Show()
      ; Blocks here
      this.MenuShapes.Delete()
   }

   /**
    * Handle a shape button click by queuing the selected shape name,
    * updating lastShape, and briefly showing a tooltip confirmation
    * @param {String} btn - Base name of the selected shape (cursor filename without extension)
    * @param {String} key - Hotkey character associated with the shape
    * @param {Object} ctl - Control that was clicked (unused)
    * @param {Integer} info - Additional event info (unused)
    */
   Static _cmdHandler(btn, key, ctl, info, *) {
      this.shapeQueue := btn
      this.lastShape := btn
      ToolTip
      ToolTip(btn " shape pressed (" key ")")
      SetTimer(ToolTip, -2000)
   }

   /**
    * Consume and return the pending queued shape command, clearing the queue
    * @returns {String|Integer} The queued shape name, or 0 if the queue is empty
    */
   Static GetQueuedCommand() {
      cmd := this.shapeQueue
      this.shapeQueue := 0
      return cmd
   }

   /**
    * Position and show the button bar beside the specified snip window (see BarPos).
    * Optionally overrides the enabled state before showing.
    * @param {Integer} [hWnd=0] - Window handle of the target snip; defaults to the active SnipShapeWindow
    * @param {Integer} [Enable] - If provided, sets the Enabled state before deciding whether to show
    * @param {Integer} [X] - Override X screen coordinate (used during live drag via WM_MOVING)
    * @param {Integer} [Y] - Override Y screen coordinate (used during live drag via WM_MOVING)
    */
   Static Show(hWnd := 0, Enable?, X?, Y?) {
      If (IsSet(Enable))
         this.Enabled := Enable
      If (this.Enabled) {
         If (hWnd OR (hWnd := WinActive("SnipShapeWindow"))) {
            ; Snip location, dragging will set these more accuratly
            If (IsSet(X) AND IsSet(Y))
               sX := X, sY := Y
            Else
               WinGetPos(&sX, &sY,,, hWnd)
            WinGetPos(,, &sW,, hWnd)
            ; Keep it visible on monitor containing snip
            pos := this.BarPos(sX, sY, sW, windowMonArea(hWnd))
            this.bbgui.Show("NA Y" pos.Y " X" pos.X)
            ; The shape bar goes along if the snip is in a draw mode
            If (SnipObj := Snips.IsValid(hWnd)) {
               ShapeBar.Update(SnipObj, sX, sY)
            }
         } Else {
            dlog("No Snip Active when expected")
         }
      }
   }
   /**
    * Where the bar goes for a snip.
    * Horizontal: above the snip, from its left edge. Vertical: to the left of the snip,
    * from its top edge; with no room on the left it goes on the right, and with no room
    * on either side it covers the snip's left edge. Kept inside the monitor's work area.
    * @param {Integer} sX - snip window screen X
    * @param {Integer} sY - snip window screen Y
    * @param {Integer} sW - snip window width
    * @param {Object} Mon - {X, Y, X2, Y2} work area of the snip's monitor
    * @returns {Object} {X, Y}
    */
   Static BarPos(sX, sY, sW, Mon) {
      If NOT this.Vertical
         Return { X: Max(sX, Mon.X), Y: Max(sY - this.bbHeight, Mon.Y) }
      X := sX - this.bbWidth
      If (X < Mon.X)
         X := (sX + sW + this.bbWidth <= Mon.X2) ? sX + sW : Mon.X
      ; A short snip near the bottom: move the bar up until it fits
      Y := Max(Min(sY, Mon.Y2 - this.bbHeight), Mon.Y)
      Return { X: X, Y: Y }
   }
   /**
    * Hide the button bar and optionally change its enabled state
    * @param {Integer} [enabled] - If provided, sets the Enabled state; pass 0 to disable, 1 to keep enabled
    */
   Static Hide(enabled?, *) {
      if (IsSet(enabled))
         this.Enabled := enabled
      this.bbgui.Hide()
      ShapeBar.Hide()
      ToolTip
   }
   Static Undo(*) {
      If (hWnd := this.SnipObj.hWnd) {
         Snips.UndoAction(hWnd)
      }
   }
   Static Redo(*) {
      If (hWnd := this.SnipObj.hWnd) {
         Snips.RedoAction(hWnd)
      }
   }
   /**
    * Save the active snip to a file
    */
   Static SaveSnip(*) {
      If (SnipObj := this.SnipObj) {
         Tooltip ; don't capture the tooltip!
         SnipObj.Snip2File(Settings.SavePath_Image, Snips.borderWithSave)
         SnipObj.flashBorder()
      }
   }
    /**
    * Clipboard the active snip
    */
   Static ClipSnip(*) {
      If (SnipObj := this.SnipObj) {
         Tooltip ; don't capture the tooltip!
         SnipObj.Snip2Clipboard(Snips.borderWithCopy)
         SnipObj.flashBorder()
      }
   }
   /**
    * Minimize the foremost SnipShapeWindow via Snips.Minimize
    */
   Static MinimizeSnip(*) {
      If (SnipObj := this.SnipObj) {
         SnipObj.Minimize()
      }
   }
   /**
    * Pin or UnPin the image on top
    */
   Static TogglePin(*) {
      If (SnipObj := this.SnipObj) {
         If (WinGetAlwaysOnTop(SnipObj.hWnd)) {
            SnipObj.Opt("-AlwaysOnTop")
         } Else {
            SnipObj.Opt("+AlwaysOnTop")
         }
         this.SyncPin(SnipObj.hwnd)
      }
   }
   /**
    * Sync Pin or UnPin button to the window state
    */
   Static SyncPin(hWnd) {
      If (this.SyncUndoRedo()) {
      ; ALso sync the undo/redo state
         state := WinGetAlwaysOnTop(hWnd)
         If (state != this.pinButton.Pinned) {
            If (state) {
               this.pinButton.SetImg(Settings.CursorPath . "Pin.ico")
               this.pinButton.Pinned := 1
            } Else {
               this.pinButton.SetImg(Settings.CursorPath . "UnPin.ico")
               this.pinButton.Pinned := 0
            }
         }
      }
   }
   /**
    * Sync undo/redo buttons to their stack length
    */
   Static SyncUndoRedo(*) {
      ; SnipObj may be a snip that was just closed (Snips.Close unsets its UnDo):
      ; only query a live undo history
      If (this.SnipObj is GuiSnip AND this.SnipObj.HasOwnProp("UnDo") AND IsObject(this.SnipObj.UnDo)) {
         this.btnUndo.enabled := (this.SnipObj.UnDo.undoStack.length > 0)
         this.btnRedo.enabled := (this.SnipObj.UnDo.redoStack.length > 0)
         return true
      }
      return false
   }
   /**
    * Close the foremost SnipShapeWindow and activate the next available snip
    */
   Static CloseSnip(*) {
      If (SnipObj := this.SnipObj) {
         Snips.Close(SnipObj, 0)
         Snips.ActivateFirst()
      } Else {
         dlog("No Snip Window Found")
      }
   }
}
logGDI(BFN(Error("", -1).File) " loaded...")
