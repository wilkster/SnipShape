/************************************************************************
 * @description Class to hold clipboard related functions
 * @file clsClipboard.ahk2
 * @author Tom Wilkason - Merged in code from fantastic guru Snipper.ahk
 * @date 2024/04/20
 * @version 1.0.0
 ***********************************************************************/

#Requires AutoHotkey v2
#include clsGDIp.ahk2
#include libMisc.ahk2
;----------------------------------------------------------------------
; Clipboard related functions
;----------------------------------------------------------------------

Class Clipboard {
   ; Helper Functions
   Static RegisterClipboardFormat(fmt)        => DllCall("RegisterClipboardFormat", "Str", fmt, "UInt")
   Static IsClipboardFormatAvailable(fmt)     => DllCall('User32.dll\IsClipboardFormatAvailable', 'UInt', fmt, "Int")
   Static GetClipboardData(fmt)               => DllCall('User32.dll\GetClipboardData', 'UInt', fmt, 'Ptr')
   Static SetClipboardData(fmt, data)         => DllCall('User32.dll\SetClipboardData', 'UInt', fmt, 'Ptr', data, 'Ptr')
   Static OpenClipboard(hWnd := 0)            => DllCall('User32.dll\OpenClipboard', 'Ptr', hWnd, "Int")
   Static CloseClipboard()                    => DllCall('User32.dll\CloseClipboard', 'Ptr')
   Static EmptyClipboard()                    => DllCall('User32.dll\EmptyClipboard', 'Ptr')
   Static GlobalLock(addr)                    => DllCall('Kernel32.dll\GlobalLock', 'Ptr',addr, 'Ptr')
   Static GlobalUnlock(addr)                  => DllCall('Kernel32.dll\GlobalUnlock', 'Ptr',addr, 'Ptr')
   Static GlobalAlloc(fmt, bytes)             => DllCall('Kernel32.dll\GlobalAlloc', 'uint',fmt, 'Ptr', bytes, 'Ptr')
   Static GlobalFree(addr)                    => DllCall('Kernel32.dll\GlobalFree', 'Ptr',addr, 'Ptr')
   Static GlobalSize(hGlobal)                 => DllCall("Kernel32.dll\GlobalSize", "Ptr", hGlobal, "Ptr")
   Static CopyMemory(dest, src, length)       => DllCall('NtDll.dll\RtlCopyMemory', 'Ptr',dest, 'Ptr', src, "Uint", length, "Int")
   Static RtlMoveMemory(pDest, pSource, Size) => DllCall("RtlMoveMemory", "Ptr", pDest, "Ptr", pSource, "UPtr", Size)
    
   Static __New() {
      Clipboard.png := this.RegisterClipboardFormat("PNG")
   }
   /**
    * Retrieves an HBITMAP handle from the clipboard and returns its dimensions.
    * @param {Integer} W - Output parameter receiving the bitmap width in pixels
    * @param {Integer} H - Output parameter receiving the bitmap height in pixels
    * @returns {Integer} Handle to the DIB Section hBitmap, or 0 if unavailable or clipboard cannot be opened
    */
   Static HBITMAPFromClipboard(&W, &H) {
      Static CF_BITMAP := 2
      Static CF_DIB    := 8
      Static CF_DIBV5  := 17
             hBitmap   := 0
      W := H := 0
      If (!this.OpenClipboard(A_ScriptHwnd))
         Return (0)
      ;------------------------------------------
      ; DIBV5 is preferred, then DIB, then BITMAP
      ;------------------------------------------
      If (this.IsClipboardFormatAvailable(CF_DIBV5)) {
         hGlobal := this.GetClipboardData(CF_DIBV5)
         hBitmap := this.ConvertClipboardDIBToDIBSection(hGlobal, &W, &H)
         debug("CF_DIBV5 Cliboard of W=" W ", H=" H)
      } Else If (this.IsClipboardFormatAvailable(CF_DIB)) {
         hGlobal := this.GetClipboardData(CF_DIB)
         hBitmap := this.ConvertClipboardDIBToDIBSection(hGlobal, &W, &H)
         debug("CF_DIB Cliboard of W=" W ", H=" H)
      } Else If (this.IsClipboardFormatAvailable(CF_BITMAP)) {
         If (hBitmap := this.GetClipboardData(CF_BITMAP)) {
            ; https://learn.microsoft.com/en-us/windows/win32/api/wingdi/ns-wingdi-bitmap
            ; Convert DDB to DIB if necessary
            If (hBitmap := this.ConvertDDBToDIB(hBitmap, true, &W, &H)) {
               ; Get rid of any transparency
               BitMap.SetAlphaChannel(hBitmap, 0xFF)
            }
            debug("CF_BITMAP Cliboard of W=" W ", H=" H)
         } Else
            hBitmap := 0
      }
      this.CloseClipboard()
      ; We like DIBs
      Return hBitmap
   }

   /**
    * Put a GDI+ bitmap to the clipboard
    * @param {Integer} TpBitmap Handle to GDI+ bitmap
    * @param {String} pszText Optional plain text to place on the clipboard alongside the image
    * @returns {Integer} 0 on success, or negative error code on failure
    */
   Static SetPBitmapToClipboard(TpBitmap, pszText := "") {
      hBitmap := Gdip.CreateARGBHBITMAPFromBitmap(TpBitmap, 0)
      Gdip.DisposeImage(TpBitmap)
      If !hBitmap {
         Return -3
      }
      this.SetHBitmapToClipboard(hBitmap, pszText)
   }
   /**
    * Take an hBitmap DIB and put it on the clipboard
    * @param {Integer} hBitmap Handle to bitmap to use; will be discarded after the call
    * @param {String} pszText Optional plain text to place on the clipboard alongside the image
    * @returns {Integer} 0 on success, or negative error code on failure
    */
   Static SetHBITMAPToClipboard(hBitmap, pszText := "") {

      ;--------------------------------------------------------------------
      ; Open Clipboard and empty it
      ;--------------------------------------------------------------------
      pid  := DllCall("GetCurrentProcessId", "uint")
      hwnd := WinExist("ahk_pid " . pid)
      If not this.OpenClipboard(hwnd) {
         GDI.DeleteObject(hBitmap)
         warning("Clipboard: Failed to open clipboard")
         Return -1
      }
      If not this.EmptyClipboard() {
         warning("Clipboard: Failed to empty clipboard")
         GDI.DeleteObject(hBitmap)
         this.CloseClipboard()
         Return -2
      }
      ;--------------------------------------------------------------------
      ; DDB Format for failsafe
      ;--------------------------------------------------------------------
      hBmpCopy := GDI.CopyImage(hBitmap)
      If not this.SetClipboardData(CF_BITMAP := 2, hBmpCopy) {
         warning("Clipboard: Failed to set CF_BITMAP format")
         DllCall("CloseClipboard")
         Gdi.DeleteObject(hBitmap)
         Return -10
      }

      ;--------------------------------------------------------------------
      ; DIB Format for alpha support and more modern app support
      ; Structure to hold the bitmap data
      ;--------------------------------------------------------------------
      ds  := tagDIBSECTION()
      GDI.GetObject(hBitmap, ds.size, ds.ptr)

      ; Allocate a moveable global block large enough for: BITMAPINFOHEADER (40 bytes) + raw pixel data
      dwBytes := ds.dsBmih.size + ds.dsBmih.biSizeImage
      If not (hDIB := this.GlobalAlloc(GMEM_MOVEABLE := 2, dwBytes)) {
         warning("Clipboard: Failed to allocate memory")
         DllCall("CloseClipboard")
         Gdi.DeleteObject(hBitmap)
         Return -3
      }
      ; Lock down the object while we work with it
      pDIB := this.GlobalLock(hDIB)
      ; Copy BITMAPINFOHEADER into the front of the global block
      this.CopyMemory(pDIB, ds.dsBmih.Ptr, ds.dsBmih.Size)
      ; ; Copy raw pixel data after the header
      this.CopyMemory(pDIB + ds.dsBmih.Size, ds.dsBm.bmBits, ds.dsBmih.biSizeImage)
      this.GlobalUnlock(hDIB)

      ; Place the DIB on the clipboard — on success clipboard owns hdib, do NOT free it
      If not this.SetClipboardData(CF_DIB := 8, hDIB) {
         warning("Clipboard: Failed to set CF_DIB Format")
         this.GlobalFree(hDIB) ; only free if failed
         this.CloseClipboard()
         Gdi.DeleteObject(hBitmap)
         Return -4
      }

      ;--------------------------------------------------------------------
      ; Registered PNG -- what new Outlook/WebView2 paste targets look for
      ;--------------------------------------------------------------------
      hPng  := this.ToPNG(hBitmap)
      If not this.SetClipboardData(Clipboard.png, hPng) {
         warning("Clipboard: Failed to set PNG Format")
         this.CloseClipboard()
         Gdi.DeleteObject(hBitmap)
         Return -9
      }      
      ; ------------------------------------------------------------------
      ; Optionally post CF_TEXT
      ; CF_TEXT expects a null-terminated ANSI string in a GMEM_MOVEABLE
      ; global block — StrPut includes the null terminator in its byte count
      ; ------------------------------------------------------------------
      If (pszText) {
         textBytes := StrPut(pszText, "CP0")              ; byte count including null terminator
         If not (htext := this.GlobalAlloc(GMEM_MOVEABLE := 2, textBytes)) {
            warning("Clipboard: Failed set CF_DIB Format")
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -5
         }
         ptext := this.GlobalLock(htext)
         StrPut(pszText, ptext, textBytes, "CP0")          ; CP0 = system ANSI code page
         this.GlobalUnlock(htext)
         ; ------------------------------------------------------------------
         ; Place the text on the clipboard — on success clipboard owns htext, do NOT free it
         ; ------------------------------------------------------------------
         If not this.SetClipboardData(CF_TEXT := 1, htext) {
            warning("Clipboard: Failed to set CP0 CF_TEXT Format")
            this.GlobalFree(htext)
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -6
         }
         ; ------------------------------------------------------------------
         ; Unicode text as well
         ; ------------------------------------------------------------------
         textBytes := StrPut(pszText, "UTF-16")          ; byte count including null terminator
         If not (htext := this.GlobalAlloc(GMEM_MOVEABLE := 2, textBytes)) {
            warning("Clipboard: Failed to allocate memory for text")
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -7
         }
         ptext := this.GlobalLock(htext)
         StrPut(pszText, ptext, textBytes, "UTF-16")          ; CP0 = system ANSI code page
         this.GlobalUnlock(htext)
         ; Place the text on the clipboard — on success clipboard owns htext, do NOT free it
         If not this.SetClipboardData(CF_TEXT := 13, htext) {
            warning("Clipboard: Failed to set UTF-16 CF_TEXT Format")
            this.GlobalFree(htext)
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -8
         }
      }      
      this.CloseClipboard()
      Gdi.DeleteObject(hBitmap)
      Return 0
   }
   /**
    * Convert an hBitmap to PNG format for the clipboard
    * @param hBitmap Input hbitmap to convert
    * @returns {Float | Integer | String} 
    */
   Static ToPNG(hBitmap) {
      ; CreateARGBBitmapFromHBITMAP already handles the 32bpp-alpha-preserving
      ; path vs falling back to CreateBitmapFromHBITMAP -- no manual alpha
      ; handling needed here.
      if (NOT hBitmap)
         return 0
      pBitmap := GDIp.CreateARGBBitmapFromHBITMAP(hBitmap)

      DllCall("ole32\CreateStreamOnHGlobal", "Ptr", 0, "Int", true, "Ptr*", &pStream := 0)

      ; PNG encoder CLSID: {557CF406-1A04-11D3-9A73-0000F81EF32E}
      clsid := Buffer(16)
      DllCall("ole32\CLSIDFromString", "WStr", "{557CF406-1A04-11D3-9A73-0000F81EF32E}", "Ptr", clsid)
      if (res := DllCall("gdiplus\GdipSaveImageToStream", "Ptr", pBitmap, "Ptr", pStream, "Ptr", clsid, "Ptr", 0)) {
         warning("Failure to Save to PNG format " res " " A_LastError)
         return 0
      }
      ; STREAM_SEEK_END = 2 -- gets the real written length, not the
      ; over-allocated HGLOBAL block size that GlobalSize would report.
      ComCall(5, pStream, "Int64", 0, "UInt", 2, "UInt64*", &size := 0)

      DllCall("ole32\GetHGlobalFromStream", "Ptr", pStream, "Ptr*", &hGlobal := 0)

      ; Duplicate the memory -- releasing pStream frees hGlobal (fDeleteOnRelease=true above)
      hCopy := this.GlobalAlloc(0x42, size)
      pSrc  := this.GlobalLock(hGlobal)
      pDst  := this.GlobalLock(hCopy)
      this.RtlMoveMemory(pDst, pSrc, size)
      this.GlobalUnlock(hGlobal)
      this.GlobalUnlock(hCopy)

      ObjRelease(pStream)
      GDIp.DisposeImage(pBitmap)
      Return hCopy
   }
   /**
    * Ensures a bitmap handle is a DIB section, converting from a DDB if necessary.
    * If hBitmap is already a DIB section, it is returned unchanged.
    * If hBitmap is a DDB, a new 32bpp top-down DIB section is created with the
    * same pixel data, and (by default) the original DDB is deleted.
    * @param {Integer} hBitmap Handle to a bitmap (DDB or DIB section)
    * @param {Integer} DiscardOriginal If true, deletes the source DDB after conversion
    * @returns {Integer} Handle to a DIB section, or 0 on failure
    */
   Static ConvertDDBToDIB(hBitmap, DiscardOriginal := true, &W, &H) {
      static SIZE_BITMAP := (A_PtrSize = 8) ? 32 : 24
      ds     := tagDIBSECTION()
      result := GDI.GetObject(hBitmap, ds.Size, ds.Ptr)
      If (!result)
         Return 0
      W := ds.dsBm.bmWidth
      H := ds.dsBm.bmHeight
      ; Already a DIB section - nothing to do
      If (result > SIZE_BITMAP)
         Return hBitmap
      ; DDB path - pull dimensions from the BITMAP portion already populated above

      bi               := tagBITMAPINFOHEADER()
      bi.biWidth       := W
      bi.biHeight      := H ;  our hBitmaps are bottoms up
      bi.biPlanes      := 1
      bi.biBitCount    := 32
      bi.biCompression := 0

      hdc :=GDI.GetDC(0)

      ppvBits := 0
      hDib := GDI.CreateDIBSection(bi.biWidth, bi.biHeight, hdc, bi.biBitCount, &ppvBits)

      If (!hDIB) {
         DllCall("ReleaseDC", "Ptr", 0, "Ptr", hdc)
         Return 0
      }
      If !GDI.GetDIBits(hdc, hBitmap, 0, H, ppvBits, bi, 2) {
         GDI.DeleteObject(hDIB)
         GDI.ReleaseDC(hdc)
         Return 0
      }
      GDI.ReleaseDC(hdc)

      If (DiscardOriginal)
         GDI.DeleteObject(hBitmap)

      Return hDIB
   }
   /**
    * Convert a clipboard DIB handle to a hBitmap DIB hBitmap
    * @param hGlobal Global handle to a DIB_V5 image
    * @returns hBitmap handle or 0 for error 
    */
   Static ConvertClipboardDIBToDIBSection(hGlobal, &W, &H) {
      Static BI_RGB := 0
      Static BI_BITFIELDS := 3

      If (!hGlobal)
         Return 0
      pHeader := this.GlobalLock(hGlobal)
      If (!pHeader)
         Return 0

      HeaderSize := NumGet(pHeader, 0, "UInt")

      ;------------------------------------
      ; Copy clipboard header into a structure
      ;------------------------------------
      Switch HeaderSize {

         Case tagBITMAPINFOHEADER().Size:
            bmi := tagBITMAPINFOHEADER()
            this.RtlMoveMemory(bmi.Ptr, pHeader, bmi.Size)

         Case tagBITMAPV4HEADER().Size:
            bmi := tagBITMAPV4HEADER()
            this.RtlMoveMemory(bmi.Ptr, pHeader, bmi.Size)

         Case tagBITMAPV5HEADER().size:
            bmi := tagBITMAPV5HEADER()
            this.RtlMoveMemory(bmi.Ptr, pHeader, bmi.Size)

         default:
            this.GlobalUnlock(hGlobal)
            Return 0
      }

      ;------------------------------------
      ; Validate
      ;------------------------------------

      If (bmi.biPlanes != 1) {
         this.GlobalUnlock(hGlobal)
         Return 0
      }

      If (bmi.biCompression != BI_RGB
         && bmi.biCompression != BI_BITFIELDS) {
         this.GlobalUnlock(hGlobal)
         Return 0
      }

      Width       := bmi.biWidth
      Height      := Abs(bmi.biHeight)
      BitCount    := bmi.biBitCount
      Compression := bmi.biCompression
      SizeImage   := bmi.biSizeImage

      ;------------------------------------
      ; Locate the pixel bits
      ;------------------------------------

      pBits := pHeader + HeaderSize

      ; BI_BITFIELDS stores three DWORD masks immediately after the header.
      ; (For V4/V5 the masks are already inside the header.)
      If (Compression = BI_BITFIELDS && HeaderSize = 40)
         pBits += 12

      ; Skip palette entries
      If (BitCount <= 8) {
         Colors := bmi.biClrUsed
         If (!Colors)
            Colors := 1 << BitCount
         pBits += Colors * 4
      }

      ;------------------------------------
      ; Determine image size
      ;------------------------------------

      If (!SizeImage) {
         Stride := ((Width * BitCount + 31) // 32) * 4
         SizeImage := Stride * Height
      }

      ;------------------------------------
      ; Create destination DIBSection
      ;------------------------------------

      hdc  := GDI.GetDC(0)
      hDIB := GDI.CreateDIBSection(Width, bmi.biHeight, hdc, BitCount, &ppvBits := 0)

      If (!hDIB) {
         this.GlobalUnlock(hGlobal)
         GDI.ReleaseDC(hdc)
         Return 0
      }
      W := Width
      H := Abs(bmi.biHeight)
      ;------------------------------------
      ; Copy pixels exactly
      ;------------------------------------
      this.RtlMoveMemory(ppvBits, pBits, SizeImage)
      this.GlobalUnlock(hGlobal)
      GDI.ReleaseDC(hdc)

      Return hDIB
   }   
   ;----------------------------------------------------------------------------
   ; Idea from: https://www.autohotkey.com/boards/viewtopic.php?f=83&t=114568
   ;----------------------------------------------------------------------------

   /**
    * Renders an HTML string and copies the resulting content to the clipboard
    * via an Internet Explorer COM object's execCommand interface.
    * @param {String} html The HTML markup string to place on the clipboard
    * @returns {void}
    */
   Static HTMLToClipboard(html) {
      htmlFile := ComObject('HTMLfile')
      htmlFile.write(html)
      htmlFile.body.createTextRange().execCommand("Copy")
      htmlFile := unset
   }

   /**
    * Checks whether the clipboard currently contains any text content.
    * @returns {Integer} 1 (true) if a recognised text format is available, 0 (false) otherwise
    */
   Static hasText() =>StrLen(A_Clipboard)
   ; 🐞 Below will return true if there is a null string
   ; Static hasText() {
   ;    For fmt in Array(1, 7, 13, 16, 49358)
   ;       if (ClipIsAvailable(fmt))
   ;          Return true
   ;    Return false
   ; }

   /**
    * Checks whether the clipboard currently contains any image content.
    * @returns {Integer} 1 (true) if a recognised image format is available, 0 (false) otherwise
    */
   Static hasImage() {
      For fmt in Array(2, 6, 8, 17, Clipboard.png)
         if (ClipIsAvailable(fmt))
            Return true
      Return false
   }

}
ClipIsAvailable(format) => DllCall("IsClipboardFormatAvailable", "uint", format)
logGDI(BFN(Error("", -1).File) " loaded...")