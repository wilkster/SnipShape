/************************************************************************
 * @description Class to hold clipboard related functions
 * @file clsClipboard.ahk2
 * @author Tom Wilkason - Merged in code from fantastic guru Snipper.ahk
 * @date 2024/04/20
 * @version 1.0.0
 ***********************************************************************/

#Requires AutoHotkey v2.1-
#include clsGDIp.ahk2
#include libMisc.ahk2
;----------------------------------------------------------------------
; Clipboard related functions
;----------------------------------------------------------------------

Class Clipboard {
   ; Helper Functions
   Static RegisterClipboardFormat(fmt)        => DllCall("RegisterClipboardFormat", "Str", fmt, "UInt")
   Static IsClipboardFormatAvailable(fmt)     => DllCall('User32.dll\IsClipboardFormatAvailable', 'UInt', fmt, "Int")
   Static GetClipboardData(fmt)               => DllCall('User32.dll\GetClipboardData', 'UInt', fmt, 'Ptr')
   Static SetClipboardData(fmt, data)         => DllCall('User32.dll\SetClipboardData', 'UInt', fmt, 'Ptr', data, 'Ptr')
   Static OpenClipboard(hWnd := 0)            => DllCall('User32.dll\OpenClipboard', 'Ptr', hWnd, "Int")
   Static CloseClipboard()                    => DllCall('User32.dll\CloseClipboard', 'Ptr')
   Static EmptyClipboard()                    => DllCall('User32.dll\EmptyClipboard', 'Ptr')
   Static GlobalLock(addr)                    => DllCall('Kernel32.dll\GlobalLock', 'Ptr',addr, 'Ptr')
   Static GlobalUnlock(addr)                  => DllCall('Kernel32.dll\GlobalUnlock', 'Ptr',addr, 'Ptr')
   Static GlobalAlloc(fmt, bytes)             => DllCall('Kernel32.dll\GlobalAlloc', 'uint',fmt, 'Ptr', bytes, 'Ptr')
   Static GlobalFree(addr)                    => DllCall('Kernel32.dll\GlobalFree', 'Ptr',addr, 'Ptr')
   Static GlobalSize(hGlobal)                 => DllCall("Kernel32.dll\GlobalSize", "Ptr", hGlobal, "Ptr")
   Static CopyMemory(dest, src, length)       => DllCall('NtDll.dll\RtlCopyMemory', 'Ptr',dest, 'Ptr', src, "Uint", length, "Int")
   Static RtlMoveMemory(pDest, pSource, Size) => DllCall("RtlMoveMemory", "Ptr", pDest, "Ptr", pSource, "UPtr", Size)
    
   Static __New() {
      Clipboard.png := this.RegisterClipboardFormat("PNG")
   }
   /**
    * Retrieves an HBITMAP handle from the clipboard and returns its dimensions.
    * @param {Integer} W - Output parameter receiving the bitmap width in pixels
    * @param {Integer} H - Output parameter receiving the bitmap height in pixels
    * @returns {Integer} Handle to the DIB Section hBitmap, or 0 if unavailable or clipboard cannot be opened
    */
   Static HBITMAPFromClipboard(&W, &H) {
      Static CF_BITMAP := 2
      Static CF_DIB    := 8
      Static CF_DIBV5  := 17
             hBitmap   := 0
      W := H := 0
      If (!this.OpenClipboard(A_ScriptHwnd))
         Return (0)
      ;------------------------------------------
      ; DIBV5 is preferred, then DIB, then BITMAP
      ;------------------------------------------
      If (this.IsClipboardFormatAvailable(CF_DIBV5)) {
         hGlobal := this.GetClipboardData(CF_DIBV5)
         hBitmap := this.ConvertClipboardDIBToDIBSection(hGlobal, &W, &H)
         debug("CF_DIBV5 Cliboard of W=" W ", H=" H)
      } Else If (this.IsClipboardFormatAvailable(CF_DIB)) {
         hGlobal := this.GetClipboardData(CF_DIB)
         hBitmap := this.ConvertClipboardDIBToDIBSection(hGlobal, &W, &H)
         debug("CF_DIB Cliboard of W=" W ", H=" H)
      } Else If (this.IsClipboardFormatAvailable(CF_BITMAP)) {
         ; The clipboard owns this handle - never modify or delete it, work on a copy
         If (hClip := this.GetClipboardData(CF_BITMAP)) {
            ; https://learn.microsoft.com/en-us/windows/win32/api/wingdi/ns-wingdi-bitmap
            If (hCopy := GDI.CopyImage(hClip)) {
               ; Convert DDB to DIB if necessary (discards hCopy if converted)
               If (hBitmap := this.ConvertDDBToDIB(hCopy, true, &W, &H)) {
                  ; Get rid of any transparency
                  BitMap.SetAlphaChannel(hBitmap, 0xFF)
               } Else
                  GDI.DeleteObject(hCopy)
            }
            debug("CF_BITMAP Cliboard of W=" W ", H=" H)
         }
      }
      this.CloseClipboard()
      ; We like DIBs
      Return hBitmap
   }

   /**
    * Put a GDI+ bitmap to the clipboard
    * @param {Integer} TpBitmap Handle to GDI+ bitmap
    * @param {String} pszText Optional plain text to place on the clipboard alongside the image
    * @returns {Integer} 0 on success, or negative error code on failure
    */
   Static SetPBitmapToClipboard(TpBitmap, pszText := "", dpi := 0) {
      hBitmap := Gdip.CreateARGBHBITMAPFromBitmap(TpBitmap, 0)
      Gdip.DisposeImage(TpBitmap)
      If !hBitmap {
         Return -3
      }
      return this.SetHBitmapToClipboard(hBitmap, pszText, dpi)
   }
   /**
    * Take an hBitmap DIB and put it on the clipboard
    * @param {Integer} hBitmap Handle to bitmap to use; will be discarded after the call
    * @param {String} pszText Optional plain text to place on the clipboard alongside the image
    * @param {Number} [dpi] DPI of the monitor the picture was shown on, stored in the PNG
    *        and DIB so apps size it as seen (0 = system DPI)
    * @returns {Integer} 0 on success, or negative error code on failure
    */
   Static SetHBITMAPToClipboard(hBitmap, pszText := "", dpi := 0) {
      ;--------------------------------------------------------------------
      ; Validate we were given a DIB section (DDBs have no bmBits), do this
      ; before touching the clipboard so a bad call doesn't empty it
      ;--------------------------------------------------------------------
      ds  := tagDIBSECTION()
      If (!GDI.GetObject(hBitmap, ds.size, ds.ptr) || !ds.dsBm.bmBits) {
         warning("Clipboard: hBitmap is not a DIB section")
         GDI.DeleteObject(hBitmap)
         Return -11
      }
      ;--------------------------------------------------------------------
      ; Open Clipboard and empty it
      ; Must have an owner window, with a NULL owner EmptyClipboard sets
      ; the owner to NULL and SetClipboardData then fails
      ;--------------------------------------------------------------------
      If not this.OpenClipboard(A_ScriptHwnd) {
         GDI.DeleteObject(hBitmap)
         warning("Clipboard: Failed to open clipboard")
         Return -1
      }
      If not this.EmptyClipboard() {
         warning("Clipboard: Failed to empty clipboard")
         GDI.DeleteObject(hBitmap)
         this.CloseClipboard()
         Return -2
      }
      ;--------------------------------------------------------------------
      ; Registered PNG first (the usual convention: many apps take the first
      ; image format they understand). PNG keeps the alpha (straight). Our
      ; DIB/BITMAP are premultiplied and most readers ignore their alpha:
      ; OneNote Desktop reads CF_DIB only, so transparent corners paste black
      ; and translucent pictures darker. Our own CF_DIBV5 with an alpha mask
      ; was tried and didn't help OneNote, so it was dropped.
      ;--------------------------------------------------------------------
      ; Optional format: on failure warn and continue with BITMAP/DIB.
      ; Never pass a NULL handle, that requests delayed rendering we don't service.
      If (hPng := this.ToPNG(hBitmap, dpi)) {
         If not this.SetClipboardData(Clipboard.png, hPng) {
            warning("Clipboard: Failed to set PNG Format")
            this.GlobalFree(hPng) ; only free if failed
         }
      } Else
         warning("Clipboard: PNG conversion failed, PNG format skipped")
      ;--------------------------------------------------------------------
      ; DDB Format for failsafe
      ;--------------------------------------------------------------------
      hBmpCopy := GDI.CopyImage(hBitmap)
      If not this.SetClipboardData(CF_BITMAP := 2, hBmpCopy) {
         warning("Clipboard: Failed to set CF_BITMAP format")
         DllCall("CloseClipboard")
         Gdi.DeleteObject(hBitmap)
         Gdi.DeleteObject(hBmpCopy)
         Return -10
      }

      ;--------------------------------------------------------------------
      ; DIB Format for alpha support and more modern app support
      ;--------------------------------------------------------------------
      If not (hDIB := this.ToDIB(hBitmap, dpi)) {
         warning("Clipboard: Failed to allocate memory")
         DllCall("CloseClipboard")
         Gdi.DeleteObject(hBitmap)
         Return -3
      }

      ; Place the DIB on the clipboard — on success clipboard owns hdib, do NOT free it
      If not this.SetClipboardData(CF_DIB := 8, hDIB) {
         warning("Clipboard: Failed to set CF_DIB Format")
         this.GlobalFree(hDIB) ; only free if failed
         this.CloseClipboard()
         Gdi.DeleteObject(hBitmap)
         Return -4
      }

      ; ------------------------------------------------------------------
      ; Optionally post CF_TEXT
      ; CF_TEXT expects a null-terminated ANSI string in a GMEM_MOVEABLE
      ; global block — StrPut includes the null terminator in its byte count
      ; ------------------------------------------------------------------
      If (pszText) {
         textBytes := StrPut(pszText, "CP0")              ; byte count including null terminator
         If not (htext := this.GlobalAlloc(GMEM_MOVEABLE := 2, textBytes)) {
            warning("Clipboard: Failed set CF_DIB Format")
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -5
         }
         ptext := this.GlobalLock(htext)
         StrPut(pszText, ptext, textBytes, "CP0")          ; CP0 = system ANSI code page
         this.GlobalUnlock(htext)
         ; ------------------------------------------------------------------
         ; Place the text on the clipboard — on success clipboard owns htext, do NOT free it
         ; ------------------------------------------------------------------
         If not this.SetClipboardData(CF_TEXT := 1, htext) {
            warning("Clipboard: Failed to set CP0 CF_TEXT Format")
            this.GlobalFree(htext)
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -6
         }
         ; ------------------------------------------------------------------
         ; Unicode text as well
         ; ------------------------------------------------------------------
         textBytes := StrPut(pszText, "UTF-16")          ; byte count including null terminator
         If not (htext := this.GlobalAlloc(GMEM_MOVEABLE := 2, textBytes)) {
            warning("Clipboard: Failed to allocate memory for text")
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -7
         }
         ptext := this.GlobalLock(htext)
         StrPut(pszText, ptext, textBytes, "UTF-16")          ; CP0 = system ANSI code page
         this.GlobalUnlock(htext)
         ; Place the text on the clipboard — on success clipboard owns htext, do NOT free it
         If not this.SetClipboardData(CF_UNICODETEXT := 13, htext) {
            warning("Clipboard: Failed to set UTF-16 CF_UNICODETEXT Format")
            this.GlobalFree(htext)
            this.CloseClipboard()
            Gdi.DeleteObject(hBitmap)
            Return -8
         }
      }      
      this.CloseClipboard()
      Gdi.DeleteObject(hBitmap)
      Return 0
   }
   /**
    * Pack a DIB section as a CF_DIB block (BITMAPINFOHEADER + pixels) in a moveable
    * global, for the clipboard or a drag data object (the receiver owns it)
    * @param hBitmap DIB section (not changed)
    * @param {Number} [dpi] Resolution to record in the header (0 = system DPI)
    * @returns {Ptr} HGLOBAL, or 0 if hBitmap isn't a DIB section or allocation failed
    */
   Static ToDIB(hBitmap, dpi := 0) {
      ds := tagDIBSECTION()
      If (!GDI.GetObject(hBitmap, ds.size, ds.ptr) || !ds.dsBm.bmBits)
         Return 0
      ; biSizeImage may be 0 for BI_RGB, compute from the stride if so
      imgBytes := ds.dsBmih.biSizeImage || ds.dsBm.bmWidthBytes * Abs(ds.dsBmih.biHeight)
      If not (hDIB := this.GlobalAlloc(GMEM_MOVEABLE := 2, ds.dsBmih.size + imgBytes))
         Return 0
      pDIB := this.GlobalLock(hDIB)
      this.CopyMemory(pDIB, ds.dsBmih.Ptr, ds.dsBmih.Size)                ; header
      this.CopyMemory(pDIB + ds.dsBmih.Size, ds.dsBm.bmBits, imgBytes)   ; pixels
      ; Resolution: a DIB section has none (0 = readers assume 96 dpi). Write the DPI of
      ; the monitor the picture was shown on (same as the PNG), or apps that take the DIB
      ; (Office on a drag-drop, OneNote) show it larger than on screen on a high-DPI
      ; monitor (1.5x at 150%)
      ppm := Round((dpi || A_ScreenDPI) / 0.0254)                         ; pixels per metre
      NumPut("Int", ppm, "Int", ppm, pDIB, 24)                            ; biX/biYPelsPerMeter
      this.GlobalUnlock(hDIB)
      Return hDIB
   }
   /**
    * Convert an hBitmap to PNG format for the clipboard
    * @param hBitmap Input hbitmap to convert
    * @param {Number} [dpi] Resolution to record in the PNG (0 = system DPI, GDI+'s default)
    * @returns {Float | Integer | String}
    */
   Static ToPNG(hBitmap, dpi := 0) {
      ; CreateARGBBitmapFromHBITMAP already handles the 32bpp-alpha-preserving
      ; path vs falling back to CreateBitmapFromHBITMAP -- no manual alpha
      ; handling needed here.
      if (NOT hBitmap)
         return 0

      res := DllCall("ole32\CreateStreamOnHGlobal", "Ptr", 0, "Int", true, "Ptr*", &pStream := 0)
      ; PNG encoder CLSID: {557CF406-1A04-11D3-9A73-0000F81EF32E}
      If (pStream == 0 OR res != 0) {
         warning("Failed to allocate pStream:" res " " A_LastError)
         return 0
      }
      ; Our hBitmaps are premultiplied: read them as PARGB (0xE200B) so the PNG gets straight alpha
      If !(pBitmap := GDIp.CreateARGBBitmapFromHBITMAP(hBitmap, 0xE200B)) {
         warning("Failed to create GDI+ bitmap for PNG")
         ObjRelease(pStream)
         return 0
      }
      If (dpi)
         GDIp.BitmapSetResolution(pBitmap, dpi)
      clsid := Buffer(16)
      DllCall("ole32\CLSIDFromString", "WStr", "{557CF406-1A04-11D3-9A73-0000F81EF32E}", "Ptr", clsid, "Int")
      If (res := DllCall("gdiplus\GdipSaveImageToStream", "Ptr", pBitmap, "Ptr", pStream, "Ptr", clsid, "Ptr", 0)) {
         warning("Failure to Save to PNG format " res " " A_LastError)
         ObjRelease(pStream)
         GDIp.DisposeImage(pBitmap)
         Return 0
      }
      ; STREAM_SEEK_END = 2 -- gets the real written length, not the
      ; over-allocated HGLOBAL block size that GlobalSize would report.
      ComCall(5, pStream, "Int64", 0, "UInt", 2, "UInt64*", &size := 0)

      If (res := DllCall("ole32\GetHGlobalFromStream", "Ptr", pStream, "Ptr*", &hGlobal := 0)) {
         warning("Get Global from Stream " res " " A_LastError)
         ObjRelease(pStream)
         GDIp.DisposeImage(pBitmap)
         Return 0
      }
      ; Duplicate the memory -- releasing pStream frees hGlobal (fDeleteOnRelease=true above)
      If (hCopy := this.GlobalAlloc(GMEM_MOVEABLE := 2, size)) {
         pSrc  := this.GlobalLock(hGlobal)
         pDst  := this.GlobalLock(hCopy)
         If (pSrc && pDst)
            this.RtlMoveMemory(pDst, pSrc, size)
         If pSrc
            this.GlobalUnlock(hGlobal)
         If pDst
            this.GlobalUnlock(hCopy)
         If !(pSrc && pDst) {
            warning("Failed to lock PNG memory")
            this.GlobalFree(hCopy)
            hCopy := 0
         }
      } Else
         warning("Failed to allocate PNG memory " A_LastError)

      ObjRelease(pStream)
      GDIp.DisposeImage(pBitmap)
      Return hCopy
   }
   /**
    * Ensures a bitmap handle is a DIB section, converting from a DDB if necessary.
    * If hBitmap is already a DIB section, it is returned unchanged.
    * If hBitmap is a DDB, a new 32bpp bottum-up DIB section is created with the
    * same pixel data, and (by default) the original DDB is deleted.
    * @param {Integer} hBitmap Handle to a bitmap (DDB or DIB section)
    * @param {Integer} DiscardOriginal If true, deletes the source DDB after conversion
    * @returns {Integer} Handle to a DIB section, or 0 on failure
    */
   Static ConvertDDBToDIB(hBitmap, DiscardOriginal := true, &W, &H) {
      static SIZE_BITMAP := (A_PtrSize = 8) ? 32 : 24
      ds     := tagDIBSECTION()
      result := GDI.GetObject(hBitmap, ds.Size, ds.Ptr)
      If (!result)
         Return 0
      W := ds.dsBm.bmWidth
      H := ds.dsBm.bmHeight
      ; Already a DIB section - nothing to do
      If (result > SIZE_BITMAP)
         Return hBitmap
      ; DDB path - pull dimensions from the BITMAP portion already populated above

      bi               := tagBITMAPINFOHEADER()
      bi.biWidth       := W
      bi.biHeight      := H ;  our hBitmaps are bottoms up
      bi.biPlanes      := 1
      bi.biBitCount    := 32
      bi.biCompression := 0

      hdc :=GDI.GetDC(0)

      ppvBits := 0
      hDib := GDI.CreateDIBSection(bi.biWidth, bi.biHeight, hdc, bi.biBitCount, &ppvBits)

      If (!hDIB) {
         GDI.ReleaseDC(hdc)
         Return 0
      }
      If !GDI.GetDIBits(hdc, hBitmap, 0, H, ppvBits, bi) {
         GDI.DeleteObject(hDIB)
         GDI.ReleaseDC(hdc)
         Return 0
      }
      GDI.ReleaseDC(hdc)

      If (DiscardOriginal)
         GDI.DeleteObject(hBitmap)

      Return hDIB
   }
   /**
    * Convert a clipboard DIB handle to a hBitmap DIB hBitmap
    * @param hGlobal Global handle to a DIB_V5 image
    * @returns hBitmap handle or 0 for error 
    */
   Static ConvertClipboardDIBToDIBSection(hGlobal, &W, &H) {
      Static BI_RGB := 0
      Static BI_BITFIELDS := 3

      If (!hGlobal)
         Return 0
      pHeader := this.GlobalLock(hGlobal)
      If (!pHeader)
         Return 0

      HeaderSize := NumGet(pHeader, 0, "UInt")

      ;------------------------------------
      ; Copy clipboard header into a structure
      ;------------------------------------
      Switch HeaderSize {

         Case tagBITMAPINFOHEADER().Size:
            bmi := tagBITMAPINFOHEADER()
            this.RtlMoveMemory(bmi.Ptr, pHeader, bmi.Size)

         Case tagBITMAPV4HEADER().Size:
            bmi := tagBITMAPV4HEADER()
            this.RtlMoveMemory(bmi.Ptr, pHeader, bmi.Size)

         Case tagBITMAPV5HEADER().size:
            bmi := tagBITMAPV5HEADER()
            this.RtlMoveMemory(bmi.Ptr, pHeader, bmi.Size)

         default:
            this.GlobalUnlock(hGlobal)
            Return 0
      }

      ;------------------------------------
      ; Validate
      ;------------------------------------

      If (bmi.biPlanes != 1) {
         this.GlobalUnlock(hGlobal)
         Return 0
      }

      If (bmi.biCompression != BI_RGB
         && bmi.biCompression != BI_BITFIELDS) {
         this.GlobalUnlock(hGlobal)
         Return 0
      }

      Width       := bmi.biWidth
      Height      := Abs(bmi.biHeight)
      BitCount    := bmi.biBitCount
      Compression := bmi.biCompression
      SizeImage   := bmi.biSizeImage

      ;------------------------------------
      ; Locate the pixel bits
      ;------------------------------------

      pBits := pHeader + HeaderSize

      ; BI_BITFIELDS stores three DWORD masks immediately after the header.
      ; (For V4/V5 the masks are already inside the header.)
      If (Compression = BI_BITFIELDS && HeaderSize = 40)
         pBits += 12

      ; Skip palette entries
      If (BitCount <= 8) {
         Colors := bmi.biClrUsed
         If (!Colors)
            Colors := 1 << BitCount
         pBits += Colors * 4
      }

      ;------------------------------------
      ; Determine image size
      ;------------------------------------

      ; Never trust the header's biSizeImage: clamp to what the destination
      ; DIB section holds and to what the source global block actually contains
      Stride    := ((Width * BitCount + 31) // 32) * 4
      DestBytes := Stride * Height
      SrcBytes  := this.GlobalSize(hGlobal) - (pBits - pHeader)
      If (!SizeImage || SizeImage > DestBytes)
         SizeImage := DestBytes
      If (SizeImage > SrcBytes) {
         warning("Clipboard: DIB data truncated, need " SizeImage " bytes, have " SrcBytes)
         If (SrcBytes <= 0) {
            this.GlobalUnlock(hGlobal)
            Return 0
         }
         SizeImage := SrcBytes
      }

      ;------------------------------------
      ; Create destination DIBSection
      ;------------------------------------

      hdc  := GDI.GetDC(0)
      hDIB := GDI.CreateDIBSection(Width, bmi.biHeight, hdc, BitCount, &ppvBits := 0)

      If (!hDIB) {
         this.GlobalUnlock(hGlobal)
         GDI.ReleaseDC(hdc)
         Return 0
      }
      W := Width
      H := Abs(bmi.biHeight)
      ;------------------------------------
      ; Copy pixels exactly
      ;------------------------------------
      this.RtlMoveMemory(ppvBits, pBits, SizeImage)
      this.GlobalUnlock(hGlobal)
      GDI.ReleaseDC(hdc)

      Return hDIB
   }   
   ;----------------------------------------------------------------------------
   ; Idea from: https://www.autohotkey.com/boards/viewtopic.php?f=83&t=114568
   ;----------------------------------------------------------------------------

   /**
    * Renders an HTML string and copies the resulting content to the clipboard
    * via an Internet Explorer COM object's execCommand interface.
    * @param {String} html The HTML markup string to place on the clipboard
    * @returns {void}
    */
   Static HTMLToClipboard(html) {
      htmlFile := ComObject('HTMLfile')
      htmlFile.write(html)
      htmlFile.body.createTextRange().execCommand("Copy")
      htmlFile := unset
   }

   /**
    * Checks whether the clipboard currently contains any text content.
    * @returns {Integer} 1 (true) if a recognised text format is available, 0 (false) otherwise
    */
   Static hasText() => (StrLen(A_Clipboard) > 0)
   ; 🐞 Below will return true if there is a null string
   ; Static hasText() {
   ;    For fmt in Array(1, 7, 13, 16, 49358)
   ;       if (ClipIsAvailable(fmt))
   ;          Return true
   ;    Return false
   ; }

   /**
    * Checks whether the clipboard currently contains any image content.
    * @returns {Integer} 1 (true) if a recognised image format is available, 0 (false) otherwise
    */
   Static hasImage() {
      For fmt in Array(2, 6, 8, 17, Clipboard.png)
         if (this.IsClipboardFormatAvailable(fmt))
            Return true
      Return false
   }
   ; Image file extensions a snip can be opened from (file drops, copied files)
   Static ImageFileRegEx := "i)\.(png|jpe?g|bmp|gif|ico|wmf|tiff?)$"
   /**
    * Image files on the clipboard as a copied file list (CF_HDROP, e.g. Ctrl-C in Explorer)
    * @returns {Array} full paths of existing image files (empty if none)
    */
   Static ImageFileNames() {
      files := []
      If NOT this.IsClipboardFormatAvailable(CF_HDROP := 15)
         Return files
      If NOT this.OpenClipboard(A_ScriptHwnd)
         Return files
      If (hDrop := this.GetClipboardData(CF_HDROP)) {
         n := DllCall("shell32\DragQueryFileW", "Ptr", hDrop, "UInt", 0xFFFFFFFF, "Ptr", 0, "UInt", 0, "UInt")
         Loop n {
            len := DllCall("shell32\DragQueryFileW", "Ptr", hDrop, "UInt", A_Index - 1, "Ptr", 0, "UInt", 0, "UInt")
            buf := Buffer((len + 1) * 2)
            DllCall("shell32\DragQueryFileW", "Ptr", hDrop, "UInt", A_Index - 1, "Ptr", buf, "UInt", len + 1, "UInt")
            sFile := StrGet(buf, "UTF-16")
            If ((sFile ~= this.ImageFileRegEx) AND (attr := FileExist(sFile)) AND NOT InStr(attr, "D"))
               files.Push(sFile)
         }
      }
      this.CloseClipboard()
      Return files
   }
   /**
    * Checks whether the clipboard holds copied image files (see ImageFileNames)
    * @returns {Integer} true if at least one image file is on the clipboard
    */
   Static hasImageName() => this.ImageFileNames().Length > 0
   /**
    * Add a file to the clipboard such that it can pasted it somewhere.
    * @param files one or more files to add to the clipboard
    * @returns {Any} 
    */
   Static AddFilesToClipboard(files) {
      If !(hGlobal := this.ToHDROP(files))
         Return false
      ; Need an owner window, a NULL owner makes SetClipboardData fail after EmptyClipboard
      If !this.OpenClipboard(A_ScriptHwnd) {
         this.GlobalFree(hGlobal)
         Return false
      }
      this.EmptyClipboard()
      ok := this.SetClipboardData(15, hGlobal)  ; CF_HDROP = 15
      this.CloseClipboard()

      If !ok
         this.GlobalFree(hGlobal)  ; only free on failure - clipboard owns it once SetClipboardData succeeds

      Return !!ok
   }
   Static AddFileToClipboard(file) => this.AddFilesToClipboard(file)
   /**
    * Build a CF_HDROP block (DROPFILES + wide file list) in a moveable global,
    * for the clipboard or a drag data object (the receiver owns it)
    * @param files a single path string or an Array of path strings
    * @returns {Ptr} HGLOBAL, or 0 on failure
    */
   Static ToHDROP(files) {
      If !(files is Array)
         files := [files]
      If !files.Length
         Return 0

      ; --- size the file-list block (wide chars, each null-terminated, +1 final null) ---
      listSize := 2  ; final terminating null
      For file in files
         listSize += (StrLen(file) + 1) * 2

      dropFilesSize := 20  ; sizeof(DROPFILES): DWORD pFiles + POINT + BOOL fNC + BOOL fWide
      totalSize := dropFilesSize + listSize

      hGlobal := this.GlobalAlloc(0x42, totalSize)  ; GMEM_MOVEABLE | GMEM_ZEROINIT
      If !hGlobal
         Return 0

      pGlobal := this.GlobalLock(hGlobal)
      If !pGlobal {
         this.GlobalFree(hGlobal)
         Return 0
      }

      NumPut("UInt", dropFilesSize, pGlobal, 0)   ; pFiles - offset to list
      NumPut("Int", 0, pGlobal, 4)   ; pt.x
      NumPut("Int", 0, pGlobal, 8)   ; pt.y
      NumPut("Int", 0, pGlobal, 12)  ; fNC
      NumPut("Int", 1, pGlobal, 16)  ; fWide = TRUE

      offset := dropFilesSize
      For file in files {
         StrPut(file, pGlobal + offset, StrLen(file) + 1, "UTF-16")
         offset += (StrLen(file) + 1) * 2
      }
      ; trailing double-null already present from GMEM_ZEROINIT

      this.GlobalUnlock(hGlobal)
      Return hGlobal
   }
}
logGDI(BFN(Error("", -1).File) " loaded...")