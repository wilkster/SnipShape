/************************************************************************
 * @description Line Shape Class
 * @author Tom Wilkason
 * @date 2026/03/09
 * @version 1.0.0
 ***********************************************************************/

#Requires AutoHotkey v2.0 
#include ..\clsGDIp.ahk2
#include ..\libMisc.ahk2
#include ..\clsShapes.ahk2
#include clsCommonShape.ahk2

/**
 * Class Line related shapes
 * @extends commonShape
 * Handles drawing and management of linear shapes including arrows, lines, brackets, and connectors.
 */
Class LineShape extends commonShape {

   /**
    * Initializes the LineShape instance with default values based on the specific shape type
    * @param {Any} args - Optional arguments
    */
   Init(*) {
      Super.Init()
      this.outlineColor        := Shapes.outlineColor
      this.outlineThickFactor := Shapes.outlineThickFactor
      this.fillOpacity         := Shapes.fillOpacity
      Switch this.Shape {
         Case Shapes.SHAPE_TAPARROW:
            this.shapeOpacity := Shapes.arrowOpacity
            this.shapeThickness := Shapes.arrowLineThickness * this.Factor * this.DPIFactor * 2
         Case Shapes.SHAPE_ARROW, Shapes.SHAPE_OARROW, Shapes.SHAPE_ODARROW:
            this.shapeOpacity := Shapes.arrowOpacity
            this.shapeThickness := Shapes.arrowLineThickness * this.Factor * this.DPIFactor
         Case Shapes.SHAPE_LINE, Shapes.SHAPE_BRACKET, Shapes.SHAPE_CONNECT:
            this.shapeThickness := Shapes.rawLineThickness * this.Factor * this.DPIFactor
         Default:
      }
   }

   /**
    * Configures GDI+ pens, brushes, and caps prior to drawing or refreshing the shape
    */
   Startup() {
      super.Startup()
      Switch this.Shape {

         Case Shapes.SHAPE_ARROW, Shapes.SHAPE_TAPARROW:
            ; filled = 1 solid triangle, =0 just two lines
            ; Width will be N x Pen Width
            If (this.shape = Shapes.SHAPE_TAPARROW) {
               ; Tapered window fill color
               this.fBrush := this.myBrushes.Add(this.shapeOpacity << 24 | this.Color)
               ; no cap since converging to a point
               GDIp.SetPenStartCap(this.pPrime, 0)
               ; Outline pen
               this.pOutline := this.myPens.Add(this.outlineOpacity << 24 | this.outlineColor, this.shapeThickness * this.outlineThickFactor / 6) ; Grey thickness/color of the outer border
               GDIp.SetPenLineJoin(this.pOutline, 2)  ;1=bevel, 2=rounded

            } Else {
               GDIp.CustomArrowCap(this.pPrime, 5, 4, 1, 1)
               ; Rounded Start
               GDIp.SetPenStartCap(this.pPrime, 2)
            }
            GDIp.SetPenAlignment(this.pPrime, 0)

         Case Shapes.SHAPE_OARROW, Shapes.SHAPE_ODARROW:
            ; Outline arrow is a little more complex to draw
            this.pOutline := this.myPens.Add(this.outlineOpacity << 24 | this.outlineColor, this.shapeThickness * this.outlineThickFactor / 3) ; Grey thickness/color of the outer border
            GDIp.CustomArrowCap(this.pPrime, 5, 4, 1, 1, this.shape = Shapes.SHAPE_ODARROW)
            ; GDIp.CustomArrowCap(this.pOutline, 5, 4, 1, 1, this.shape = Shapes.SHAPE_ODARROW) ; This isn't necessary since we are drawing along a path
            GDIp.SetPenLineJoin(this.pOutline, 2)  ;1=bevel, 2=rounded, round the outline only

         Case Shapes.SHAPE_BRACKET:
            GDIp.SetPenLineJoin(this.pPrime, 2)  ;1=bevel, 2=rounded
            GDIp.SetPenAlignment(this.pPrime, 0) ; center
            GDIp.SetPenLineCaps(this.pPrime, 3, 3) ; triangles

         Case Shapes.SHAPE_LINE:
            GDIp.SetPenAlignment(this.pPrime, 0) ; doesn't matter
            GDIp.SetPenLineCaps(this.pPrime, 2, 2) ; rounded, joins better when snapped
         Case Shapes.SHAPE_CONNECT:
            GDIp.SetPenLineJoin(this.pPrime, 2)  ;1=bevel, 2=rounded
            GDIp.SetPenAlignment(this.pPrime, 0) ; doesn't matter
            GDIp.SetPenLineCaps(this.pPrime, 0x12, 0x12) ; triangles
            ; Fraction of the way along the run where the middle segment sits.
            ; Startup runs on every redraw, so keep a value the user has dragged.
            If (NOT this.HasOwnProp("MidPos") OR this.MidPos = "")
               this.MidPos := 0.5
      }
   }

   /**
    * Set a new color for this shape for subsequent draw actions
    * @param {Integer} newColor - The ARGB color to apply
    */
   SetColor(newColor) {
      super.SetColor(newColor)
      If (this.HasProp("fBrush")) { ; highlight/redact brush
          GDIp.SetBrushColor(this.fBrush, this.shapeOpacity << 24 | newColor)
      }
   }

   /**
    * Draw a new line shape at X/Y & W/H
    * @param {Ptr} G - Graphics Handle
    * @param {Number} X1 - X Location of start
    * @param {Number} Y1 - Y Location of start
    * @param {Number} X2 - X Location of finish
    * @param {Number} Y2 - Y Location of finish
    */
   Draw(G, X1, Y1, X2, Y2) {
      ; Lines/arrows bent with the "Bend" control point are drawn as a curve through
      ; start, control point and end; 0 = straight (the original drawing below)
      bend := this._BendPoints(X1, Y1, X2, Y2)
      Switch this.shape {
         Case Shapes.SHAPE_OARROW, Shapes.SHAPE_ODARROW:
            oPath := GDIp.Path(G)
            If (bend)
               oPath.AddPathCurve2(bend)
            Else
               oPath.AddPathLine(X1, Y1, X2, Y2)
            oPath.WidenPath(this.pPrime)
            oPath.DrawPath(this.pOutline)
            ; If we are not opaque we have to remove the arrow-head inside lines from the shape
            ; by overwriting the inside of the path before drawing the translucent line to fill it
            If (this.shapeOpacity < 255) {
                oPath.SolidFillPath(this.blankBrush)
            }

            oPath := ""
            If (bend)
               this._DrawCurve(G, this.pPrime, bend)       ; inside pen
            Else
               GDIp.DrawLine(G, this.pPrime, X1, Y1, X2, Y2) ; inside pen

         Case Shapes.SHAPE_TAPARROW:
            ; Start point is tiny, hard to grab
            If (bend)
               this._DrawCurve(G, this.pGrab, bend)
            Else
               GDIp.DrawLine(G, this.pGrab, X1, Y1, X2, Y2)
            ; Create the arrow left to right on the 0 X centerline then rotate/translate into the graphics space
            T := GDIp.GetPenWidth(this.pPrime) ; Everything scales off the primary thickness
            W := T * 2 ; width of tip (Y dimension)
            H := T * 2 ; length of tip (X dimension)
            I := T * 0.25 ; Inset of tip from length (X dimension)
            L := Sqrt((X1 - X2) ** 2 + (Y1 - Y2) ** 2)
            ; Bent: the same outline built along the curve, already in place
            pArray := bend ? this._TaperCurvePolygon(bend, T, W, H, I) : 0
            oPath := GDIp.Path(G)
            If (pArray) {
               oPath.SetPathFillMode(1)   ; winding: a tight bend folds the inner side over itself
               oPath.AddPathArray(pArray, 1)
               oPath.ClosePathFigure()
            } Else {
               ; Coordinates of the tapered arrow
               pArray := [[0, 0], [L - H + I, T / 2], [L - H, W / 2], [L, 0], [L - H, -W / 2], [L - H + I, -T / 2]]
               oPath.AddPathArray(pArray, 1)
               oPath.ClosePathFigure()
               ; Compute the rotation angle and rotate the arrow (around graphics origin), then translate to the start point
               ; 2.1 has proper Atan2
               Ang := myAngle(Y2 - Y1, X2 - X1)
               oPath.TranslateRotatePath(Ang, X1, Y1)
            }
            ; HACK - we center on the path, so we overlap it by half. Which is ok for opacity=255, but we get blending otherwise
            If (this.shapeOpacity < 255)
                GDIp.SetCompositingMode(G, 1) ; not a fan, but will work to stop the blending
            ; oPath.WidenPath(this.pOutline) ; Leaves a hole in the middle since the path is replaced by the outline of the pen
            oPath.DrawPath(this.pOutline)
            oPath.FillPath(this.fBrush)
            oPath := ""

         Case Shapes.SHAPE_CONNECT:
            GDIp.DrawLine(G, this.pGrab, X1, Y1, X2, Y2) ; grab points
            ; Initial drawing direction is saved for reuse
            If (this.HasOwnProp("InitXY")) {
                dx := Abs(X2 - this.InitXY.X1)
                dy := Abs(Y2 - this.InitXY.Y1)
               ; Wait untill we have a clear direction
                If ( Not this.HasOwnProp("HasDirection") AND (dx > 50 OR dy > 50)) {
                   this.HasDirection := dx > dy
                }
            } Else {
                this.InitXY := { X1: X1, X2: X2, Y1: Y1, Y2: Y2 }
            }
            ; Orientation depends on initial drawing direction
            If (this.HasDirection ?? true) {
                X50 := X1 + (X2 - X1) * this.MidPos
                pArray := [[X1, Y1], [X50, Y1], [X50, Y2], [X2, Y2]]
            } Else {
                Y50 := Y1 + (Y2 - Y1) * this.MidPos
                pArray := [[X1, Y1], [X1, Y50], [X2, Y50], [X2, Y2]]
            }
            oPath := GDIp.Path(G)
            oPath.AddPathArray(pArray, 0)
            oPath.DrawPath(this.pPrime) 
            oPath := ""

         Case Shapes.SHAPE_BRACKET:
            /*
               Compute the raw shape then rotate into place around the start point
               This method can be used to draw any shape that follows the start/end
               point while drawing.
            */
            GDIp.DrawLine(G, this.pGrab, X1, Y1, X2, Y2) ; grab points
            ; Bracket unique stuff
            ; Create an array of the unrotated points for the bracket shape then put them into a points array
            ; The triangle's position/depth can be moved with the "Notch" control point
            B := this.BracketGeom(X1, Y1, X2, Y2)
            notch := B.notch, dX := B.dX
            s1 := B.s1           ; start of the triangle base (end of the first flat segment)
            ; pArray := [[0, notch], [0, 0], [(0.5 - pOffset) * dX, 0], [dX / 2, -notch], [(0.5 + pOffset) * dX, 0], [dX, 0], [dX, +notch]]
            ;    |_____________  _______________|
            ;                  \/
            pArray := [[0, notch], [0, 0], [s1, 0], [B.c, -B.depth], [s1 + B.s2, 0], [dX, 0], [dX, +notch]]
            ; Translate/Rotate and Draw the points into the current context
            oPath := GDIp.Path(G)
            oPath.AddPathArray(pArray, 0)
            ; Rotate the bracket (around graphics origin), then translate to the start point
            oPath.TranslateRotatePath(B.Ang, X1, Y1)
            oPath.DrawPath(this.pPrime)
            oPath := ""

         Default: ; SHAPE_LINE, SHAPE_ARROW
            If (bend) {
               this._DrawCurve(G, this.pGrab, bend)
               this._DrawCurve(G, this.pPrime, bend)
            } Else {
               GDIp.DrawLine(G, this.pGrab, X1, Y1, X2, Y2)
               GDIp.DrawLine(G, this.pPrime, X1, Y1, X2, Y2)
            }

      }
      this.shapeCoord := { X1: X1, X2: X2, Y1: Y1, Y2: Y2}
   }

   /**
    * Redraw a line shape based on existing coordinates and properties
    * Adjust padding dynamicily to ensure we can spill shape beyound coordinates
    */
   Refresh() {
      ; internal shape boundaries and padding
      C := this.shapeCoord
      If (C.W > 0 OR C.H > 0) {
         If (NOT this.Started) {
            started := true
            this.Startup()
         }
         ;----------------------------------------------------------------------
         ; The window is placed using the padding the surface was drawn with, so
         ; sPad must equal that padding afterwards, or GetPos/Move (and the focus
         ; box) end up offset from the line. If the measured extent needs different
         ; padding (thickness change, a bend/notch drag that grew it), redraw once
         ; with it before placing the window. Usually it matches: one pass.
         ;----------------------------------------------------------------------
         Loop 2 {
            P := this.sPad
            r := this._DrawSurface(C, P)
            If (A_Index = 2)
               Break
            ; Padding the drawn extent needs
            ; NOTE - if we jumped our pen thickness too much this won't be enough padding
            ext := r.Surf.FindExtent(P.L, P.T, C.W, C.H, Shapes.shapePad)
            If (ext.L = P.L AND ext.T = P.T AND ext.R = P.R AND ext.B = P.B)
               Break
            this.savePadding(ext.L, ext.T, ext.R, ext.B)
            r := ""
         }
         ; Locate shape on surface
         r.Surf.UpdateLayer(r.X, r.Y)
         r := ""
         If (IsSet(started)) {
            this.CleanUp()
         }
      }
   }

   /**
    * Draw the line shape onto a new surface for export, with its current padding and
    * without touching its window or saved state (see commonShape.RenderSurface)
    * @returns {Object|Integer} {Surf, X, Y} or 0
    */
   RenderSurface() {
      C := this.shapeCoord
      If NOT (C.W > 0 OR C.H > 0)
         Return 0
      If (NOT this.Started) {
         started := true
         this.Startup()
      }
      r := this._DrawSurface(C, this.sPad)
      If (IsSet(started))
         this.CleanUp()
      Return r
   }

   /**
    * Draw the shape onto a new surface sized by coordinates C plus padding P.
    * Shared by Refresh (screen) and RenderSurface (export).
    * @returns {Object} {Surf, X, Y}: surface and its snip position
    */
   _DrawSurface(C, P) {
      ; Location of shape on surface (with padding)
      shapeX := (C.X - P.L), shapeY := (C.Y - P.T)
      ; Create DIB with padding
      Surf := GDIp.DIBSurface(P.L + P.R + C.W, P.T + P.B + C.H, this.Hwnd)
      ; Draw shape (translate by snip position)
      Surf.Translate(-shapeX, -shapeY)
      this.Draw(Surf.G, C.X1, C.Y1, C.X2, C.Y2)
      Return { Surf: Surf, X: shapeX, Y: shapeY }
   }
      /**
    * InstanceInfo
    * Get the key unique instance info to recreate this shape instance
    * @returns {FreeHandShape} 
    */
   InstanceInfo() {
      infoObj := super.InstanceInfo()
      ; Connectors have direction and a middle segment position
      if this.HasOwnProp("HasDirection")
         infoObj.HasDirection  := this.HasDirection
      this._AddControlState(infoObj)
      return infoObj
   }
   /**
    * Resize info for undo/redo, plus control point state (undo of a control point drag
    * restores it)
    * @returns {Object}
    */
   ResizeInfo() {
      info := super.ResizeInfo()
      this._AddControlState(info)
      return info
   }
   /**
    * Copy the control point state (connector MidPos, bracket BrPos/BrDepth) into info.
    * Always included for the shape that owns them, "" meaning "default", so undo of
    * the first drag can put an untouched shape back.
    */
   _AddControlState(info) {
      Switch this.Shape {
         Case Shapes.SHAPE_CONNECT: props := ["MidPos"]
         Case Shapes.SHAPE_BRACKET: props := ["BrPos", "BrDepth"]
         Case Shapes.SHAPE_LINE, Shapes.SHAPE_ARROW, Shapes.SHAPE_OARROW, Shapes.SHAPE_ODARROW, Shapes.SHAPE_TAPARROW:
            props := ["BendT", "BendD"]
         Default: Return
      }
      For prop in props
         info.%prop% := this.HasOwnProp(prop) ? this.%prop% : ""
   }

      /*
         1-------------------------------------------------2
         |                                                 |
         |               Line Corners                      |
         |                                                 |
         6-------------------------------------------------4

         Lines have corners of 1/4 or 4/1 2/6, 6/2 depending on their
         orientation and direction.
    */
   FocusSquare => false

   /**
    * Returns shape information for focus points and the corner the mouse is over
    * @returns {Array} - Array of point objects containing corner index and relative coordinates
    */
   FocusPoints() {
      ; Static ResizePoints := Array() ; NOTE these need to offset relative to shape not window
      C := this.shapeCoord
      ; Line start is always Corner 1/9 and Line Finish is always Corner 4/10 (lean sets cursor angle)
      ; If XOR we flag the alternate cursor to use
      If ((C.Y2 > C.Y1) ^ (C.X2 > C.X1)) {
         ; NESW cursor
         ; ResizePoints.push({ C: 2, X: C.X1 - C.X, Y: C.Y1 - C.Y }, { C: 6, X: C.X2 - C.X, Y: C.Y2 - C.Y })
          pts := [{ C: 2, X: C.X1 - C.X, Y: C.Y1 - C.Y }, { C: 6, X: C.X2 - C.X, Y: C.Y2 - C.Y }]
      } Else {
         ; NWSE cursor
         ; ResizePoints.push({ C: 1, X: C.X1 - C.X, Y: C.Y1 - C.Y }, { C: 4, X: C.X2 - C.X, Y: C.Y2 - C.Y })
          pts := [{ C: 1, X: C.X1 - C.X, Y: C.Y1 - C.Y }, { C: 4, X: C.X2 - C.X, Y: C.Y2 - C.Y }]
      }
      ;----------------------------------------------------------------------
      ; Control points (see commonShape): sections of the shape that can be moved
      ;----------------------------------------------------------------------
      If (this.Shape = Shapes.SHAPE_CONNECT) {
         ; Middle of the centre segment; it slides along the run (left/right when the
         ; connector was drawn horizontally first, otherwise up/down)
         mid := this.ConnectMidPoint()
         pts.Push({ C: 9, Ctrl: "Mid", Cur: mid.Horz ? "SizeEW" : "SizeNS", X: mid.X - C.X, Y: mid.Y - C.Y })
      } Else If (this.Bendable) {
         ; Middle of the line: drag it to bend the line/arrow into a curve.
         ; Listed after the end points so they win where they overlap on short lines.
         M := this.BendPoint(C.X1, C.Y1, C.X2, C.Y2)
         pts.Push({ C: 9, Ctrl: "Bend", Cur: "SizeAll", X: M.X - C.X, Y: M.Y - C.Y })
      } Else If (this.Shape = Shapes.SHAPE_BRACKET) {
         ; Tip of the centre triangle: along the bracket moves it, across sets its depth
         tip := this.BracketTip()
         pts.Push({ C: 9, Ctrl: "Notch", Cur: "SizeAll", X: tip.X - C.X, Y: tip.Y - C.Y })
      }
      return pts
   }
   /**
    * Centre of a connector's middle segment, in snip coordinates
    * @returns {Object} {X, Y, Horz}: Horz true when the segment moves left/right
    */
   ConnectMidPoint() {
      C    := this.shapeCoord
      horz := this.HasOwnProp("HasDirection") ? this.HasDirection : true   ; Draw() defaults to true
      mp   := (this.HasOwnProp("MidPos") AND this.MidPos != "") ? this.MidPos : 0.5
      If (horz)
         Return { X: C.X1 + (C.X2 - C.X1) * mp, Y: (C.Y1 + C.Y2) / 2, Horz: true }
      Return { X: (C.X1 + C.X2) / 2, Y: C.Y1 + (C.Y2 - C.Y1) * mp, Horz: false }
   }
   /**
    * True for the line/arrow shapes that can be bent with the "Bend" control point
    * @type {Integer}
    */
   Bendable => (this.Shape = Shapes.SHAPE_LINE OR this.Shape = Shapes.SHAPE_ARROW
             OR this.Shape = Shapes.SHAPE_OARROW OR this.Shape = Shapes.SHAPE_ODARROW
             OR this.Shape = Shapes.SHAPE_TAPARROW)

   /**
    * Snip position of the "Bend" control point for a line from X1,Y1 to X2,Y2.
    * Stored relative to the line (BendT: fraction along it, BendD: pixels to its left
    * side looking from start to end) so resizing by the ends keeps the curve's shape.
    * @returns {Object} {X, Y}
    */
   BendPoint(X1, Y1, X2, Y2) {
      t := (this.HasOwnProp("BendT") AND this.BendT != "") ? this.BendT : 0.5
      d := (this.HasOwnProp("BendD") AND this.BendD != "") ? this.BendD : 0
      len := Sqrt((X2 - X1) ** 2 + (Y2 - Y1) ** 2)
      If (len < 1)
         Return { X: X1, Y: Y1 }
      ux := (X2 - X1) / len, uy := (Y2 - Y1) / len
      Return { X: X1 + (X2 - X1) * t - uy * d, Y: Y1 + (Y2 - Y1) * t + ux * d }
   }

   /**
    * Curve points for a bent line, or 0 if the line is straight (or not bendable)
    * @returns {Array|Integer} [[start], [control point], [end]] or 0
    */
   _BendPoints(X1, Y1, X2, Y2) {
      If (NOT this.Bendable OR NOT this.HasOwnProp("BendD") OR this.BendD = "" OR this.BendD = 0)
         Return 0
      M := this.BendPoint(X1, Y1, X2, Y2)
      Return [[X1, Y1], [M.X, M.Y], [X2, Y2]]
   }

   /**
    * Outline of a bent tapered arrow: the straight version's shape laid along the
    * cardinal curve through start, control point and end. The shaft widens from 0 at
    * the start to T where it meets the head; the head (base width W, length H, shaft
    * joins I in front of the base) points from the curve point H before the end to the end.
    * The curve is the same one GDI+ draws for AddPathCurve2 at tension 0.5 (cubic
    * Beziers with control points tension/3 along the neighbouring chords).
    * @param {Array} pts - [[start], [control point], [end]]
    * @returns {Array|Integer} polygon points, or 0 if the curve is too short for a head
    */
   _TaperCurvePolygon(pts, T, W, H, I) {
      k := 0.5 / 3
      P0 := pts[1], P1 := pts[2], P2 := pts[3]
      ; (AHK names are case-insensitive: no t/n/i locals, they would be T/N/I)
      ; Two cubic segments: P0 -> P1 -> P2
      segs := [[P0, [P0[1] + k * (P1[1] - P0[1]), P0[2] + k * (P1[2] - P0[2])]
                  , [P1[1] - k * (P2[1] - P0[1]), P1[2] - k * (P2[2] - P0[2])], P1]
             , [P1, [P1[1] + k * (P2[1] - P0[1]), P1[2] + k * (P2[2] - P0[2])]
                  , [P2[1] + k * (P1[1] - P2[1]), P2[2] + k * (P1[2] - P2[2])], P2]]
      ; Sample the curve with cumulative arc length
      segN := 32
      sx := [P0[1]], sy := [P0[2]], sl := [0]
      For sg in segs {
         Loop segN {
            tt := A_Index / segN, u := 1 - tt
            a := u * u * u, b := 3 * u * u * tt, c := 3 * u * tt * tt, d := tt * tt * tt
            x := a * sg[1][1] + b * sg[2][1] + c * sg[3][1] + d * sg[4][1]
            y := a * sg[1][2] + b * sg[2][2] + c * sg[3][2] + d * sg[4][2]
            sl.Push(sl[sl.Length] + Sqrt((x - sx[sx.Length]) ** 2 + (y - sy[sy.Length]) ** 2))
            sx.Push(x), sy.Push(y)
         }
      }
      cnt := sx.Length, S := sl[cnt]
      If (S <= H + 1)
         Return 0
      ; Head base: the curve point H before the end; head axis from there to the tip
      sb := S - H
      Loop cnt - 1 {
         j := A_Index
         If (sl[j + 1] >= sb)
            Break
      }
      f  := (sb - sl[j]) / Max(sl[j + 1] - sl[j], 1e-9)
      bx := sx[j] + (sx[j + 1] - sx[j]) * f, by := sy[j] + (sy[j + 1] - sy[j]) * f
      hl := Sqrt((P2[1] - bx) ** 2 + (P2[2] - by) ** 2)
      If (hl < 1)
         Return 0
      ux := (P2[1] - bx) / hl, uy := (P2[2] - by) / hl
      ; Shaft half width grows linearly to T/2 where it meets the head
      span := sb + I
      left := [], right := []
      Loop j {
         ix := A_Index
         ; Direction at the sample (central difference)
         dx := sx[Min(ix + 1, cnt)] - sx[Max(ix - 1, 1)], dy := sy[Min(ix + 1, cnt)] - sy[Max(ix - 1, 1)]
         dl := Sqrt(dx * dx + dy * dy)
         If (dl < 1e-9)
            Continue
         hw := (T / 2) * sl[ix] / span
         nx := -dy / dl * hw, ny := dx / dl * hw
         left.Push([sx[ix] + nx, sy[ix] + ny])
         right.Push([sx[ix] - nx, sy[ix] - ny])
      }
      vx := -uy, vy := ux   ; head normal (same side as "left")
      pArray := left
      pArray.Push([bx + ux * I + vx * T / 2, by + uy * I + vy * T / 2])
      pArray.Push([bx + vx * W / 2, by + vy * W / 2])
      pArray.Push([P2[1], P2[2]])
      pArray.Push([bx - vx * W / 2, by - vy * W / 2])
      pArray.Push([bx + ux * I - vx * T / 2, by + uy * I - vy * T / 2])
      Loop right.Length
         pArray.Push(right[right.Length + 1 - A_Index])
      Return pArray
   }

   /**
    * Draw an open cardinal curve (GDI+ default tension 0.5) through the points.
    * Pen caps (arrowheads) follow the curve's direction at its ends.
    */
   _DrawCurve(G, pen, pts) {
      P := GDIp.Path(G)
      P.AddPathCurve2(pts, 0.5)
      P.DrawPath(pen)
   }

   /**
    * Bracket geometry in its own frame: x along the bracket from (X1,Y1), y across it
    * (the triangle points to -y). Shared by Draw and the "Notch" control point.
    * @returns {Object} {dX: length, notch: end-tick depth, s2: triangle base width,
    *                    c: triangle centre along x, s1: start of the base, depth: triangle
    *                    height, Ang: rotation in degrees, cos, sin}
    */
   BracketGeom(X1, Y1, X2, Y2) {
      Static notchSize := 0
      If (NOT notchSize)
         notchSize := 15 * this.DPIFactor   ; depth of the end ticks (first shape's DPI, as before)
      dX := Sqrt((X1 - X2) ** 2 + (Y1 - Y2) ** 2)
      s2 := Min(notchSize * 2, 0.2 * dX) ; width of callout, 20% nomoly but no bigger than 2x notch size
      pos   := (this.HasOwnProp("BrPos") AND this.BrPos != "") ? this.BrPos : 0.5
      depth := (this.HasOwnProp("BrDepth") AND this.BrDepth != "") ? this.BrDepth : notchSize
      c  := dX * pos
      ; 2.1 has proper Atan2
      Ang := myAngle(Y2 - Y1, X2 - X1)
      Return { dX: dX, notch: notchSize, s2: s2, c: c, s1: (dX - s2) / 2 + (c - dX / 2), depth: depth
             , Ang: Ang, cos: Cos(Ang * 0.017453292519943), sin: Sin(Ang * 0.017453292519943) }
   }
   /**
    * Snip position of the bracket's triangle tip
    * @returns {Object} {X, Y}
    */
   BracketTip() {
      C := this.shapeCoord
      B := this.BracketGeom(C.X1, C.Y1, C.X2, C.Y2)
      ; local (c, -depth) rotated by Ang, then moved to the start point
      Return { X: C.X1 + B.c * B.cos + B.depth * B.sin, Y: C.Y1 + B.c * B.sin - B.depth * B.cos }
   }
   /**
    * Grow the padding so a point (plus a margin) is inside the drawing area on the next
    * Refresh. Refresh only grows padding a little per redraw, so a fast drag could clip.
    * The extent pass in Refresh trims any excess afterwards.
    */
   _EnsurePadFor(X, Y, m) {
      C := this.shapeCoord, P := this.sPad
      this.sPad := { L: Ceil(Max(P.L, C.X - X + m)), T: Ceil(Max(P.T, C.Y - Y + m))
                   , R: Ceil(Max(P.R, X - (C.X + C.W) + m)), B: Ceil(Max(P.B, Y - (C.Y + C.H) + m)) }
   }
   /**
    * Control point drag (see commonShape):
    *  "Mid"   - slides the connector's middle segment; kept between the end points so
    *            the shape stays inside its drawing area
    *  "Notch" - bracket triangle: along the bracket moves it, across sets its depth
    * @param {String} name - Ctrl name
    * @param {Number} X - Snip X of the mouse
    * @param {Number} Y - Snip Y of the mouse
    */
   ControlDrag(name, X, Y) {
      If (name = "Bend" AND this.Bendable) {
         C := this.shapeCoord
         len := Sqrt((C.X2 - C.X1) ** 2 + (C.Y2 - C.Y1) ** 2)
         If (len < 1)
            Return
         ux := (C.X2 - C.X1) / len, uy := (C.Y2 - C.Y1) / len
         vx := X - C.X1, vy := Y - C.Y1
         ; Along the line (kept off the ends so the curve stays well formed) and across it
         this.BendT := Constrain(0.1, 0.9, (vx * ux + vy * uy) / len)
         d := -vx * uy + vy * ux
         ; Back near the straight line: snap straight
         this.BendD := (Abs(d) < 4 * this.DPIFactor) ? 0 : d
         ; Make room for the curve and for the end caps, which turn with it
         ; (AHK names are case-insensitive: don't call these M and m)
         bp     := this.BendPoint(C.X1, C.Y1, C.X2, C.Y2)
         margin := this.shapeThickness * 2 + Shapes.shapePad
         this._EnsurePadFor(bp.X, bp.Y, margin + Abs(this.BendD) * 0.15)   ; a cardinal curve can bulge slightly past it
         cap := this.shapeThickness * 6 + Shapes.shapePad
         this._EnsurePadFor(C.X1, C.Y1, cap)
         this._EnsurePadFor(C.X2, C.Y2, cap)
         this.Refresh()
         Return
      }
      If (name = "Notch" AND this.Shape = Shapes.SHAPE_BRACKET) {
         C := this.shapeCoord
         B := this.BracketGeom(C.X1, C.Y1, C.X2, C.Y2)
         If (B.dX < 1)
            Return
         vx := X - C.X1, vy := Y - C.Y1
         along := vx * B.cos + vy * B.sin          ; along the bracket
         depth := vx * B.sin - vy * B.cos          ; across it, toward the tip side
         half  := B.s2 / 2
         ; keep the whole triangle base on the bracket line; depth 0 = flat
         this.BrPos   := Constrain(half / B.dX, 1 - half / B.dX, along / B.dX)
         this.BrDepth := Max(0, depth)
         tip := this.BracketTip()
         this._EnsurePadFor(tip.X, tip.Y, this.shapeThickness * 2 + Shapes.shapePad)
         this.Refresh()
         Return
      }
      If (name != "Mid" OR this.Shape != Shapes.SHAPE_CONNECT)
         Return
      C := this.shapeCoord
      If (this.ConnectMidPoint().Horz) {
         If (C.X2 = C.X1)
            Return
         this.MidPos := Constrain(0, 1, (X - C.X1) / (C.X2 - C.X1))
      } Else {
         If (C.Y2 = C.Y1)
            Return
         this.MidPos := Constrain(0, 1, (Y - C.Y1) / (C.Y2 - C.Y1))
      }
      this.Refresh()
   }

}