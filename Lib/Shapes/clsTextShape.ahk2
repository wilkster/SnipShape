/************************************************************************
 * @description Text Shapes and Edit Control
 * @author Tom Wilkason
 * @date 2026/03/09
 * @version 1.0.0
 ***********************************************************************/
#Requires AutoHotkey v2.0 
#include clsCommonShape.ahk2
#include ..\Settings.ahk2
#Include ..\libMisc.ahk2
#Include ..\clsGDIp.ahk2
#Include ..\clsBitmap.ahk2
#Include ..\Theming.ahk2
#Include ..\clsShapes.ahk2
#Include ..\clsCursor.ahk2
#include ..\ColorPopDown.ahk2
/**
 * PicPlus class that extends the base picture class
 * @param {number} 
 * @returns {number} 
 * TODO - replace static AddPicturePlus with __Call??
 */
; IDEA - could use a big blur vs a opaque fill text of bg color to block background
;        will have to deal with irregular shpes though
Class TextShape extends CommonShape {
; @ lint-disable class-non-dynamic-member-check
   Static TagFontName     := IniReadValue("Text", "Tag Font Name", "Tahoma")
   Static TagFontStyle    := IniReadValue("Text", "Tag Font Style", "Bold")
   Static TagFontSize     := IniReadValue("Text", "Tag Font Size", 15)
   Static TCOpacity       := IniReadValue("Text", "Tag Center Opacity", 160)

   Static FillFontName    := IniReadValue("Text", "Fill Font Name", "Tahoma")
   Static FillFontStyle   := IniReadValue("Text", "Fill Font Style", "Bold")
   Static FillAlignment   := IniReadValue("Text", "Fill Text Alignment", "Center")
   Static FillFontSize    := IniReadValue("Text", "Fill Font Size", 12)
   Static FTOpacity       := IniReadValue("Text", "Fill Text Opacity", 192)
   Static FTOLOpacity     := IniReadValue("Text", "Outline Opacity", 255)
   Static FillOutline     := IniReadValue("Text", "Rectangle Around Text", "None")

   Static OLFontName      := IniReadValue("Text", "Outline Font Name", "Verdana")
   Static OLFontStyle     := IniReadValue("Text", "Outline Font Style", "Bold")
   Static OLAlignment     := IniReadValue("Text", "Outline Font Alignment", "Left")
   Static OLFontSize      := IniReadValue("Text", "Outline Font Size", 15)
   Static OLOpacity       := IniReadValue("Text", "Outline Edge Opacity", 160)
   Static OLFillThickness := IniReadValue("Text", "Outline Width Percent",16)
   Static OLBlur          := IniReadValue("Text", "Outline Blur Value",1)
   Static textOpacity     := IniReadValue("Text", "Text Opacity", 0xFF)
   /**
    * Initialize instance properties unique to text shapes.
    * Called on creation; sets source type, default font, alignment, color, and opacity values.
    */
   Init(*) {
      Super.Init()
      this.Source               := "Text"
      this.sText                := ""
      this.Corner               := 0
      this._Text                := ""
      this._fontName            := "Arial"
      this.DPIFactor            := A_ScreenDPI / 96
      this._fontSize            := 12 ; Round(12 * pOBJ.DPIFactor)
      this._ogFontSize          := 0
      this._Alignment           := "Left"  ; Left|Center|Right
      this._calloutArrowDivisor := 6
      this._fontColor           := Shapes.globalShapeColor
      this.textOpacity          := TextShape.textOpacity
      this.TCOpacity            := TextShape.TCOpacity
      this.FTOpacity            := TextShape.FTOpacity
      this.FillOutline          := TextShape.FillOutline
      this.FTOLOpacity          := TextShape.FTOLOpacity
      this.OLOpacity            := TextShape.OLOpacity
      this.OLFillThickness      := TextShape.OLFillThickness
      this.OLBlur               := TextShape.OLBlur
      this._fontStyle           := "Bold"
      this.FocusRecOn           := false
      this._BGColor             := 0x000000
      this.shapeCoord           := { X1: 0, Y1: 0, X2: 0, Y2: 0}
      this.EditHeight           := unset
      this.EditWidth            := unset
      this.Tip                  := ""      ; callout tip {X, Y} in snip coordinates, "" = none
      this._tailShown           := false
   }
   /**
    * Property a changed button bar default sets on this shape (see commonShape.StyleTarget).
    * The text properties have the same names as the TextShape defaults. Fonts, sizes
    * and alignment are not applied.
    */
   StyleTarget(key) {
      S := this.Shape
      isFill := (S = Shapes.SHAPE_FILLTEXT OR S = Shapes.SHAPE_LEFTARROWTEXT OR S = Shapes.SHAPE_RIGHTARROWTEXT)
      Switch key, false {
         Case "textOpacity":
            ok := true
         Case "TCOpacity":
            ok := (S = Shapes.SHAPE_TAG)
         Case "FTOpacity", "FTOLOpacity":
            ok := isFill
         Case "FillOutline":
            ok := (S = Shapes.SHAPE_FILLTEXT)
         Case "OLOpacity", "OLBlur", "OLFillThickness":
            ok := (S = Shapes.SHAPE_OLTEXT)
         Default:
            ok := false
      }
      Return ok ? { Prop: key, Scale: false } : 0
   }
   /**
    * Configure text and font properties prior to drawing.
    * Font size, colors, and other characteristics may also be updated dynamically during resize events.
    * @param {Integer} [Size] - Font size in points
    * @param {String} [Text] - Text content to display
    * @param {String} [FontName] - Font family name
    * @param {String} [Alignment] - Horizontal alignment: "Left", "Center", or "Right"
    * @param {String} [Style] - Font style: "Normal", "Bold", "Italic", "BoldItalic", "Underline", or "Strikeout"
    * @param {Integer} [Color] - ARGB font color value
    * @param {Integer} [BGColor] - RGB background fill color value
    */
   Startup(Size?, Text?, FontName?, Alignment?, Style?, Color?, BGColor?) {
      super.Startup()
      If (IsSet(Size))
         this._fontSize := Size
      If (IsSet(Text))
         this._Text := Text
      If (IsSet(FontName))
         this._fontName := FontName
      If (IsSet(Alignment))
         this._Alignment := Alignment
      If (IsSet(Color))
         this._fontColor := Color ; includes alpha
      If (IsSet(Style))
         this._fontStyle := Style
      If (IsSet(BGColor))
         this._BGColor := BGColor & 0xFFFFFF
      Switch this.Shape {
         Case Shapes.SHAPE_TAG:
         Case Shapes.SHAPE_LEFTARROWTEXT, Shapes.SHAPE_RIGHTARROWTEXT:
         Case Shapes.SHAPE_FILLTEXT:
         Default:
      }
   }
   /**
    * Get or set the font family name
    * @type {String}
    */
   FontName {
      get => this._fontName
      Set => this._fontName := Value
   }
   /**
    * Get or set the font size in points
    * @type {Integer}
    */
   FontSize {
      get => this._fontSize
      set => this._fontSize := Value
   }
   /**
    * Get or set the text content displayed by this shape
    * @type {String}
    */
   Text {
      get => this._Text
      set => this._Text := Value
   }
   /**
    * Get or set the horizontal text alignment ("Left", "Center", or "Right")
    * @type {String}
    */
   Alignment {
      get => this._Alignment
      set => this._Alignment := Value
   }
   /**
    * Get or set the font style ("Normal", "Bold", "Italic", "BoldItalic", "Underline", or "Strikeout")
    * @type {String}
    */
   FontStyle {
      get => this._fontStyle
      set => this._fontStyle := Value
   }
   /**
    * Get or set the background fill color (RGB).
    * Setting this property also triggers a redraw of the text at the current position.
    * @type {Integer}
    */
   BGColor {
      get => this._BGColor
      set {
         this._BGColor := Value
         this.GetPos(&_X,&_Y)
         this.DrawText(_X,_Y,,,,,,,RGBVal(Value))
      }
   }

   /**
    * Set any supplied text properties, then render the shape with its text body at lX/lY.
    * Thin wrapper over Render() kept for the existing call sites.
    * @param {Integer} [lX] - Snip X of the text body's left edge (default: current position)
    * @param {Integer} [lY] - Snip Y of the text body's top edge (default: current position)
    * @param {Integer} [Size] - Font size in points; updates the stored value if provided
    * @param {String} [Text] - Text to render; updates the stored value if provided
    * @param {String} [FontName] - Font family name; updates the stored value if provided
    * @param {String} [Alignment] - Horizontal alignment ("Left", "Center", or "Right")
    * @param {String} [Style] - Font style string; updates the stored value if provided
    * @param {Integer} [Color] - ARGB font color; updates the stored value if provided
    * @param {Integer} [BGColor] - RGB background fill color; updates the stored value if provided
    * @returns {Integer} 1 on success, 0 if the font is invalid or no text was found
    */
   DrawText(lX?, lY?, Size?, Text?, FontName?, Alignment?, Style?, Color?, BGColor?) {
      If (IsSet(Size))
         this._fontSize := Size
      If (IsSet(Text))
         this._Text := Text
      If (IsSet(FontName))
         this._fontName := FontName
      If (IsSet(Alignment))
         this._Alignment := Alignment
      If (IsSet(Color))
         this._fontColor := Color ; includes alpha
      If (IsSet(Style))
         this._fontStyle := Style
      If (IsSet(BGColor))
         this._BGColor := BGColor & 0xFFFFFF
      Return this.Render(lX?, lY?)
   }

   /**
    * Render the shape and update its layered window.
    * The text "body" (the box the text and its border/fill occupy) is placed at bX/bY.
    * shapeCoord is the body; sPad is how far the window extends beyond it (0 unless a
    * callout tail sticks out), the same convention the drawn shapes use.
    * @param {Integer} [bX] - Snip X of the body's left edge (default: current position)
    * @param {Integer} [bY] - Snip Y of the body's top edge (default: current position)
    * @returns {Integer} 1 on success, 0 if the font is invalid or no text was found
    */
   Render(bX?, bY?) {
      bX := bX ?? this.sCoord.X
      bY := bY ?? this.sCoord.Y
      If !(r := this._RenderSurface(bX, bY))
         Return 0
      ; Update the window with the text (different than the underlying picture control)
      r.Surf.UpdateLayer(r.X, r.Y)
      r.Surf := ""
      ; Body coordinates: window minus padding
      win := r.win
      this.sPad := { L: win.offX, T: win.offY, R: win.W - win.offX - r.bodyW, B: win.H - win.offY - r.bodyH }
      this.UpdateCoord()
      Return 1
   }

   /**
    * Draw the text shape onto a new surface for export, without touching its window or
    * saved padding/coordinates (see commonShape.RenderSurface)
    * @returns {Object|Integer} {Surf, X, Y} or 0
    */
   RenderSurface() {
      C := this.shapeCoord
      Return this._RenderSurface(C.X1, C.Y1)
   }

   /**
    * Lay out and draw the shape with its body at bX/bY onto a new surface.
    * Shared by Render (screen) and RenderSurface (export).
    * @returns {Object|Integer} {Surf, X, Y (window position), win, bodyW, bodyH}, or 0
    *          if the font is invalid or there is no text
    */
   _RenderSurface(bX, bY) {
      If !(L := this._Layout())
         Return 0
      ;----------------------------------------------------------------------
      ; Window = body, plus any callout tail. off = body origin inside the window
      ;----------------------------------------------------------------------
      win := this._WindowBox(L, bX, bY)
      mySurf := DIBSurface(win.W, win.H, this.hWnd)
      G := mySurf.G
      ;--------------------------------------------------------------
      ; Quality Settings Here
      ;--------------------------------------------------------------
      GDIp.SetSmoothingMode(G, 4)                ; Anti Aliased 4x4 (most difference for shapes)
      GDIp.SetInterpolationMode(G, 7)            ; High Quality Bicubic
      GDIp.SetCompositingQuality(G, 5)           ; Linear, not sRGB
      GDIp.SetCompositingMode(G, 0)              ; Alpha blend, Source over
      GDIpText.SetTextRenderingHint(G, L.Rendering) ; AntiAliasGridFit for Text
      GDIpText.SetStringFormatAlign(L.hFormat, this._Alignment = "Left" ? 0 : (this._Alignment = "Center" ? 1 : 2))
      GDIpText.GdipSetStringFormatLineAlign(L.hFormat, 1) ; Vertical alignment is center
      GDIp.GraphicsClear(G, 0)
      ; Draw in body coordinates
      If (win.offX OR win.offY)
         mySurf.Translate(win.offX, win.offY)
      this._DrawBody(G, L, mySurf, win)
      If (L.tail)
         this._DrawTipGrab(G, L)
      ; Clean up the font objects
      GDIpText.DeleteStringFormat(L.hFormat)
      GDIpText.DeleteFont(L.hFont)
      GDIpText.DeleteFontFamily(L.hFamily)
      Return { Surf: mySurf, X: bX - win.offX, Y: bY - win.offY, win: win, bodyW: L.bodyW, bodyH: L.bodyH }
   }

   /**
    * Window placement for the current layout: the body, grown to include any callout.
    * @param {Object} L - Layout from _Layout()
    * @param {Number} bX - Snip X of the body
    * @param {Number} bY - Snip Y of the body
    * @returns {Object} {offX, offY, W, H}: body offset inside the window, and window size
    */
   _WindowBox(L, bX, bY) {
      L.tail := this._TailPolygon(L, bX, bY)
      If (NOT L.tail)
         Return { offX: 0, offY: 0, W: L.bodyW, H: L.bodyH }
      ; Only the tip can stick out (the tail base / arrow start is on or inside the body)
      ; Margin covers the arrowhead (4 line widths wide) or tail anti-aliasing, and the
      ; grab circle drawn at the tip
      If (this._IsArrowCallout)
         m := Max(this._ArrowWidth() * 3, this._ArrowGrabWidth() / 2) + 3
      Else
         m := this._HasFillOutline() ? L.outlineThickness + 3 : 3
      m := Max(m, Cursor.ResizeBox + 2)
      tip := L.tail[2]
      x1 := Min(0, tip[1] - m), y1 := Min(0, tip[2] - m)
      x2 := Max(L.bodyW, tip[1] + m), y2 := Max(L.bodyH, tip[2] + m)
      ; Whole pixels in snip coordinates
      wx1 := Floor(bX + x1), wy1 := Floor(bY + y1)
      wx2 := Ceil(bX + x2),  wy2 := Ceil(bY + y2)
      Return { offX: bX - wx1, offY: bY - wy1, W: wx2 - wx1, H: wy2 - wy1 }
   }

   ;======================================================================
   ; Callouts: a tail from the shape to a tip point the user drags out.
   ; this.Tip holds the tip in snip coordinates (it stays put when the body
   ; moves) or "" for no callout. While the tip is inside the shape nothing
   ; is drawn, so a text that never gets its tip dragged out has no callout.
   ;======================================================================
   /**
    * True if this text type can have a callout
    * @type {Integer}
    */
   CalloutCapable => (this.Shape = Shapes.SHAPE_TAG OR this.Shape = Shapes.SHAPE_FILLTEXT
                   OR this.Shape = Shapes.SHAPE_TEXT OR this.Shape = Shapes.SHAPE_OLTEXT)

   /**
    * True for text types whose callout is a straight arrow: plain and outline text, and
    * fill text with no border (its fill is sampled from the background, so a filled
    * tail with no border would blend into whatever is behind it).
    * Tags and bordered fill text get a filled triangular tail instead.
    * @type {Integer}
    */
   _IsArrowCallout => (this.Shape = Shapes.SHAPE_TEXT OR this.Shape = Shapes.SHAPE_OLTEXT
                    OR (this.Shape = Shapes.SHAPE_FILLTEXT AND NOT this._HasFillOutline()))

   /**
    * True for fill text drawn with a border
    */
   _HasFillOutline() => (this.Shape = Shapes.SHAPE_FILLTEXT AND this.FillOutline != "None")

   /**
    * Callout arrow line width: scales with the font (about a fifth of the text height).
    * The arrowhead is sized relative to this, so it scales with it.
    * @returns {Number} Width in pixels
    */
   _ArrowWidth() => Max(4, this._fontSize * A_ScreenDPI / 72 / this._calloutArrowDivisor )

   /**
    * Width of the near-invisible pen laid under the callout arrow so it is easy to grab
    * @returns {Number} Width in pixels
    */
   _ArrowGrabWidth() => 15 * this.DPIFactor

   /**
    * Draw the callout arrow for plain/outline/fill text: a straight line from the body's
    * outer edge (invisible for plain/outline text) to the tip, with the same arrowhead
    * as the arrow shapes.
    * Drawn last so the outline-text blur doesn't touch it.
    * @param {Ptr} G - Graphics handle
    * @param {Object} L - Layout (L.tail = [[edge X, Y], [tip X, Y]])
    */
   _DrawCalloutArrow(G, L) {
      If (NOT L.tail OR NOT this._IsArrowCallout)
         Return
      s := L.tail[1], t := L.tail[2]
      grabPen := GDIp.CreatePen(0x01000000, this._ArrowGrabWidth())
      GDIp.DrawLine(G, grabPen, s[1], s[2], t[1], t[2])
      GDIp.DeletePen(grabPen)
      pen := GDIp.CreatePen(this._fontColor, this._ArrowWidth())
      GDIp.CustomArrowCap(pen, 5, 4, 1, 1)
      GDIp.SetPenStartCap(pen, 2) ; rounded start
      GDIp.DrawLine(G, pen, s[1], s[2], t[1], t[2])
      GDIp.DeletePen(pen)
   }

   /**
    * True if the callout tail is currently drawn (tip set and outside the shape)
    * @type {Integer}
    */
   HasCallout => (this.CalloutCapable AND IsObject(this.Tip) AND this.HasOwnProp("_tailShown") AND this._tailShown)

   /**
    * The shape the tail or arrow starts from, in body coordinates: the Tag's circle,
    * otherwise the whole body box
    * @param {Object} L - Layout from _Layout()
    * @returns {Object} {Kind: "Ellipse"|"Rect", X, Y, W, H}
    */
   _CalloutBase(L) {
      R := L.RCTextF
      If (this.Shape = Shapes.SHAPE_TAG)
         Return { Kind: "Ellipse", X: R.X1, Y: R.Y1, W: R.W, H: R.H }
      Return { Kind: "Rect", X: 0, Y: 0, W: L.bodyW, H: L.bodyH }
   }

   /**
    * Compute the tail triangle in body coordinates.
    * The base sits across the shape's centre (hidden inside the shape) and is widened so
    * the tail has a steady width where it leaves the shape, whatever the tip distance.
    * @param {Object} L - Layout from _Layout()
    * @param {Number} bX - Snip X of the body
    * @param {Number} bY - Snip Y of the body
    * @returns {Array|Integer} [[base1], [tip], [base2]] or 0 when no tail is drawn
    */
   _TailPolygon(L, bX, bY) {
      this._tailShown := false
      If (NOT this.CalloutCapable OR NOT IsObject(this.Tip))
         Return 0
      ; (AHK names are case-insensitive, so the base can't be "B" next to semi-axis "b")
      base := this._CalloutBase(L)
      a  := base.W / 2, b := base.H / 2
      If (a <= 0 OR b <= 0)
         Return 0
      cx := base.X + a, cy := base.Y + b
      tx := this.Tip.X - bX, ty := this.Tip.Y - bY
      dx := tx - cx, dy := ty - cy
      len := Sqrt(dx * dx + dy * dy)
      If (len < 1)
         Return 0
      ux := dx / len, uy := dy / len
      ; Distance from the centre to the shape edge along the tail
      If (base.Kind = "Ellipse")
         r := 1 / Sqrt((ux / a) ** 2 + (uy / b) ** 2)
      Else
         r := Min(ux ? a / Abs(ux) : 1e9, uy ? b / Abs(uy) : 1e9)
      ; Tip still inside the shape: no callout
      If (len <= r + 1)
         Return 0
      ; Plain/outline/fill text: an arrow from the body edge to the tip
      If (this._IsArrowCallout) {
         this._tailShown := true
         Return [[cx + ux * r, cy + uy * r], [tx, ty]]
      }
      ; Half width where the tail leaves the shape (tags get a wider, pin-like tail)
      hwEdge := Min(a, b) * (base.Kind = "Ellipse" ? 0.5 : 0.35)
      hw     := Min(hwEdge * len / (len - r), Min(a, b) * 0.95)
      nx := -uy, ny := ux
      this._tailShown := true
      Return [[cx + nx * hw, cy + ny * hw], [tx, ty], [cx - nx * hw, cy - ny * hw]]
   }

   /**
    * Fill (and optionally outline) the body and tail as ONE shape: the union outline of
    * the two, built as a single polygon. A single anti-aliased fill means a translucent
    * fill is never doubled, and a single stroke gives real corners where the tail meets
    * the body border (no gap, no clip seams).
    * @param {Ptr} G - Graphics handle
    * @param {Object} L - Layout (L.tail must be set)
    * @param {GDIp.Path} bodyPath - Body outline (for a border: along the pen's centre line)
    * @param {Ptr} fillBrush - Brush for body and tail
    * @param {Ptr} [pen] - Border pen; omit for no border
    */
   _FillUnion(G, L, bodyPath, fillBrush, pen := 0) {
      pts := this._UnionOutline(this._PathPolygon(bodyPath), L.tail)
      U := GDIp.Path(G)
      If (pts)
         U.AddPathArray(pts, 1)
      Else {                                   ; fallback: should not happen
         DllCall("gdiplus\GdipAddPathPath", "Ptr", U.pPath, "Ptr", bodyPath.pPath, "Int", 0)
         U.AddPathArray(L.tail, 1)
      }
      blankBrush := GDIp.BrushCreateSolid(0x01808080)  ; so the tail can be grabbed too
      U.FillPath(blankBrush)
      GDIp.DeleteBrush(blankBrush)
      U.FillPath(fillBrush)
      If (pen)
         U.DrawPath(pen)
   }

   /**
    * Flatten a closed path (curves become short lines) and return its points, in
    * clockwise screen order (positive shoelace area with Y down).
    * @param {GDIp.Path} P - Path; it is flattened in place
    * @returns {Array} [[x, y], ...]
    */
   _PathPolygon(P) {
      GDIp.FlattenPath(P.pPath, 0.25)
      buf := P.GetPathPointbuffer(&count)
      pts := []
      Loop count
         pts.Push([NumGet(buf, (A_Index - 1) * 8, "Float"), NumGet(buf, (A_Index - 1) * 8 + 4, "Float")])
      ; Drop a closing point that repeats the first
      If (pts.Length > 2 AND pts[1][1] = pts[-1][1] AND pts[1][2] = pts[-1][2])
         pts.Pop()
      If (this._SignedArea(pts) < 0)
         this._Reverse(pts)
      Return pts
   }

   _SignedArea(pts) {
      s := 0, n := pts.Length
      Loop n {
         p := pts[A_Index], q := pts[Mod(A_Index, n) + 1]
         s += p[1] * q[2] - q[1] * p[2]
      }
      Return s / 2
   }

   _Reverse(pts) {
      i := 1, j := pts.Length
      While (i < j) {
         t := pts[i], pts[i] := pts[j], pts[j] := t
         i++, j--
      }
   }

   /**
    * Union outline of a convex body polygon and the tail triangle whose base is inside
    * the body and tip outside it: the body outline with the tail wedge spliced in where
    * each tail side crosses it.
    * @param {Array} poly - Body polygon, clockwise
    * @param {Array} tail - [[base1], [tip], [base2]]
    * @returns {Array|Integer} Union polygon points, or 0 if the crossings aren't found
    */
   _UnionOutline(poly, tail) {
      n := poly.Length
      If (n < 3)
         Return 0
      b1 := tail[1], tip := tail[2], b2 := tail[3]
      ; Same (clockwise) orientation as the body, so the splice below runs the right way
      If (this._SignedArea([b1, tip, b2]) < 0)
         t := b1, b1 := b2, b2 := t
      cA := this._LastCrossing(poly, b1, tip)   ; side b1 -> tip
      cB := this._LastCrossing(poly, b2, tip)   ; side b2 -> tip
      If (NOT cA OR NOT cB)
         Return 0
      ; A -> tip -> B, then forward round the body from B's edge back to A's edge
      out := [cA.P, tip, cB.P]
      steps := Mod(cA.i - cB.i + n, n)
      If (steps = 0)
         steps := n
      i := cB.i
      Loop steps {
         i := Mod(i, n) + 1
         out.Push(poly[i])
      }
      Return out
   }

   /**
    * Where segment s0 -> s1 last crosses the polygon boundary (closest to s1)
    * @returns {Object|Integer} {i: edge index (edge i runs poly[i] -> poly[i+1]), P: [x, y]} or 0
    */
   _LastCrossing(poly, s0, s1) {
      n := poly.Length, best := 0, bestT := -1
      dx := s1[1] - s0[1], dy := s1[2] - s0[2]
      Loop n {
         e0 := poly[A_Index], e1 := poly[Mod(A_Index, n) + 1]
         ex := e1[1] - e0[1], ey := e1[2] - e0[2]
         den := dx * ey - dy * ex
         If (Abs(den) < 1e-9)
            Continue
         wx := e0[1] - s0[1], wy := e0[2] - s0[2]
         t := (wx * ey - wy * ex) / den          ; along the tail side
         u := (wx * dy - wy * dx) / den          ; along the body edge
         If (t >= 0 AND t <= 1 AND u >= 0 AND u <= 1 AND t > bestT)
            bestT := t, best := { i: A_Index, P: [s0[1] + t * dx, s0[2] + t * dy] }
      }
      Return best
   }

   /**
    * Build a closed rounded-rectangle path matching GDIp.FillRoundedRectangle
    * @returns {GDIp.Path}
    */
   _RoundRectPath(G, x, y, w, h, r) {
      r := (w <= h) ? (r < w / 2) ? r : w / 2 : (r < h / 2) ? r : h / 2
      r2 := r * 2
      P := GDIp.Path(G)
      GDIp.AddPathArc(P.pPath, x         , y         , r2, r2, 180, 90)
      GDIp.AddPathArc(P.pPath, x + w - r2, y         , r2, r2, 270, 90)
      GDIp.AddPathArc(P.pPath, x + w - r2, y + h - r2, r2, r2,   0, 90)
      GDIp.AddPathArc(P.pPath, x         , y + h - r2, r2, r2,  90, 90)
      GDIp.ClosePathFigure(P.pPath)
      Return P
   }

   /**
    * Lay a near-invisible circle over the callout tip, the size of the handle hit area,
    * so the tip can be hovered and grabbed even where the arrowhead is thin.
    * @param {Ptr} G - Graphics handle (body coordinates)
    * @param {Object} L - Layout (L.tail set)
    */
   _DrawTipGrab(G, L) {
      t := L.tail[2], r := Cursor.ResizeBox
      grabBrush := GDIp.BrushCreateSolid(0x01000000)
      GDIp.FillEllipse(G, grabBrush, t[1] - r, t[2] - r, r * 2, r * 2)
      GDIp.DeleteBrush(grabBrush)
   }

   /**
    * Create the font objects, measure the text and compute the body geometry.
    * Caller must delete L.hFormat, L.hFont and L.hFamily.
    * @returns {Object|Integer} Layout object, or 0 if the font is invalid or there is no text
    */
   _Layout() {
      Static StyleIndex := Map("Normal", 0, "Bold", 1, "Italic", 2, "BoldItalic", 3, "Underline", 4, "Strikeout", 8)
      ; Text alpha always comes from textOpacity. It used to be OR'd in only while
      ; _fontColor had no alpha, and the Color setter forces 0xFF, so a recolor
      ; (1-9 keys, group color, color undo, duplicate) made the text opaque
      this._fontColor := (this._fontColor & 0xFFFFFF) | ((this.textOpacity & 0xFF) << 24)
      ; Startup
      If (this._ogFontSize = 0)
         this._ogFontSize := this._fontSize
      ; NOTE - If I want to retain pixel for pixel sameness, stick to using A_ScreenDPI vs per monitor
      ; IF I really want per monitor DPI then font sizes will have to be scaled vs A_ScreenDPI
      DPI := WinDPI(this.hWnd)
      this.DPIFactor := DPI / 96

      isdc   := GDI.GetDC(this.GUI.hWnd) ; 0 or hwnd, doesn't seem to matter
      G      := GDIp.GraphicsFromHDC(isdc)
      GDIpText.SetTextRenderingHint(G, Rendering := 3) ; 5 causes color issues on small text
      ;-------------------------------------------------------------------
      ; Create the necessary Font Info
      ;-------------------------------------------------------------------
      hFamily := GDIpText.FontFamilyCreate(this._fontName) ; , IFC
      If ( NOT hFamily) {
         GDIp.DeleteGraphics(G), GDI.ReleaseDC(isdc, this.GUI.hWnd)
         MsgBox("Invalid Font " this._fontName)
         Return 0
      } else If ( NOT IsNumber(this._fontSize)) {
         GDIp.DeleteGraphics(G), GDI.ReleaseDC(isdc, this.GUI.hWnd)
         GDIpText.DeleteFontFamily(hFamily)
         MsgBox("Invalid Font Size " this._fontSize)
         Return 0
      }
      StyleCode := StyleIndex.Get(this._fontStyle, 0)
      hFont     := GDIpText.FontCreate(hFamily, this._fontSize, StyleCode)
      ; NOTE - unicode doesn't display as a font fallback, only works with Segoe emoji
      ; GDI DrawText will, but have opacity issues with it currently
      hFormat   := GDIpText.StringFormatCreate(FormatStyle := 0x00004004) ; 0x0000400 0x80000400
      GDIpText.SetStringFormatTrimming(hFormat, 0)
      ;-------------------------------------------------------------------
      ; Measure required window size to bound the text, used to create
      ; DIB Section in the next step, overall bound will be the GUI size
      ;-------------------------------------------------------------------
      this.GUI.GetPos(,, &Width, &Height)
      ; NOTE - Maximum width of text rectangle will be Snip width.
      GDIp.CreateRectF(&RCWin, 0, 0, Width, Height)
      ; Don't specify alignment, use top/left
      RCTextF := GDIpText.MeasureString(G, this._Text, hFont, hFormat, RCWin, &Lines)
      GDIp.DeleteGraphics(G)
      GDI.ReleaseDC(isdc, this.GUI.hWnd)

      If (Lines == 0) {
         qTrayTip("No text found on clipboard")
         ; Unwind
         GDIpText.DeleteStringFormat(hFormat)
         GDIpText.DeleteFont(hFont)
         GDIpText.DeleteFontFamily(hFamily)
         Return 0
      }
      ;----------------------------------------------------------------------
      ; Get initial coordinates of the required rectangle for the text
      ;----------------------------------------------------------------------
      pad      := {}
      ahFactor := {}
      ahLen    := 0
      Inset    := 0
      txt := {
         X: RCTextF.X1 ,
         Y: RCTextF.Y1 ,
         W: RCTextF.X2 ,
         H: RCTextF.Y2
      }
      txt.LH   := txt.H / Lines

      txt.W *= 1.01 ; make a bit bigger to prevent pre-mature wrapping in some cases with large text
      outlineThickness := Round(this.DPIFactor * this.shapeThickness * this._fontSize / 20) ; Scale borders with font size
      outlineOpacity   := this.FTOLOpacity << 24
      ;----------------------------------------------------------------------
      ; Some preliminary adjustments for certain shapes
      ; Compute the necessary padding and tweak text box dimensions
      ;----------------------------------------------------------------------
      Switch this.Shape {
         Case Shapes.SHAPE_TAG:
            ; Tags will be square, enlarge box
            txt.W := txt.H := Max(txt.W, txt.H)
            pad.l := pad.r := pad.t := pad.b := 0
            ; txt.x += pad.r + 1, txt.y += pad.t + 2
         Case Shapes.SHAPE_LEFTARROWTEXT, Shapes.SHAPE_RIGHTARROWTEXT:
            ahFactor.x := 0.95 ; how far the point sticks out (rel to height)
            ahFactor.y := 0.30 ; how far the top/bot sides stick out (rel to height)
            ahLen := ahFactor.x * txt.H ; Arrowhead Length
            Inset := ahLen / 25 ; So arrow doesn't look clunky

            ; Padding relative to text required height so we can draw the arrow head
            ; use 66% so the text fills in the arrow head a bit and arrow is shorter
            If (this.Shape = Shapes.SHAPE_RIGHTARROWTEXT) {
               pad.r := Ceil(ahLen * 0.66) ; only needed on one side (one arrow), don't pad the text
               pad.l := 0
            } Else {
               pad.r := 0
               pad.l := Ceil(ahLen * 0.66) ; only needed on one side (one arrow)
               txt.x += pad.l
            }
            pad.t := pad.b := Ceil(ahFactor.y * txt.H) ; needed for both top and bottom
            txt.y += pad.t
            ; Slight offset so text is somewhat in the arrowhead
         Case Shapes.SHAPE_FILLTEXT:
            ; right now it draws it at the txt locations
            pad.l := pad.r := pad.t := pad.b := (this.FillOutline = "None") ? 0 : outlineThickness * 3
            txt.x += pad.r, txt.y += pad.t
         Default:
            ; Enlarge draw rectangle by a bit for outline text to prevent clipping
            ; Needed for some fonts, probably a bug
            pad.l := pad.r := pad.t := pad.b := 3
            txt.x += pad.r, txt.y += pad.t
      }
      ;----------------------------------------------------------------------
      ; This is the adjusted rectangle we draw the text in
      ;----------------------------------------------------------------------
      RCTextF.Init(txt.X, txt.Y, txt.W, txt.H)
      txt.iW := Ceil(txt.W), txt.iH := Ceil(txt.H)
      ; First time draw, save width, always save height for the text editor
      if (NOT this.HasProp("EditWidth"))
         this.EditWidth := txt.W / this.DPIFactor *1.03
      ; Always add an extra line for the editor
      this.EditHeight := (txt.H + txt.LH) / this.DPIFactor * 1.05
      Return {
         hFamily: hFamily, hFont: hFont, hFormat: hFormat, StyleCode: StyleCode, Rendering: Rendering,
         RCTextF: RCTextF, txt: txt, pad: pad, ahLen: ahLen, Inset: Inset,
         outlineThickness: outlineThickness, outlineOpacity: outlineOpacity,
         ; Body size: the text rectangle plus the shape's own padding
         bodyW: txt.iW + pad.l + pad.r, bodyH: txt.iH + pad.t + pad.b
      }
   }

   /**
    * Draw the text body for the current shape type, with its top-left at 0,0 in G's
    * (possibly translated) coordinates.
    * @param {Ptr} G - Graphics handle of the render surface
    * @param {Object} L - Layout from _Layout()
    * @param {DIBSurface} mySurf - Render surface (needed for the outline-text blur)
    * @param {Object} win - Window box from _WindowBox()
    */
   _DrawBody(G, L, mySurf, win) {
      RCTextF          := L.RCTextF
      txt              := L.txt
      hFormat          := L.hFormat
      hFont            := L.hFont
      outlineThickness := L.outlineThickness
      outlineOpacity   := L.outlineOpacity
      bodyW            := L.bodyW
      bodyH            := L.bodyH
      ahLen            := L.ahLen
      inset            := L.Inset
      ;--------------------------------------------------------------
      ; Create the brushes and define the shape parameters
      ;--------------------------------------------------------------
      textBrush        := GDIp.BrushCreateSolid(this._fontColor)
      ; Minimial opaqueness so we can grap the shape anywhere
      blankBrush       := GDIp.BrushCreateSolid(0x01808080)  ; near blank
      GDIp.FillRectangle(G, blankBrush, 0, 0, bodyW, bodyH)
      GDIp.DeleteBrush(blankBrush)

      ;--------------------------------------------------------------
      ; Compute coordinates and draw each text type
      ;--------------------------------------------------------------
      Switch this.Shape {
         Case Shapes.SHAPE_TEXT:
            ; Rectangle to help grab resize points
            ; utfBuf := Buffer(StrPut(this._Text, "UTF-8"))
            ; StrPut(this._Text, utfBuf, , "UTF-8")
            ; GDIpText.DrawString(G, StrGet(utfBuf,,"UTF-8"), hFont, hFormat, textBrush, &RCText)
            GDIpText.DrawString(G, this._Text, hFont, hFormat, textBrush, &RCTextF)
            this._DrawCalloutArrow(G, L)

         Case Shapes.SHAPE_LEFTARROWTEXT, Shapes.SHAPE_RIGHTARROWTEXT:
            ; IDEA - Up/Down arrows as well?
            ;----------------------------------------------------------------------
            ; Compute and draw the arrow outline path based on the body dimensions
            ; Create Arrow points for a left facing arrow
            ; The arrow coordinates all are scaled based on the text height (i.e. point size)
            ; The body is the outer box around the arrowhead
            ; The text box is contained within the body centered vert, but offset in X
            ;----------------------------------------------------------------------
            pArray := [
               [0            , bodyH / 2],             ; left vertex (point), the middle Y position
               [ahLen        , 0],                     ; top tip end
               [ahLen - inset, txt.Y],                 ; top tip base (where the inset ends)
               [bodyW        , txt.Y],                 ; ur corner (far side of arrow)
               [bodyW        , txt.Y + txt.H],         ; lr corner
               [ahLen - inset, txt.Y + txt.H],         ; bottom tip base (inset ends)
               [ahLen        , bodyH]                  ; bottom tip end
            ]
            oPath := GDIp.Path(G)
            oPath.AddPathArray(pArray, 1) ; close the polygon
            ; Flip the arrow 180 deg (L/R) needed
            If (this.Shape = Shapes.SHAPE_RIGHTARROWTEXT) {
               ; It rotates around top/left so shift it back by that amount so it maintains overall geometry
               oPath.TranslateRotatePath(180, bodyW, bodyH)
            }
            ; Fill shape opaque
            fillBrush := GDIp.BrushCreateSolid((this.FTOpacity << 24) | (this._BGColor & 0xFFFFFF))
            oPath.FillPath(fillBrush)
            GDIp.DeleteBrush(fillBrush)
            ; Draw the shape outline
            outlinePen := GDIp.CreatePen(outlineOpacity | this.Color, outlineThickness)
            GDIp.SetPenLineJoin(outlinePen, 2) ; gives a rounded curve to the inset only
            GDIp.SetPenAlignment(outlinePen, 1)
            oPath.DrawPath(outlinePen)
            ; Clean up
            GDIp.DeletePen(outlinePen)
            oPath := ""
            ;----------------------------------------------------------------------
            ; Finally Draw the text last on top
            ;----------------------------------------------------------------------
            GDIpText.DrawString(G, this._Text, hFont, hFormat, textBrush, &RCTextF)

         Case Shapes.SHAPE_FILLTEXT:
            fillBrush := GDIp.BrushCreateSolid((this.FTOpacity << 24) | (this._BGColor & 0xFFFFFF))
            radius := outlineThickness * 3 ; Min(txt.W, txt.H) * 0.10
            If (L.tail AND this._HasFillOutline()) {
               ;----------------------------------------------------------------------
               ; Bordered callout: triangle tail with the same fill, and one border
               ; around the union of the box and the tail
               ;----------------------------------------------------------------------
               ; The union outline runs along the border's centre line, half a pen width
               ; inside the body, so the border's outer edge lands where it does
               ; without a callout (same geometry DrawRectangle inset / DrawRoundedRectangle use)
               outlinePen := GDIp.CreatePen(outlineOpacity | this.Color, outlineThickness)
               GDIp.SetPenAlignment(outlinePen, 0)
               pw := outlineThickness / 2
               If (this.FillOutline = "Rectangle") {
                  bodyPath := GDIp.Path(G)
                  bodyPath.AddPathRectangle(pw, pw, bodyW - pw * 2, bodyH - pw * 2)
                  GDIp.SetPenLineJoin(outlinePen, 3)  ; sharp corners, clipped at the tail tip
               } Else { ; Rounded Rectangle, radius clamped as in GDIp.DrawRoundedRectangle
                  r := radius
                  If (bodyW <= bodyH && (r + pw > bodyW / 2))
                     r := (bodyW / 2 > pw) ? bodyW / 2 - pw : 0
                  Else If (bodyH < bodyW && r + pw > bodyH / 2)
                     r := (bodyH / 2 > pw) ? bodyH / 2 - pw : 0
                  Else If (r < pw / 2)
                     r := pw / 2
                  bodyPath := this._RoundRectPath(G, pw, pw, bodyW - pw * 2, bodyH - pw * 2, r)
                  GDIp.SetPenLineJoin(outlinePen, 2)  ; rounded, matches the corners
               }
               this._FillUnion(G, L, bodyPath, fillBrush, outlinePen)
               GDIp.DeletePen(outlinePen)
               bodyPath := ""
               GDIp.DeleteBrush(fillBrush)
               GDIpText.DrawString(G, this._Text, hFont, hFormat, textBrush, &RCTextF)
               GDIp.DeleteBrush(textBrush)
               Return
            }
            ; Account for padding
            Switch this.FillOutline {
               Case "Rectangle":
                  outlinePen := GDIp.CreatePen(outlineOpacity | this.Color, outlineThickness)
                  GDIp.SetPenAlignment(outlinePen, 1)
                  GDIp.FillRectangle(G,fillBrush, 0, 0, bodyW, bodyH)
                  GDIp.DrawRectangle(G, outlinePen, 0, 0, bodyW, bodyH)
                  GDIp.DeletePen(outlinePen)
               Case "Rounded Rectangle":
                  of := radius/8
                  outlinePen := GDIp.CreatePen(outlineOpacity | this.Color, outlineThickness)
                  GDIp.SetPenAlignment(outlinePen, 0)
                  GDIp.FillRoundedRectangle(G, fillBrush, of, of, bodyW - of * 2, bodyH - of * 2, radius)
                  GDIp.DrawRoundedRectangle(G, outlinePen, 0, 0, bodyW, bodyH, radius)
                  GDIp.DeletePen(outlinePen)
               Default:
                  GDIp.FillRoundedRectangle(G, fillBrush, RCTextF.X1, RCTextF.Y1, RCTextF.W, RCTextF.H, radius)
            }
            GDIp.DeleteBrush(fillBrush)
            GDIpText.DrawString(G, this._Text, hFont, hFormat, textBrush, &RCTextF)
            this._DrawCalloutArrow(G, L)

         Case Shapes.SHAPE_OLTEXT:
            ; outline text size, A_ScreenDPI keeps it consistent across monitors and computers
            emVal := this._fontSize * A_ScreenDPI / 72
            olThickness := emVal * this.OLFillThickness/100 ; IDEA - larger when blurring?
            ; background Just so it isn't transparent for click thru
            ; IDEA - should this be an option for B&W vs complementary outline?
            ; outlinePen := GDIp.CreatePen(Caption.OLOpacity << 24 | 0xFFFFFF & BlackOrWhite(this._fontColor), olThickness)
            outlinePen := GDIp.CreatePen(this.OLOpacity << 24 | 0xFFFFFF & Complementary(this._fontColor, 0.75), olThickness)
            GDIp.SetPenLineJoin(outlinePen, 2) ; Rounded, avoid spikes
            ; Write the outline text first
            Path := GDIp.CreatePath(0)
            res  := GDIpText.AddPathString(Path, this._Text, -1, L.hFamily, L.StyleCode, emVal, &RCTextF, hFormat)
            res  := GDIp.DrawPath(G, outlinePen, Path)    ; outside
            ; We now have the outside shape in the G graphics
            ; If we want to blur it then shrink/expand the outline part
            If (this.OLBlur > 1) {
               ; get alpha pBitmap copy
               pFull := mySurf.getARGBpBitmap()
               ; blur it by setting amount, font size and DPI adjusted
               pBlur := BitMap.BlurBitmap(pFull, round(this.OLBlur * emVal/128))
               ; write blur back into graphics (whole surface, so draw untranslated)
               GDIp.GraphicsClear(G)   ; remove old outline
               If (win.offX OR win.offY)
                  GDIp.ResetWorldTransform(G)
               GDIp.DrawImage(G, pBlur, 0, 0, mySurf.Width, mySurf.Height, 0, 0, mySurf.Width, mySurf.Height)
               If (win.offX OR win.offY)
                  mySurf.Translate(win.offX, win.offY)
               ; cleanup
               GDIp.DisposeImage(pBlur)
               ; Also look at gradient brushes (PathGradientBrush) where the outside color is the background color
            }
            res  := GDIp.FillPath(G, textBrush, Path) ; inside
            GDIp.DeletePen(outlinePen)
            GDIp.DeletePath(Path)
            this._DrawCalloutArrow(G, L)

         Case Shapes.SHAPE_TAG:
            ; Simplier solid background with black/white text
            fillBrush := GDIp.BrushCreateSolid((this.TCOpacity << 24) | (this._fontColor & 0xFFFFFF))
            If (L.tail) {
               ; Callout: circle and tail filled as one shape (pin style)
               bodyPath := GDIp.Path(G)
               bodyPath.AddPathEllipse(RCTextF.X1, RCTextF.Y1, RCTextF.W, RCTextF.H)
               this._FillUnion(G, L, bodyPath, fillBrush)
               bodyPath := ""
            } Else
               GDIp.FillEllipse(G, fillBrush, RCTextF.X1, RCTextF.Y1, RCTextF.W, RCTextF.H)
            cColor := BlackOrWhite(this._fontColor & 0xFFFFFF)
            textAltBrush := GDIp.BrushCreateSolid(0xFF000000 | cColor)
            GDIpText.DrawString(G, this._Text, hFont, hFormat, textAltBrush, &RCTextF)
            GDIp.DeleteBrush(textAltBrush)
            GDIp.DeleteBrush(fillBrush)

         Default:
      }
      GDIp.DeleteBrush(textBrush)
   }
   /**
    * Open the text input dialog to edit the shape's displayed text.
    * On confirmation, applies the updated text, font, size, alignment, style, and color.
    */
   EditDispText(*) {
      CoordMode('Mouse', 'Window')
      C := this.shapeCoord
      this.PostAction(UnDo.TEXT_CHANGE) 
      _ := PreDialog(this.Gui)
      Obj := TextInputBox(this, "Edit Text (Ctrl-Enter to Accept), Resize to set wrapping in shape", "Snip Text", this.text)
      If (Obj.Result = "OK") {
         this.Shape := Obj.Shape
         this.DrawText(C.X1, C.Y1, Obj.Size, Trim(Obj.Value, " `n"), Obj.Font, Obj.ALignment, Obj.FontStyle, RGBval(Obj.Color))
         ; Reposition if alignment not left after editing
         Cn := this.shapeCoord
         Switch Obj.ALignment {
            Case "Left" :
            Case "Center" :
               this.Move(Cn.X1 + (C.W - Cn.W) / 2, Cn.Y1)
            Case "Right" :
               this.Move(Cn.X1 + C.W - Cn.W, Cn.Y1)
         }
      } else
         this.PopAction()
   }

   ;//////////////////////////////////////////////////////////////////////
   ; Common Methods that are overridden here
   ;//////////////////////////////////////////////////////////////////////
   /**
    * Close the text shape by rendering it invisible before calling the base class close
    */
   Close(skipUndo?) {
      Super.Close(skipUndo?)
      this.Tip := ""   ; undo info was captured above; don't draw a tail on the blanked window
      this.DrawText(0,0,2,".",,,,0x0)
      ; this.OnEvent("DoubleClick", this.bindDClick, false)
   }

   /**
    * Get or set the font color as an RGB value (alpha channel is stripped on get, forced opaque on set)
    * @type {Integer}
    */
   Color {
      get => this._fontColor & 0xFFFFFF
      set => this._fontColor := (0xFF000000 | RGBval(Value))
   }

   /**
    * Rerender the text at its current position using the original (pre-resize) font size
    */
   ResetSize() {
      this.GetPos(&_X,&_Y)
      this.DrawText(_X,_Y,this._ogFontSize)
   }

   /**
    * Move the shape to a new position and optionally redraw at a new font size.
    * For fill-text and arrow shapes, also resamples the background color under the shape.
    * @param {Integer} [wX] - New snip X of the text body (excluding any callout)
    * @param {Integer} [wY] - New snip Y of the text body
    * @param {Integer} [fontSize] - If provided, forces a redraw at this font size
    */
   Move(wX?, wY?, fontSize?) {
      ; 1st move to where we want to be
      ; A callout tip stays where it points, so the tail has to be redrawn on any move.
      ; Test for a tip, not a visible tail: when the body is dragged over the tip the
      ; tail hides, and it must come back (and the window cover the tip handle again)
      ; once the body moves off it.
      willRefresh := IsSet(fontSize) OR (this.CalloutCapable AND IsObject(this.Tip))
      Switch this.Shape {
         ; Recompute the background color in real time
         Case Shapes.SHAPE_FILLTEXT, Shapes.SHAPE_LEFTARROWTEXT, Shapes.SHAPE_RIGHTARROWTEXT:
            ; Recompute and redraw with the text background color
            If ((res := this.ShapeBackgroundColor()) >= 0) {
               If (this._BGColor != res) {
                  this._BGColor := res
                  willRefresh := true
               }
            }
         Default:
      }
      ; Just move it if no re-draw is needed
      if not willRefresh
         super.Move(wX?, wY?)
      else
         this.DrawText(wX?, wY?, fontSize?)
   }
   /**
    * Scale and move shapes when the snip is scaled
    * @param amount Factor to adjust
    * @returns {unset?} 
    */
   Scale(amount) {
      sc := this.shapeCoord
      If (IsObject(this.Tip))
         this.Tip := { X: this.Tip.X * amount, Y: this.Tip.Y * amount }
      this.Move(sc.X * amount, sc.Y * amount, this._fontSize * amount)
   }
   /**
    * Redraw the text shape at its current position and sync the focus border.
    * Called when the shape needs to be redrawn in place, e.g. after a property change.
    * shapeCoord is the text body, so redraw at the body position (Render works out the
    * window position and padding).
    */
   Refresh(*) {
      C := this.shapeCoord
      this.DrawText(C.X1, C.Y1)
      focusBorder.Sync(this) ;Size may have changed
   }
   /**
    * No-op cleanup stub; satisfies the CommonShape interface
    */
   Cleanup() => {}
   /**
    * Scale the font size and shape border thickness by a relative percentage
    * @param {Float} percent - Fractional change to apply (e.g. 0.1 = +10%, -0.1 = -10%)
    */
   ChangeThickness(percent) {
      this._fontSize      *= (1 + percent)
      this.shapeThickness *= (1 + percent)
   }
   /**
    * Set the font color of the text shape
    * @param {Integer} newColor - New RGB color value
    */
   SetColor(newColor) {
      this.Color := newColor
   }
   /**
    * Indicate that this shape uses a square focus rectangle
    * @type {Integer}
    */
   FocusSquare => true
   /**
    * Return the set of resize handle focus points for this text shape
    * @returns {Array} Array of objects with C (corner index), X, and Y properties
    */
   FocusPoints() {
      C := this.shapeCoord
      pts := [{ C: 1, X: 0, Y: 0 },         { C: 2, X: C.w, Y: 0 },
              { C: 3, X: C.w, Y: C.h / 2 }, { C: 4, X: C.w, Y: C.h },
              { C: 7, x: 0, Y: C.h/2 },     { C: 6, x: 0, Y: C.h }]
      ; Callout tip (C 9, round handle). Checked first so it wins over a corner it overlaps.
      If (this.CalloutCapable) {
         tip := this.TipPoint()
         pts.InsertAt(1, { C: 9, Ctrl: "Tip", Cur: "SizeAll", X: tip.X - C.X, Y: tip.Y - C.Y, Round: true })
      }
      return pts
   }
   /**
    * Where the callout tip handle sits, in snip coordinates. With no callout it rests
    * inside the body near the bottom centre (clear of the corner handles and the middle,
    * where the shape is usually grabbed to move it).
    * @returns {Object} {X, Y}
    */
   TipPoint() {
      If (IsObject(this.Tip))
         Return { X: this.Tip.X, Y: this.Tip.Y }
      C := this.shapeCoord
      Return { X: C.X + C.W / 2, Y: C.Y + C.H - Min(C.H / 4, Cursor.ResizeBox) }
   }
   /**
    * True if a snip point is on the callout's tail/arrow rather than the text body.
    * The window only extends past the body for the callout, so a click there is on it.
    * @param {Number} mX - Snip X
    * @param {Number} mY - Snip Y
    * @returns {Integer}
    */
   IsOnCallout(mX, mY) {
      If (NOT this.HasCallout)
         Return false
      C := this.shapeCoord
      Return NOT (mX >= C.X AND mX <= C.X + C.W AND mY >= C.Y AND mY <= C.Y + C.H)
   }
   /**
    * Control point drag (see commonShape): "Tip" moves the callout tip, redrawing live.
    * @param {String} name - Ctrl name
    * @param {Number} X - Snip X of the mouse
    * @param {Number} Y - Snip Y of the mouse
    */
   ControlDrag(name, X, Y) {
      If (name = "Tip") {
         this.Tip := { X: X, Y: Y }
         this.Refresh()           ; redraws and syncs the focus border
      }
   }
   /**
    * End of a control point drag: a tip dropped back inside the shape removes the callout.
    * @param {String} name - Ctrl name
    */
   ControlDragEnd(name) {
      If (name = "Tip" AND NOT this._tailShown AND IsObject(this.Tip)) {
         this.Tip := ""
         this.Refresh()
      }
   }
   /**
    * InstanceInfo
    * Get the key unique instance info to recreate this shape instance
    * @returns {FreeHandShape} 
    */
   InstanceInfo() {
      infoObj                   := super.InstanceInfo()
      infoObj._Text             := this._Text
      infoObj._fontName         := this._fontName
      infoObj._fontStyle        := this._fontStyle
      infoObj._fontSize         := this._fontSize
      infoObj._Alignment        := this._Alignment
      infoObj._BGColor          := this._BGColor
      infoObj.Tip               := IsObject(this.Tip) ? this.Tip.Clone() : ""
      Return infoObj
   }
   /**
    * Move info for undo/redo: also the callout tip, which moves with the body when the
    * callout itself is dragged
    * @returns {Object}
    */
   MoveInfo() {
      info := super.MoveInfo()
      info.Tip := IsObject(this.Tip) ? this.Tip.Clone() : ""
      Return info
   }
   /**
    * Resize Info for Text Boxes (also covers dragging the callout tip)
    * @returns {Object}
    */
   ResizeInfo() {
      Return {
         sCoord        : this.sCoord.clone(),
         sPad          : this.sPad.clone(),
         _fontSize     : this._fontSize,
         _ogFontSize   : this._ogFontSize,
         Tip           : IsObject(this.Tip) ? this.Tip.Clone() : ""
      }
   }
   /**
    * Text info needed if text formatting changes
    * @returns {Object} 
    */
   TextInfo() {
      Return {
         Shape     : this.Shape,
         _Text     : this._Text,
         _fontName : this._fontName,
         _Alignment: this._Alignment,
         _BGColor  : this._BGColor,
         _fontStyle: this._fontStyle,
         _fontSize : this._fontSize
      }

   }
}

/**
 * GDI+ text rendering utility class.
 * Wraps GDI+ string drawing, measuring, font, and format DllCall operations.
 */
Class GDIpText {

   ;#####################################################################################

   /**
    * Draws a string based on a font, a layout rectangle, and a format.
    * @param G Pointer to the Graphics object.
    * @param sString Pointer to a wide-character string to be drawn.
    * @param hFont Pointer to a Font object that specifies the font attributes (the family name, the size, and the style of the font) to use.
    * @param hFormat  Pointer to a StringFormat object that specifies text layout information and display manipulations to be applied to the string.
    * @param pBrush Pointer to a Brush object that is used to fill the string.
    * @param RectF Reference to a rectangle that bounds the string
    * @returns DrawString result code 
    */
   Static DrawString(G, sString, hFont, hFormat, pBrush, &RectF) {
      Return DllCall("gdiplus\GdipDrawString"
         , "Ptr", G
         , "Ptr", StrPtr(sString)
         , "Int", -1
         , "Ptr", hFont
         , "Ptr", RectF.Ptr
         , "Ptr", hFormat
         , "Ptr", pBrush)
   }
   /**
    * Append a string to a GDI+ graphics path using the given font family and layout rectangle
    * @param {Integer} path - Pointer to the GraphicsPath object
    * @param {String} string - Wide-character string to add
    * @param {Integer} length - Number of characters (-1 for null-terminated)
    * @param {Integer} family - Pointer to the FontFamily object
    * @param {Integer} style - Font style flags (0=Normal, 1=Bold, 2=Italic, etc.)
    * @param {Float} emSize - Font em size in world units
    * @param {Object} layoutRect - Reference to the bounding RectF
    * @param {Integer} format - Pointer to the StringFormat object
    * @returns {Integer} GDI+ status code
    */
   Static AddPathString(path, string, length, family, style, emSize, &layoutRect, format) 
      => DllCall('Gdiplus\GdipAddPathString', 'ptr', path, 'wstr', string, 'int', length, 'ptr', family, 'int', style, 'float', emSize, 'ptr', layoutRect.Ptr, 'ptr', format, 'uint')
   /**
    * Append a string to a GDI+ graphics path using integer em size units
    * @param {Integer} path - Pointer to the GraphicsPath object
    * @param {String} string - Wide-character string to add
    * @param {Integer} length - Number of characters (-1 for null-terminated)
    * @param {Integer} family - Pointer to the FontFamily object
    * @param {Integer} style - Font style flags
    * @param {Integer} emSize - Font em size as an integer
    * @param {Object} layoutRect - Reference to the bounding RectF
    * @param {Integer} format - Pointer to the StringFormat object
    * @returns {Integer} GDI+ status code
    */
   Static AddPathStringI(path, string, length, family, style, emSize, &layoutRect, format) 
      => DllCall('Gdiplus\GdipAddPathStringI', 'ptr', path, 'wstr', string, 'int', length, 'ptr', family, 'int', style, 'int', emSize, 'ptr', layoutRect.Ptr, 'ptr', format, 'uint')

   ;#####################################################################################

   /**
    * Measures the extent of the string in the specified font, format, and layout rectangle
    * @param G Pointer to the Graphics object.
    * @param sString  Pointer to a wide-character string to be measured.
    * @param hFont Pointer to a Font object that specifies the family name, size, and style of the font to be applied to the string.
    * @param hFormat Pointer to a StringFormat object that specifies the layout information, such as alignment, trimming, tab stops, and so forth
    * @param RectF Out - Reference to the rectangle that bounds the string.
    * @returns Bounding rectangle to hold the string along with # Chars and # Lines that will fit in the rectangle 
    */
   Static MeasureString(G, sString, hFont, hFormat, RectF, &Lines?) {
      DllCall("gdiplus\GdipMeasureString"
         , "Ptr", G
         , "Ptr", StrPtr(sString)
         , "Int", -1
         , "Ptr", hFont
         , "Ptr", RectF.Ptr
         , "Ptr", hFormat
         , stRECTF.Ptr, &RC
         , "uint*", &Chars := 0
         , "uint*", &Lines := 0)
      Return RC
      ; Return {X : NumGet(RC, 0, "Float"), Y : NumGet(RC, 4, "Float"), W: NumGet(RC, 8, "Float"), H: NumGet(RC, 12, "Float"), C: Chars, L : Lines }
   }
   ; Near   = 0
   ; Center = 1
   ; Far    = 2
   /**
    * Set the horizontal alignment of text within its layout rectangle
    * @param {Integer} hFormat - Pointer to the StringFormat object
    * @param {Integer} Align - 0=Near (Left), 1=Center, 2=Far (Right)
    * @returns {Integer} GDI+ status code
    */
   Static SetStringFormatAlign(hFormat, Align) => DllCall("gdiplus\GdipSetStringFormatAlign", "Ptr", hFormat, "Int", Align)
   ; Top    = 0
   ; Center = 1
   ; Bottom = 2
   /**
    * Set the vertical (line) alignment of text within its layout rectangle
    * @param {Integer} hFormat - Pointer to the StringFormat object
    * @param {Integer} Align - 0=Top, 1=Center, 2=Bottom
    * @returns {Integer} GDI+ status code
    */
   Static GdipSetStringFormatLineAlign(hFormat, Align) => DllCall("gdiplus\GdipSetStringFormatLineAlign", "ptr", hFormat, "int", Align) ; Top = 0, Center = 1, Bottom = 2


   ; StringFormatFlagsDirectionRightToLeft    = 0x00000001
   ; StringFormatFlagsDirectionVertical       = 0x00000002
   ; StringFormatFlagsNoFitBlackBox           = 0x00000004 Allow glyph to overhang bounding box
   ; StringFormatFlagsDisplayFormatControl    = 0x00000020 Show control glyphs
   ; StringFormatFlagsNoFontFallback          = 0x00000400 <- leave off
   ; StringFormatFlagsMeasureTrailingSpaces   = 0x00000800
   ; StringFormatFlagsNoWrap                  = 0x00001000
   ; StringFormatFlagsLineLimit               = 0x00002000
   ; StringFormatFlagsNoClip                  = 0x00004000 Allow overhaning pixels
   ; StringFormatFlagsBypassGDI               = 0x80000000
   /**
    * Create a GDI+ StringFormat object with the specified format flags and language
    * @param {Integer} [Format=0] - Combination of StringFormatFlags bit values
    * @param {Integer} [Lang=0] - Language identifier for digit substitution (0 = default)
    * @returns {Integer} Handle to the new StringFormat object
    */
   Static StringFormatCreate(Format := 0, Lang := 0) {
      DllCall("gdiplus\GdipCreateStringFormat", "Int", Format, "Int", Lang, "UPtr*", &hFormat := 0)
      Return hFormat
   }
   ; Style
   ; Normal     = 0 (Default)
   ; Bold       = 1
   ; Italic     = 2
   ; BoldItalic = 3
   ; Underline  = 4
   ; Strikeout  = 8
   ; Units - 
   ; UnitWorld,      0 -- World coordinate (non-physical unit)
   ; UnitDisplay,    1 -- Variable -- for PageTransform only
   ; UnitPixel,      2 -- Each unit is one device pixel.
   ; UnitPoint,      3 -- (Default) Each unit is a printer's point, or 1/72 inch.
   ; UnitInch,       4 -- Each unit is 1 inch.
   ; UnitDocument,   5 -- Each unit is 1/300 inch.
   ; UnitMillimeter  6 -- Each unit is 1 millimeter.
   /**
    * Create a GDI+ Font object from a font family handle
    * @param {Integer} hFamily - Pointer to the FontFamily object
    * @param {Float} Size - Font size in the specified units
    * @param {Integer} [Style=0] - Font style flags (0=Normal, 1=Bold, 2=Italic, 3=BoldItalic, 4=Underline, 8=Strikeout)
    * @param {Integer} [Units=3] - Unit of measurement (3=Point, 2=Pixel, etc.)
    * @returns {Integer} Handle to the new Font object
    */
   Static FontCreate(hFamily, Size, Style := 0, Units := 3) {
      DllCall("gdiplus\GdipCreateFont", "Ptr", hFamily, "Float", Size, "Int", Style, "Int", Units, "UPtr*", &hFont := 0)
      Return hFont
   }
   /**
    * Retrieve the em size of a GDI+ font in the font's unit of measure
    * @param {Integer} hFont - Pointer to the Font object
    * @returns {Float} The font's em size
    */
   Static GetFontSize(hFont) {
      DllCall("gdiplus\GdipGetFontSize", "UPtr", hFont, "float*", &result := 0)
      Return result
   }
   ; pFormat =
   ; StringTrimmingNone = 0,
   ; StringTrimmingCharacter = 1,
   ; StringTrimmingWord = 2,
   ; StringTrimmingEllipsisCharacter = 3,
   ; StringTrimmingEllipsisWord = 4,
   ; StringTrimmingEllipsisPath = 5
   /**
    * Set the trimming style applied to characters that exceed the layout rectangle
    * @param {Integer} pFormat - Pointer to the StringFormat object
    * @param {Integer} [Trimming=0] - Trimming mode (0=None, 1=Character, 2=Word, 3=EllipsisCharacter, 4=EllipsisWord, 5=EllipsisPath)
    * @returns {Integer} GDI+ status code
    */
   Static SetStringFormatTrimming(pFormat, Trimming := 0) {
      return DllCall("gdiplus\GdipSetStringFormatTrimming", "Ptr", pFormat, "Int", Trimming)
   }
   /**
    * Create a GDI+ FontFamily object from a font name string
    * @param {String} Font - Font family name (e.g. "Arial")
    * @param {Integer} [fontCollection=0] - Pointer to a font collection to search; 0 uses the installed font collection
    * @returns {Integer} Handle to the new FontFamily object, or 0 on failure
    */
   Static FontFamilyCreate(Font, fontCollection:=0) {
      DllCall("gdiplus\GdipCreateFontFamilyFromName"
         , "Ptr", StrPtr(Font)
         , "Ptr", fontCollection
         , "UPtr*", &hFamily := 0)

      Return hFamily
   }

   /**
    * Delete a GDI+ StringFormat object and free its resources
    * @param {Integer} hStringFormat - Handle to the StringFormat object to delete
    */
   Static DeleteStringFormat(hStringFormat) {
      if (res := DllCall("gdiplus\GdipDeleteStringFormat", "Ptr", hStringFormat))
         warning("Failed to delete String Format " res)
   }
   /**
    * Delete a GDI+ Font object and free its resources
    * @param {Integer} hFont - Handle to the Font object to delete
    */
   Static DeleteFont(hFont) {
      if (res := DllCall("gdiplus\GdipDeleteFont", "Ptr", hFont))
         warning("Failed to delete Font " res)
   }
   /**
    * Delete a GDI+ FontFamily object and free its resources
    * @param {Integer} hFontFamily - Handle to the FontFamily object to delete
    */
   Static DeleteFontFamily(hFontFamily) {
      if (res := DllCall("gdiplus\GdipDeleteFontFamily", "Ptr", hFontFamily))
         warning("Failed to delete Font Family" res)
   }
   ; RenderingHint options:
   ; SystemDefault            = 0 Specifies that a character is drawn using the currently selected system font smoothing mode (also called a rendering hint).
   ; SingleBitPerPixelGridFit = 1 Specifies that a character is drawn using its glyph bitmap and hinting to improve character appearance on stems and curvature.
   ; SingleBitPerPixel        = 2 Specifies that a character is drawn using its glyph bitmap and no hinting. This results in better performance at the expense of quality.
   ; AntiAliasGridFit         = 3 Specifies that a character is drawn using its antialiased glyph bitmap and hinting. This results in much better quality due to antialiasing at a higher performance cost.
   ; AntiAlias                = 4 Specifies that a character is drawn using its antialiased glyph bitmap and no hinting. Stem width differences may be noticeable because hinting is turned off.
   ; ClearTypeGridFit         = 5 Specifies that a character is drawn using its glyph ClearType bitmap and hinting. Can't be used with CompositingModeSourceCopy.
   /**
    * Set the text rendering hint (anti-aliasing mode) for a GDI+ Graphics object
    * @param {Integer} G - Pointer to the Graphics object
    * @param {Integer} RenderingHint - Rendering hint value (0=SystemDefault … 5=ClearTypeGridFit)
    * @returns {Integer} GDI+ status code
    */
   Static SetTextRenderingHint(G, RenderingHint) => DllCall("gdiplus\GdipSetTextRenderingHint", "Ptr", G, "int", RenderingHint)

   /**
    * Create a new empty private font collection
    * @returns {Integer} Handle to the new private FontCollection object
    */
   Static NewPrivateFontCollection() {
      DllCall("gdiplus\GdipNewPrivateFontCollection", "UPtr*", &hFontCollection:=0)
      Return hFontCollection
   }
   /**
    * Retrieve a handle to the installed (system) font collection
    * @returns {Integer} Handle to the installed FontCollection object
    */
   Static NewInstalledFontCollection() {
      DllCall('Gdiplus\GdipNewInstalledFontCollection', 'UPtr*', &hFontCollection:=0, 'uint')
      Return hFontCollection
   }
   /*
   StringDigitSubstituteUser
   Value: 0 Specifies a user-defined substitution scheme.
   StringDigitSubstituteNone
   Value: 1 Specifies to disable substitutions.
   StringDigitSubstituteNational
   Value: 2 Specifies substitution digits that correspond with the official national language of the user's locale.
   StringDigitSubstituteTraditional
   Value: 3 Specifies substitution digits that correspond with the user's native script or language, which may be different from the official national language of the user's locale.
   */
   /**
    * Set the digit substitution language and mode for a StringFormat object
    * @param {Integer} hStringFormat - Pointer to the StringFormat object
    * @param {Integer} [StringDigitSubstitute=2] - Substitution mode (0=User, 1=None, 2=National, 3=Traditional)
    * @param {Integer} [langID=0] - Language identifier; 0 uses the thread's locale
    * @returns {Integer} GDI+ status code
    */
   Static SetStringFormatDigitSubstitution(hStringFormat, StringDigitSubstitute:=2, langID:=0) {
      Return DllCall("gdiplus\GdipSetStringFormatDigitSubstitution", "Ptr", hStringFormat, "UInt", langID, "Int", StringDigitSubstitute)
   } 
}

/**
 * Display a resizable text editing dialog for a TextShape, allowing the user to edit
 * the text content and adjust font, style, size, alignment, color, and shape type.
 * Adapted from https://github.com/Ixiko/AHK-libs-and-classes-collection/blob/8f89301ab7b9b7a219970a665bb1d2c9baab08b8/libs/g-n/TextInputBox.ahk#L55
 * @param {Object} ShapeObj - The TextShape instance being edited
 * @param {String} [Prompt=""] - Descriptive text shown in the dialog title bar
 * @param {String} [Title=""] - Base title of the dialog window
 * @param {String} [InitText=""] - Initial text to populate the edit control
 * @returns {Object} Result object with properties: Result ("OK"|"Cancel"), Value, Font, Size,
 *                   Alignment, FontStyle, Shape, Color
 */
TextInputBox(ShapeObj, Prompt := '', Title := '', InitText := '') {
   Static typeMap  := Map("Fill Text", Shapes.SHAPE_FILLTEXT, "Outline", Shapes.SHAPE_OLTEXT, "Tag", Shapes.SHAPE_TAG, "Left Arrow", Shapes.SHAPE_LEFTARROWTEXT, "Right Arrow", Shapes.SHAPE_RIGHTARROWTEXT, "Text Only", Shapes.SHAPE_TEXT)
   Static DarkMode := GetWindowsTheme()
   ; Any more than this request subclassing, not really worth it.
   If ((Owner := WinExist("A")) != ShapeObj.GUI.hWnd) {
      ; Handle extraneous triggers
      dlog("No Active Window Owner found")
      Return {Result:"Cancel"}
   }
   ; Theming overrides these
   guiBC  := DarkMode ? " c3E3E3E" : ""
   btBG   := DarkMode ? " cD9D9D9 Background3E3E3E" : "" ; button has same BG as the GUI
   ctrlBG := DarkMode ? " cD9D9D9 Background323232" : "" ; Other controls have a bit lighter background
   ; Want to be on top
   ; Edit GUI
   textGui := Gui('+Resize +ToolWindow -MaximizeBox -MinimizeBox +DPIScale +AlwaysOnTop' . (Owner ? ' +Owner' . Owner : ''), Title " - " Prompt)
   Scale := WinDPI(textGui.hWnd) / 96

   textGui.BackColor := guiBC
   textGui.MarginX := "10", textGui.MarginY := "10"
   textGui.SetFont('s10', "Tahoma")

   ; List of fonts
   ddlWidth := 125
   oFonts := textGui.AddDropDownList("Section W" . ddlWidth . ctrlBG, Shapes.InstalledFonts)
   oFonts.OnEvent("Change", FontChange)
   oFonts.text := ShapeObj.FontName
   ; Make the dropdown list a bit wider (need to DPI scale)
   PostMessage(0x0160, Round(ddlWidth * 2 * Scale), 0, oFonts.hWnd)  ; raw pixels, make it 2x the width of the entry box

   ; List of Styles
   oStyle := textGui.AddDropDownList("YP W80" ctrlBG, ["Normal", "Bold", "Italic", "BoldItalic", "Underline", "Strikeout"])
   oStyle.OnEvent("Change", StyleChange)
   oStyle.text := ShapeObj.FontStyle
   ; Get control height and use that moving forward
   oStyle.GetPos(,,,&butH)

   ; UpDown List of font sizes
   oFontVal  := textGui.AddEdit("YP W50 H" butH ctrlBG)
   oFontSize := textGui.AddUpDown("YP Range4-500" , ShapeObj.FontSize)
   ; PicButton.Theme(oFontSize.Hwnd)
   ; PicButton.Theme(oFontVal.Hwnd)

   oFontSize.OnEvent("Change", SizeChange)
   oFontVal.OnEvent("Change", SizeChange)

   ; Alignment options
   oAlign := textGui.AddDropDownList("YP W65" ctrlBG, ["Left", "Center", "Right"])
   oAlign.OnEvent("Change", AlignmentChange)
   oAlign.text := ShapeObj.Alignment

   ; Optionally Text Style (fill, outline, tag)
   oType := textGui.AddDropDownList("YP W90" ctrlBG, ["Text Only", "Fill Text", "Outline", "Tag", "Left Arrow" , "Right Arrow"])
   oType.OnEvent("Change", TypeChange)
   Switch ShapeObj.Shape {
      Case Shapes.SHAPE_TEXT:
         oType.text := "Text Only"
      Case Shapes.SHAPE_FILLTEXT:
         oType.text := "Fill Text"
      Case Shapes.SHAPE_OLTEXT:
         oType.text := "Outline"
      Case Shapes.SHAPE_TAG:
         oType.text := "Tag"
      Case Shapes.SHAPE_LEFTARROWTEXT:
         oType.text := "Left Arrow"
      Case Shapes.SHAPE_RIGHTARROWTEXT:
         oType.text := "Right Arrow"
      Default:
   }
   ; Color Button to select custom button
   oColButton := textGui.AddPicButton("YP HP W" butH btBG, SETTINGS.CursorPath . "colors.ico", "W" butH * Scale - 4 " H" butH * Scale - 4)
   oColButton.OnEvent("Click", PickColor)
   Color := ShapeObj.Color
   ; Edit Control
   ; IDEA - option to enable/disable word wrap, note it can't be toggled for existing control
   ;        would need two edit controls with one or the other hidden to toggle wrap
   ; If we added text with soft CRLF, then remove them here and let them re-wrap
   ; LF `n would be a normal hard return
   If (InitText) {
      InitText := StrReplace(InitText, "`r`n", "")
   }
   ; Restore edit control size from last edit if it exists   
   ; NOTE - if we shrunk the edit control, it will also be expanded to that of the controls above it
   editDesiredHeight := Max(150, ShapeObj.FontSize * Scale * 3)
   eWidth  := ShapeObj.HasProp("EditWidth") ? ShapeObj.EditWidth : 400
   eHeight := ShapeObj.HasProp("EditHeight") ? ShapeObj.EditHeight : editDesiredHeight
   oEdit := textGui.AddEdit('+Wrap +' oAlign.text . ctrlBG . ' W' . eWidth . ' XM Y+M h' . eHeight . ' WantTab T4 Multi VScroll HScroll -E0x200 Border', InitText)
   oEdit.SetFont('s' ShapeObj.FontSize, ShapeObj.FontName)
   SetEditFontStyle(oStyle.text)

   oCancel   := textGui.AddButton('XM Y+M' ctrlBG, 'Cancel')
   oAccept   := textGui.AddButton('XM YP WP HP Default' ctrlBG, 'OK') 
   oDefaults := textGui.AddButton('XM YP HP' ctrlBG, 'Save Defaults')

   ; Hide windows and move some controls around
   WinSetTransparent(0, textGui.hWnd)
   ; Enabling overall theming

   tc := ControlThemes(textGui, DarkMode)
   textGui.Show("AutoSize Center")
   ; Resize after geometry is computed
   ; Restore prior edit box size to maintain word wrap
   PlaceControls()
   WinRedraw(textGui.hWnd)
   WinSetTransparent("Off", textGui.hWnd)
   textGui.OnEvent("Size", ResizeMe)

   ; Window is now visible

   ; Object to return to user
   Data := { Result : "OK", Value: '', g: textGui, oEdit: oEdit }
   ; Event Handlers
   textGui.OnEvent('Close', InputBox_Close.Bind(Data, false))
   textGui.OnEvent('Escape', InputBox_Close.Bind(Data, false))
   oCancel.OnEvent('Click', InputBox_Close.Bind(Data, false))
   oAccept.OnEvent('Click', InputBox_Close.Bind(Data, true))
   oDefaults.OnEvent('Click', InputBox_SetDefults.Bind(Data, true))
   ; Bind ^Enter to accept input
   ; Registered once with a fixed criterion so repeated calls don't accumulate
   ; #HotIf criteria / hotkey variants (which can't be deleted in AHK v2)
   static activeHwnd := 0, activeCb := 0, registered := false
   If !registered {
      HotIf((*) => activeHwnd && WinActive("ahk_id " activeHwnd))
      Hotkey("^Enter", (*) => activeCb && activeCb())
      HotIf()
      registered := true
   }
   activeHwnd := textGui.hWnd
   activeCb   := InputBox_Close.Bind(Data, true)
   ControlFocus(oEdit)
   WinWaitClose(textGui.hWnd)
   activeHwnd := 0, activeCb := 0   ; release closure over this dialog's state
   Try WinActivate(Owner)

   Return Data
   ;/////////////////////////////////////////////////////////////////////////
   /**
    * Handle GUI resize events by repositioning all controls within the new client area
    * @param {Object} GuiObj - The GUI object that was resized
    * @param {Integer} MinMax - -1 if minimized, 1 if maximized, 0 otherwise
    * @param {Integer} Width - New client width in pixels
    * @param {Integer} Height - New client height in pixels
    */
   ResizeMe(GuiObj, MinMax, Width, Height) {
      If minmax = -1
         Return
      PlaceControls()
   }
   
   /**
    * Tell the edit control to return wrapped text with soft breaks (CRLF)
    * @param {Integer} softBreak 
    * @returns {Integer} 
    */
   SetEditFormat(softBreak := 1) {
      Static EM_FMTLINES := 0xC8
      SendMessage(EM_FMTLINES, softBreak, , oEdit.hWnd)
      Return A_LastError
   }
   /**
    * Reposition the edit control and action buttons to fill the current dialog client area.
    * Buttons are placed at evenly spaced grid positions along the bottom edge.
    */
   PlaceControls() {
      ; Buttons on bottom spaced at 1/3 position
      grid := 6
      textGui.GetClientPos(,, &guiW, &guiH)
      oAccept.GetPos(, , &butW, &butH)

      oAccept.Move(4 * guiW / grid - butW / 2, guiH - butH - textGui.MarginY)
      oCancel.Move(5 * guiW / grid - butW / 2, guiH - butH - textGui.MarginY)

      oDefaults.GetPos(, , &butW, &butH)
      oDefaults.Move(1 * guiW / grid - butW / 2, guiH - butH - textGui.MarginY)
      ; Span with width for the edit control, resize vertically
      oEdit.GetPos(, &editY , &editW, &editH)
      oEdit.Move(, , guiW - 2 * textGui.MarginX, guiH - editY - (butH + 2 * textGui.MarginY))
   }
   /**
    * Set defaults for selected shape to current values
    * @param Data 
    * @param Ok 
    */
   InputBox_SetDefults(Data, Ok, *) {
      Switch typeMap[oType.text] {
         Case Shapes.SHAPE_TEXT, Shapes.SHAPE_FILLTEXT , Shapes.SHAPE_LEFTARROWTEXT:
            TextShape.FillFontName  := oFonts.text
            TextShape.FillFontStyle := oStyle.text
            TextShape.FillAlignment := oAlign.text
            TextShape.FillFontSize  := oFontVal.text
         Case Shapes.SHAPE_OLTEXT:
            TextShape.OLFontName   := oFonts.text
            TextShape.OLFontStyle  := oStyle.text
            TextShape.OLAlignment  := oAlign.text
            TextShape.OLFontSize   := oFontVal.text
         Case Shapes.SHAPE_TAG:
            TextShape.TagFontName  := oFonts.text
            TextShape.TagFontStyle := oStyle.text
            TextShape.TagFontSize  := oFontVal.text
         Default:

      }
   }
   /**
    * Event callback when edit text dialog is closed
    * @param Data Object to store results
    * @param Ok True to accept changes, false to cancel
    */
   InputBox_Close(Data, Ok, *) {
      If (Ok) {
         tc.Dispose()
         SetEditFormat(true)  ; indicate we want softbreaks translated to `r`n
         Data.Value     := Trim(Data.oEdit.Value) ; Value returns just a LF (`n) for manual breaks
         SetEditFormat(false)
         Data.Alignment  := oAlign.text
         Data.Font       := oFonts.text
         Data.Size       := oFontVal.text
         Data.FontStyle  := oStyle.text
         Data.Shape      := typeMap[oType.text]
         Data.Color      := Color
         If Data.Value = "" {
            Data.Result := "Cancel"
         } Else {
            ; Save edit box dimensions for next time
            oEdit.GetPos(,,  &editW, &editH)
            ShapeObj.EditWidth  := editW
         }
      } else {
         Data.Result := "Cancel"
      }
      Data.g.Destroy()
   }
   /**
    * Update the edit control's text alignment when the alignment dropdown changes
    */
   AlignmentChange(*) {
      oEdit.Opt("+" oAlign.text)
   }
   /**
    * Update the edit control's font family when the font dropdown changes
    */
   FontChange(*) {
      oEdit.SetFont('s' oFontVal.text, oFonts.text)
   }
   /**
    * Placeholder for future color change handling in the edit control
    */
   ColorChange(*) {
   }
   /**
    * Update the edit control's font style when the style dropdown changes
    */
   StyleChange(*) {
      SetEditFontStyle(oStyle.text)
   }
   /**
    * Update the live TextShape type when the type dropdown changes
    */
   TypeChange(*) {
      ShapeObj.Shape := typeMap[oType.text]
   }
   /**
    * Apply the selected style string to the edit control's font
    * @param {String} style - Style name: "Bold", "Italic", "BoldItalic", "Normal", "Strikeout", or "Underline"
    */
   SetEditFontStyle(style) {
      Switch style {
         Case "Bold":
            oEdit.SetFont("norm bold")
         Case "Italic":
            oEdit.SetFont("norm italic")
         Case "BoldItalic":
            oEdit.SetFont("bold italic")
         Case "Normal":
            oEdit.SetFont("norm")
         Case "Strikeout":
            oEdit.SetFont("norm strike")
         Case "Underline":
            oEdit.SetFont("norm underline")
         Default:
            oEdit.SetFont("norm")
      }
   }
   /**
    * Update the edit control's font size when the size spin control or edit changes
    */
   SizeChange(*) {
      if IsInteger(oFontVal.text)
         oEdit.SetFont('s' oFontVal.text, oFonts.text)
   }
   /**
    * Open the  color picker
    * and update the local Color variable with the user's selection
    */
   PickColor(*) {
      ColorPopDown.ShowColorPopup(setColor, RGBval(Color)) ; textGui.hWnd already has an owner
   }
   setColor(obj, Clr,*) {
      Color := Clr
   }
}
; a:=A_TickCount
; GetFontNames
; debug(A_TickCount - a "ms for fonts")
/**
 * Return a sorted array of all TrueType font family names installed on the system.
 * Uses GDI EnumFontFamiliesEx to enumerate fonts; runs in approximately 3ms for ~273 fonts.
 * @returns {Array} Alphabetically sorted array of font family name strings
 */
GetInstalledFontNames() {
   hDC     := GDI.GetDC()
   LOGFONT := Buffer(92, 0)
   oFonts  := Map()
   aFonts  := Array()
   NumPut("UChar", DEFAULT_CHARSET := 1, LOGFONT.PTR, 23 )
   cb := CallbackCreate(EnumFontFamExProc, "F", 4)
   DllCall("Gdi32\EnumFontFamiliesEx", "Ptr", hDC, "Ptr", LOGFONT, "Ptr", cb, "Ptr", 0, "UInt", 0)
   GDI.ReleaseDC(hDC)
   CallbackFree(cb)
   ; Map keeps keys in sorted order, so use that
   for FaceName, xx in oFonts
      aFonts.push(FaceName)
   Return aFonts

   EnumFontFamExProc(lpelfe, lpntme, FontType, lParam) {
      ; lpelfe is ENUMLOGFONTEX structure
      lfFaceName := StrGet(lpelfe + 28)
      ; charSet := NumGet(LOGFONT,27,"Char")
      ; debug(lfFaceName "=" charSet)
      ; Skip non true-type fonts (TRUETYPE_FONTTYPE)
      If NOT (lfFaceName ~= "i)@") AND (FontType = 4) {
         If NOT oFonts.has(lfFaceName) {
            oFonts[lfFaceName] := 1
         }
      }
      Return true
   }
}
/**
 * Utility class to render a short overlay text label above a screen coordinate
 * within an existing GDI+ graphics surface. Used to show selection dimensions
 * during screen region selection.
 */
Class shortText {
   /**
    * Initialize the shortText renderer by creating the shared font, format, and brush objects
    * @param {Integer} G - Pointer to the GDI+ Graphics object to render into
    */
   __New(G) {
      GDIpText.SetTextRenderingHint(G, Rendering := 3)
      this.hFamily   := GDIpText.FontFamilyCreate("Segoe UI")
      this.hFont     := GDIpText.FontCreate(this.hFamily, 12)
      this.hFormat   := GDIpText.StringFormatCreate(FormatStyle := 0x80004000) ; 0x0000400 0x80000400
      this.textBrush := GDIp.BrushCreateSolid(0xFFF0F0F0)
      this.fillBrush := GDIp.BrushCreateSolid(0x80000000)
      this.G         := G
   }
   /**
    * Render a short text label with a semi-transparent background immediately above the given coordinate
    * @param {Integer} X - X coordinate in graphics surface units for the left edge of the label
    * @param {Integer} Y - Y coordinate in graphics surface units for the bottom edge of the label
    * @param {String} text - Text string to display
    */
   DrawText(X, Y, text) {
      ; Need blending composting mode
      cMode := GDIp.GetCompositingMode(this.G)
      GDIp.SetCompositingMode(this.G, 0)              ; Blend with existing
      GDIp.CreateRectF(&RCWin, 0, 0, 500, 100)
      RCText    := GDIpText.MeasureString(this.G, text, this.hFont, this.hFormat, RCWin)
      W         := RCText.W
      H         := RCText.H
      ; desired screen coordinate with needed text w/h offset by height (bottom alignment)
      RCText.Init(X, Y - H, W, H)
      GDIp.FillRectangle(this.G, this.fillBrush, X, Y - H, W, H)
      GDIpText.DrawString(this.G, text , this.hFont, this.hFormat, this.textBrush, &RCText)
      GDIp.SetCompositingMode(this.G, cMode)              ; Replace existing

   }
   /**
    * Release all GDI+ resources created by this instance
    */
   __Delete() {
      GDIp.DeleteBrush(this.textBrush)
      GDIp.DeleteBrush(this.fillBrush)
      GDIpText.DeleteStringFormat(this.hFormat)
      GDIpText.DeleteFont(this.hFont)
      GDIpText.DeleteFontFamily(this.hFamily)
   }

}
