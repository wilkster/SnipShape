/************************************************************************
 * @description Class to contain the color select popup
 * @file ColorPopDown.ahk2
 * @author Tom Wilkason
 * @date 2026/07/13
 * @version 1.0.0
 *
 * A grid of 36 color circles (the last is the color wheel / screen color picker) drawn with
 * GDI+ on one layered window (DrawnBar), no controls or icons: each redraw paints the
 * circles. The current color is ringed; the one under the mouse is drawn larger.
 *   - left click (on release, also after pressing elsewhere and dragging onto a color, as in
 *     a menu): pick it
 *   - right click: change that color (color dialog; Ctrl: pick it from the screen)
 * It takes the focus when shown and hides when it loses it. The window exists only while
 * snips are drawn on: Build() when a drawing tool is first chosen (or the popup is first
 * shown), Release() when the last snip closes.
 ***********************************************************************/
#Requires Autohotkey 2.1-alpha.25
#include clsDrawnBar.ahk2
#include LibMisc.ahk2    ; custom imagelist
#include clsShapes.ahk2 ; default colors are shared
#include clsColorPicker.ahk2
Class ColorPopDown extends DrawnBar {
   Static colorNameArray   := Array() ; Index -> name (tool tips only)
   Static colorValArray    := Array() ; Index -> Color value in decimal
   Static gui              := 0       ; the window, 0 until Build
   Static hWnd             := 0
   Static DPIFactor        := activeDPIFactor()
   Static callback         := 0       ; called with the color picked (ShowColorPopup)
   Static current          := -1      ; color shown ringed
   Static MaxIndex         := 36
   Static Cols             := 6
   Static circleSize       := 0
   Static _pos             := 0       ; where it was last shown {X, Y}
   Static __New() {
      fontSize := IniReadValue("User Button Bar", "Font Size", 8)
      ; Scale circle size with the size of the font/buttons for the button bar
      this.circleSize := round(this.DPIFactor * (FontSize / 0.36))
      this.Scale      := this.DPIFactor
      this._LoadColors()
      this._upHotkey  := this._ButtonUp.Bind(this)
   }
   /**
    * Read the color values and names from the settings file (cheap, kept for the session:
    * GuiSnip.ReplaceSnipBGColor uses the values without the popup)
    */
   Static _LoadColors() {
      Loop this.MaxIndex {
         ColorName := IniReadValue("User Shape Color", "Color " A_Index, 123)
         If ColorName = 123 {
            Color := 0x808080
            ColorName := hex(Color)
            IniWrite(hex(Color), SETTINGS.File, "User Shape Color", "Color " A_Index)
         } Else {
            Color := RGBval(ColorName)
         }
         ; Descriptive Name
         this.colorNameArray.push("Set " ColorName . (A_Index < 10 ? " color (" . A_Index . ")" :  " color " A_Index))
         ; Last index is reserved for color wheel / color picker
         this.colorValArray.push(A_Index == this.MaxIndex ? RGBval(-1) : Color)
      }
   }
   /**
    * True if the popup window exists (see Build/Release)
    * @type {Integer}
    */
   Static IsBuilt => this.gui != 0
   /**
    * True if the popup is built and showing
    * @type {Integer}
    */
   Static IsShown => this.gui AND IsWindowVisible(this.hWnd)
   /**
    * Make the popup window if it doesn't exist (a few ms: one window, no icons)
    */
   Static Build() {
      If this.gui
         Return
      ; It takes the focus when shown, and hides when it loses it
      this._InitBar(false)
      this.gui.OnMessage(0x0006, this._WM_ACTIVATE.Bind(this))   ; WM_ACTIVATE
      this._Layout()
      logGDI("Created Color GUI")
   }
   /**
    * Destroy the popup window (the last snip closed). The color values stay.
    */
   Static Release() {
      If NOT this.gui
         Return
      this._hideMe()
      this._DestroyBar()
      this.callback := 0
      logGDI("Released Color GUI")
   }
   ; Cells: 6 columns of circles
   Static _Layout() {
      cs     := this.circleSize
      gap    := Round(1.8 * this.DPIFactor)
      margin := gap * 4
      rows   := Ceil(this.MaxIndex / this.Cols)
      this.Items := []
      Loop this.MaxIndex {
         col := Mod(A_Index - 1, this.Cols), row := (A_Index - 1) // this.Cols
         this.Items.Push({ Index: A_Index, X: margin + col * (cs + gap), Y: margin + row * (cs + gap), W: cs, H: cs
            , Tip: A_Index = this.MaxIndex ? "Color Picker" : "" })
      }
      this.BarW := 2 * margin + this.Cols * cs + (this.Cols - 1) * gap
      this.BarH := 2 * margin + rows * cs + (rows - 1) * gap
   }
   /**
    * Show the popup at the mouse
    * @param {Func} [callback] - called with the color picked: callback(ColorPopDown, color)
    * @param {Integer} [defColor] - current color, shown ringed
    * @param {Integer} [parent] - owner window
    */
   Static ShowColorPopup(callback?, defColor?, parent:=0, *) {
      ; Normally built when a drawing tool was chosen; a selected shape or the text
      ; dialog can ask for it without one
      this.Build()
      If (IsSet(callback))
         this.callback := callback ; used by _colorPicked
      If (IsSet(defColor))
         this.current := defColor
      ; Attach a parent if needed
      if (WinExist(parent))
         this.gui.Opt("+Owner" parent)
      else
         this.gui.Opt("-Owner")
      ; At the mouse (a bit under it, on the margin), kept on the monitor
      cm := CoordMode("Mouse", "Screen")
      MouseGetPos(&sX, &sY)
      CoordMode("Mouse", cm)
      KeepOnMonitor(sX, sY, this.BarW, this.BarH, &X, &Y)
      this._ShowAt(X, Y)
   }
   Static _ShowAt(X, Y) {
      this._pos   := { X: X, Y: Y }
      this._hover := 0
      ; A color is picked when the button is released over it, also after pressing
      ; elsewhere and dragging onto it (as in a menu)
      Hotkey("~LButton Up", this._upHotkey, "On")
      wasShown := this.IsShown
      this._Render(X, Y, true, true)
      If (wasShown)
         WinActivate(this.hWnd)
      SetWindowTop(this.hWnd)
   }
   /**
    * Hide the popup
    */
   Static _hideMe() {
      If NOT this.gui
         Return
      Try Hotkey("~LButton Up", this._upHotkey, "Off")
      SetTimer(this._hoverTimer, 0)
      If (this._hover)
         ToolTip
      this._hover := 0
      this.gui.Opt("-Owner")
      this.gui.Hide()
   }
   ; Losing the focus hides it
   Static _WM_ACTIVATE(GuiObj, wParam, *) {
      If ((wParam & 0xFFFF) = 0)
         this._hideMe()
   }
   ; Left button released anywhere while shown: over a color, pick it
   Static _ButtonUp(*) {
      If NOT this.IsShown
         Return
      If (idx := this._MouseItem(&x, &y))
         this._colorPicked(idx)
   }
   ; Pressed on the popup: the color is picked on release (_ButtonUp)
   Static Click() {
   }
   ; Right click on a color: change it (not the color wheel)
   Static RightClick() {
      If ((idx := this._MouseItem(&x, &y)) AND idx < this.MaxIndex)
         this._ColorEdit(idx)
   }
   /**
    * Pick a color: hide the popup, call the callback
    * @param {Integer} Index - cell; the last one runs the screen color picker
    */
   Static _colorPicked(Index, *) {
      If (Index == this.MaxIndex) {
         color := ColorPicker.Run()
      } Else {
         color := this.colorValArray[Index]
      }
      this._hideMe()
      if (this.callback and color >= 0)
         this.callback(color)
   }
   /**
    * Replace a color with another and update the INI file (color dialog, or the screen
    * color picker with Ctrl). The dialog takes the focus, which hides the popup: it is
    * shown again where it was.
    * @param {Integer} Index - cell
    */
   Static _ColorEdit(Index) {
      editColor := this.colorValArray[Index]
      pos := this._pos
      ; Ctrl down uses color picker
      If (GetKeyState("Ctrl", "P")) {
         NewColor := ColorPicker.Run()
      } Else {
         NewColor := RGBval(this._PickCustomColor(editColor))
      }
      If (NewColor >= 0 AND editColor != RGBval(NewColor)) {
         ; TODO - Create an undo point
         NewColor := RGBval(NewColor)
         this.colorNameArray[Index] := "Set " hex(NewColor) . (Index < 10 ? " color (" . Index . ")" :  " color " Index)
         IniWrite(hex(NewColor), Settings.File, "User Shape Color", "Color " Index)
         this.colorValArray[Index] := NewColor
      }
      If (this.gui AND pos)
         this._ShowAt(pos.X, pos.Y)
   }
   /**
    * Bring up the color chooser with the first 16 colors as pre-sets
    * @param clr Current color to highlight
    * @returns {String}
    */
   Static _PickCustomColor(clr) {
      colArray := Array()
      ; Read up 16 custom colors from the color dialog presets
      Loop 16 {
         colArray.push(this.colorValArray[A_Index])
      }
      Return ColorSelectDialog(clr, this.hWnd, colArray, 1)
   }

   ;----------------------------------------------------------------------
   ; Drawing
   ;----------------------------------------------------------------------
   /**
    * Draw the popup: background, then each circle (current one ringed, the one under the
    * mouse larger)
    * @returns {DIBSurface}
    */
   Static Draw() {
      Surf := DIBSurface(this.BarW, this.BarH, this.hWnd)
      G    := Surf.G
      Surf.GraphicsClear(0)
      GDIp.SetSmoothingMode(G, 4)
      GDIp.SetPixelOffsetMode(G, 4)
      this._DrawBack(G, this._Px(4))
      For idx, item in this.Items {
         clr   := (idx = this.MaxIndex) ? -1 : this.colorValArray[idx]
         style := (this.colorValArray[idx] = this.current) ? 2 : (idx = this._hover ? 3 : 1)
         this._DrawCircle(G, item.X, item.Y, clr, style)
      }
      Return Surf
   }
   /**
    * One circle in a cell (same geometry as the old icons)
    * @param {Integer} color - RGB, or -1 for the color wheel
    * @param {Integer} style - 1 smaller circle, 2 ringed (current), 3 larger (under the mouse)
    */
   Static _DrawCircle(G, X, Y, color, style) {
      cs    := this.circleSize
      small := cs * 0.8
      Switch style {
         Case 1:
            bs := small, pad := (cs - bs) / 2
         Case 2:
            If (color >= 0)
               bs := small, pad := (cs - bs) / 2
            Else
               bs := cs - 2, pad := 1
         Default:
            bs := cs - 2, pad := 1
      }
      If (color >= 0) {
         brush := GDIp.BrushCreateSolid(0xFF000000 | color)
         GDIp.FillEllipse(G, brush, X + pad, Y + pad, bs, bs)
         GDIp.DeleteBrush(brush)
         If (style = 2) {
            ; ring with a small gap around the circle, in the text color so it shows on
            ; light and dark backgrounds
            pw  := cs * 0.07
            pen := GDIp.CreatePen(this.Colors.Value, pw)
            GDIp.DrawEllipse(G, pen, X + pad - pw, Y + pad - pw, bs + pw * 2, bs + pw * 2)
            GDIp.DeletePen(pen)
         }
         Return
      }
      ; Color wheel: 16 pie slices around a hole in the background color
      brush  := GDIp.BrushCreateSolid(0xFFFFFFFF)
      pieces := 16
      slice  := 360 / pieces
      Loop pieces {
         a := Round((A_Index - 1) * slice, 0)
         GDIp.SetBrushColor(brush, this.HsvToArgb(a))
         GDIp.FillPie(G, brush, X + pad, Y + pad, bs, bs, a - 90, slice + 5)
      }
      GDIp.SetBrushColor(brush, this.Colors.Back)
      r := bs / 5
      GDIp.FillEllipse(G, brush, X + cs / 2 - r, Y + cs / 2 - r, r * 2, r * 2)
      GDIp.DeleteBrush(brush)
   }
   ; h = 0..359, full saturation/value, integer math
   Static HsvToArgb(h) {
      f := Mod(h, 60) * 255 // 60
      switch h // 60 {
         case 0: r := 255,     g := f,       b := 0
         case 1: r := 255 - f, g := 255,     b := 0
         case 2: r := 0,       g := 255,     b := f
         case 3: r := 0,       g := 255 - f, b := 255
         case 4: r := f,       g := 0,       b := 255
         default: r := 255,    g := 0,       b := 255 - f
      }
      return 0xFF000000 | r << 16 | g << 8 | b
   }
}
